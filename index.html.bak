  <!-- HERO SECTION -->
  <section class="nk-hero relative overflow-hidden" aria-label="Nauka houseboat escapes in Alleppey">
    <video class="nk-hero-video absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline webkit-playsinline preload="metadata" disablepictureinpicture aria-label="Houseboat cruising on the Kerala backwaters">
      <source src="https://res.cloudinary.com/dxmuistk4/video/upload/v1791635372/12867885_1920_1080_24fps_hddsck.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay absolute inset-0"></div><div class="nk-hero-fade" aria-hidden="true"></div>
    <script id="nk-hero-video-loader">
(function(){
  var v=document.querySelector('.nk-hero-video'); if(!v) return;
  var shown=false;
  function show(){ if(shown) return; shown=true; v.classList.add('nk-video-ready'); }
  function tryPlay(){ var p=v.play&&v.play(); if(p&&p.catch) p.catch(function(){}); }
  ['loadeddata','canplay','playing'].forEach(function(e){ v.addEventListener(e,function(){ if(v.readyState>=2) show(); if(e!=='playing') tryPlay(); }); });
  if(v.readyState>=2) show();
  tryPlay();
  document.addEventListener('visibilitychange',function(){ if(!document.hidden) tryPlay(); });
  setTimeout(show,6000); /* safety net: never leave the hero empty */
})();
</script>

    <div class="nk-hero-quote"><span class="nk-hero-kicker">THE AUTHENTIC BACKWATER EXPERIENCE</span><p>Your Dream Houseboat.<br /><em>Your Perfect Getaway.</em></p></div>
