  function syncHomeSearchDates(){const start=document.getElementById('booking-date')?.value||'',end=document.getElementById('booking-checkout')?.value||'',fmt=iso=>{if(!iso)return 'Choose date';const [y,m,d]=iso.split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})};const a=document.getElementById('nk-search-checkin'),b=document.getElementById('nk-search-checkout');if(a)a.textContent=fmt(start);if(b)b.textContent=(window.nkBookingMode||window.nkCruiseMode)==='day'&&start?'Same day':fmt(end)}
  function renderSmartSuggestions(){
    const target=document.getElementById('nk-smart-suggestion-list');
    if(!target||typeof PROPERTIES==='undefined'||typeof window.renderPropertyCards!=='function')return;
    const isBoat=p=>p&&String(p.category||'').toLowerCase()==='houseboat'&&!p.roomListing;
    const fleet=PROPERTIES.filter(isBoat);
    /* Prefer boats that have a photo, then fill with any other boat, then with room stays so the section is never empty. */
    const ranked=[...fleet.filter(p=>p.image),...fleet.filter(p=>!p.image),...PROPERTIES.filter(p=>p&&p.roomListing)];
    const pool=ranked.filter((p,k,a)=>a.findIndex(x=>String(x.id)===String(p.id))===k);
    const signature=pool.map(p=>String(p.id)).join(',');
    if(!pool.length){
      target.innerHTML=typeof window.buildFleetLoadingSkeleton === 'function' ? window.buildFleetLoadingSkeleton(3, 'smart') : '<p class="nk-suggestion-empty">Our fleet is loading — please check back in a moment.</p>';
      target.dataset.signature='';
      return;
    }
    if(target.dataset.signature!==signature||!target.querySelector('.property-card')){
      /* Shuffle once per fleet change, keep the picks stable between re-renders. */
      const items=pool.slice(0,Math.max(5,Math.min(pool.length,12)));
      for(let k=items.length-1;k>0;k--){const m=Math.floor(Math.random()*(k+1));[items[k],items[m]]=[items[m],items[k]]}
      window.nkSuggestionIds=items.slice(0,3).map(p=>String(p.id));
      target.dataset.signature=signature;
    }
    const picks=(window.nkSuggestionIds||[]).map(id=>pool.find(p=>String(p.id)===id)).filter(Boolean);
    window.renderPropertyCards(picks.length?picks:pool.slice(0,3),target);
  }
  window.renderSmartSuggestions=renderSmartSuggestions;
  function addBookingAndTrustSections(){const route=document.getElementById('routes');if(!route||document.getElementById('nk-booking-steps'))return;route.insertAdjacentHTML('afterend',`<section id="nk-booking-steps" class="nk-booking-steps"><div class="nk-feature-heading"><div class="nk-section-kicker">A simple way to sail</div><h2>How Booking Works</h2><p>Four clear steps from choosing your boat to stepping aboard.</p></div><div class="nk-step-grid"><article class="nk-step-card"><span class="nk-step-number">01</span><span class="nk-step-icon"><i class="fa-solid fa-ship"></i></span><h3>Choose your boat</h3><p>Find the houseboat and experience that fit your trip.</p></article><article class="nk-step-card"><span class="nk-step-number">02</span><span class="nk-step-icon"><i class="fa-brands fa-whatsapp"></i></span><h3>Confirm availability through WhatsApp</h3><p>Our team confirms your dates and trip details with you.</p></article><article class="nk-step-card"><span class="nk-step-number">03</span><span class="nk-step-icon"><i class="fa-solid fa-shield-heart"></i></span><h3>Pay 25% advance</h3><p>Secure your booking once availability and details are confirmed.</p></article><article class="nk-step-card"><span class="nk-step-number">04</span><span class="nk-step-icon"><i class="fa-solid fa-sun"></i></span><h3>Check-in &amp; Enjoy</h3><p>Arrive at the boarding point and settle into your backwater escape.</p></article></div></section><section id="nk-why-nauka" class="nk-why-nauka"><div class="nk-feature-heading"><div class="nk-section-kicker">The Nauka difference</div><h2>Why choose <em>Nauka?</em></h2><p>Discover the backwaters with a local team that makes each step feel considered, clear, and easy.</p></div><div class="nk-why-grid"><article class="nk-why-card"><span class="nk-why-icon mint"><i class="fa-solid fa-compass"></i></span><h3>Local expertise</h3><p>Plan your Alleppey stay with a team that knows these waterways.</p></article><article class="nk-why-card"><span class="nk-why-icon peach"><i class="fa-solid fa-utensils"></i></span><h3>Kerala hospitality</h3><p>Explore boat options with local meals and thoughtful onboard service.</p></article><article class="nk-why-card"><span class="nk-why-icon blue"><i class="fa-solid fa-bed"></i></span><h3>Stays for your group</h3><p>Compare houseboats and private room stays to find your fit.</p></article><article class="nk-why-card"><span class="nk-why-icon aqua"><i class="fa-solid fa-receipt"></i></span><h3>Clear trip details</h3><p>Review the boat, amenities, dates, and pricing before confirming.</p></article><article class="nk-why-card"><span class="nk-why-icon rose"><i class="fa-solid fa-comments"></i></span><h3>Local guest support</h3><p>Reach the Nauka team for help before your trip and at check-in.</p></article></div></section>`)}
  function hookSuggestionRefresh(){const original=window.renderProperties;if(!original||original.__nkSuggestionHook)return;const wrapped=function(){const result=original.apply(this,arguments);renderSmartSuggestions();return result};wrapped.__nkSuggestionHook=true;window.renderProperties=wrapped}  function clearHomeSearch(){window.nkHomeFilter=null;state._currentCategory='all';document.querySelectorAll('.cat-chip').forEach(x=>x.classList.toggle('selected',x.dataset.cat==='all'));const n=document.getElementById('fleet-route-notice');if(n){n.classList.add('hidden');n.classList.remove('flex')}if(typeof renderProperties==='function')renderProperties()}
   function showAllBoats(){clearHomeSearch();showView('boats');if(typeof renderProperties==='function')renderProperties()}window.showAllBoats=showAllBoats;window.clearHomeSearch=clearHomeSearch;
   (function syncCruiseTypeIntoAvailabilityRpc(){const api=window.naukaSupabase;if(!api?.rpc||api.__nkCruiseTypeRpc)return;const original=api.rpc.bind(api);api.rpc=function(name,args,...rest){if(name==='get_listing_blocked_dates'&&args&&!Object.prototype.hasOwnProperty.call(args,'p_cruise_type')){const selected=document.getElementById('nk-search-experience')?.value||window.nkBookingMode||window.nkCruiseMode||'night';args={...args,p_cruise_type:selected==='day'?'day':'night'}}return original(name,args,...rest)};api.__nkCruiseTypeRpc=true})();
  async function applyNaukaHomeSearch(){const start=document.getElementById('booking-date')?.value||'',mode=document.getElementById('nk-search-experience')?.value||'overnight',checkout=document.getElementById('booking-checkout')?.value||'';if(!start){window.nkSearchPickDate('in');return}if(mode!=='day'&&!checkout){window.nkSearchPickDate('out');return}const adults=Number(document.getElementById('nk-search-adults')?.textContent||2),children=Number(document.getElementById('nk-search-children')?.textContent||0),guests=adults+children,type=document.getElementById('nk-search-boat-type')?.value||'all';const eligible=PROPERTIES.filter(p=>p.category==='houseboat'&&!p.roomListing&&p.image&&(type==='all'||(type==='5plus'?(Number(p.bedrooms)||0)>5:Number(p.bedrooms)===Number(type)))&&Math.max(2,Number(p.includedGuests)||(Number(p.bedrooms)||1)*2)>=guests);let ids=eligible.map(p=>String(p.id)),errors=0,live=false;const rpc=window.naukaSupabase;if(rpc?.rpc&&eligible.length){const through=mode==='day'?start:(()=>{const [y,m,d]=checkout.split('-').map(Number),x=new Date(y,m-1,d-1);return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0')})();const results=await Promise.all(eligible.map(async p=>{try{const r=await rpc.rpc('get_listing_blocked_dates',{p_property_id:Number(p.id),p_from:start,p_to:through});if(r.error){errors++;return null}return(r.data||[]).length?null:String(p.id)}catch(_){errors++;return null}}));ids=results.filter(Boolean);live=errors===0}if(!ids.length){document.getElementById('nk-search-guest-panel')?.setAttribute('hidden','');window.nkShowNoBoatPopup();return}window.nkCruiseMode=mode;window.nkBookingMode=mode;window.nkHomeFilter={start,checkout:mode==='day'?start:checkout,mode,adults,children,guests,boatType:type,resultIds:ids,liveAvailability:live,availabilityErrors:errors};state._currentCategory='all';document.querySelectorAll('.cat-chip').forEach(x=>x.classList.toggle('selected',x.dataset.cat==='all'));showView('boats');if(typeof renderProperties==='function')renderProperties();const notice=document.getElementById('fleet-route-notice');if(notice){const fmt=x=>new Date(x+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short'}),dates=mode==='day'?fmt(start):fmt(start)+' – '+fmt(checkout),status=live?'available':errors?'availability to confirm':'matched';notice.innerHTML='<i class="fa-solid fa-calendar-check"></i><span>Showing '+ids.length+' '+(ids.length===1?'houseboat':'houseboats')+' · '+dates+' · '+guests+' guest'+(guests===1?'':'s')+' · '+status+'</span><button type="button" class="nk-filter-clear" onclick="clearHomeSearch()">Clear</button>';notice.classList.remove('hidden');notice.classList.add('flex')}document.getElementById('nk-search-guest-panel')?.setAttribute('hidden','')}
  window.applyNaukaHomeSearch=applyNaukaHomeSearch;
  window.nkShowNoBoatPopup=function(){
    let m=document.getElementById('nk-nobt-modal');
    if(!m){
      document.body.insertAdjacentHTML('beforeend','<div id="nk-nobt-modal" role="dialog" aria-modal="true" aria-labelledby="nk-nobt-title"><div class="nk-nobt-card"><button type="button" class="nk-nobt-x" aria-label="Close" onclick="nkCloseNoBoatPopup()"><i class="fa-solid fa-xmark"></i></button><div class="nk-nobt-icon"><i class="fa-solid fa-calendar-xmark"></i></div><p class="nk-nobt-kicker">Let us widen the search</p><h3 id="nk-nobt-title">No boat matches your search.</h3><p>Nothing matches this combination yet. Try another date, guest count or boat type and we’ll find the best fit.</p><button type="button" class="nk-nobt-cta" onclick="nkExploreFleet()">Explore the full fleet <i class="fa-solid fa-arrow-right"></i></button></div></div>');
      m=document.getElementById('nk-nobt-modal');
      m.addEventListener('click',e=>{if(e.target===m)nkCloseNoBoatPopup()});
      document.addEventListener('keydown',e=>{if(e.key==='Escape')nkCloseNoBoatPopup()});
    }
    m.classList.add('open');
  };
  window.nkCloseNoBoatPopup=function(){document.getElementById('nk-nobt-modal')?.classList.remove('open')};
  window.nkExploreFleet=function(){nkCloseNoBoatPopup();showAllBoats();window.scrollTo({top:0,behavior:'smooth'})};  function replaceHomeRoutes(){
    const old=document.getElementById('routes'); if(!old||old.dataset.nkDone)return;
    old.dataset.nkDone='1';
    old.innerHTML=`<div class="nk-suggestion-heading"><div><div class="nk-section-kicker">Picked for your escape</div><h2 class="text-3xl sm:text-4xl font-serif font-bold text-navy mt-4">Smart Suggestions</h2><p class="text-slate-600 text-sm sm:text-base mt-2">A few houseboats to get your Alleppey getaway started.</p></div></div><div id="nk-smart-suggestion-list" class="nk-suggestion-grid" aria-live="polite"></div><div class="nk-suggestion-actions"><button type="button" class="nk-show-more" onclick="showAllBoats()" aria-label="Explore the full houseboat fleet"><span class="nk-sm-text"><strong>Explore the full fleet</strong><small>Every houseboat &amp; room stay in Alleppey</small></span><span class="nk-sm-arrow"><i class="fa-solid fa-arrow-right"></i></span></button></div>`;
    renderSmartSuggestions();
  }  function replaceFaq(){
    const faq=document.getElementById('faq'); if(!faq||faq.dataset.nkDone)return; faq.dataset.nkDone='1';
    const items=[
      ['What’s the difference between Deluxe and Premium houseboats?','Premium boats add larger rooms, a more spacious deck and a higher level of onboard service. The exact inclusions are shown on each boat’s detail page.'],
      ['Should I book a private or a sharing houseboat?','Private is best for families, couples and celebrations. Sharing is a more social way to enjoy the same waterway at a lighter price.'],
