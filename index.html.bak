  }
  function addMailModal(){
    if(document.getElementById('nk-mail-backdrop'))return;
    document.body.insertAdjacentHTML('beforeend',`<div id="nk-mail-backdrop" onclick="if(event.target===this)closeMailContact()"><div class="nk-mail-card"><div class="flex items-start justify-between gap-3"><div><h3>Email Nauka</h3><p>Copy the address first, then open Gmail when you’re ready.</p></div><button class="nk-contact-close" onclick="closeMailContact()" aria-label="Close"><i class="fa-solid fa-xmark"></i></button></div><div class="nk-mail-address"><span id="nk-mail-address-text">booking.nauka@gmail.com</span><button class="nk-mail-copy" onclick="copyNaukaEmail()">Copy</button></div><div class="nk-mail-actions"><button class="nk-mail-cancel" onclick="closeMailContact()">Cancel</button><button class="nk-mail-open" onclick="openNaukaGmail()">Open Gmail <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i></button></div></div></div>`);
  }
  function openMailContact(){addMailModal();document.getElementById('nk-mail-backdrop')?.classList.add('open')}
  function closeMailContact(){document.getElementById('nk-mail-backdrop')?.classList.remove('open')}
  async function copyNaukaEmail(){const value='booking.nauka@gmail.com';try{await navigator.clipboard.writeText(value)}catch(e){const input=document.createElement('textarea');input.value=value;document.body.appendChild(input);input.select();document.execCommand('copy');input.remove()}const b=document.querySelector('.nk-mail-copy');if(b){b.textContent='Copied';setTimeout(()=>{b.textContent='Copy'},1500)}}
  function openNaukaGmail(){closeMailContact();window.open('https://mail.google.com/mail/?view=cm&fs=1&to=booking.nauka@gmail.com','_blank','noopener')}
  function addReviewModal(){
    if(document.getElementById('nk-review-backdrop'))return;
    document.body.insertAdjacentHTML('beforeend',`<div id="nk-review-backdrop" onclick="if(event.target===this)closeReview()"><div class="nk-review-dialog"><div class="flex items-center justify-between mb-4"><div class="flex items-center gap-3"><img id="nk-review-dialog-avatar" class="nk-review-avatar" src=""/><div><p id="nk-review-dialog-name" class="nk-review-name"></p><p id="nk-review-dialog-meta" class="nk-review-meta"></p></div></div><button class="nk-contact-close" onclick="closeReview()"><i class="fa-solid fa-xmark"></i></button></div><div class="nk-review-stars mb-3">★★★★★</div><p id="nk-review-dialog-text" class="text-gray-600 text-sm font-body leading-relaxed"></p></div></div>`);
