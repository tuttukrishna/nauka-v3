/* Agent bookings data */
/* Live bookings are loaded from Supabase after authentication. */
const AGENT_BOOKINGS = [];
/* ─────────────────────────────────────────
   STATE
───────────────────────────────────────── */
const state = {
  selectedProperty: null,
  currentView: 'home',
  bookingData: {},
  notifOpen: false,
  loggedInUser: null,
  isAdmin: false,
  savedProperties: [],   // array of property ids
  userBookings: [],      // array of booking data objects
  bookingSeenAt: 0,      // timestamp of the last time the customer opened Bookings
};

/* ─────────────────────────────────────────
   INIT
───────────────────────────────────────── */
function normalizeNaukaRegion(region) {
  const value = String(region || '').trim().toUpperCase();
  if (value === 'USA' || value.includes('UNITED STATES')) return 'USA';
  if (value === 'UAE' || value.includes('UNITED ARAB')) return 'UAE';
  if (value === 'EUROPE' || value.includes('EURO')) return 'EUROPE';
  return 'INDIA';
}

function init() {
  // Do not treat localStorage as authentication. Supabase must verify the
  // current session before a profile, saved data, or admin role is restored.

  renderProperties();
  renderAgentBookings();
  renderSavedView();
  renderMyBookings();

  // Restore heart icons for saved properties
  if (state.savedProperties.length > 0) {
    state.savedProperties.forEach(id => {
      const card = document.querySelector(`#property-list [data-id="${id}"]`);
      if (card) {
        const icon = card.querySelector('button i.fa-regular.fa-heart');
        if (icon) { icon.classList.replace('fa-regular', 'fa-solid'); icon.style.color = '#e53e3e'; }
      }
    });
  }

  // Preserve an intentional deep link until Supabase session hydration has
  // completed. This prevents an admin/customer route from flickering to home.
  const rawHash = (window.location.hash || '').replace(/^#/, '').trim();
  const initialView = rawHash === 'fleet' ? 'boats' : rawHash;
  const validView = initialView && document.getElementById('view-' + initialView) ? initialView : 'home';
  history.replaceState({ view: validView }, '', '#' + (validView === 'boats' ? 'fleet' : validView));

  // Set today's date as min for booking date
  const today = new Date().toISOString().split('T')[0];
  const dateInput = document.getElementById('booking-date');
  if (dateInput) dateInput.min = today;

  const nightsInput = document.getElementById('booking-nights');
  if (nightsInput) nightsInput.addEventListener('input', updatePriceSummary);

  // Guests now enter the home screen directly. Authentication remains available
  // from the existing Sign In / Create Account actions and booking flow.
}

/* ─────────────────────────────────────────
   VIEW MANAGEMENT (with History API)
───────────────────────────────────────── */
function showView(viewName, pushHistory = true) {
  if (viewName === 'fleet') viewName = 'boats';
  if (viewName === 'admin' && !state.isAdmin) viewName = 'home';
  const target = document.getElementById('view-' + viewName);
  if (!target) return;
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  target.classList.add('active');
  state.currentView = viewName;
  window.scrollTo(0, 0);
  _syncChrome(viewName);

  // Push to browser history so back-button works
  if (pushHistory) {
    history.pushState({ view: viewName }, '', '#' + (viewName === 'boats' ? 'fleet' : viewName));
  }

  // Re-render dynamic views on navigation
  if (viewName === 'boats') renderProperties();
  if (viewName === 'saved') renderSavedView();
  if (viewName === 'mybookings') renderMyBookings();
  if (viewName === 'tours') { renderTourCards(); }

  // Nav management
  const customerNav = document.getElementById('customer-bottom-nav');
  const agentNav = document.getElementById('agent-bottom-nav');

  if (viewName === 'agent') {
    customerNav.style.display = 'none';
    agentNav.classList.remove('hidden');
    updateAgentNavActive('overview');
  } else if (viewName === 'admin') {
    customerNav.style.display = 'none';
    agentNav.classList.add('hidden');
    /* The live Admin Control Centre owns its first render. */
  } else {
    customerNav.style.display = '';
    agentNav.classList.add('hidden');
  }

  if (viewName === 'login' || viewName === 'success' || viewName === 'admin') {
    customerNav.style.display = 'none';
  }
  if (viewName === 'home' || viewName === 'detail' || viewName === 'saved' || viewName === 'mybookings' || viewName === 'profile' || viewName === 'tours' || viewName === 'boats') {
    customerNav.style.display = '';
  }
  // If not logged in and trying to view profile, go to login
  if (viewName === 'profile' && !state.loggedInUser) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById('view-login').classList.add('active');
    state.currentView = 'login';
    customerNav.style.display = 'none';
    return;
  }
}

window.openAdminPortal = function () {
  if (!state.isAdmin) {
    if (typeof showBackendMessage === 'function') showBackendMessage('Admin access is not available for this account.', true);
    return;
  }
  showView('admin');
};

// Handle initial deep-link hash and browser back/forward buttons
function handleInitialRoute() {
  const hash = (window.location.hash || '').replace(/^#/, '').trim();
  if (hash) {
    const view = hash === 'fleet' ? 'boats' : hash;
    if (view === 'admin' && !state.isAdmin) {
      showView('home', false);
      return;
    }
    if (document.getElementById('view-' + view)) {
      showView(view, false);
    }
  }
}
window.handleInitialRoute = handleInitialRoute;

window.addEventListener('popstate', function(e) {
  if (e.state && e.state.view) {
    showView(e.state.view, false);
  } else {
    const hash = (window.location.hash || '').replace(/^#/, '').trim();
    showView(hash || 'home', false);
  }
  // Close any open modals/panels
  closeBookingModal();
  closeNotifPanel();
});

window.addEventListener('hashchange', function() {
  const hash = (window.location.hash || '').replace(/^#/, '').trim();
  if (hash) {
    const view = hash === 'fleet' ? 'boats' : hash;
    if (document.getElementById('view-' + view) && state.currentView !== view) {
      showView(view, false);
    }
  }
});

/* ─────────────────────────────────────────
   NOTIFICATION PANEL
───────────────────────────────────────── */
function openNotifPanel() {
  document.getElementById('notif-panel').classList.add('open');
  document.getElementById('notif-backdrop').classList.add('open');
  state.notifOpen = true;
}

function closeNotifPanel() {
  document.getElementById('notif-panel').classList.remove('open');
  document.getElementById('notif-backdrop').classList.remove('open');
  state.notifOpen = false;
  // Clear badge
  const badge = document.getElementById('notif-badge');
  if (badge) badge.style.display = 'none';
}

/* ─────────────────────────────────────────
   LOGIN PAGE TABS (Feature 5)
───────────────────────────────────────── */
function switchLoginTab(tab) {
  document.getElementById('tab-customer')?.classList.toggle('active', true);
  document.getElementById('form-customer')?.classList.toggle('active', true);
}

function loginAsCustomer() {
  return;
}

function loginAsAgent() {
  return;
}

/* ─────────────────────────────────────────
   AGENT DASHBOARD TABS (Feature 6)
───────────────────────────────────────── */
function switchAgentTab(tab) {
  const tabs = ['overview', 'bookings', 'listings', 'earnings'];
  tabs.forEach(t => {
    const el = document.getElementById('agent-tab-' + t);
    if (el) el.classList.toggle('hidden', t !== tab);
  });

  // Update top sub-nav pills
  tabs.forEach(t => {
    const btn = document.getElementById('atab-' + t);
    if (btn) {
      if (t === tab) {
        btn.style.background = 'rgba(255,255,255,0.25)';
        btn.style.color = 'white';
      } else {
        btn.style.background = '';
        btn.style.color = 'rgba(255,255,255,0.6)';
      }
    }
  });

  updateAgentNavActive(tab);
}

function updateAgentNavActive(tab) {
  const tabs = ['overview', 'bookings', 'listings', 'earnings'];
  tabs.forEach(t => {
    const btn = document.getElementById('anav-' + t);
    if (btn) {
      btn.style.color = t === tab ? 'white' : 'rgba(255,255,255,0.4)';
    }
  });
}

function exitAgentDashboard() {
  showView('home');
}

/* ─────────────────────────────────────────
   AGENT BOOKINGS MANAGEMENT
───────────────────────────────────────── */
function renderAgentBookings() {
  const container = document.getElementById('bookings-list');
  if (!container) return;

  container.innerHTML = AGENT_BOOKINGS.map(b => `
    <div class="booking-row px-5 py-4 border-b border-gray-50 last:border-b-0" data-booking-id="${b.id}">
      <div class="flex items-start justify-between mb-2">
        <div>
          <p class="font-body font-semibold text-ink text-sm">${b.guest}</p>
          <p class="text-gray-400 text-xs font-body">${b.property}</p>
        </div>
        <span class="badge-${b.status} text-[11px] font-semibold font-body px-2.5 py-1 rounded-full capitalize">${b.status}</span>
      </div>
      <div class="flex items-center justify-between">
        <div class="flex gap-3">
          <span class="text-gray-500 text-xs font-body">${b.date}</span>
          <span class="text-gray-400 text-xs font-body">·</span>
          <span class="text-gray-500 text-xs font-body">${b.guests} guests</span>
          <span class="text-gray-400 text-xs font-body">·</span>
          <span class="text-emerald font-semibold text-xs font-body">${b.total}</span>
        </div>
        ${b.status === 'pending' ? `
          <div class="flex gap-1.5">
            <button onclick="handleBookingById('${b.id}','accept')" class="bg-emerald-mist text-emerald text-[11px] font-semibold font-body px-2.5 py-1.5 rounded-xl hover:bg-emerald hover:text-white transition">Accept</button>
            <button onclick="handleBookingById('${b.id}','decline')" class="bg-red-50 text-red-500 text-[11px] font-semibold font-body px-2.5 py-1.5 rounded-xl hover:bg-red-500 hover:text-white transition">Decline</button>
          </div>` : ''}
      </div>
    </div>
  `).join('');
}

function handleBooking(btn, action) {
  const row = btn.closest('.flex.items-center.gap-3');
  const badge = row ? row.querySelector('.badge-pending, .badge-confirmed') : null;
  // Find the action buttons container and replace with status
  const actionsDiv = btn.parentElement;
  if (actionsDiv) {
    actionsDiv.innerHTML = action === 'accept'
      ? '<span class="badge-confirmed text-[11px] font-semibold font-body px-2.5 py-1 rounded-full">Confirmed</span>'
      : '<span class="badge-declined text-[11px] font-semibold font-body px-2.5 py-1 rounded-full">Declined</span>';
  }
}

function handleBookingById(bookingId, action) {
  const booking = AGENT_BOOKINGS.find(b => b.id === bookingId);
  if (booking) booking.status = action === 'accept' ? 'confirmed' : 'declined';
  renderAgentBookings();
}

window.buildFleetLoadingSkeleton = function(count = 3, context = 'fleet') {
  const isFleet = context === 'fleet';
  const subtitle = isFleet 
    ? 'Connecting to live Alleppey houseboats & verified rates…'
    : 'Finding verified houseboats for your backwater escape…';
  
  let cardsHtml = '';
  for (let i = 0; i < count; i++) {
    cardsHtml += `
      <div class="nk-skeleton-card">
        <div class="nk-skeleton-img">
          <div class="nk-skeleton-shimmer"></div>
          <div class="nk-skeleton-badge"></div>
        </div>
        <div class="nk-skeleton-body">
          <div class="nk-skeleton-line title"></div>
          <div class="nk-skeleton-line sub"></div>
          <div class="nk-skeleton-footer">
            <div class="nk-skeleton-line price"></div>
            <div class="nk-skeleton-btn"></div>
          </div>
        </div>
      </div>`;
  }

  return `
    <div class="nk-fleet-loading-container">
      <div class="nk-fleet-loading-banner">
        <div class="nk-loading-icon-pulse">
          <span class="nk-pulse-ring"></span>
          <i class="fa-solid fa-ship"></i>
        </div>
        <div class="nk-loading-info">
          <div class="flex items-center gap-2">
            <h4 class="nk-loading-title">Curating Our Luxury Fleet</h4>
            <span class="nk-loading-live-chip"><span class="nk-live-dot"></span> LIVE</span>
          </div>
          <p class="nk-loading-subtitle">${subtitle}</p>
        </div>
        <div class="nk-loading-bars">
          <span></span><span></span><span></span>
        </div>
      </div>
      <div class="${isFleet ? 'flex flex-col gap-5' : 'nk-suggestion-grid'}">
        ${cardsHtml}
      </div>
    </div>`;
};

/* ─────────────────────────────────────────
   RENDER PROPERTY CARDS
───────────────────────────────────────── */
function renderPropertyCards(properties, target = 'property-list') {
  const container = typeof target === 'string' ? document.getElementById(target) : target;
  if (!container) return;
  container.innerHTML = '';

  if (properties.length === 0) {
    if (!window.nkFleetLoaded) {
      container.innerHTML = window.buildFleetLoadingSkeleton(3, target === 'property-list' ? 'fleet' : 'smart');
      return;
    }
    container.innerHTML = `
      <div class="text-center py-12">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" class="mx-auto mb-3"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p class="text-gray-400 font-body text-sm">No houseboats in this category yet. Tap the selected chip again to see all.</p>
      </div>`;
    return;
  }

  properties.forEach(prop => {
    const starsHTML = buildStars(prop.rating);
    const displayPrice = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(prop, window.nkCruiseMode || 'overnight') : prop.price;
    const catKey = String(prop.category || '').toLowerCase();
    const categoryLabel = prop.roomListing ? 'Room stay' : ({houseboat:'Houseboat',shikara:'Shikara',homestay:'Homestay',tour:'Tour Package'}[catKey] || 'Listing');
    const priceLabel = prop.category === 'tour' ? 'Per person from' : (prop.roomListing ? 'Per room · night' : 'Per night from');
    const btnLabel = prop.category === 'tour' ? 'View Tour' : 'View Details';
    const imageStyle = typeof window.nkImagePositionStyle === 'function' ? window.nkImagePositionStyle(prop.image) : '';
    const ratingNum = Number(prop.rating) || 0;
    const reviewNum = Number(prop.reviews) || 0;
    const ratingHTML = ratingNum > 0
      ? `<span class="nk-rating"><i class="fa-solid fa-star"></i><b>${ratingNum.toFixed(1)}</b>${reviewNum ? `<em>(${reviewNum})</em>` : ''}</span>`
      : `<span class="nk-rating nk-rating-new"><i class="fa-solid fa-sparkles"></i><b>New</b></span>`;
    const amenityList = (prop.amenities || []).slice(0,3);

    const card = document.createElement('div');
    card.className = 'property-card nk-card bg-white rounded-3xl overflow-hidden shadow-card cursor-pointer' + (prop.roomListing ? ' room-listing-card' : '');
    card.setAttribute('data-id', prop.id);
    card.innerHTML = `
      <div class="relative overflow-hidden nk-card-media">
        <img src="${prop.image}" alt="${prop.title}" style="${imageStyle}" class="w-full h-full object-cover transition-transform duration-500" loading="lazy" />
        <span class="nk-card-badge ${prop.category === 'tour' ? 'is-gold' : ''}">${categoryLabel}</span>
        <button onclick="event.stopPropagation(); toggleHeart(this)" aria-label="Save" class="nk-card-heart">
          <i class="fa-regular fa-heart text-sm"></i>
        </button>
      </div>
      <div class="px-4 nk-card-body">
        <div class="nk-card-head">
          <h3 class="font-body font-bold text-ink">${prop.title}</h3>
          ${ratingHTML}
        </div>
        <p class="nk-card-loc"><i class="fa-solid fa-location-dot"></i>${prop.location}</p>
        ${prop.roomListing ? '<div class="nk-room-card-label"><i class="fa-solid fa-bed"></i>Room stay · book one room</div><div class="nk-room-pricing"><i class="fa-solid fa-ship"></i><span><b>PER-ROOM HOUSEBOAT</b><small>One private room inside a multi-room boat · not the whole boat.</small></span></div>' : ''}
        <div class="nk-card-chips">
          ${amenityList.map(a => `<span class="amenity-pill text-xs"><i class="fa-solid ${a.icon || 'fa-check'}"></i>${a.label}</span>`).join('')}
        </div>
        <div class="nk-card-foot">
          <div class="nk-card-price">
            <p class="nk-price-label">${priceLabel}</p>
            <p class="nk-price-value">${typeof window.nkFormatPrice==='function'?window.nkFormatPrice(displayPrice):'₹'+displayPrice.toLocaleString('en-IN')}</p>
          </div>
          <button ${prop.category === 'tour' ? `onclick="openTourDetail('T0${prop.id - 100}')"` : `data-nk-detail-id="${prop.id}" onclick="openPropertyDetail(${prop.id})"`} class="nk-card-cta ${prop.category === 'tour' ? 'btn-gold' : 'btn-emerald'}">${btnLabel}<i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>
    `;
    card.addEventListener('click', function(e) {
      if (!e.target.closest('button')) openPropertyDetail(prop.id);
    });
    container.appendChild(card);
  });
}

/* ─────────────────────────────────────────
   PROPERTY DETAIL
───────────────────────────────────────── */
function openPropertyDetail(propertyId) {
  // Clear any booking/popup layer before opening a fresh detail view.
  document.getElementById('bookingModal')?.classList.remove('open');
  window.closeCalendar?.();
  document.getElementById('nk-gallery-backdrop')?.classList.remove('open');
  document.getElementById('nk-concierge-backdrop')?.classList.remove('open');
  document.getElementById('nk-redirect-modal')?.classList.remove('open');
  document.body.style.overflow = '';
  const normalizedId = Number(propertyId);
  const prop = PROPERTIES.find(p => p.id === normalizedId);
  if (!prop) return;
  state.selectedProperty = prop;

  document.getElementById('detail-hero-src').src = prop.image;
  if (typeof window.nkApplyListingImagePosition === 'function') window.nkApplyListingImagePosition(document.getElementById('detail-hero-src'), prop.image);
  document.getElementById('detail-hero-src').alt = prop.title;
  document.getElementById('detail-title').textContent = prop.title;
  document.getElementById('detail-location').querySelector('span').textContent = prop.location;
  const detailPrice = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(prop, window.nkCruiseMode || 'overnight') : prop.price;
  const detailPriceEl=document.getElementById('detail-price');
  const detailCurrencyEl=document.getElementById('detail-price-currency');
  if(typeof window.nkFormatPrice==='function'){detailPriceEl.textContent=window.nkFormatPrice(detailPrice);if(detailCurrencyEl)detailCurrencyEl.textContent='';}
  else{detailPriceEl.textContent=detailPrice.toLocaleString('en-IN');if(detailCurrencyEl)detailCurrencyEl.textContent='₹';}
  document.getElementById('detail-reviews').textContent = `(${prop.reviews} reviews)`;
  document.getElementById('detail-desc').textContent = prop.description;
  const detailHost = document.getElementById('detail-host');
  if (detailHost) detailHost.textContent = prop.host;

  const catMap = {houseboat:'Luxury Houseboat',shikara:'Shikara Cruise',homestay:'Heritage Homestay'};
  document.getElementById('detail-category-badge').textContent = catMap[prop.category] || 'Listing';
  document.getElementById('detail-stars').innerHTML = buildStars(prop.rating);

  const amenitiesEl = document.getElementById('detail-amenities');
  amenitiesEl.innerHTML = prop.amenities.map(a => `<span class="amenity-pill"><i class="fa-solid ${a.icon}"></i>${a.label}</span>`).join('');

  const detailView = document.getElementById('view-detail');
  const galleryHeading = detailView ? [...detailView.querySelectorAll('h4')].find(h => h.textContent.trim() === 'Gallery') : null;
  // The enhanced gallery replaces the starter images after the first open, so
  // always resolve the reusable gallery container instead of relying on a
  // one-time child id.
  const galGrid = document.getElementById('gallery-img-1')?.parentElement
    || galleryHeading?.nextElementSibling
    || detailView?.querySelector('[data-nk-gallery-grid]');
  if (!galGrid) return;
  const hasGal = prop.gallery && prop.gallery.length >= 3;
  galGrid.style.display = hasGal ? '' : 'none';
  if (galGrid.previousElementSibling) galGrid.previousElementSibling.style.display = hasGal ? '' : 'none';
  if (hasGal) {
    [...galGrid.querySelectorAll('img')].slice(0, 3).forEach((img, index) => {
      if (prop.gallery[index]) { img.src = prop.gallery[index]; if (typeof window.nkApplyListingImagePosition === 'function') window.nkApplyListingImagePosition(img, prop.gallery[index]); }
    });
  }

  state.detailReturn = state.currentView === 'detail' ? state.detailReturn : state.currentView;
  showView('detail');
}

/* ─────────────────────────────────────────
   CATEGORY FILTER
───────────────────────────────────────── */
function filterCategory(category) {
  const requested = String(category);
  const next = String(state._currentCategory || '') === requested ? 'all' : requested;
  document.querySelectorAll('.cat-chip').forEach(chip => chip.classList.toggle('selected', chip.dataset.cat === next));
  state._currentCategory = next;
  renderProperties();
}

function renderProperties() {
  const category = state._currentCategory || 'all';
  let filtered = PROPERTIES.filter(p => p.category === 'houseboat');
  const homeFilter=window.nkHomeFilter;
  if(homeFilter){const ids=new Set((homeFilter.resultIds||[]).map(String));filtered=filtered.filter(p=>!p.roomListing&&(homeFilter.boatType==='all'||(homeFilter.boatType==='5plus'?(Number(p.bedrooms)||0)>5:Number(p.bedrooms)===Number(homeFilter.boatType)))&&Math.max(2,Number(p.includedGuests)||(Number(p.bedrooms)||1)*2)>=Number(homeFilter.guests||1)&&ids.has(String(p.id)))}
  if (category === 'per-room') filtered = filtered.filter(p => p.roomListing);
  else if (category === '5plus') filtered = filtered.filter(p => (p.bedrooms || 0) > 5);
  else if (category !== 'all') filtered = filtered.filter(p => p.bedrooms === parseInt(category, 10));
  // Apply sort
  const sort = typeof _currentSort !== 'undefined' ? _currentSort : 'recommended';
  const sortPrice = p => typeof window.nkPriceFor === 'function' ? window.nkPriceFor(p, window.nkCruiseMode || 'overnight') : p.price;
  if (sort === 'price-low') filtered.sort((a,b) => sortPrice(a) - sortPrice(b));
  else if (sort === 'price-high') filtered.sort((a,b) => sortPrice(b) - sortPrice(a));
  else if (sort === 'rating') filtered.sort((a,b) => b.rating - a.rating);
  else if (sort === 'reviews') filtered.sort((a,b) => b.reviews - a.reviews);
  if(homeFilter&&filtered.length===0){const list=document.getElementById('property-list');if(list){const copy=homeFilter.availabilityErrors?'We could not verify live availability. Please contact Nauka on WhatsApp and we’ll check these dates for you.':'Try another date, guest count or boat type and we’ll find the best fit.';list.innerHTML=`<div class="nk-filter-empty"><i class="fa-regular fa-calendar-xmark"></i><p class="nk-empty-kicker">Filter result</p><h3>No Boats <em>available</em></h3><p>No Boats available based on your filter. ${copy}</p><a href="https://wa.me/919447724293" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Check with Nauka</a></div>`;return}}
  renderPropertyCards(filtered);
}

/* ─────────────────────────────────────────
   BOOKING MODAL
───────────────────────────────────────── */
function openBookingModal() {
  if (!state.selectedProperty) return;

  // ── Auth gate: require login to book ──
  if (!state.loggedInUser) {
    // Show the auth gate sheet with property name as context
    const label = document.getElementById('auth-gate-property-label');
    if (label) label.textContent = `Sign in to book "${state.selectedProperty.title}" and manage your trip.`;
    document.getElementById('auth-gate-backdrop').classList.add('open');
    document.getElementById('auth-gate-sheet').classList.add('open');
    document.body.style.overflow = 'hidden';
    return;
  }

  document.getElementById('modal-property-name').textContent = state.selectedProperty.title;
  document.getElementById('booking-date').value = '';
  if (document.getElementById('booking-checkout')) document.getElementById('booking-checkout').value = '';
  document.getElementById('nk-booking-terms')?.removeAttribute('checked');
  if (document.getElementById('nk-booking-terms')) document.getElementById('nk-booking-terms').checked = false;
  window.nkResetBookingDateRange?.();
  // Reset adults to 1
  document.getElementById('booking-adults').value = 1;
  const adDisp = document.getElementById('booking-adults-display');
  if (adDisp) adDisp.textContent = '1';
  const adMinus = document.getElementById('btn-adults-minus');
  if (adMinus) adMinus.style.opacity = '0.35';
  // Reset children to 0
  document.getElementById('booking-children').value = 0;
  const chDisp = document.getElementById('booking-children-display');
  if (chDisp) chDisp.textContent = '0';
  const chMinus = document.getElementById('btn-children-minus');
  if (chMinus) chMinus.style.opacity = '0.35';
  _setupRouteField(false);
  // Reset nights to 1
  document.getElementById('booking-nights').value = 1;
  hideBookingError();
  updatePriceSummary();
  document.getElementById('bookingModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeBookingModal() {
  document.getElementById('bookingModal').classList.remove('open');
  document.body.style.overflow = '';
}

function updatePriceSummary() {
  if (!state.selectedProperty) return;
  const price = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(state.selectedProperty, window.nkBookingMode || window.nkCruiseMode || 'overnight') : state.selectedProperty.price;
  const mode = window.nkBookingMode || window.nkCruiseMode || 'overnight';
  const dayCruise = mode === 'day';
  const checkIn = document.getElementById('booking-date')?.value || '';
  const checkOut = document.getElementById('booking-checkout')?.value || '';
  const nights = dayCruise ? 1 : Math.max(1, Math.round((new Date(checkOut + 'T00:00:00') - new Date(checkIn + 'T00:00:00')) / 86400000) || 1);
  const datesReady = !!checkIn && (dayCruise || !!checkOut);
  const subtotal = datesReady ? price * nights : 0;
  const total = subtotal;
  const formatPrice=typeof window.nkFormatPrice==='function'?window.nkFormatPrice:(value=>'₹'+Number(value).toLocaleString('en-IN'));
  document.getElementById('modal-price-breakdown').textContent = !checkIn ? 'Select dates to see the estimate' : dayCruise ? formatPrice(price)+' · Day Cruise' : !checkOut ? 'Choose a check-out date' : formatPrice(price)+' × '+nights+' night'+(nights > 1 ? 's' : '');
  document.getElementById('modal-subtotal').textContent = formatPrice(subtotal);
  document.getElementById('modal-total').textContent = formatPrice(total);
}

function changeAdults(delta) {
  const input = document.getElementById('booking-adults');
  const display = document.getElementById('booking-adults-display');
  const minusBtn = document.getElementById('btn-adults-minus');
  const newVal = Math.min(12, Math.max(1, (parseInt(input.value) || 1) + delta));
  input.value = newVal;
  display.textContent = newVal;
  minusBtn.style.opacity = newVal <= 1 ? '0.35' : '1';
}

function changeChildren(delta) {
  const input = document.getElementById('booking-children');
  const display = document.getElementById('booking-children-display');
  const minusBtn = document.getElementById('btn-children-minus');
  const newVal = Math.min(10, Math.max(0, (parseInt(input.value) || 0) + delta));
  input.value = newVal;
  display.textContent = newVal;
  minusBtn.style.opacity = newVal <= 0 ? '0.35' : '1';
}

function changeNights(delta) {
  const input = document.getElementById('booking-nights');
  const newVal = Math.min(30, Math.max(1, (parseInt(input.value) || 1) + delta));
  input.value = newVal;
  updatePriceSummary();
}

/* ─────────────────────────────────────────
   CONFIRM BOOKING
───────────────────────────────────────── */
function confirmBooking() {
  const dateInput = document.getElementById('booking-date');
  const adultsInput = document.getElementById('booking-adults');
  const childrenInput = document.getElementById('booking-children');
  const nightsInput = document.getElementById('booking-nights');
  const date = dateInput.value;
  const adults = parseInt(adultsInput.value) || 1;
  const children = parseInt(childrenInput.value) || 0;
  const guests = adults + children;
  const nights = parseInt(nightsInput.value);

  if (!date) {
    showBookingError('Please select a check-in date to continue.');
    dateInput.classList.add('shake');
    setTimeout(() => dateInput.classList.remove('shake'), 500);
    return;
  }

  const selectedDate = new Date(date);
  const today = new Date(); today.setHours(0,0,0,0);
  if (selectedDate < today) {
    showBookingError('Check-in date cannot be in the past.');
    dateInput.classList.add('shake');
    setTimeout(() => dateInput.classList.remove('shake'), 500);
    return;
  }

  if (adults < 1) {
    showBookingError('Please add at least 1 adult guest.');
    return;
  }

  const price = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(state.selectedProperty, window.nkBookingMode || window.nkCruiseMode || 'overnight') : state.selectedProperty.price;
  const subtotal = price * nights;
  const totalAmount = subtotal;
  const bookingId = 'ALP-' + Math.random().toString(36).substring(2, 8).toUpperCase();

  const formattedDate = new Date(date + 'T00:00:00').toLocaleDateString('en-IN', {
    weekday:'short', day:'numeric', month:'long', year:'numeric',
  });

  // Guest summary string e.g. "2 Adults, 1 Child"
  const guestStr = [
    adults + ' Adult' + (adults > 1 ? 's' : ''),
    children > 0 ? children + ' Child' + (children > 1 ? 'ren' : '') : ''
  ].filter(Boolean).join(', ');

  // Store booking data for PDF
  state.bookingData = {
    propertyName: state.selectedProperty.title,
    propertyCategory: state.selectedProperty.category,
    location: state.selectedProperty.location,
    host: state.selectedProperty.host,
    date: formattedDate,
    rawDate: date,
    guests, adults, children, guestStr, nights, subtotal, totalAmount, bookingId,
    cruiseType: window.nkBookingMode || window.nkCruiseMode || 'overnight',
    price,
  };

  // Push into user bookings list so My Bookings tab reflects it
  state.userBookings.unshift({ ...state.bookingData });
  persistState();
  renderMyBookings();

  document.getElementById('success-property-name').textContent = state.selectedProperty.title;
  document.getElementById('success-date').textContent = formattedDate;
  document.getElementById('success-guests').textContent = `${guestStr} · ${nights} Night${nights > 1 ? 's' : ''}`;
  document.getElementById('success-price').textContent = typeof window.nkFormatPrice==='function' ? window.nkFormatPrice(totalAmount) : `₹${totalAmount.toLocaleString('en-IN')}`;
  document.getElementById('success-booking-id').textContent = bookingId;

  // Generate real QR code
  const qrContainer = document.getElementById('ticket-qr-container');
  qrContainer.innerHTML = '';
  new QRCode(qrContainer, {
    text: `BOOKING:${bookingId}|PROPERTY:${state.selectedProperty.title}|DATE:${date}|GUESTS:${guests}`,
    width: 56,
    height: 56,
    colorDark: '#0d4f3c',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.M,
  });

  closeBookingModal();
  showView('success');
}

/* ─────────────────────────────────────────
   PDF TICKET DOWNLOAD — Feature 3 (Fixed)
   Uses jsPDF to build a proper layout server-side
───────────────────────────────────────── */
async function downloadTicketPDF() {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a5' });

  const bd = state.bookingData;
  if (!bd || !bd.bookingId) {
    alert('No booking data available.');
    return;
  }

  const W = doc.internal.pageSize.getWidth();
  const H = doc.internal.pageSize.getHeight();

  /* ── Colors ── */
  const EMERALD = [13, 79, 60];
  const GOLD    = [201, 168, 76];
  const PEARL   = [250, 249, 247];
  const LIGHT   = [232, 242, 238];
  const GRAY    = [107, 114, 128];
  const INK     = [26, 26, 24];

  /* ── Hero Header ── */
  doc.setFillColor(...EMERALD);
  doc.roundedRect(0, 0, W, 58, 0, 0, 'F');

  // Decorative circles
  doc.setFillColor(255, 255, 255);
  doc.setGState(new doc.GState({ opacity: 0.05 }));
  doc.circle(W - 20, 10, 30, 'F');
  doc.circle(W - 35, 50, 20, 'F');
  doc.setGState(new doc.GState({ opacity: 1 }));

  // Try to embed logo image
  try {
    if (!_nkLogo) await nkLogoLoad();
    if (!nkLogoPdf(doc, 8, 8, 14)) throw new Error('logo unavailable');
  } catch(e) {
    // Fallback text logo
    doc.setTextColor(255, 255, 255);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('NAUKA', 8, 18);
  }

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(6);
  doc.setTextColor(255, 255, 255);
  doc.setGState(new doc.GState({ opacity: 0.6 }));
  doc.text('OFFICIAL BOOKING CONFIRMATION', 8, 30);
  doc.setGState(new doc.GState({ opacity: 1 }));

  // Property name
  doc.setFont('times', 'italic');
  doc.setFontSize(17);
  doc.setTextColor(255, 255, 255);
  doc.text(bd.propertyName || 'Property', 8, 50, { maxWidth: W - 16 });

  /* ── Ticket Tear effect ── */
  doc.setFillColor(...PEARL);
  doc.circle(-4, 61, 5, 'F');
  doc.circle(W + 4, 61, 5, 'F');
  doc.setDrawColor(...LIGHT);
  doc.setLineWidth(0.3);
  doc.setLineDashPattern([2, 2], 0);
  doc.line(0, 61, W, 61);
  doc.setLineDashPattern([], 0);

  /* ── Body ── */
  let y = 70;

  // Status badge
  doc.setFillColor(...LIGHT);
  doc.roundedRect(8, y - 4, 32, 7, 2, 2, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(6);
  doc.setTextColor(...EMERALD);
  doc.text('✓  BOOKING CONFIRMED', 10, y + 1);

  y += 12;

  /* Grid of booking details */
  const col1x = 8, col2x = W / 2 + 2;
  const lineH = 12;

  function drawField(label, value, x, curY) {
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(5);
    doc.setTextColor(...GRAY);
    doc.text(label.toUpperCase(), x, curY);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8.5);
    doc.setTextColor(...INK);
    doc.text(String(value), x, curY + 5.5, { maxWidth: W / 2 - 12 });
  }

  drawField('Check-in Date', bd.date || '—', col1x, y);
  drawField('Location', bd.location || '—', col2x, y);
  y += lineH;

  drawField('Guests', `${bd.guests} Guest${bd.guests > 1 ? 's' : ''}`, col1x, y);
  drawField('Duration', `${bd.nights} Night${bd.nights > 1 ? 's' : ''}`, col2x, y);
  y += lineH;

  const catLabel = {houseboat:'Luxury Houseboat',shikara:'Shikara Cruise',homestay:'Heritage Homestay'}[bd.propertyCategory] || 'Experience';
  drawField('Category', catLabel, col1x, y);
  y += lineH + 3;

  /* ── Price breakdown box ── */
  doc.setFillColor(...LIGHT);
  doc.roundedRect(8, y, W - 16, 34, 3, 3, 'F');
  y += 8;

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(7.5);
  doc.setTextColor(...GRAY);
  const priceLabel = `₹${bd.price ? bd.price.toLocaleString('en-IN') : '0'} × ${bd.nights} night${bd.nights > 1 ? 's' : ''}`;
  doc.text(priceLabel, 14, y);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(...INK);
  doc.text(`₹${bd.subtotal ? bd.subtotal.toLocaleString('en-IN') : '0'}`, W - 14, y, { align: 'right' });
  y += 7;

  y += 6;

  doc.setDrawColor(...EMERALD);
  doc.setGState(new doc.GState({ opacity: 0.2 }));
  doc.line(14, y, W - 14, y);
  doc.setGState(new doc.GState({ opacity: 1 }));
  y += 6;

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(8.5);
  doc.setTextColor(...INK);
  doc.text('Total Amount', 14, y);
  doc.setTextColor(...EMERALD);
  doc.setFontSize(13);
  doc.text(`₹${bd.totalAmount ? bd.totalAmount.toLocaleString('en-IN') : '0'}`, W - 14, y, { align: 'right' });

  y += 16;

  /* ── Second tear ── */
  doc.setFillColor(...PEARL);
  doc.circle(-4, y, 5, 'F');
  doc.circle(W + 4, y, 5, 'F');
  doc.setDrawColor(...LIGHT);
  doc.setLineWidth(0.3);
  doc.setLineDashPattern([2, 2], 0);
  doc.line(0, y, W, y);
  doc.setLineDashPattern([], 0);

  y += 8;

  /* ── Booking ID section ── */
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(5.5);
  doc.setTextColor(...GRAY);
  doc.text('BOOKING ID', 8, y);
  y += 5.5;
  doc.setFont('courier', 'bold');
  doc.setFontSize(14);
  doc.setTextColor(...INK);
  doc.text(bd.bookingId || 'ALP-XXXXXX', 8, y);
  y += 3;

  // QR area: branded box with scannable-looking grid
  const qrX = W - 42, qrY = y - 16;
  doc.setFillColor(255, 255, 255);
  doc.roundedRect(qrX, qrY, 30, 30, 2, 2, 'FD');
  doc.setDrawColor(...EMERALD);
  doc.setLineWidth(0.4);
  doc.roundedRect(qrX, qrY, 30, 30, 2, 2, 'D');

  // Draw QR-like finder patterns
  function qrFinder(fx, fy, s) {
    doc.setFillColor(...EMERALD);
    doc.rect(fx, fy, s, s, 'F');
    doc.setFillColor(255, 255, 255);
    doc.rect(fx + s*0.15, fy + s*0.15, s*0.7, s*0.7, 'F');
    doc.setFillColor(...EMERALD);
    doc.rect(fx + s*0.3, fy + s*0.3, s*0.4, s*0.4, 'F');
  }
  const qs = 8;
  qrFinder(qrX + 2, qrY + 2, qs);
  qrFinder(qrX + 30 - qs - 2, qrY + 2, qs);
  qrFinder(qrX + 2, qrY + 30 - qs - 2, qs);

  // Data modules (deterministic grid from booking ID)
  doc.setFillColor(...EMERALD);
  const idBytes = (bd.bookingId || 'ALP').split('').map(c => c.charCodeAt(0));
  const cellSize = 1.5;
  const gridStart = { x: qrX + 12, y: qrY + 2 };
  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      const bit = (idBytes[(r * 8 + c) % idBytes.length] >> (c % 8)) & 1;
      if (bit) doc.rect(gridStart.x + c * cellSize, gridStart.y + r * cellSize, cellSize - 0.2, cellSize - 0.2, 'F');
    }
  }

  // "Scan to verify" label
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(4.5);
  doc.setTextColor(...GRAY);
  doc.text('SCAN TO VERIFY', qrX + 15, qrY + 32, { align: 'center' });

  y += 16;

  /* ── Footer ── */
  doc.setFillColor(...EMERALD);
  doc.rect(0, H - 20, W, 20, 'F');
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(6);
  doc.setTextColor(255, 255, 255);
  doc.setGState(new doc.GState({ opacity: 0.7 }));
  doc.text("Nauka  ·  God's Own Country, Kerala, India", W / 2, H - 12, { align: 'center' });
  doc.text('support@explorealleppey.in  ·  +91 477 222 1234', W / 2, H - 6, { align: 'center' });
  doc.setGState(new doc.GState({ opacity: 1 }));

  doc.save(`Nauka_Booking_${bd.bookingId || 'ticket'}.pdf`);
}

/* ─────────────────────────────────────────
   PRINT BOOKING PDF — 2-Page Premium Design
   Serif + Classic Numerical Font (Didot/Times style)
───────────────────────────────────────── */
async function printBookingPDF() {
  const { jsPDF } = window.jspdf;
  const bd = state.bookingData;
  if (!bd || !bd.bookingId) { alert('No booking data available.'); return; }

  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const W = doc.internal.pageSize.getWidth();
  const H = doc.internal.pageSize.getHeight();

  const EMERALD = [13, 79, 60];
  const GOLD    = [201, 168, 76];
  const PEARL   = [250, 249, 247];
  const LIGHT   = [232, 242, 238];
  const GRAY    = [130, 130, 130];
  const INK     = [26, 26, 24];
  const GOLD_LIGHT = [245, 235, 200];

  /* ════════ PAGE 1: CONFIRMATION ════════ */

  // Full-page cream background
  doc.setFillColor(...PEARL);
  doc.rect(0, 0, W, H, 'F');

  // Deep emerald header block
  doc.setFillColor(...EMERALD);
  doc.rect(0, 0, W, 72, 'F');

  // Gold top rule
  doc.setFillColor(...GOLD);
  doc.rect(0, 0, W, 2, 'F');

  // Decorative watermark circles in header
  doc.setFillColor(255, 255, 255);
  doc.setGState(new doc.GState({ opacity: 0.04 }));
  doc.circle(W - 18, -12, 55, 'F');
  doc.circle(W + 5, 65, 40, 'F');
  doc.circle(10, 80, 30, 'F');
  doc.setGState(new doc.GState({ opacity: 1 }));

  // Logo
  try {
    if (!_nkLogo) await nkLogoLoad();
    if (!nkLogoPdf(doc, 14, 12, 16)) throw new Error('logo unavailable');
  } catch(e) {
    doc.setFont('times', 'bolditalic'); doc.setFontSize(13); doc.setTextColor(255,255,255);
    doc.text('Nauka', 14, 22);
  }

  // "Official Booking Confirmation" label
  doc.setFont('times', 'italic'); doc.setFontSize(8); doc.setTextColor(255,255,255);
  doc.setGState(new doc.GState({ opacity: 0.65 }));
  doc.text('OFFICIAL BOOKING CONFIRMATION', 14, 35);
  doc.setGState(new doc.GState({ opacity: 1 }));

  // Property name in large serif italic
  doc.setFont('times', 'bolditalic'); doc.setFontSize(22); doc.setTextColor(255,255,255);
  doc.text(bd.propertyName || 'Property', 14, 52, { maxWidth: W - 30 });

  // Category sub-label
  const catLabel = {houseboat:'Luxury Houseboat • Alappuzha Backwaters',shikara:'Shikara Cruise • Vembanad Lake',homestay:'Heritage Homestay • Kerala',tour:'Exclusive Tour Package • Kerala'}[bd.propertyCategory] || 'Premium Experience';
  doc.setFont('times', 'italic'); doc.setFontSize(9); doc.setTextColor(...GOLD_LIGHT);
  doc.text(catLabel, 14, 63);

  // Gold divider with circles (ticket tear effect)
  doc.setFillColor(...PEARL);
  doc.circle(-5, 74, 6, 'F');
  doc.circle(W + 5, 74, 6, 'F');
  doc.setDrawColor(...GOLD);
  doc.setLineWidth(0.4);
  doc.setLineDashPattern([3, 3], 0);
  doc.line(0, 74, W, 74);
  doc.setLineDashPattern([], 0);

  // ── Status Confirmed badge ──
  doc.setFillColor(...LIGHT);
  doc.roundedRect(14, 80, 44, 9, 2, 2, 'F');
  doc.setFillColor(...EMERALD);
  doc.roundedRect(14, 80, 44, 9, 2, 2, 'D');
  doc.setFont('times', 'bold'); doc.setFontSize(7.5); doc.setTextColor(...EMERALD);
  doc.text('✓  CONFIRMED', 36, 85.5, { align: 'center' });

  // ── Booking details grid — 2 columns ──
  let y = 98;
  const c1 = 14, c2 = W / 2 + 4;

  function pField(label, value, x, curY, highlight = false) {
    doc.setFont('times', 'italic'); doc.setFontSize(6.5); doc.setTextColor(...GRAY);
    doc.text(label.toUpperCase(), x, curY);
    if (highlight) { doc.setTextColor(...EMERALD); doc.setFont('times', 'bold'); doc.setFontSize(11); }
    else { doc.setFont('times', 'bold'); doc.setFontSize(10); doc.setTextColor(...INK); }
    doc.text(String(value), x, curY + 6, { maxWidth: W/2 - 18 });
  }

  pField('Check-in Date', bd.date || '—', c1, y);
  pField('Location', bd.location || 'Alappuzha, Kerala', c2, y);
  y += 16;
  pField('Guests', `${bd.guests} Guest${bd.guests > 1 ? 's' : ''}`, c1, y);
  pField('Duration', `${bd.nights} Night${bd.nights > 1 ? 's' : ''}`, c2, y);
  y += 16;
  pField('Category', catLabel.split('•')[0].trim(), c1, y);
  y += 22;

  // ── Price breakdown box (serif numbers) ──
  doc.setFillColor(245, 250, 247);
  doc.roundedRect(14, y, W - 28, 34, 4, 4, 'F');
  doc.setDrawColor(...EMERALD); doc.setLineWidth(0.3);
  doc.roundedRect(14, y, W - 28, 34, 4, 4, 'D');
  y += 10;

  doc.setFont('times', 'italic'); doc.setFontSize(8.5); doc.setTextColor(...GRAY);
  doc.text(`₹${bd.price ? bd.price.toLocaleString('en-IN') : '0'}  ×  ${bd.nights} Night${bd.nights > 1 ? 's' : ''}`, 22, y);
  doc.setFont('times', 'bold'); doc.setFontSize(10); doc.setTextColor(...INK);
  doc.text(`₹${bd.subtotal ? bd.subtotal.toLocaleString('en-IN') : '0'}`, W - 16, y, { align: 'right' });
  y += 9;

  doc.setDrawColor(...GOLD); doc.setLineWidth(0.5); doc.setGState(new doc.GState({ opacity: 0.4 }));
  doc.line(22, y, W - 16, y);
  doc.setGState(new doc.GState({ opacity: 1 })); y += 8;

  doc.setFont('times', 'bold'); doc.setFontSize(9); doc.setTextColor(...GRAY);
  doc.text('Total Amount', 22, y);
  doc.setFont('times', 'bold'); doc.setFontSize(16); doc.setTextColor(...EMERALD);
  doc.text(`₹${bd.totalAmount ? bd.totalAmount.toLocaleString('en-IN') : '0'}`, W - 16, y, { align: 'right' });
  y += 22;

  // ── Second tear ──
  doc.setFillColor(...PEARL);
  doc.circle(-5, y, 6, 'F'); doc.circle(W + 5, y, 6, 'F');
  doc.setDrawColor(...GOLD); doc.setLineWidth(0.4); doc.setLineDashPattern([3,3],0);
  doc.line(0, y, W, y); doc.setLineDashPattern([],0);
  y += 10;

  // ── Booking ID ──
  doc.setFont('times', 'bold'); doc.setFontSize(7); doc.setTextColor(...GRAY);
  doc.text('BOOKING REFERENCE', 14, y); y += 6;
  doc.setFont('courier', 'bold'); doc.setFontSize(18); doc.setTextColor(...INK);
  doc.text(bd.bookingId || 'ALP-XXXXXX', 14, y);

  // QR box
  const qrX = W - 46, qrY = y - 16;
  doc.setFillColor(255,255,255);
  doc.roundedRect(qrX, qrY, 32, 32, 3, 3, 'FD');
  doc.setDrawColor(...EMERALD); doc.setLineWidth(0.5);
  doc.roundedRect(qrX, qrY, 32, 32, 3, 3, 'D');
  function qrF(fx, fy, s) {
    doc.setFillColor(...EMERALD); doc.rect(fx,fy,s,s,'F');
    doc.setFillColor(255,255,255); doc.rect(fx+s*.15,fy+s*.15,s*.7,s*.7,'F');
    doc.setFillColor(...EMERALD); doc.rect(fx+s*.3,fy+s*.3,s*.4,s*.4,'F');
  }
  const qs2 = 9;
  qrF(qrX+2, qrY+2, qs2); qrF(qrX+32-qs2-2, qrY+2, qs2); qrF(qrX+2, qrY+32-qs2-2, qs2);
  const idB = (bd.bookingId||'ALP').split('').map(c=>c.charCodeAt(0));
  doc.setFillColor(...EMERALD);
  const cs2 = 1.6, gs2 = {x:qrX+13, y:qrY+2};
  for(let r=0;r<8;r++) for(let c=0;c<8;c++) { const b=(idB[(r*8+c)%idB.length]>>(c%8))&1; if(b) doc.rect(gs2.x+c*cs2, gs2.y+r*cs2, cs2-.2, cs2-.2,'F'); }
  doc.setFont('times','italic'); doc.setFontSize(5); doc.setTextColor(...GRAY);
  doc.text('Scan to verify', qrX+16, qrY+34, { align:'center' });

  y += 20;

  // ── Footer P1 ──
  doc.setFillColor(...EMERALD);
  doc.rect(0, H - 22, W, 22, 'F');
  doc.setFillColor(...GOLD); doc.rect(0, H - 22, W, 1.5, 'F');
  doc.setFont('times','italic'); doc.setFontSize(7.5); doc.setTextColor(255,255,255);
  doc.setGState(new doc.GState({ opacity: 0.8 }));
  doc.text("Nauka  ·  God's Own Country, Kerala, India", W/2, H - 13, {align:'center'});
  doc.setFontSize(6.5);
  doc.text('support@explorealleppey.in  ·  +91 477 222 1234  ·  www.explorealleppey.in', W/2, H - 7, {align:'center'});
  doc.setGState(new doc.GState({ opacity: 1 }));
  // Page number
  doc.setFont('times','italic'); doc.setFontSize(6); doc.setTextColor(255,255,255);
  doc.setGState(new doc.GState({ opacity: 0.5 }));
  doc.text('1 / 2', W - 12, H - 9);
  doc.setGState(new doc.GState({ opacity: 1 }));

  /* ════════ PAGE 2: GUEST INFO & POLICIES ════════ */
  doc.addPage();

  doc.setFillColor(...PEARL); doc.rect(0,0,W,H,'F');
  doc.setFillColor(...EMERALD); doc.rect(0,0,W,38,'F');
  doc.setFillColor(...GOLD); doc.rect(0,0,W,2,'F');

  // P2 Header
  doc.setFont('times','bolditalic'); doc.setFontSize(16); doc.setTextColor(255,255,255);
  doc.text('Guest Information & Policies', 14, 20);
  doc.setFont('times','italic'); doc.setFontSize(8); doc.setTextColor(...GOLD_LIGHT);
  doc.setGState(new doc.GState({ opacity: 0.75 }));
  doc.text(`Booking Ref: ${bd.bookingId}`, 14, 30);
  doc.setGState(new doc.GState({ opacity: 1 }));

  let y2 = 52;

  function section(title, items) {
    doc.setFont('times','bold'); doc.setFontSize(11); doc.setTextColor(...EMERALD);
    doc.text(title, 14, y2);
    doc.setFillColor(...GOLD); doc.rect(14, y2+2, 28, 0.8, 'F');
    y2 += 12;
    items.forEach(item => {
      doc.setFont('times','italic'); doc.setFontSize(7.5); doc.setTextColor(...GRAY);
      doc.text('•  ' + item, 18, y2);
      y2 += 7;
    });
    y2 += 4;
  }

  section('Check-In Details', [
    `Check-in Date: ${bd.date || '—'}`,
    'Check-in Time: 2:00 PM  |  Check-out: 11:00 AM',
    `Number of Guests: ${bd.guests} Guest${bd.guests > 1 ? 's' : ''} for ${bd.nights} Night${bd.nights > 1 ? 's' : ''}`,
    `Location: ${bd.location || 'Alappuzha, Kerala'}`,
  ]);

  section('What\'s Included', [
    'All meals prepared by your personal cook (unless otherwise specified)',
    'Complimentary welcome drink and fresh coconut water on arrival',
    'Guided backwater cruise through narrow canals and open lakes',
    'Life jackets and safety equipment provided on board',
    ' 24/7 guest support via the Nauka platform',
  ]);

  section('Cancellation Policy', [
    'Free cancellation up to 7 days before check-in date',
    '50% refund for cancellations 3–7 days before check-in',
    'No refund for cancellations within 48 hours of check-in',
    'All refunds processed within 5–7 business days to original payment method',
    'Bookings may be rescheduled (subject to availability) at no extra charge',
  ]);

  section('Important Notes', [
    'Please carry a valid government-issued photo ID for verification at check-in',
    'Smoking and alcohol are not permitted on houseboats and shikaras',
    'Swimming in backwaters is not permitted for safety reasons',
    'Pets and outside food/beverages are not allowed without prior approval',
    'Noise restrictions apply after 10:00 PM in all property categories',
  ]);

  // Decorative separator
  doc.setDrawColor(...GOLD); doc.setLineWidth(0.4); doc.setGState(new doc.GState({ opacity: 0.35 }));
  doc.line(14, y2, W - 14, y2); doc.setGState(new doc.GState({ opacity: 1 }));
  y2 += 10;

  // Thank you message
  doc.setFont('times','bolditalic'); doc.setFontSize(13); doc.setTextColor(...EMERALD);
  doc.text('Thank you for choosing Nauka', W/2, y2, { align: 'center' }); y2 += 8;
  doc.setFont('times','italic'); doc.setFontSize(8.5); doc.setTextColor(...GRAY);
  doc.text('We wish you a magical journey through God\'s Own Country.', W/2, y2, { align: 'center' });

  // Footer P2
  doc.setFillColor(...EMERALD); doc.rect(0, H-22, W, 22, 'F');
  doc.setFillColor(...GOLD); doc.rect(0, H-22, W, 1.5, 'F');
  doc.setFont('times','italic'); doc.setFontSize(7.5); doc.setTextColor(255,255,255);
  doc.setGState(new doc.GState({ opacity: 0.8 }));
  doc.text("Nauka  ·  God's Own Country, Kerala, India", W/2, H-13, {align:'center'});
  doc.setFontSize(6.5);
  doc.text('support@explorealleppey.in  ·  +91 477 222 1234  ·  www.explorealleppey.in', W/2, H-7, {align:'center'});
  doc.setGState(new doc.GState({ opacity: 1 }));
  doc.setFont('times','italic'); doc.setFontSize(6); doc.setTextColor(255,255,255);
  doc.setGState(new doc.GState({ opacity: 0.5 }));
  doc.text('2 / 2', W-12, H-9);
  doc.setGState(new doc.GState({ opacity: 1 }));

  // Open print dialog
  const pdfBlob = doc.output('blob');
  const pdfUrl = URL.createObjectURL(pdfBlob);
  const printWin = window.open(pdfUrl, '_blank');
  if (printWin) {
    printWin.addEventListener('load', () => { printWin.focus(); printWin.print(); });
  } else {
    doc.save(`Nauka_Print_${bd.bookingId || 'ticket'}.pdf`);
  }
}

/* ─────────────────────────────────────────
   SORT FUNCTIONALITY
───────────────────────────────────────── */
let _currentSort = 'recommended';

function toggleSortMenu() {
  const menu = document.getElementById('sort-menu');
  const chevron = document.getElementById('sort-chevron');
  const isOpen = menu.style.display !== 'none';
  menu.style.display = isOpen ? 'none' : 'block';
  chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
}

// Close sort menu when clicking outside
document.addEventListener('click', function(e) {
  const wrap = document.getElementById('sort-dropdown-wrap');
  if (wrap && !wrap.contains(e.target)) {
    const menu = document.getElementById('sort-menu');
    const chevron = document.getElementById('sort-chevron');
    if (menu) menu.style.display = 'none';
    if (chevron) chevron.style.transform = '';
  }
});

function applySortOption(val, label) {
  _currentSort = val;
  document.getElementById('sort-label').textContent = label;
  document.getElementById('sort-menu').style.display = 'none';
  document.getElementById('sort-chevron').style.transform = '';
  // Highlight active option
  document.querySelectorAll('.sort-opt').forEach(btn => {
    btn.style.background = btn.dataset.val === val ? 'var(--emerald-mist)' : '';
    btn.style.color = btn.dataset.val === val ? 'var(--emerald)' : '';
  });
  renderProperties();
}


function showBookingError(message) {
  const errorEl = document.getElementById('booking-error');
  const errorText = document.getElementById('booking-error-text');
  errorText.textContent = message;
  errorEl.classList.remove('hidden');
  errorEl.classList.add('flex');
  setTimeout(hideBookingError, 5000);
}

function hideBookingError() {
  const errorEl = document.getElementById('booking-error');
  errorEl.classList.add('hidden');
  errorEl.classList.remove('flex');
}

/* ─────────────────────────────────────────
   BACK TO HOME
───────────────────────────────────────── */
function backToHome() {
  state.selectedProperty = null;
  state.bookingDate = '';
  state.bookingGuests = 2;
  state.bookingNights = 2;
  showView('home');
}

/* ─────────────────────────────────────────
   TOGGLE HEART
───────────────────────────────────────── */
function toggleHeart(btn) {
  /* The live Supabase handler is installed after the base UI script. Inline
     onclick handlers resolve this function, so delegate once the backend is
     ready instead of silently saving only to local state. */
  if (typeof window.toggleHeart === 'function' && window.toggleHeart !== toggleHeart) {
    return window.toggleHeart(btn);
  }
  const icon = btn.querySelector('i');
  if (!icon) return;

  // Find the property id from the card
  const card = btn.closest('[data-id]');
  const propId = card ? parseInt(card.getAttribute('data-id')) : Number(state.selectedProperty?.id || 0) || null;

  if (icon.classList.contains('fa-regular')) {
    // Add to saved
    icon.classList.replace('fa-regular', 'fa-solid');
    icon.style.color = '#e53e3e';
    if (propId && !state.savedProperties.includes(propId)) {
      state.savedProperties.push(propId);
    }
  } else {
    // Remove from saved
    icon.classList.replace('fa-solid', 'fa-regular');
    icon.style.color = '';
    if (propId) {
      state.savedProperties = state.savedProperties.filter(id => id !== propId);
    }
  }
  persistState();
  renderSavedView();
}

/* ─────────────────────────────────────────
   RENDER SAVED VIEW
───────────────────────────────────────── */
function renderSavedView() {
  const container = document.getElementById('saved-list');
  if (!container) return;

  if (state.savedProperties.length === 0) {
    container.innerHTML = `
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-20 h-20 rounded-3xl bg-emerald-mist flex items-center justify-center mb-5">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0d4f3c" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <h3 class="font-display text-2xl font-light text-ink mb-2">No saved escapes yet</h3>
        <p class="text-gray-400 text-sm font-body mb-6 max-w-[260px] leading-relaxed">Tap the heart icon on any property to save it here for later.</p>
        <button onclick="showView('boats')" class="btn-emerald text-white font-semibold text-sm rounded-2xl px-6 py-3 font-body">
          Browse Properties
        </button>
      </div>`;
    return;
  }

  const props = state.savedProperties.map(id => PROPERTIES.find(p => p.id === id)).filter(Boolean);
  container.innerHTML = props.map(prop => {
    const catLabel = {houseboat:'Houseboat',shikara:'Shikara',homestay:'Homestay'}[prop.category] || 'Listing';
    const savedPrice = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(prop, window.nkCruiseMode || 'overnight') : prop.price;
    return `
      <div class="bg-white rounded-3xl overflow-hidden shadow-card cursor-pointer property-card mb-4" data-id="${prop.id}">
        <div class="relative h-44 overflow-hidden">
          <img src="${prop.image}" alt="${prop.title}" style="${typeof window.nkImagePositionStyle==='function'?window.nkImagePositionStyle(prop.image):''}" class="w-full h-full object-cover" loading="lazy"/>
          <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-emerald text-xs font-semibold font-body px-2.5 py-1 rounded-full">${catLabel}</span>
          <button onclick="event.stopPropagation(); removeSaved(${prop.id}, this)" class="absolute top-3 right-3 w-8 h-8 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-sm hover:scale-110 transition-transform">
            <i class="fa-solid fa-heart text-red-500 text-sm"></i>
          </button>
        </div>
        <div class="px-4 pt-3 pb-4">
          <div class="flex items-start justify-between gap-2 mb-1">
            <h3 class="font-body font-bold text-ink text-sm leading-tight flex-1">${prop.title}</h3>
            <div class="flex items-center gap-1 bg-gold-pale rounded-xl px-2 py-0.5 flex-shrink-0">
              <i class="fa-solid fa-star text-gold text-xs"></i>
              <span class="text-ink text-xs font-bold font-body">${prop.rating}</span>
            </div>
          </div>
          <p class="text-gray-500 text-xs font-body mb-3 flex items-center gap-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0d4f3c" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            ${prop.location}
          </p>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-400 text-xs font-body">Per night from</p>
            <p class="font-bold text-ink text-base font-body">${typeof window.nkFormatPrice==='function'?window.nkFormatPrice(savedPrice):'₹'+savedPrice.toLocaleString('en-IN')}</p>
            </div>
            <button data-nk-detail-id="${prop.id}" class="btn-emerald text-white text-xs font-semibold font-body px-4 py-2 rounded-2xl">View Details</button>
          </div>
        </div>
      </div>`;
  }).join('');
}

function removeSaved(propId, btn) {
  if (typeof window.removeSaved === 'function' && window.removeSaved !== removeSaved) {
    return window.removeSaved(propId);
  }
  state.savedProperties = state.savedProperties.filter(id => id !== propId);
  const homeCard = document.querySelector(`#property-list [data-id="${propId}"]`);
  if (homeCard) {
    const heartIcon = homeCard.querySelector('button i.fa-solid.fa-heart');
    if (heartIcon) {
      heartIcon.classList.replace('fa-solid', 'fa-regular');
      heartIcon.style.color = '';
    }
  }
  persistState();
  renderSavedView();
}

/* ─────────────────────────────────────────
   RENDER MY BOOKINGS VIEW
───────────────────────────────────────── */
/* ─────────────────────────────────────────
   BOTTOM NAV: Set active state
───────────────────────────────────────── */
function setActiveNav(clickedBtn) {
  document.querySelectorAll('#customer-bottom-nav .nav-item').forEach(btn => btn.classList.remove('active-nav'));
  clickedBtn.classList.add('active-nav');
}

/* ─────────────────────────────────────────
   PROFILE VIEW RENDERER
───────────────────────────────────────── */
function renderProfileView(username, email) {
  const container = document.getElementById('profile-dynamic-content');
  if (!container) return;

  // Guard: avatarIdx can exceed the legacy PROFILE_AVATARS list (newer picker has 14 avatars).
  // An out-of-range index used to throw here and silently block the Profile tab from opening.
  const avatarCfg   = PROFILE_AVATARS[(Math.abs(parseInt(state.avatarIdx, 10)) || 0) % PROFILE_AVATARS.length] || PROFILE_AVATARS[0];
  const bannerCfg   = PROFILE_BANNERS[(Math.abs(parseInt(state.bannerIdx, 10)) || 0) % PROFILE_BANNERS.length] || PROFILE_BANNERS[0];
  const displayName = (state.profileDisplayName) || (username.charAt(0).toUpperCase() + username.slice(1));
  const displayPhone = state.profilePhone || '';

  container.innerHTML = `
    <!-- Dynamic Banner + Avatar — banner height reduced 40% (176px → ~106px) -->
    <div class="relative mb-14">

      <!-- Pastel CSS banner -->
      <div class="w-full overflow-hidden relative" style="height:106px;background:${bannerCfg.css};">
        <div style="position:absolute;top:-20px;right:-20px;width:90px;height:90px;border-radius:50%;background:${bannerCfg.dot1};opacity:0.55;"></div>
        <div style="position:absolute;bottom:-14px;left:-14px;width:70px;height:70px;border-radius:50%;background:${bannerCfg.dot2};opacity:0.45;"></div>
        <div style="position:absolute;top:18px;left:42%;width:40px;height:40px;border-radius:50%;background:${bannerCfg.dot1};opacity:0.3;"></div>
        <!-- Banner label pill -->
        <div style="position:absolute;top:10px;right:12px;">
          <span class="text-[10px] font-body font-semibold tracking-widest uppercase px-3 py-1 rounded-full" style="background:rgba(255,255,255,0.55);backdrop-filter:blur(8px);color:rgba(26,26,24,0.6);">${bannerCfg.label}</span>
        </div>
      </div>

      <!-- Floating avatar — centred, overlapping banner bottom -->
      <div class="absolute left-1/2 -translate-x-1/2" style="bottom:-40px;">
        <div class="relative">
          <div class="rounded-full border-4 border-white overflow-hidden shadow-card"
               style="width:80px;height:80px;background:${avatarCfg.bg};box-shadow:0 0 0 3px ${avatarCfg.ring}, 0 8px 32px rgba(0,0,0,0.14);">
            ${avatarCfg.svg}
          </div>
          <!-- Pencil edit button -->
          <button onclick="openEditProfileSheet()"
            class="absolute bottom-0 right-0 w-7 h-7 rounded-full flex items-center justify-center border-2 border-white shadow-md transition hover:scale-110 active:scale-95"
            style="background:var(--emerald);"
            title="Edit Profile">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Name + email + badges -->
    <div class="pb-4 px-5 text-center">
      <h2 class="font-display text-2xl font-light text-ink" style="display:inline-flex;align-items:center;justify-content:center;gap:6px;">${displayName}${/^\S+@\S+\.\S+$/.test(email || '') ? '<svg class="nk-verified-tick" width="20" height="20" viewBox="0 0 24 24" aria-label="Verified" role="img" style="flex:none;"><path fill="var(--emerald, #0d4f3c)" d="M12 1.5l2.4 1.7 2.9-.3 1.2 2.7 2.7 1.2-.3 2.9L22.5 12l-1.7 2.4.3 2.9-2.7 1.2-1.2 2.7-2.9-.3L12 22.5l-2.4-1.7-2.9.3-1.2-2.7-2.7-1.2.3-2.9L1.5 12l1.7-2.4-.3-2.9 2.7-1.2 1.2-2.7 2.9.3z"/><path d="M7.8 12.3l3 3 5.4-6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' : ''}</h2>
      ${displayPhone ? `<p class="text-gray-400 text-xs font-body mt-0.5 flex items-center justify-center gap-1"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.38 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.95A16 16 0 0 0 15 16.05l.95-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>${displayPhone}</p>` : ''}
    </div>

    <!-- Account settings list -->
    <div class="mx-5 mb-5">
      <h4 class="font-body font-semibold text-ink text-sm mb-3">Account</h4>
      <div class="bg-white rounded-3xl shadow-soft border border-gray-100 overflow-hidden divide-y divide-gray-50">
        ${[
          ['fa-user','Personal Info','Update your name, phone & address', 'openEditProfileSheet()'],
          ['fa-bell','Notifications','Manage alerts & reminders', ''],
          ['fa-shield-halved','Privacy & Security','Password, 2FA & data settings', ''],
                    ['fa-gift','Loyalty Rewards','Your points & referral benefits', ''],
          ['fa-language','Language & Region','English (IN) • ₹ INR', ''],
        ].map(([icon, label, sub, action]) => `
          <div class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 transition cursor-pointer" ${action ? `onclick="${action}"` : ''}>
            <div class="w-9 h-9 rounded-xl bg-emerald-mist flex items-center justify-center flex-shrink-0">
              <i class="fa-solid ${icon} text-emerald text-sm"></i>
            </div>
            <div class="flex-1">
              <p class="font-body font-semibold text-ink text-sm">${label}</p>
              <p class="text-gray-400 text-xs font-body">${sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        `).join('')}
      </div>
    </div>

    <!-- Support -->
    <div class="mx-5 mb-5">
      <h4 class="font-body font-semibold text-ink text-sm mb-3">Support</h4>
      <div class="bg-white rounded-3xl shadow-soft border border-gray-100 overflow-hidden divide-y divide-gray-50">
        ${[
          ['fa-headset','Help Centre','FAQs, contact & chat support'],
          ['fa-star','Rate the App','Tell us what you think'],
          ['fa-file-contract','Terms & Privacy','Read our policies'],
        ].map(([icon, label, sub]) => `
          <div class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 transition cursor-pointer">
            <div class="w-9 h-9 rounded-xl bg-emerald-mist flex items-center justify-center flex-shrink-0">
              <i class="fa-solid ${icon} text-emerald text-sm"></i>
            </div>
            <div class="flex-1">
              <p class="font-body font-semibold text-ink text-sm">${label}</p>
              <p class="text-gray-400 text-xs font-body">${sub}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        `).join('')}
      </div>
    </div>

    ${state.isAdmin ? `<div class="mx-5 mb-5"><button onclick="openAdminPortal()" class="w-full py-3.5 rounded-2xl bg-emerald text-white font-semibold text-sm font-body flex items-center justify-center gap-2 shadow-sm hover:opacity-90 transition"><i class="fa-solid fa-shield-halved"></i>Open Admin Control Centre</button></div>` : ''}

    <!-- Sign out -->
    <div class="mx-5 mb-8">
      <button onclick="logOut()" class="w-full py-3.5 rounded-2xl border-2 border-red-200 text-red-500 font-semibold text-sm font-body flex items-center justify-center gap-2 hover:bg-red-50 transition">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      </button>
    </div>
  `;
}

/* ─────────────────────────────────────────
   STAR BUILDER
───────────────────────────────────────── */
function buildStars(rating) {
  let html = '';
  for (let i = 1; i <= 5; i++) {
    if (rating >= i) html += `<i class="fa-solid fa-star star-filled text-xs"></i>`;
    else if (rating >= i - 0.5) html += `<i class="fa-solid fa-star-half-stroke star-filled text-xs"></i>`;
    else html += `<i class="fa-regular fa-star star-empty text-xs"></i>`;
  }
  return html;
}

/* ─────────────────────────────────────────
   AUTH GATE (booking while logged out)
───────────────────────────────────────── */
function closeAuthGate() {
  document.getElementById('auth-gate-backdrop').classList.remove('open');
  document.getElementById('auth-gate-sheet').classList.remove('open');
  document.body.style.overflow = '';
}

function authGateGoLogin() {
  closeAuthGate();
  showView('login');
  setTimeout(() => switchLoginTab('customer'), 50);
}

function authGateGoSignup() {
  closeAuthGate();
  showView('login');
  setTimeout(() => {
    switchLoginTab('customer');
    const createLink = document.querySelector('#form-customer p.text-center .text-emerald.font-semibold.cursor-pointer');
    if (createLink) {
      createLink.scrollIntoView({ behavior: 'smooth', block: 'center' });
      createLink.style.transition = 'all 0.3s ease';
      createLink.style.background = 'var(--emerald-mist)';
      createLink.style.borderRadius = '8px';
      createLink.style.padding = '2px 6px';
      setTimeout(() => { createLink.style.background = ''; createLink.style.padding = ''; }, 1800);
    }
  }, 80);
}

/* ─────────────────────────────────────────
   AUTH LAUNCH SHEET
───────────────────────────────────────── */
function showAuthSheet() {
  document.getElementById('auth-sheet-backdrop').classList.add('open');
  document.getElementById('auth-sheet').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeAuthSheet() {
  document.getElementById('auth-sheet-backdrop').classList.remove('open');
  document.getElementById('auth-sheet').classList.remove('open');
  document.body.style.overflow = '';
}

function skipAuth() {
  closeAuthSheet();
  localStorage.setItem('alp_session', JSON.stringify({ type: 'guest', ts: Date.now() }));
}

function authGoLogin() {
  closeAuthSheet();
  // Switch to customer tab on the login view
  showView('login');
  setTimeout(() => switchLoginTab('customer'), 50);
}

function authGoSignup() {
  closeAuthSheet();
  // Navigate to login view and trigger sign-up mode (create account section)
  showView('login');
  setTimeout(() => {
    switchLoginTab('customer');
    // Scroll to "create account" row smoothly
    const createLink = document.querySelector('#form-customer p.text-center .text-emerald.font-semibold.cursor-pointer');
    if (createLink) {
      createLink.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Pulse the element to draw attention
      createLink.style.transition = 'all 0.3s ease';
      createLink.style.background = 'var(--emerald-mist)';
      createLink.style.borderRadius = '8px';
      createLink.style.padding = '2px 6px';
      setTimeout(() => {
        createLink.style.background = '';
        createLink.style.padding = '';
      }, 1800);
    }
  }, 80);
}

/* ─────────────────────────────────────────
   LOCAL STORAGE PERSISTENCE
   Single key: 'alp_user_data' stores
   { username, email, savedProperties, userBookings }
───────────────────────────────────────── */
const ALP_STORAGE_KEY = 'alp_user_data';

function persistState() {
  if (!state.loggedInUser) return;
  const payload = {
    username:            state.loggedInUser.username,
    email:               state.loggedInUser.email,
    savedProperties:     state.savedProperties,
    userBookings:        state.userBookings,
    bookingSeenAt:       state.bookingSeenAt || 0,
    avatarIdx:           state.avatarIdx,
    bannerIdx:           state.bannerIdx,
    profileDisplayName:  state.profileDisplayName || '',
    profilePhone:        state.profilePhone        || '',
    profileLocation:     state.profileLocation     || '',
    profileBio:          state.profileBio          || '',
    profileLanguage:     state.profileLanguage     || 'English',
    profileRegion:       normalizeNaukaRegion(state.profileRegion),
    profileCurrency:     state.profileCurrency     || 'INR',
    currencyRates:       state.currencyRates       || {},
    currencyRateDate:    state.currencyRateDate    || '',
  };
  try {
    localStorage.setItem(ALP_STORAGE_KEY, JSON.stringify(payload));
  } catch(e) {
    console.warn('localStorage write failed', e);
  }
}

function loadPersistedState() {
  try {
    const raw = localStorage.getItem(ALP_STORAGE_KEY);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch(e) {
    console.warn('localStorage read failed', e);
    return null;
  }
}

function clearUserState() {
  // Clear persisted data
  localStorage.removeItem(ALP_STORAGE_KEY);
  localStorage.removeItem('alp_session');
  // Reset in-memory state
  state.loggedInUser   = null;
  state.isAdmin        = false;
  state.savedProperties = [];
  state.userBookings   = [];
  state.bookingSeenAt  = 0;
  state.bookingData    = {};
  state.avatarIdx      = undefined;
  state.bannerIdx      = undefined;
  state.profileDisplayName = '';
  state.profilePhone       = '';
  state.profileLocation    = '';
  state.profileBio         = '';
  state.profileLanguage    = 'English';
  state.profileRegion      = 'INDIA';
  state.profileCurrency    = 'INR';
  state.currencyRates      = {};
  state.currencyRateDate   = '';
  // Reset profile view to logged-out state
  const profileContainer = document.getElementById('profile-dynamic-content');
  if (profileContainer) {
    profileContainer.innerHTML = `
      <div class="flex flex-col items-center justify-center py-24 text-center px-6">
        <div class="w-20 h-20 rounded-3xl bg-emerald-mist flex items-center justify-center mb-5">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0d4f3c" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        </div>
        <h3 class="font-display text-2xl font-light text-ink mb-2">You're not signed in</h3>
        <p class="text-gray-400 text-sm font-body mb-6 max-w-[260px] leading-relaxed">Sign in to view your profile, bookings and saved properties.</p>
        <button onclick="showView('login')" class="btn-emerald text-white font-semibold text-sm rounded-2xl px-6 py-3 font-body">Sign In</button>
      </div>`;
  }
  // Re-render dynamic views to show empty states
  renderSavedView();
  renderMyBookings();
  // Un-heart all property cards on home
  document.querySelectorAll('#property-list [data-id] button i.fa-solid.fa-heart').forEach(icon => {
    icon.classList.replace('fa-solid', 'fa-regular');
    icon.style.color = '';
  });
}

/* ── logOut: called by Sign Out button in profile ── */
function logOut() {
  clearUserState();
  // Stay on login page after logout
  showView('login');
  setTimeout(() => switchLoginTab('customer'), 50);
}

/* Session flag (auth sheet suppression only — not user data) */
function _saveSession(type, data) {
  localStorage.setItem('alp_session', JSON.stringify({ type, data, ts: Date.now() }));
}

/* ─────────────────────────────────────────
   EDIT PROFILE SHEET
───────────────────────────────────────── */

// Temp state for the edit modal (uncommitted until Save)
let _ep = { avatarIdx: 0, bannerIdx: 0 };

function openEditProfileSheet() {
  const modal = document.getElementById('edit-profile-modal');
  if (!modal) return;

  // Clone current state into temp
  _ep.avatarIdx = state.avatarIdx ?? 0;
  _ep.bannerIdx = state.bannerIdx ?? 0;

  // Pre-fill fields
  const displayName = state.profileDisplayName || (state.loggedInUser ? (state.loggedInUser.username.charAt(0).toUpperCase() + state.loggedInUser.username.slice(1)) : '');
  const email = state.loggedInUser ? state.loggedInUser.email : '';
  document.getElementById('ep-name').value     = displayName;
  document.getElementById('ep-email-display').textContent = email || (state.loggedInUser ? state.loggedInUser.username + '@example.com' : '');
  document.getElementById('ep-phone').value    = state.profilePhone    || '';
  document.getElementById('ep-location').value = state.profileLocation || '';
  document.getElementById('ep-bio').value      = state.profileBio      || '';

  // Render avatar swatches
  _renderEpAvatarSwatches();

  // Render banner swatches
  _renderEpBannerSwatches();

  // Update avatar preview
  _updateEpAvatarPreview();
  _updateEpBannerPreview();

  // Show modal with animation
  modal.style.animation = 'fadeSlideUp 0.38s cubic-bezier(0.25,0.46,0.45,0.94) both';
  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';
}

function closeEditProfileSheet() {
  const modal = document.getElementById('edit-profile-modal');
  if (!modal) return;
  modal.style.display = 'none';
  document.body.style.overflow = '';
}

function saveEditProfile() {
  // Commit temp state to real state
  state.avatarIdx = _ep.avatarIdx;
  state.bannerIdx = _ep.bannerIdx;

  const nameVal = (document.getElementById('ep-name').value || '').trim();
  if (nameVal) state.profileDisplayName = nameVal;
  state.profilePhone    = (document.getElementById('ep-phone').value    || '').trim();
  state.profileLocation = (document.getElementById('ep-location').value || '').trim();
  state.profileBio      = (document.getElementById('ep-bio').value      || '').trim();

  persistState();

  // Re-render profile view
  if (state.loggedInUser) {
    renderProfileView(state.loggedInUser.username, state.loggedInUser.email);
  }

  closeEditProfileSheet();

  // Subtle confirmation flash on profile view
  const container = document.getElementById('profile-dynamic-content');
  if (container) {
    container.style.transition = 'opacity 0.2s ease';
    container.style.opacity = '0.6';
    setTimeout(() => { container.style.opacity = '1'; }, 220);
  }
}

function _renderEpAvatarSwatches() {
  const grid = document.getElementById('ep-avatar-swatches');
  if (!grid) return;
  grid.innerHTML = PROFILE_AVATARS.map((av, i) => `
    <button onclick="_epSelectAvatar(${i})" title="${av.label}" id="ep-av-${i}"
      class="rounded-full overflow-hidden transition-all duration-200 flex-shrink-0"
      style="width:100%;aspect-ratio:1;background:${av.bg};${i === _ep.avatarIdx ? 'box-shadow:0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.2);transform:scale(1.12);' : 'opacity:0.55;'}">
      ${av.svg}
    </button>`).join('');
}

function _renderEpBannerSwatches() {
  const grid = document.getElementById('ep-banner-swatches');
  if (!grid) return;
  grid.innerHTML = PROFILE_BANNERS.map((b, i) => `
    <button onclick="_epSelectBanner(${i})" title="${b.label}" id="ep-bn-${i}"
      class="rounded-xl transition-all duration-200"
      style="width:100%;height:32px;background:${b.css};${i === _ep.bannerIdx ? 'box-shadow:0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.18);transform:scale(1.09);' : 'opacity:0.55;'}">
    </button>`).join('');
}

function _updateEpAvatarPreview() {
  const preview = document.getElementById('ep-avatar-preview');
  if (!preview) return;
  const av = PROFILE_AVATARS[_ep.avatarIdx];
  preview.style.background = av.bg;
  preview.style.boxShadow  = `0 0 0 3px ${av.ring}, 0 4px 16px rgba(0,0,0,0.14)`;
  preview.innerHTML = av.svg;
}

function _updateEpBannerPreview() {
  const preview = document.getElementById('ep-banner-preview');
  if (!preview) return;
  const b = PROFILE_BANNERS[_ep.bannerIdx];
  preview.style.background = b.css;
  preview.innerHTML = `
    <div style="position:absolute;top:-10px;right:-10px;width:60px;height:60px;border-radius:50%;background:${b.dot1};opacity:0.5;"></div>
    <div style="position:absolute;bottom:-8px;left:-8px;width:45px;height:45px;border-radius:50%;background:${b.dot2};opacity:0.4;"></div>
    <div class="absolute inset-0 flex items-center justify-end pr-3">
      <span class="text-[9px] font-body font-semibold tracking-widest uppercase px-2 py-1 rounded-full" style="background:rgba(255,255,255,0.55);backdrop-filter:blur(6px);color:rgba(26,26,24,0.6);">${b.label}</span>
    </div>`;
}

function _epSelectAvatar(idx) {
  _ep.avatarIdx = idx;
  _updateEpAvatarPreview();
  // Update swatch highlights
  PROFILE_AVATARS.forEach((_, i) => {
    const btn = document.getElementById(`ep-av-${i}`);
    if (!btn) return;
    if (i === idx) { btn.style.boxShadow = '0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.2)'; btn.style.opacity = '1'; btn.style.transform = 'scale(1.12)'; }
    else           { btn.style.boxShadow = ''; btn.style.opacity = '0.55'; btn.style.transform = ''; }
  });
}

function _epSelectBanner(idx) {
  _ep.bannerIdx = idx;
  _updateEpBannerPreview();
  // Update swatch highlights
  PROFILE_BANNERS.forEach((_, i) => {
    const btn = document.getElementById(`ep-bn-${i}`);
    if (!btn) return;
    if (i === idx) { btn.style.boxShadow = '0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.18)'; btn.style.opacity = '1'; btn.style.transform = 'scale(1.09)'; }
    else           { btn.style.boxShadow = ''; btn.style.opacity = '0.55'; btn.style.transform = ''; }
  });
}

function epShuffleAvatar() {
  let idx = Math.floor(Math.random() * PROFILE_AVATARS.length);
  if (idx === _ep.avatarIdx && PROFILE_AVATARS.length > 1) idx = (idx + 1) % PROFILE_AVATARS.length;
  _epSelectAvatar(idx);
}

/* ─────────────────────────────────────────
   AGENT LISTINGS MANAGEMENT
───────────────────────────────────────── */

// In-memory agent listings store (index 1-3 pre-seeded, additions appended)
const agentListings = {};
let _nextListingId = 4;
let _editingListingId = null;

function openAddListing() {
  _editingListingId = null;
  document.getElementById('listing-modal-title').innerHTML = 'Add <em>New Listing</em>';
  document.getElementById('listing-save-label').textContent = 'Save Listing';
  // Clear form
  document.getElementById('listing-title').value = '';
  const companyInput = document.getElementById('nka-listing-company');
  const bedroomsInput = document.getElementById('nka-listing-bedrooms');
  if (companyInput) companyInput.value = '';
  if (bedroomsInput) bedroomsInput.value = 2;
  document.getElementById('listing-subtitle').value = '';
  document.getElementById('listing-category').value = 'houseboat';
  document.getElementById('listing-location').value = '';
  document.getElementById('listing-price').value = '';
  document.getElementById('listing-description').value = '';
  document.getElementById('listing-amenities').value = '';
  document.getElementById('listing-img-url').value = '';
  const preview = document.getElementById('listing-img-preview');
  if (preview) { if (typeof window.nkSetListingImageSource === 'function') window.nkSetListingImageSource(''); else { preview.src = 'https://images.unsplash.com/photo-1593693411515-c20261bcad6e?w=600&q=80'; preview.dataset.nkImageSource = ''; } }
  const fileInput = document.getElementById('listing-img-input');
  if (fileInput) fileInput.value = '';
  window.nkSetListingMedia?.([]);
  document.getElementById('listing-error').classList.add('hidden');
  document.getElementById('listingModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function openEditListing(id) {
  const listing = agentListings[id];
  if (!listing) return;
  _editingListingId = id;
  document.getElementById('listing-modal-title').innerHTML = 'Edit <em>Listing</em>';
  document.getElementById('listing-save-label').textContent = 'Update Listing';
  document.getElementById('listing-title').value = listing.title;
  const companyInput = document.getElementById('nka-listing-company');
  const bedroomsInput = document.getElementById('nka-listing-bedrooms');
  if (companyInput) companyInput.value = listing.host || '';
  if (bedroomsInput) bedroomsInput.value = listing.bedrooms || 1;
  document.getElementById('listing-subtitle').value = listing.subtitle || '';
  document.getElementById('listing-category').value = listing.category;
  document.getElementById('listing-location').value = listing.location;
  document.getElementById('listing-price').value = listing.price;
  document.getElementById('listing-description').value = listing.description || '';
  document.getElementById('listing-amenities').value = listing.amenities || '';
  document.getElementById('listing-img-url').value = listing.image || '';
  const preview = document.getElementById('listing-img-preview');
  if (preview) { if (typeof window.nkSetListingImageSource === 'function') window.nkSetListingImageSource(listing.image || ''); else { preview.src = listing.image || ''; preview.dataset.nkImageSource = listing.image || ''; } }
  window.nkSetListingMedia?.(listing.gallery || []);
  document.getElementById('listing-error').classList.add('hidden');
  document.getElementById('listingModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeListingModal() {
  document.getElementById('listingModal').classList.remove('open');
  document.body.style.overflow = '';
}

function previewListingImg(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const preview = document.getElementById('listing-img-preview');
    const url = document.getElementById('listing-img-url');
    if (preview) { if (typeof window.nkSetListingImageSource === 'function') window.nkSetListingImageSource(e.target.result); else { preview.src = e.target.result; preview.dataset.nkImageSource = e.target.result; } }
    /* A selected local photo must win over the old URL when the form is saved. */
    if (url) url.value = '';
  };
  reader.readAsDataURL(file);
}

function updateListingImgFromUrl(url) {
  if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
    const preview = document.getElementById('listing-img-preview');
    if (preview) { if (typeof window.nkSetListingImageSource === 'function') window.nkSetListingImageSource(url); else { preview.src = url; preview.dataset.nkImageSource = url; } }
  }
}

function saveListing() {
  const title = document.getElementById('listing-title').value.trim();
  const location = document.getElementById('listing-location').value.trim();
  const price = parseInt(document.getElementById('listing-price').value);
  const description = document.getElementById('listing-description').value.trim();
  const category = document.getElementById('listing-category').value;

  // Validate
  if (!title) { showListingError('Property title is required.'); return; }
  if (!location) { showListingError('Location is required.'); return; }
  if (!price || price < 100) { showListingError('Please enter a valid price (min ₹100).'); return; }
  if (!description) { showListingError('Description is required.'); return; }

  const imgUrl = document.getElementById('listing-img-preview').dataset.nkImageSource
    || document.getElementById('listing-img-url').value.trim()
    || document.getElementById('listing-img-preview').src
    || 'https://images.unsplash.com/photo-1593693411515-c20261bcad6e?w=400&q=80';

  const data = {
    title,
    subtitle: document.getElementById('listing-subtitle').value.trim(),
    category,
    location,
    price,
    description,
    amenities: document.getElementById('listing-amenities').value.trim(),
    image: imgUrl,
  };

  if (_editingListingId !== null) {
    // Update existing
    agentListings[_editingListingId] = { ...agentListings[_editingListingId], ...data };
    updateListingCard(_editingListingId);
    showListingToast('Listing updated successfully!');
  } else {
    // Add new
    const newId = _nextListingId++;
    agentListings[newId] = { id: newId, ...data, available: true };
    appendListingCard(newId);
    showListingToast('New listing added!');
  }

  closeListingModal();
  checkListingsEmpty();
}

function updateListingCard(id) {
  const listing = agentListings[id];
  if (!listing) return;
  const imgEl = document.getElementById(`agent-listing-img-${id}`);
  const titleEl = document.getElementById(`agent-listing-title-${id}`);
  const locEl = document.getElementById(`agent-listing-loc-${id}`);
  const priceEl = document.getElementById(`agent-listing-price-${id}`);
  if (imgEl) imgEl.src = listing.image;
  if (titleEl) titleEl.textContent = listing.title;
  if (locEl) locEl.textContent = listing.location;
  if (priceEl) priceEl.innerHTML = `₹${listing.price.toLocaleString('en-IN')}<span class="text-gray-400 font-normal text-xs">/night</span>`;
}

function appendListingCard(id) {
  const listing = agentListings[id];
  if (!listing) return;
  const container = document.getElementById('agent-listings-container');
  if (!container) return;
  const card = document.createElement('div');
  card.className = 'bg-white rounded-3xl shadow-soft border border-gray-100 overflow-hidden';
  card.id = `agent-listing-${id}`;
  card.innerHTML = `
    <div class="flex">
      <img src="${listing.image}" alt="" class="w-24 h-24 object-cover flex-shrink-0" id="agent-listing-img-${id}"/>
      <div class="flex-1 p-4">
        <div class="flex items-start justify-between">
          <div>
            <p class="font-body font-semibold text-ink text-sm leading-tight" id="agent-listing-title-${id}">${listing.title}</p>
            <p class="text-gray-400 text-xs font-body mt-0.5" id="agent-listing-loc-${id}">${listing.location}</p>
          </div>
          <div class="toggle-switch on ml-2 flex-shrink-0" onclick="toggleListingAvailability(this,${id})" title="Toggle availability" id="agent-toggle-${id}"></div>
        </div>
        <div class="flex items-center justify-between mt-2">
          <span class="text-emerald font-bold text-sm font-body" id="agent-listing-price-${id}">₹${listing.price.toLocaleString('en-IN')}<span class="text-gray-400 font-normal text-xs">/night</span></span>
          <div class="flex gap-1.5">
            <button onclick="openEditListing(${id})" class="text-xs text-emerald font-semibold font-body bg-emerald-mist px-2 py-1 rounded-lg hover:bg-emerald hover:text-white transition">Edit</button>
            <button onclick="openPreviewListing(${id})" class="text-xs text-gray-500 font-body bg-gray-100 px-2 py-1 rounded-lg hover:bg-gray-200 transition">Preview</button>
            <button onclick="deleteListing(${id})" class="text-xs text-red-400 font-body bg-red-50 px-2 py-1 rounded-lg hover:bg-red-500 hover:text-white transition">✕</button>
          </div>
        </div>
      </div>
    </div>`;
  container.appendChild(card);
}

function deleteListing(id) {
  const card = document.getElementById(`agent-listing-${id}`);
  if (!card) return;
  // Confirm before delete
  card.style.transition = 'all 0.3s ease';
  card.style.opacity = '0';
  card.style.transform = 'translateX(20px)';
  setTimeout(() => {
    card.remove();
    delete agentListings[id];
    checkListingsEmpty();
  }, 300);
}

function toggleListingAvailability(toggleEl, id) {
  toggleEl.classList.toggle('on');
  const listing = agentListings[id];
  if (listing) listing.available = toggleEl.classList.contains('on');
  const card = document.getElementById(`agent-listing-${id}`);
  if (card) card.style.opacity = listing && listing.available ? '1' : '0.75';
}

function checkListingsEmpty() {
  const container = document.getElementById('agent-listings-container');
  const emptyEl = document.getElementById('agent-listings-empty');
  if (!container || !emptyEl) return;
  const hasCards = container.querySelector('[id^="agent-listing-"]');
  emptyEl.classList.toggle('hidden', !!hasCards);
  container.classList.toggle('hidden', !hasCards);
}

function openPreviewListing(id) {
  const listing = agentListings[id];
  if (!listing) return;
  const catLabel = {houseboat:'Luxury Houseboat',shikara:'Shikara Cruise',homestay:'Heritage Homestay'}[listing.category] || 'Listing';
  const amenities = (listing.amenities || '').split(',').filter(a => a.trim()).map(a =>
    `<span class="amenity-pill"><i class="fa-solid fa-check text-[10px]"></i>${a.trim()}</span>`
  ).join('');

  document.getElementById('preview-modal-content').innerHTML = `
    <div class="relative">
      <img src="${listing.image}" alt="${listing.title}" class="w-full h-56 object-cover" onerror="this.src='https://images.unsplash.com/photo-1593693411515-c20261bcad6e?w=600&q=80'"/>
      <button onclick="closePreviewModal()" class="absolute top-4 left-4 w-10 h-10 glass rounded-full flex items-center justify-center shadow-card z-10">
        <i class="fa-solid fa-arrow-left text-emerald text-sm"></i>
      </button>
      <span class="absolute bottom-4 left-4 bg-emerald/90 text-white text-xs font-semibold font-body px-3 py-1.5 rounded-full">${catLabel}</span>
    </div>
    <div class="px-5 pt-5 pb-6">
      <h2 class="font-display text-2xl font-light text-ink leading-tight mb-1">${listing.title}</h2>
      ${listing.subtitle ? `<p class="text-gray-400 text-sm font-body mb-2">${listing.subtitle}</p>` : ''}
      <p class="text-gray-500 text-sm font-body mb-4 flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0d4f3c" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        ${listing.location}
      </p>
      <p class="text-gray-600 text-sm font-body leading-relaxed mb-4">${listing.description || ''}</p>
      ${amenities ? `<h4 class="font-body font-semibold text-ink text-sm mb-3">Amenities</h4><div class="flex flex-wrap gap-2 mb-4">${amenities}</div>` : ''}
      <div class="flex items-center justify-between py-4 border-t border-gray-100">
        <div>
          <p class="text-gray-400 text-xs font-body">Starting from</p>
          <p class="font-body font-bold text-xl text-ink"><span class="text-emerald">₹</span>${listing.price.toLocaleString('en-IN')}<span class="text-gray-400 text-sm font-normal"> / night</span></p>
        </div>
        <span class="bg-${listing.available ? 'emerald-mist text-emerald' : 'red-50 text-red-400'} text-xs font-semibold font-body px-3 py-1.5 rounded-full">
          ${listing.available ? '✓ Available' : '✗ Unavailable'}
        </span>
      </div>
      <button onclick="openEditListing(${id}); closePreviewModal();" class="btn-emerald w-full rounded-2xl py-3.5 text-white font-semibold text-sm font-body flex items-center justify-center gap-2 mt-2">
        <i class="fa-solid fa-pen"></i> Edit This Listing
      </button>
    </div>`;

  document.getElementById('previewModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closePreviewModal() {
  document.getElementById('previewModal').classList.remove('open');
  document.body.style.overflow = '';
}

function showListingError(msg) {
  const el = document.getElementById('listing-error');
  const txt = document.getElementById('listing-error-text');
  if (el && txt) { txt.textContent = msg; el.classList.remove('hidden'); el.classList.add('flex'); }
}

function showListingToast(msg) {
  // Create a quick toast notification
  const toast = document.createElement('div');
  toast.className = 'fixed top-6 left-1/2 z-[2000] font-body text-sm font-semibold text-white px-5 py-3 rounded-2xl shadow-float';
  toast.style.cssText = 'transform:translateX(-50%) translateY(-20px);background:var(--emerald);transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1);opacity:0;';
  toast.textContent = '✓ ' + msg;
  document.body.appendChild(toast);
  setTimeout(() => { toast.style.transform = 'translateX(-50%) translateY(0)'; toast.style.opacity = '1'; }, 30);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(-50%) translateY(-10px)'; setTimeout(() => toast.remove(), 400); }, 2800);
}

/* ─────────────────────────────────────────
   FIX: View All Bookings link in overview
───────────────────────────────────────── */
// Override booking row accept/decline so they actually work
function _fixAgentBookingsRendering() {
  // Re-render to attach proper click handlers
  renderAgentBookings();
}

/* ─────────────────────────────────────────
   TOUR PACKAGES — Data & Rendering
───────────────────────────────────────── */
const TOUR_PACKAGES = [];

let _tourFilter = 'all';
let _tourSort = 'popular';

function filterTours(category) {
  _tourFilter = category;
  document.querySelectorAll('.tour-filter-chip').forEach(chip => {
    const isActive = chip.dataset.tf === category;
    chip.classList.toggle('selected', isActive);
    if (isActive) { chip.style.background = 'var(--emerald)'; chip.style.color = 'white'; chip.style.borderColor = 'var(--emerald)'; }
    else { chip.style.background = 'white'; chip.style.color = '#4b5563'; chip.style.borderColor = '#e5e7eb'; }
  });
  renderTourCards();
}

function sortTours(val) {
  _tourSort = val;
  renderTourCards();
}

function renderTourCards() {
  const container = document.getElementById('tour-list');
  if (!container) return;

  let tours = _tourFilter === 'all' ? [...TOUR_PACKAGES] : TOUR_PACKAGES.filter(t => t.category === _tourFilter);

  if (_tourSort === 'price-low') tours.sort((a,b) => a.price - b.price);
  else if (_tourSort === 'price-high') tours.sort((a,b) => b.price - a.price);
  else if (_tourSort === 'duration') tours.sort((a,b) => parseInt(a.duration) - parseInt(b.duration));
  else tours.sort((a,b) => b.reviews - a.reviews);

  const label = document.getElementById('tour-count-label');
  if (label) label.textContent = `${tours.length} package${tours.length !== 1 ? 's' : ''} found`;

  if (tours.length === 0) {
    container.innerHTML = `<div class="flex flex-col items-center py-16 text-center">
      <div class="w-16 h-16 rounded-3xl bg-emerald-mist flex items-center justify-center mb-4">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0d4f3c" stroke-width="1.5"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg>
      </div>
      <p class="font-display text-xl font-light text-ink mb-1">No tours found</p>
      <p class="text-gray-400 text-sm font-body">Try a different filter</p>
    </div>`;
    return;
  }

  container.innerHTML = tours.map(t => {
    const stars = Array.from({length:5}, (_,i) => i < Math.floor(t.rating) ? '★' : '☆').join('');
    const highlightPills = t.highlights.map(h => `<span class="amenity-pill text-[11px]">${h}</span>`).join('');
    const availBadge = t.available
      ? '<span class="text-[10px] font-semibold font-body bg-emerald-mist text-emerald px-2 py-0.5 rounded-full">✓ Available</span>'
      : '<span class="text-[10px] font-semibold font-body bg-red-50 text-red-400 px-2 py-0.5 rounded-full">Sold Out</span>';
    return `
      <div class="bg-white rounded-3xl shadow-card overflow-hidden property-card border border-gray-100">
        <div class="relative h-48 overflow-hidden">
          <img src="${t.image}" alt="${t.title}" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=800&q=85'"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute top-3 left-3 flex gap-2">
            <span class="text-[10px] font-bold font-body text-white px-2.5 py-1 rounded-full" style="background:${t.badgeColor};">${t.badge}</span>
          </div>
          <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between">
            <div>
              <p class="text-white font-display text-xl font-light leading-tight">${t.title}</p>
              <p class="text-white/70 text-xs font-body">${t.subtitle}</p>
            </div>
          </div>
        </div>
        <div class="px-4 pt-4 pb-5">
          <!-- Rating & availability -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-1.5">
              <span class="text-gold text-sm tracking-tighter">${stars}</span>
              <span class="text-gray-400 text-xs font-body">${t.rating} · ${t.reviews} reviews</span>
            </div>
            ${availBadge}
          </div>

          <!-- Meta pills -->
          <div class="flex gap-2 mb-3">
            <span class="amenity-pill text-[11px]">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${t.duration}
            </span>
            <span class="amenity-pill text-[11px]">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              ${t.guests}
            </span>
          </div>

          <!-- Description -->
          <p class="text-gray-500 text-xs font-body leading-relaxed mb-3">${t.description}</p>

          <!-- Highlights -->
          <div class="flex flex-wrap gap-1.5 mb-4">${highlightPills}</div>

          <!-- Price + CTA -->
          <div class="flex items-center justify-between pt-3 border-t border-gray-100">
            <div>
              <p class="text-gray-400 text-[10px] font-body uppercase tracking-wider">Per Person</p>
              <p class="font-body font-bold text-xl text-ink">${typeof window.nkFormatPrice==='function'?window.nkFormatPrice(t.price):'₹'+t.price.toLocaleString('en-IN')}</p>
            </div>
            ${t.available
              ? `<button onclick="openTourDetail('${t.id}')" class="btn-gold rounded-2xl px-5 py-3 text-white font-semibold text-sm font-body shadow-gold">
                  <i class="fa-solid fa-map-location-dot mr-1.5"></i>Book Tour
                </button>`
              : `<button disabled class="rounded-2xl px-5 py-3 text-gray-400 font-semibold text-sm font-body bg-gray-100 cursor-not-allowed">Sold Out</button>`
            }
          </div>
        </div>
      </div>`;
  }).join('');
}

/* ── Tour Detail Sheet ── */
function openTourDetail(id) {
  const t = TOUR_PACKAGES.find(t => t.id === id);
  if (!t) return;
  if (!state.loggedInUser) {
    const label = document.getElementById('auth-gate-property-label');
    if (label) label.textContent = `Sign in to book "${t.title}".`;
    document.getElementById('auth-gate-backdrop').classList.add('open');
    document.getElementById('auth-gate-sheet').classList.add('open');
    document.body.style.overflow = 'hidden';
    return;
  }
  // For now, use a simple booking flow using the existing booking modal
  // Set tour as a property-like object and open modal
  state.selectedProperty = {
    id: t.id, title: t.title, subtitle: t.subtitle,
    category: 'tour', location: 'Alappuzha, Kerala',
    price: t.price, rating: t.rating, reviews: t.reviews,
    host: 'Nauka Tours', description: t.description,
    amenities: t.includes.map(i => ({ icon: 'fa-check', label: i })),
    image: t.image, gallery: [t.image, t.image, t.image],
  };
  document.getElementById('modal-property-name').textContent = t.title;
  document.getElementById('booking-date').value = '';
  if (document.getElementById('booking-checkout')) document.getElementById('booking-checkout').value = '';
  if (document.getElementById('nk-booking-terms')) document.getElementById('nk-booking-terms').checked = false;
  window.nkResetBookingDateRange?.();
  document.getElementById('booking-adults').value = 1;
  const adDisp = document.getElementById('booking-adults-display');
  if (adDisp) adDisp.textContent = '1';
  document.getElementById('booking-children').value = 0;
  const chDisp = document.getElementById('booking-children-display');
  if (chDisp) chDisp.textContent = '0';
  document.getElementById('booking-nights').value = parseInt(t.duration) || 1;
  _setupRouteField(true);
  hideBookingError();
  updatePriceSummary();
  document.getElementById('bookingModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}


document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeBookingModal();
    closeListingModal();
    closePreviewModal();
    closeNotifPanel();
    closeAuthSheet();
    closeAuthGate();
    closeEditProfileSheet();
     window.closeAdminAgentModal?.();
  }
});


/* ─────────────────────────────────────────
   BOOT
───────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', init);
</script>

<!-- ═══════════════════════════════════════
     LIVE ADMIN MOUNT
═══════════════════════════════════════ -->
<div id="view-admin" class="view" style="padding-bottom:80px;"></div>

  <script>
/* ═══════════ NAUKA FLOW: routes, availability request, bookings ═══════════ */
const NAUKA_WA = '919447724293';
const BOARDING_POINT = 'Finishing Point, Punnamada, Alleppey';

function escapeHTML(s) {
  if (s === undefined || s === null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function formatDate(iso) {
  if (!iso) return 'N/A';
  const p = iso.split('-');
  if (p.length !== 3) return iso;
  return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('en-US', { day:'numeric', month:'short', year:'numeric' });
}
function addDaysISO(iso, n) {
  const [y, m, d] = iso.split('-').map(Number);
  const dt = new Date(y, m - 1, d + n);
  return dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2,'0') + '-' + String(dt.getDate()).padStart(2,'0');
}
function openWhatsApp(msg) {
  const url = 'https://wa.me/' + NAUKA_WA + '?text=' + encodeURIComponent(msg);
  const popup = window.open(url, '_blank');
  /* Async Supabase requests can cause popup blockers to reject a new tab; in
     that case still complete the requested WhatsApp redirect in this tab. */
  if (!popup) window.location.href = url;
  return popup;
}
function plain(s) { return String(s).replace(/₹/g, 'Rs. '); }

/* chrome: nav highlight, WhatsApp button, icons */
function _syncChrome(viewName) {
  const map = { home:'home', boats:'boats', fleet:'boats', saved:'saved', mybookings:'bookings', profile:'profile' };
  if (map[viewName]) {
    document.querySelectorAll('#customer-bottom-nav .nav-item').forEach(b => b.classList.toggle('active-nav', b.dataset.nav === map[viewName]));
  }
  const fab = document.getElementById('whatsapp-fab');
  if (fab) fab.style.display = viewName === 'home' ? 'flex' : 'none';
  if (window.lucide) lucide.createIcons();
}

/* ── Journeys & FAQ ── */
function toggleFaq(button) {
  const content = button.nextElementSibling;
  const icon = button.querySelector('svg, i');
  const hidden = content.classList.contains('hidden');
  content.classList.toggle('hidden', !hidden);
  if (icon) icon.style.transform = hidden ? 'rotate(180deg)' : 'rotate(0deg)';
}
function updateRouteNotices() {
  const r = state.selectedRoute;
  const n1 = document.getElementById('selectedRouteNotice'), n1n = document.getElementById('selectedRouteNameDisplay');
  const n2 = document.getElementById('fleet-route-notice'), n2n = document.getElementById('fleet-route-name');
  if (n1 && n1n) { n1n.innerText = r || ''; n1.classList.toggle('hidden', !r); }
  if (n2 && n2n) { n2n.innerText = r || ''; n2.classList.toggle('hidden', !r); n2.classList.toggle('flex', !!r); }
}
function selectRouteAndChooseBoat(routeName) {
  state.selectedRoute = routeName;
  updateRouteNotices();
  showView('boats');
}

/* ── Booking modal helpers ── */
function _setupRouteField(isTour) {
  const wrap = document.getElementById('booking-route-wrap');
  const sel = document.getElementById('booking-route');
  if (wrap) wrap.style.display = isTour ? 'none' : '';
  if (sel) sel.value = isTour ? '' : (state.selectedRoute || '');
}

/* ── Check availability → pending booking ── */
async function submitAvailabilityRequest() {
  if (typeof window.__naukaLiveBookingHandler === 'function') return window.__naukaLiveBookingHandler();
  const liveClient = window.naukaSupabase;
  const liveUser = state.loggedInUser;
  if (liveClient && liveUser?.id) {
    const date = document.getElementById('booking-date')?.value || '';
    const adults = Math.max(1, Number(document.getElementById('booking-adults')?.value) || 1);
    const children = Math.max(0, Number(document.getElementById('booking-children')?.value) || 0);
    const nights = Math.max(1, Number(document.getElementById('booking-nights')?.value) || 1);
    const property = state.selectedProperty;
    if (!date) return showBookingError('Please select a check-in date to continue.');
    if (date < new Date().toISOString().slice(0, 10)) return showBookingError('Check-in date cannot be in the past.');
    if (!property) return showBookingError('Please select a houseboat first.');
    const mode = window.nkBookingMode || window.nkCruiseMode || 'day';
    const unitPrice = typeof window.nkPriceFor === 'function' ? Number(window.nkPriceFor(property, mode)) : Number(property.price || 0);
    const total = Number(String(document.getElementById('modal-total')?.textContent || '').replace(/[^\d.]/g, '')) || unitPrice * nights;
    const bookingId = 'NK-' + crypto.randomUUID().replace(/-/g, '').slice(0, 12).toUpperCase();
    const row = {
      id: bookingId, user_id: liveUser.id, property_id: Number(property.id), property_name: property.title,
      property_category: property.category || 'houseboat', cruise_type: mode === 'day' ? 'day' : 'night', price: unitPrice, booking_date: date, adults, children,
      guests: adults + children, nights, guest_name: state.profileDisplayName || liveUser.username || liveUser.email,
      guest_email: liveUser.email, guest_phone: state.profilePhone || '',
      route: document.getElementById('booking-route')?.value || state.selectedRoute || 'Alleppey Backwater Circuit', total, status: 'pending'
    };
    const result = await liveClient.from('bookings').insert(row).select().single();
    if (result.error) return showBookingError(result.error.message || 'Could not create your booking request.');
    const saved = result.data;
    const booking = {
      id: saved.id, reference: saved.id, bookingId: saved.id, status: saved.status,
      propertyName: saved.property_name, propertyCategory: saved.property_category, location: property.location || '', host: property.host || '', image: property.image || '',
      guests: saved.guests, adults: saved.adults, children: saved.children, nights: saved.nights,
      checkIn: saved.booking_date, rawDate: saved.booking_date, route: saved.route, price: saved.price, total: saved.total, totalAmount: saved.total,
      estimate: saved.total, guestName: saved.guest_name, guestEmail: saved.guest_email, guestPhone: saved.guest_phone,
      createdAt: saved.created_at, updatedAt: saved.updated_at
    };
    state.bookingData = booking;
    state.userBookings = [booking, ...(state.userBookings || []).filter(item => item.id !== booking.id)];
    state.bookingFilter = 'pending';
    persistState();
    window.nkUnread = Number(window.nkUnread || 0) + 1;
    window.renderNaukaBookingNotifications?.();
    closeBookingModal();
    showView('mybookings');
    return;
  }
  const dateInput = document.getElementById('booking-date');
  const date = dateInput.value;
  const adults = parseInt(document.getElementById('booking-adults').value) || 1;
  const children = parseInt(document.getElementById('booking-children').value) || 0;
  const nights = parseInt(document.getElementById('booking-nights').value) || 1;
  const p = state.selectedProperty;
  const isTour = p && p.category === 'tour';
  const route = isTour ? 'Tour Package' : document.getElementById('booking-route').value;

  if (!date) { showBookingError('Please select a check-in date to continue.'); dateInput.classList.add('shake'); setTimeout(() => dateInput.classList.remove('shake'), 500); return; }
  const today = new Date(); today.setHours(0,0,0,0);
  if (new Date(date + 'T00:00:00') < today) { showBookingError('Check-in date cannot be in the past.'); return; }
  if (!route) { showBookingError('Please select a cruise route.'); return; }

  const guestStr = [adults + ' Adult' + (adults > 1 ? 's' : ''), children > 0 ? children + ' Child' + (children > 1 ? 'ren' : '') : ''].filter(Boolean).join(', ');
  const checkOut = addDaysISO(date, nights);
  const ref = 'NK-' + Math.floor(1000 + Math.random() * 9000);
  const iso = new Date().toISOString();
  const unitPrice = typeof window.nkPriceFor === 'function' ? window.nkPriceFor(p, window.nkBookingMode || window.nkCruiseMode || 'overnight') : p.price;
  const estimate = Math.round(unitPrice * nights);

  const booking = {
    id: 'nk_' + Date.now(), reference: ref, bookingId: ref, status: 'pending',
    propertyName: p.title, propertyCategory: p.category, location: p.location, host: p.host, image: p.image,
    guests: adults + children, adults, children, guestStr, nights,
    checkIn: date, rawDate: date, checkOut, route, boarding: BOARDING_POINT,
    price: '', estimate, cruiseType: window.nkBookingMode || window.nkCruiseMode || 'overnight', quoteStatus: 'awaiting', createdAt: iso, updatedAt: iso,
  };
  state.userBookings.unshift(booking);
  persistState();
  window.nkUnread=(window.nkUnread||0)+1;
  window.renderNaukaBookingNotifications?.();

  closeBookingModal();
  state.bookingFilter = 'pending';
  showView('mybookings');
}

/* ── Bookings model ── */
function _norm(b) {
  const today = new Date().toISOString().split('T')[0];
  const n = { ...b };
  n.reference = b.reference || b.bookingId;
  n.id = b.id || n.reference;
  n.checkIn = b.checkIn || b.rawDate || '';
  n.checkOut = b.checkOut || (n.checkIn ? addDaysISO(n.checkIn, b.nights || 1) : '');
  n.status = b.status || 'confirmed';
  if (n.status === 'confirmed' && n.checkOut && n.checkOut < today) n.status = 'completed';
  const baseGuestsLabel = b.guestStr || (typeof b.guests === 'number' ? b.guests + ' Guest' + (b.guests > 1 ? 's' : '') : (b.guests || ''));
  n.guestsLabel = b.rooms ? `${b.rooms} room${b.rooms > 1 ? 's' : ''} · ${baseGuestsLabel}` : baseGuestsLabel;
  n.route = b.route || 'Backwater Cruise';
  n.boarding = b.boarding || BOARDING_POINT;
  const rawBookingPrice=Number(String(b.price||'').replace(/[^\d.]/g,''))||0;
  n.priceLabel = rawBookingPrice ? (typeof window.nkFormatPrice==='function'?window.nkFormatPrice(rawBookingPrice):b.price) : (!b.status && b.totalAmount ? (typeof window.nkFormatPrice==='function'?window.nkFormatPrice(b.totalAmount):'₹'+b.totalAmount.toLocaleString('en-IN')) : '');
  const prop = PROPERTIES.find(x => x.title === b.propertyName) || {};
  n.img = b.image || prop.image || 'https://images.unsplash.com/photo-1593693411515-c20261bcad6e?w=800&q=85&auto=format&fit=crop';
  return n;
}
function _raw(id) { return state.userBookings.find(b => (b.id || b.reference || b.bookingId) === id || b.reference === id || b.bookingId === id); }
function _get(id) { const r = _raw(id); return r ? _norm(r) : null; }

function setBookingFilter(s) { state.bookingFilter = s; renderMyBookings(); }

function renderMyBookings() {
  const tabsEl = document.getElementById('mybookings-tabs'), listEl = document.getElementById('mybookings-list');
  if (!tabsEl || !listEl) return;
  const all = state.userBookings.map(_norm);
  const f = state.bookingFilter || 'confirmed';
  const defs = [['confirmed','Confirmed','bg-emerald'], ['pending','Pending','bg-gold'], ['declined','Declined','bg-red-500']];
  tabsEl.innerHTML = '<div class="flex gap-1.5 p-1.5 bg-gray-100 rounded-2xl">' + defs.map(([k, label, dot]) => {
    const c = all.filter(b => b.status === k).length;
    const on = k === f;
    return `<button onclick="setBookingFilter('${k}')" class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-xs font-body transition-all ${on ? 'bg-white text-ink font-bold shadow-soft' : 'text-gray-500 font-semibold'}">
      <span class="w-2 h-2 rounded-full ${dot}"></span>${label}<span class="px-1.5 rounded-full text-[10px] ${on ? 'bg-emerald-mist text-emerald' : 'bg-gray-200 text-gray-600'}">${c}</span></button>`;
  }).join('') + '</div>';

  const list = all.filter(b => b.status === f);
  if (!list.length) {
    const txt = { confirmed: ['No confirmed trips','Trips appear here once Nauka confirms your booking.'], pending: ['No pending requests','Pick a houseboat and tap Check Availability to send a request.'], declined: ['No declined requests','Declined requests will appear here.'] }[f];
    listEl.innerHTML = `<div class="flex flex-col items-center text-center py-14">
      <div class="w-16 h-16 rounded-3xl bg-emerald-mist flex items-center justify-center mb-4"><i class="fa-regular fa-calendar text-emerald text-2xl"></i></div>
      <h3 class="font-display text-2xl font-light text-ink mb-1">${txt[0]}</h3>
      <p class="text-gray-400 text-sm font-body mb-5 max-w-[260px] leading-relaxed">${txt[1]}</p>
      <button onclick="showView('boats')" class="btn-emerald text-white font-semibold text-sm rounded-2xl px-6 py-3 font-body">Browse the Fleet</button></div>`;
    return;
  }
  listEl.innerHTML = list.map(_bookingCard).join('');
}

function _bookingCard(b) {
  const badge = { confirmed: ['✓ Confirmed','bg-emerald'], pending: ['Pending request','bg-gold'], completed: ['Completed','bg-gray-600'], declined: ['Declined','bg-red-500'] }[b.status] || ['Pending request','bg-gold'];
  const id = escapeHTML(b.id);
  const price = b.priceLabel ? escapeHTML(b.priceLabel) : 'Quoted on request';
  const stat = (l, v) => `<div><p class="text-[10px] text-gray-400 font-body uppercase tracking-wider">${l}</p><p class="font-body font-semibold text-ink text-sm">${v}</p></div>`;
  const btnWA = `<button onclick="contactNaukaWhatsApp('${id}')" class="flex-1 bg-emerald text-white text-xs font-bold font-body px-3 py-2.5 rounded-xl flex items-center justify-center gap-1.5"><i class="fa-brands fa-whatsapp text-sm"></i>Contact Nauka</button>`;
  let foot;
  if (b.status === 'pending') {
    foot = `<div class="bg-emerald-mist border border-emerald/15 rounded-2xl p-4">
      <p class="text-sm font-semibold text-emerald font-body leading-relaxed">We have received your request, Our team will contact you soon with best offers!. Thanks for your patience.</p>
    </div>`;
  } else {
    foot = `<div class="flex gap-2">${btnWA}
      <button onclick="shareBookingPDF('${id}')" class="flex-1 bg-ink text-white text-xs font-bold font-body px-3 py-2.5 rounded-xl flex items-center justify-center gap-1.5"><i class="fa-solid fa-share-nodes" style="color:#e8c97a"></i>Share Booking</button></div>
      <button onclick="downloadBookingPDF('${id}')" class="mt-2 w-full bg-white border border-gray-200 text-gray-700 text-xs font-bold font-body py-2.5 rounded-xl flex items-center justify-center gap-1.5"><i class="fa-solid fa-download text-gray-500"></i>Download PDF</button>`;
  }
  return `<div class="bg-white rounded-3xl shadow-soft border border-gray-100 overflow-hidden mb-4">
    <div class="relative">
      <img src="${escapeHTML(b.img)}" alt="" class="w-full h-32 object-cover"/>
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      <span class="absolute top-3 left-3 ${badge[1]} text-white text-xs font-semibold font-body px-3 py-1 rounded-full">${badge[0]}</span>
      <span class="absolute top-3 right-3 bg-white/90 text-gray-600 text-[11px] font-mono font-bold px-2.5 py-1 rounded-full">#${escapeHTML(b.reference)}</span>
      <div class="absolute bottom-3 left-4 right-4"><h4 class="text-white font-body font-bold text-base leading-tight">${escapeHTML(b.propertyName)}</h4>
      <p class="text-white/80 text-xs font-body">${escapeHTML(b.route)}</p></div>
    </div>
    <div class="p-4">
      <div class="grid grid-cols-2 gap-3 mb-3">${stat('Check-in', formatDate(b.checkIn))}${stat('Check-out', formatDate(b.checkOut))}${stat('Guests', escapeHTML(b.guestsLabel))}${stat('Price', price)}</div>
      <p class="text-[11px] text-gray-400 font-body flex items-center gap-1 mb-3"><i class="fa-solid fa-anchor text-emerald"></i>${escapeHTML(b.boarding)}</p>
      ${foot}
    </div></div>`;
}

/* ── Actions ── */
function contactNaukaWhatsApp(id) {
  const b = _get(id); if (!b) return;
  openWhatsApp(`NAUKA BOOKING ENQUIRY\n\nBooking Reference: ${b.reference}\nStatus: ${b.status.toUpperCase()}\nHouseboat: ${b.propertyName}\nRoute: ${b.route}\nGuests: ${b.guestsLabel}\nCheck-in: ${formatDate(b.checkIn)}\nCheck-out: ${formatDate(b.checkOut)}\nBoarding: ${b.boarding}\nPrice: ${b.priceLabel || 'Quoted On Request'}\n\nHello Nauka team, I would like to inquire about my booking.`);
}
function acceptPriceQuote(id) {
  const r = _raw(id); if (!r) return;
  r.quoteStatus = 'accepted'; r.status = 'confirmed'; r.updatedAt = new Date().toISOString();
  persistState();
  const b = _norm(r);
  openWhatsApp(`PRICE QUOTE ACCEPTED — NAUKA\n\nBooking Reference: ${b.reference}\nHouseboat: ${b.propertyName}\nPrice Quoted: ${b.price}\nCheck-in: ${formatDate(b.checkIn)}\nCheck-out: ${formatDate(b.checkOut)}\n\nI have accepted the quoted price via the Nauka application. Please issue final confirmation.`);
  state.bookingFilter = 'confirmed';
  renderMyBookings();
}

function _bookingPDF(b) {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const EM = [13,79,60], GOLD = [201,168,76], INK = [26,26,24], GR = [107,114,128], LI = [232,242,238];
  const done = b.status === 'completed';
  doc.setFillColor(...EM); doc.rect(0, 0, 210, 44, 'F');
  doc.setFillColor(...GOLD); doc.rect(0, 44, 210, 2, 'F');
  doc.setTextColor(255,255,255);
  if (!nkLogoPdf(doc, 15, 9, 15)) { doc.setFont('times','bolditalic'); doc.setFontSize(24); doc.text('Nauka', 15, 20); }
  doc.setFont('helvetica','normal'); doc.setFontSize(8.5); doc.setTextColor(232,201,122);
  doc.text('LUXURY BACKWATER ESCAPES  |  KERALA, INDIA', 15, 28);
  doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(11);
  doc.text(done ? 'COMPLETED JOURNEY' : 'BOOKING CONFIRMATION', 195, 20, { align: 'right' });
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.text('Ref: #' + b.reference, 195, 27, { align: 'right' });

  let y = 58;
  doc.setFillColor(...LI); doc.roundedRect(15, y, 180, 18, 3, 3, 'F');
  doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(...INK); doc.text('RESERVATION STATUS', 22, y + 11);
  doc.setFillColor(...(done ? [75,85,99] : EM)); doc.roundedRect(72, y + 4.5, 32, 9, 2, 2, 'F');
  doc.setTextColor(255,255,255); doc.setFontSize(8.5); doc.text(done ? 'COMPLETED' : 'CONFIRMED', 88, y + 10.5, { align: 'center' });
  doc.setTextColor(...GR); doc.setFont('helvetica','normal'); doc.setFontSize(8.5);
  doc.text('Issued: ' + new Date().toLocaleDateString('en-GB'), 188, y + 11, { align: 'right' });

  y += 28;
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...EM); doc.text('CRUISE DETAILS', 15, y);
  doc.setDrawColor(...GOLD); doc.setLineWidth(0.5); doc.line(15, y + 2, 195, y + 2);
  y += 6;
  const rows = [
    ['Booking reference', '#' + b.reference], ['Houseboat', b.propertyName || 'N/A'], ['Route', b.route],
    ['Guests', b.guestsLabel || 'N/A'], ['Check-in', formatDate(b.checkIn) + ' (12:00 PM)'],
    ['Check-out', formatDate(b.checkOut) + ' (09:00 AM)'], ['Boarding point', b.boarding],
    ['Price', plain(b.priceLabel || 'Quoted on request')],
  ];
  rows.forEach((r, i) => {
    if (i % 2 === 0) { doc.setFillColor(248,250,249); doc.rect(15, y, 180, 10, 'F'); }
    doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...GR); doc.text(r[0], 20, y + 6.5);
    doc.setTextColor(...INK); doc.text(String(r[1]), 80, y + 6.5, { maxWidth: 110 });
    y += 10;
  });

  y += 8;
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(...EM); doc.text('SUPPORT & ONBOARD', 15, y);
  doc.line(15, y + 2, 195, y + 2); y += 6;
  doc.setDrawColor(226,232,240); doc.setFillColor(250,249,247); doc.roundedRect(15, y, 180, 26, 3, 3, 'FD');
  doc.setFontSize(8.5);
  [['Nauka guest support', '+91 85940 23220'], ['Boarding address', 'Finishing Point, Punnamada, Alleppey, Kerala - 688001'], ['Meals', 'Kerala lunch, evening tea & snacks, dinner and breakfast']].forEach((r, i) => {
    doc.setFont('helvetica','bold'); doc.setTextColor(...INK); doc.text(r[0], 22, y + 7 + i * 7);
    doc.setFont('helvetica','normal'); doc.setTextColor(...GR); doc.text(r[1], 70, y + 7 + i * 7);
  });
  y += 34;
  doc.setFillColor(253,248,236); doc.setDrawColor(...GOLD); doc.roundedRect(15, y, 180, 22, 3, 3, 'FD');
  doc.setFont('helvetica','bold'); doc.setFontSize(8.5); doc.setTextColor(150,110,20); doc.text('OFFICIAL BOOKING NOTICE', 22, y + 7);
  doc.setFont('helvetica','normal'); doc.setFontSize(8);
  doc.text(doc.splitTextToSize('Please quote booking reference #' + b.reference + ' on arrival at the Punnamada Finishing Point jetty. Carry a valid photo ID for every guest.', 166), 22, y + 13);
  doc.setFontSize(8); doc.setTextColor(148,163,184);
  doc.text('Nauka  |  God\'s Own Country, Kerala, India', 105, 285, { align: 'center' });
  return doc;
}
function downloadBookingPDF(id) { const b = _get(id); if (b) _bookingPDF(b).save('NAUKA-' + b.reference + '.pdf'); }
async function shareBookingPDF(id) {
  const b = _get(id); if (!b) return;
  const doc = _bookingPDF(b), name = 'NAUKA-' + b.reference + '.pdf';
  try {
    const file = new File([doc.output('blob')], name, { type: 'application/pdf' });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      await navigator.share({ title: 'Booking Confirmation - ' + b.reference, text: 'Booking confirmation ' + b.reference, files: [file] });
      return;
    }
  } catch (e) { if (e && e.name === 'AbortError') return; }
  doc.save(name);
  openWhatsApp(`NAUKA BOOKING CONFIRMATION SHEET\n\nBooking Reference: ${b.reference}\nHouseboat: ${b.propertyName}\nRoute: ${b.route}\nGuests: ${b.guestsLabel}\nCheck-in: ${formatDate(b.checkIn)}\nCheck-out: ${formatDate(b.checkOut)}\nBoarding: ${b.boarding}\nPrice: ${b.priceLabel || 'Quoted On Request'}\n\nNote: ${name} has been downloaded and can be attached here.`);
}

/* ── Backend hook (same API as the Nauka variant) ── */
window.NaukaBookingBridge = {
  setStatus(id, status) {
    if (!['pending','confirmed','completed'].includes(status)) return false;
    const r = _raw(id); if (!r) return false;
    r.status = status; r.updatedAt = new Date().toISOString(); persistState(); renderMyBookings(); return true;
  },
  setQuote(id, amount) {
    const r = _raw(id); if (!r) return false;
    r.price = typeof amount === 'number' ? '₹' + amount.toLocaleString('en-IN') : amount;
    r.quoteStatus = 'quoted'; r.status = 'pending'; r.updatedAt = new Date().toISOString(); persistState(); renderMyBookings(); return true;
  },
  getBookings() { return state.userBookings; }
};

document.addEventListener('DOMContentLoaded', () => { updateRouteNotices(); if (window.lucide) lucide.createIcons(); });

</script>
<!-- ═══════ UPGRADE LAYER: Operator portal + Admin console ═══════ -->
<style>
  .xcard{background:#fff;border:1px solid #eef0ef;border-radius:1.25rem;box-shadow:0 4px 24px rgba(13,79,60,.07)}
  .xchip{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:999px;font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap}
  .s-pending{background:#fef3c7;color:#92400e}.s-quoted{background:#e0f2fe;color:#075985}.s-confirmed{background:#e8f2ee;color:#0d4f3c}
  .s-completed{background:#e5e7eb;color:#374151}.s-declined{background:#fee2e2;color:#991b1b}.s-qdeclined{background:#ffedd5;color:#9a3412}.s-active{background:#e8f2ee;color:#0d4f3c}.s-suspended{background:#fee2e2;color:#991b1b}
  .xbtn{font:700 12px 'Plus Jakarta Sans',sans-serif;padding:.65rem 1rem;border-radius:.85rem;transition:all .2s}
  .xbtn-em{background:var(--emerald);color:#fff}.xbtn-gold{background:linear-gradient(135deg,#c9a84c,#e8c97a);color:#082e23}
  .xbtn-out{background:#fff;border:1.5px solid #e5e7eb;color:#1a1a18}.xbtn-red{background:#fee2e2;color:#991b1b}
  .xin{width:100%;border:1.5px solid #e5e7eb;border-radius:.8rem;padding:.65rem .9rem;font:500 .9rem 'Plus Jakarta Sans',sans-serif;background:#fff;outline:none}
  .xin:focus{border-color:var(--emerald);box-shadow:0 0 0 3px rgba(13,79,60,.1)}
  .xlbl{display:block;font:700 10px 'Plus Jakarta Sans',sans-serif;color:#6b7280;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.35rem}
  #xsheet{display:none;position:fixed;inset:0;z-index:1300;background:rgba(8,46,35,.55);backdrop-filter:blur(6px);align-items:flex-end;justify-content:center}
  #xsheet.open{display:flex}
  #xsheet .sh{width:100%;max-width:480px;max-height:92vh;overflow-y:auto;background:#faf9f7;border-radius:2rem 2rem 0 0;padding:1.1rem 1.25rem 2rem;animation:sheetUp .4s cubic-bezier(.34,1.2,.64,1) both}
  .cal{aspect-ratio:1;border-radius:.7rem;border:1.5px solid #eef0ef;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;line-height:1.15}
  .cal b{font-size:12px;color:#1a1a18}.cal i{font-style:normal;font-size:8.5px;color:#6b7280;font-weight:600}
  .cal.we{background:var(--gold-pale);border-color:#efdca4}.cal.ov{border-color:var(--emerald);box-shadow:inset 0 0 0 1px var(--emerald)}
  .cal.bl{background:#f3f4f6;opacity:.6}.cal.bl b{text-decoration:line-through}.cal.off{visibility:hidden}
  #view-admin{background:#f3f5f4!important}
  .adtab{flex-shrink:0;font:700 12px 'Plus Jakarta Sans',sans-serif;padding:.55rem .95rem;border-radius:.8rem;color:#64748b;background:#fff;border:1px solid #e5e7eb}
  .adtab.on{background:#082e23;color:#e8c97a;border-color:#082e23}
  .adth{font:700 10px 'Plus Jakarta Sans',sans-serif;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em}
</style>

<nav id="op-nav" class="pill-nav" style="display:none">
  <button data-t="overview" onclick="OP.tab('overview')" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span class="nav-label">Overview</span></button>
  <button data-t="enquiries" onclick="OP.tab('enquiries')" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg><span class="nav-label">Bookings</span></button>
  <button data-t="fleet" onclick="OP.tab('fleet')" class="nav-item"><i class="fa-solid fa-ship nav-icon" style="font-size:17px;text-align:center"></i><span class="nav-label">Fleet</span></button>
  <button data-t="profile" onclick="OP.tab('profile')" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg><span class="nav-label">Profile</span></button>
</nav>

<script>
(function(){
'use strict';
/* ── helpers ── */
const $=id=>document.getElementById(id), E=s=>escapeHTML(s);
const pad=n=>String(n).padStart(2,'0');
const iso=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const parse=s=>{const[y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)};
const today=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
const winDays=()=>Array.from({length:90},(_,i)=>{const d=today();d.setDate(d.getDate()+i);return iso(d)});
const inWin=s=>{const w=winDays();return s>=w[0]&&s<=w[89]};
const isWE=s=>[5,6].includes(parse(s).getDay()); // Fri & Sat nights
const inr=n=>'₹'+Number(n).toLocaleString('en-IN');
const short=p=>p>=1000?(p/1000).toFixed(p%1000?1:0)+'k':String(p);
const amt=b=>Number(String(b.price||'').replace(/[^\d]/g,''))||0;
const load=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))||d}catch(e){return d}};
const save=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
function toast(m,bad){const t=document.createElement('div');t.textContent=m;t.style.cssText='position:fixed;top:24px;left:50%;transform:translateX(-50%);z-index:3000;padding:12px 20px;border-radius:16px;color:#fff;font:600 13px Plus Jakarta Sans,sans-serif;box-shadow:0 12px 40px rgba(0,0,0,.25);max-width:90vw;text-align:center;background:'+(bad?'#b91c1c':'#0d4f3c');document.body.appendChild(t);setTimeout(()=>t.remove(),2600)}
function sheet(h){let s=$('xsheet');if(!s){s=document.createElement('div');s.id='xsheet';s.onclick=e=>{if(e.target===s)closeSheet()};document.body.appendChild(s)}s.innerHTML='<div class="sh"><div class="auth-sheet-drag mb-4"></div>'+h+'</div>';s.classList.add('open');document.body.style.overflow='hidden'}
function closeSheet(){const s=$('xsheet');if(s)s.classList.remove('open');document.body.style.overflow=''}
window.closeSheet=closeSheet;
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSheet()});

/* ── operators registry (usernames) ── */
const UN={};
const OPS=[];
function syncOpsFromProperties(){
  OPS.length=0;
  const list=(typeof PROPERTIES!=='undefined'&&Array.isArray(PROPERTIES))?PROPERTIES:[];
  list.filter(p=>p.category==='houseboat').forEach(p=>{
    OPS.push({id:p.id,name:p.title,user:UN[p.id]||('op'+p.id),loc:p.location,price:p.price,rating:p.rating,reviews:p.reviews});
  });
  window.ALP_OPERATORS=OPS;
  OPS.forEach(o=>od(o.id));
}
window.syncOpsFromProperties=syncOpsFromProperties;
const K_OPS='alp_ops_v1',K_BK='alp_ops_bookings',K_AD='alp_admin_v1';
let DB={},AD_S=Object.assign({commission:10,suspended:{},cruisePricing:{dayPercent:70,overnightPercent:100}},load(K_AD,{}));
AD_S.commission=Number.isFinite(Number(AD_S.commission))&&Number(AD_S.commission)>=0?Number(AD_S.commission):10;
window.nkCommissionRate=AD_S.commission;
AD_S.cruisePricing=Object.assign({dayPercent:70,overnightPercent:100},AD_S.cruisePricing||{});
const saveDB=()=>save(K_OPS,DB),saveAD=()=>save(K_AD,AD_S);
function od(id){
  if(!DB[id]){
    const o=OPS.find(x=>x.id==id)||PROPERTIES.find(x=>x.id==id)||{price:15000};
    DB[id]={base:Number(o.price||15000),weekend:Number(o.price||15000),over:{},blocked:{},prof:{contact:'',phone:'',email:'',about:''}};
    saveDB();
  }
  return DB[id];
}
syncOpsFromProperties();
const opById=id=>OPS.find(o=>o.id==id), opByName=n=>OPS.find(o=>o.name===n);
const priceFor=(id,s)=>{const o=od(id);return o.over[s]!=null?o.over[s]:(isWE(s)?o.weekend:o.base)};

/* ── bookings registry (survives customer logout) ── */
function eff(b){const st=(b.status==='confirmed'&&b.checkOut&&b.checkOut<iso(today()))?'completed':b.status;return Object.assign({},b,{st})}
function syncBk(){const reg=load(K_BK,[]);(state.userBookings||[]).forEach(b=>{if(!b.status||!b.reference||!opByName(b.propertyName))return;const i=reg.findIndex(x=>x.id===b.id);if(i<0)reg.push(Object.assign({},b));else if(tsOf(b)>tsOf(reg[i]))reg[i]=Object.assign({},reg[i],b)});save(K_BK,reg);return reg}
const tsOf=x=>x.updatedAt||x.createdAt||'';
const allBk=()=>Array.isArray(window.__nkAdminBookings)
  ? window.__nkAdminBookings.map(eff)
  : syncBk().map(eff);
const opBk=id=>{const o=opById(id);return allBk().filter(b=>b.propertyName===o.name).sort((a,b)=>(b.createdAt||'').localeCompare(a.createdAt||''))};
function mutate(id,fn){const reg=syncBk(),r=reg.find(x=>x.id===id),ts=new Date().toISOString();if(r){fn(r);r.updatedAt=ts;save(K_BK,reg)}const u=(state.userBookings||[]).find(x=>x.id===id);if(u){fn(u);u.updatedAt=ts;persistState()}if(window.renderMyBookings)renderMyBookings()}
const key=b=>b.st==='pending'?(b.quoteStatus==='quoted'?'quoted':b.quoteStatus==='declined'?'qdeclined':'pending'):b.st;
const LAB={pending:'New enquiry',quoted:'Quote sent',qdeclined:'Quote declined',confirmed:'Confirmed',completed:'Completed',declined:'Declined'};
const chip=b=>`<span class="xchip s-${key(b)}">${LAB[key(b)]}</span>`;
const refresh=()=>{if($('view-admin').classList.contains('active'))AD.go(AD.t);else OP.body()};

/* stamp guest identity on new enquiries (invisible to customer UI) */
const _sar=window.submitAvailabilityRequest;
window.submitAvailabilityRequest=function(){const n=(state.userBookings||[]).length;_sar.apply(this,arguments);if((state.userBookings||[]).length>n){const b=state.userBookings[0],u=state.loggedInUser||{};b.guestName=state.profileDisplayName||u.username||'Guest';b.guestEmail=u.email||'';b.guestKey=String(u.email||u.username||'').toLowerCase();b.guestPhone=state.profilePhone?'+91'+state.profilePhone.replace(/\D/g,''):'';persistState();syncBk()}};

/* ═══════════ OPERATOR PORTAL ═══════════ */
const ST={id:null,tab:'overview',filter:'pending',boat:0};
const bd=()=>{const d=od(ST.id);return ST.boat>0&&d.extra&&d.extra[ST.boat-1]?d.extra[ST.boat-1]:d};
const bpr=(d,s)=>d.over[s]!=null?d.over[s]:(isWE(s)?d.weekend:d.base);
const fleetBoats=id=>{const d=od(id);return [{i:0,name:d.bname||'Houseboat 01',d}].concat((d.extra||[]).map((x,k)=>({i:k+1,name:x.name,d:x})))};
const boatHdr=()=>{const b=fleetBoats(ST.id)[ST.boat]||fleetBoats(ST.id)[0];return `<div class="flex items-center gap-3 mb-4"><button onclick="OP.tab('fleet')" class="w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-arrow-left text-gray-600 text-xs"></i></button><div class="min-w-0"><p class="adth">Managing boat</p><p class="font-body font-bold text-sm text-ink truncate">${E(opById(ST.id).name)} · ${E(b.name)}</p></div></div>`};
const kpi=(l,v,s,c)=>`<div class="xcard p-4"><p class="adth">${l}</p><p class="font-body font-bold text-2xl mt-1" style="color:${c||'#1a1a18'}">${v}</p><p class="text-[11px] text-gray-400 font-body">${s}</p></div>`;
const empty=(i,t,s)=>`<div class="text-center py-12"><div class="w-14 h-14 mx-auto rounded-3xl bg-emerald-mist flex items-center justify-center mb-3"><i class="fa-solid ${i} text-emerald text-xl"></i></div><p class="font-display text-xl text-ink">${t}</p><p class="text-gray-400 text-xs font-body mt-1 max-w-[240px] mx-auto">${s}</p></div>`;
const OP={
 render(){const o=opById(ST.id);if(!o)return;const v=$('view-agent');v.style.paddingBottom='120px';
  v.innerHTML=`<div class="bg-emerald px-5 pt-12 pb-5 relative overflow-hidden"><div class="absolute inset-0 opacity-10"><svg viewBox="0 0 480 140" class="w-full h-full" preserveAspectRatio="xMidYMid slice"><circle cx="380" cy="-20" r="100" fill="none" stroke="white" stroke-width="1.5"/><path d="M0 100 Q240 70 480 100" fill="none" stroke="white"/></svg></div>
  <div class="relative z-10 flex items-center justify-between gap-3"><div class="min-w-0"><p class="text-white/60 text-[10px] font-body tracking-widest uppercase">Fleet Management</p><h2 class="text-white font-display text-2xl font-light leading-tight truncate">${E(o.name)}</h2><p class="text-gold-light text-xs font-body mt-0.5">@${E(o.user)} · ${E(o.loc)}</p></div>
  <button onclick="OP.logout()" class="w-10 h-10 rounded-2xl bg-white/15 flex items-center justify-center flex-shrink-0" title="Back to Admin"><i class="fa-solid fa-arrow-left text-white text-sm"></i></button></div></div><div id="op-body" class="px-4 py-5"></div>`;
  this.body()},
 tab(t){ST.tab=t;if(t==='fleet')ST.boat=0;this.body();window.scrollTo(0,0)},
 bks(){return opBk(ST.id)},
 body(){const el=$('op-body');if(!el||!ST.id)return;
  document.querySelectorAll('#op-nav .nav-item').forEach(b=>b.classList.toggle('active-nav',b.dataset.t===(ST.tab==='pricing'?'fleet':ST.tab)));
  el.innerHTML=({overview:this.ov,enquiries:this.enq,fleet:this.fleet,pricing:this.pricing,profile:this.profile})[ST.tab].call(this)},
 ov(){const o=opById(ST.id),bk=this.bks(),n=k=>bk.filter(b=>key(b)===k).length,t=iso(today()),d=od(o.id);
  const rev=bk.filter(b=>['confirmed','completed'].includes(b.st)).reduce((s,b)=>s+amt(b),0);
  const up=bk.filter(b=>b.st==='confirmed'&&b.checkIn>=t).sort((a,b)=>a.checkIn.localeCompare(b.checkIn));
  const need=bk.filter(b=>b.st==='pending'&&b.quoteStatus!=='quoted');
  return `<div class="grid grid-cols-2 gap-3 mb-4">${kpi('New enquiries',need.length,'awaiting your quote','#c9a84c')}${kpi('Confirmed trips',n('confirmed'),up.length+' upcoming','#0d4f3c')}${kpi('Revenue',inr(rev),'confirmed + completed')}${kpi('Rating',o.rating+' ★',o.reviews+' reviews','#8b5cf6')}</div>
  <div class="xcard p-4 mb-4"><div class="flex items-center justify-between mb-2"><p class="font-body font-semibold text-sm text-ink">Tonight's rates</p><button onclick="OP.tab('fleet')" class="text-emerald text-xs font-semibold font-body">Fleet →</button></div>
  <div class="grid grid-cols-3 gap-2 text-center"><div class="bg-emerald-mist rounded-xl py-2"><p class="adth">Tonight</p><p class="font-bold text-sm font-body">${inr(priceFor(o.id,t))}</p></div><div class="bg-gray-50 rounded-xl py-2"><p class="adth">Weekday</p><p class="font-bold text-sm font-body">${inr(d.base)}</p></div><div class="bg-gold-pale rounded-xl py-2"><p class="adth">Weekend</p><p class="font-bold text-sm font-body">${inr(d.weekend)}</p></div></div></div>
  <div class="xcard p-4 mb-4"><div class="flex items-center justify-between mb-3"><p class="font-body font-semibold text-sm text-ink">Needs your response</p><span class="xchip s-pending">${need.length}</span></div>
  ${need.length?need.slice(0,3).map(b=>this.mini(b)).join(''):'<p class="text-xs text-gray-400 font-body">All enquiries are answered. 🎉</p>'}
  ${need.length?`<button onclick="ST_F('pending')" class="w-full mt-2 text-emerald text-xs font-semibold font-body py-2 rounded-xl hover:bg-emerald-mist">View all enquiries →</button>`:''}</div>
  <div class="xcard p-4"><p class="font-body font-semibold text-sm text-ink mb-3">Upcoming guests</p>${up.length?up.slice(0,4).map(b=>this.mini(b)).join(''):'<p class="text-xs text-gray-400 font-body">No confirmed upcoming trips yet.</p>'}</div>`},
 mini(b){return `<div onclick="OP.open('${b.id}')" class="flex items-center gap-3 py-2 cursor-pointer booking-row rounded-xl px-1"><div class="w-9 h-9 rounded-xl bg-emerald-mist flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-user text-emerald text-xs"></i></div><div class="flex-1 min-w-0"><p class="font-body font-semibold text-xs text-ink truncate">${E(b.guestName||'Guest')} · #${E(b.reference)}</p><p class="text-[11px] text-gray-400 font-body">${formatDate(b.checkIn)} · ${E(b.guestStr||'')}</p></div>${chip(b)}</div>`},
 enq(){const bk=this.bks(),f=ST.filter,defs=[['pending','New'],['quoted','Quoted'],['qdeclined','Quote declined'],['confirmed','Confirmed'],['completed','Done'],['declined','Declined']];
  const tabs=`<div class="flex gap-1.5 overflow-x-auto pb-3" style="scrollbar-width:none">${defs.map(([k,l])=>{const c=bk.filter(b=>key(b)===k).length,on=k===f;return `<button onclick="ST_F('${k}')" class="flex-shrink-0 xchip ${on?'':''}" style="padding:7px 13px;${on?'background:#0d4f3c;color:#fff':'background:#fff;color:#64748b;border:1px solid #e5e7eb'}">${l} · ${c}</button>`}).join('')}</div>`;
  const list=bk.filter(b=>key(b)===f);
  return tabs+(list.length?list.map(b=>this.card(b)).join(''):empty('fa-inbox','Nothing here','Guest requests for '+E(opById(ST.id).name)+' appear in this list.'))},
 card(b){const q=amt(b);return `<div class="xcard mb-3 overflow-hidden"><div onclick="OP.open('${b.id}')" class="p-4 cursor-pointer"><div class="flex items-start justify-between gap-2 mb-2"><div class="min-w-0"><p class="font-body font-bold text-sm text-ink truncate">${E(b.guestName||'Guest')}</p><p class="text-[11px] text-gray-400 font-mono">#${E(b.reference)}</p></div>${chip(b)}</div>
  <div class="grid grid-cols-3 gap-2 text-[11px] font-body"><div><p class="adth">Check-in</p><p class="font-semibold text-ink">${formatDate(b.checkIn)}</p></div><div><p class="adth">Nights</p><p class="font-semibold text-ink">${b.nights||1}</p></div><div><p class="adth">${q?'Quote':'Estimate'}</p><p class="font-semibold text-emerald">${inr(q||b.estimate||0)}</p></div></div>
  <p class="text-[11px] text-gray-500 font-body mt-2"><i class="fa-solid fa-route text-emerald mr-1"></i>${E(b.route)} · ${E(b.guestStr||'')}</p></div>
  <div class="px-4 pb-4 flex gap-2">${b.st==='pending'?`<button onclick="OP.open('${b.id}')" class="xbtn xbtn-em flex-1">Review &amp; respond</button>`:b.st==='confirmed'?`<button onclick="OP.open('${b.id}')" class="xbtn xbtn-out flex-1">Details</button><button onclick="OP.setStatus('${b.id}','completed')" class="xbtn xbtn-em flex-1">Mark completed</button>`:`<button onclick="OP.open('${b.id}')" class="xbtn xbtn-out flex-1">View details</button>`}</div></div>`},
  open(id){const b=allBk().find(x=>x.id===id);if(!b)return;const o=opByName(b.propertyName);if(!o)return;const d=od(o.id);
  const dts=Array.from({length:b.nights||1},(_,i)=>addDaysISO(b.checkIn,i)),cruiseCfg=AD_S.cruisePricing||{dayPercent:70,overnightPercent:100},cruiseRate=(b.cruiseType==='day'?Number(cruiseCfg.dayPercent)||70:Number(cruiseCfg.overnightPercent)||100)/100,sum=Math.round(dts.reduce((s,x)=>s+priceFor(o.id,x),0)*cruiseRate),bl=dts.filter(x=>d.blocked[x]);
  const row=(l,v)=>`<div class="flex justify-between gap-3 py-1.5 text-xs font-body border-b border-gray-100 last:border-0"><span class="text-gray-400">${l}</span><span class="font-semibold text-ink text-right">${v}</span></div>`;
  const ph=b.guestPhone?E(b.guestPhone):'';
  let act='';
  if(b.st==='pending'){const pre=amt(b)||sum;act=`<label class="xlbl mt-4">Final agreed price (₹, all-inclusive)</label><input id="x-quote" type="number" min="1" class="xin" value="${pre}"/>
   ${bl.length?`<p class="text-[11px] text-red-500 font-body mt-1"><i class="fa-solid fa-triangle-exclamation"></i> ${bl.length} night(s) are blocked in your calendar.</p>`:''}
   <div class="grid gap-2 mt-3" style="grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr)"><button onclick="OP.quote('${b.id}',true)" class="xbtn xbtn-gold">Confirm booking</button><button onclick="OP.decline('${b.id}')" class="xbtn xbtn-red">Decline</button></div>`}
  else if(b.st==='confirmed')act=`<div class="grid grid-cols-2 gap-2 mt-4"><button onclick="OP.setStatus('${b.id}','completed')" class="xbtn xbtn-em">Mark completed</button><button onclick="OP.decline('${b.id}')" class="xbtn xbtn-red">Cancel booking</button></div>`;
  else if(b.st==='declined')act=`<button onclick="OP.setStatus('${b.id}','pending')" class="xbtn xbtn-out w-full mt-4">Reopen as new enquiry</button>`;
  sheet(`<div class="flex items-start justify-between mb-3"><div><h3 class="font-display text-2xl text-ink leading-tight">Booking <em>#${E(b.reference)}</em></h3><div class="mt-1">${chip(b)}</div></div><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div>
  <div class="xcard p-4 mb-3" style="background:#e8f2ee"><p class="adth mb-1">Operator / Agent</p><p class="font-body font-bold text-sm text-ink">${E(o.name)}</p><p class="text-xs font-body text-emerald font-semibold">Username: @${E(o.user)}</p><p class="text-[11px] text-gray-500 font-body">${E(o.loc)}</p></div>
  <div class="xcard p-4 mb-3"><p class="adth mb-1">Guest</p>${row('Name',E(b.guestName||'Guest'))}${b.guestEmail?row('Email',E(b.guestEmail)):''}${ph?row('Phone',ph):''}${row('Party',E(b.guestStr||b.guestsLabel||''))}
  ${ph?`<div class="flex gap-2 mt-2"><a href="tel:${ph}" class="xbtn xbtn-out flex-1 text-center"><i class="fa-solid fa-phone mr-1"></i>Call</a><a target="_blank" href="https://wa.me/${ph.replace(/\D/g,'')}" class="xbtn xbtn-em flex-1 text-center"><i class="fa-brands fa-whatsapp mr-1"></i>WhatsApp</a></div>`:''}</div>
  <div class="xcard p-4 mb-3"><p class="adth mb-1">Trip</p>${row('Check-in',formatDate(b.checkIn))}${row('Check-out',formatDate(b.checkOut))}${row('Nights',b.nights||1)}${row('Route',E(b.route))}${row('Boarding',E(b.boarding))}${row('Requested',b.createdAt?formatDate(b.createdAt.slice(0,10)):'—')}</div>
  <div class="xcard p-4"><p class="adth mb-1">Your rates for these nights</p><div style="max-height:120px;overflow-y:auto">${dts.map(x=>row(formatDate(x)+(isWE(x)?' · weekend':'')+(d.blocked[x]?' · blocked':''),inr(priceFor(o.id,x)))).join('')}</div>${row('Subtotal',inr(sum))}${row('Suggested total','<b>'+inr(sum)+'</b>')}${amt(b)?row('Quoted to guest','<b class="text-emerald">'+inr(amt(b))+'</b>'):''}</div>${act}`)},
  async quote(id,now){const v=Math.round(Number($('x-quote').value));if(!v||v<1)return toast('Enter the final agreed price',true);
  const b=allBk().find(x=>x.id===id),o=opByName(b.propertyName),bl=Array.from({length:b.nights||1},(_,i)=>addDaysISO(b.checkIn,i)).filter(x=>od(o.id).blocked[x]);
  if(bl.length&&!confirm('Some nights are blocked in your calendar. Continue?'))return;
  if(window.nkAdminUpdateBooking){const result=await window.nkAdminUpdateBooking(id,{status:now?'confirmed':'pending',price:v,total:v});if(result?.error)return toast(result.error.message||'Could not update the booking',true)}
  else mutate(id,r=>{r.price=inr(v);r.quoteStatus=now?'accepted':'quoted';r.status=now?'confirmed':'pending'});
  closeSheet();ST.filter=now?'confirmed':'quoted';toast(now?'Booking confirmed':'Final price sent to guest');refresh()},
  async decline(id){if(!confirm('Decline this booking?'))return;if(window.nkAdminUpdateBooking){const result=await window.nkAdminUpdateBooking(id,{status:'declined'});if(result?.error)return toast(result.error.message||'Could not decline the booking',true)}else mutate(id,r=>{r.status='declined'});closeSheet();ST.filter='declined';toast('Booking declined');refresh()},
  async setStatus(id,s){if(window.nkAdminUpdateBooking){const result=await window.nkAdminUpdateBooking(id,{status:s});if(result?.error)return toast(result.error.message||'Could not update the booking',true)}else mutate(id,r=>{r.status=s;if(s==='pending')r.quoteStatus='awaiting'});closeSheet();toast('Status updated');refresh()},
 /* pricing */
 pricing(){const o=opById(ST.id),d=bd(),w=winDays(),last=w[89];let html='',cur='',i=0;
  w.forEach(s=>{const dt=parse(s),m=dt.getFullYear()*12+dt.getMonth();if(m!==cur){if(cur!=='')html+='</div>';cur=m;html+=`<p class="font-body font-semibold text-sm text-ink mt-4 mb-2">${dt.toLocaleDateString('en-IN',{month:'long',year:'numeric'})}</p><div class="grid grid-cols-7 gap-1 mb-1">${'SMTWTFS'.split('').map(x=>`<p class="adth text-center">${x}</p>`).join('')}</div><div class="grid grid-cols-7 gap-1">`+'<div class="cal off"></div>'.repeat(dt.getDay())}
   const p=bpr(d,s),bl=d.blocked[s],ov=d.over[s]!=null;
   html+=`<button onclick="OP.day('${s}')" class="cal ${isWE(s)?'we':''} ${ov?'ov':''} ${bl?'bl':''}"><b>${dt.getDate()}</b><i>${bl?'blocked':short(p)}</i></button>`});
  html+='</div>';
  return boatHdr()+`<div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-1">Default nightly rates</p><p class="text-[11px] text-gray-400 font-body mb-3">Weekend = Friday &amp; Saturday nights.</p><div class="grid grid-cols-2 gap-3"><div><label class="xlbl">Weekday ₹</label><input id="x-base" type="number" class="xin" value="${d.base}"/></div><div><label class="xlbl">Weekend ₹</label><input id="x-we" type="number" class="xin" value="${d.weekend}"/></div></div><button onclick="OP.saveRates()" class="xbtn xbtn-em w-full mt-3">Save rates</button></div>
  <div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-3">Set price for a date range</p><div class="grid grid-cols-2 gap-3"><div><label class="xlbl">From</label><input id="x-from" type="text" readonly class="xin" min="${w[0]}" max="${last}" placeholder="Select date" onclick="showAdminDateCalendar('x-from')"/></div><div><label class="xlbl">To</label><input id="x-to" type="text" readonly class="xin" min="${w[0]}" max="${last}" placeholder="Select date" onclick="showAdminDateCalendar('x-to')"/></div></div><label class="xlbl mt-3">Price per night ₹</label><input id="x-rp" type="number" class="xin" placeholder="e.g. 18000"/><div class="grid grid-cols-2 gap-2 mt-3"><button onclick="OP.range(false)" class="xbtn xbtn-em">Apply price</button><button onclick="OP.range(true)" class="xbtn xbtn-out">Block dates</button></div></div>
  <div class="xcard p-4"><div class="flex items-center justify-between"><div><p class="font-body font-semibold text-sm text-ink">90-day calendar</p><p class="text-[11px] text-gray-400 font-body">Editable until ${formatDate(last)} · tap a date</p></div><button onclick="OP.clearOver()" class="xbtn xbtn-red" style="padding:.45rem .7rem">Reset</button></div>
  <div class="flex gap-3 text-[10px] font-body text-gray-500 mt-2"><span><span class="inline-block w-2.5 h-2.5 rounded bg-gold-pale border" style="border-color:#efdca4"></span> Weekend</span><span><span class="inline-block w-2.5 h-2.5 rounded border-2 border-emerald"></span> Custom</span><span><span class="inline-block w-2.5 h-2.5 rounded bg-gray-200"></span> Blocked</span></div>${html}</div>`},
 saveRates(){const b=Math.round(Number($('x-base').value)),w=Math.round(Number($('x-we').value));if(!(b>0&&w>0))return toast('Enter valid rates',true);const d=bd();d.base=b;d.weekend=w;saveDB();toast('Rates saved');this.body()},
 day(s){const o=opById(ST.id),d=bd();sheet(`<div class="flex items-center justify-between mb-4"><h3 class="font-display text-2xl text-ink">${parse(s).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'short'})}</h3><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div>
  <p class="text-[11px] text-gray-400 font-body mb-3">${isWE(s)?'Weekend night':'Weekday night'} · default ${inr(isWE(s)?d.weekend:d.base)}</p><label class="xlbl">Price for this night ₹</label><input id="x-dp" type="number" class="xin" value="${bpr(d,s)}"/>
  <label class="flex items-center gap-2 mt-3 text-sm font-body text-ink"><input id="x-db" type="checkbox" ${d.blocked[s]?'checked':''} style="width:18px;height:18px;accent-color:#0d4f3c"/> Block this date (not available)</label>
  <div class="grid grid-cols-2 gap-2 mt-4"><button onclick="OP.saveDay('${s}')" class="xbtn xbtn-em">Save</button><button onclick="OP.resetDay('${s}')" class="xbtn xbtn-out">Reset to default</button></div>`)},
 saveDay(s){if(!inWin(s))return toast('Only the next 90 days can be edited',true);const p=Math.round(Number($('x-dp').value));if(!(p>0))return toast('Enter a valid price',true);const d=bd(),def=isWE(s)?d.weekend:d.base;if(p===def)delete d.over[s];else d.over[s]=p;if($('x-db').checked)d.blocked[s]=true;else delete d.blocked[s];saveDB();closeSheet();toast('Date updated');this.body()},
 resetDay(s){const d=bd();delete d.over[s];delete d.blocked[s];saveDB();closeSheet();toast('Reset to default');this.body()},
 range(block){const f=$('x-from').value,t=$('x-to').value,p=Math.round(Number($('x-rp').value));if(!f||!t||f>t)return toast('Choose a valid date range',true);if(!inWin(f)||!inWin(t))return toast('Dates must be within the next 90 days',true);if(!block&&!(p>0))return toast('Enter a price',true);
  const d=bd();let s=f,n=0;while(s<=t){if(block)d.blocked[s]=true;else{d.over[s]=p;delete d.blocked[s]}s=addDaysISO(s,1);n++}saveDB();toast(n+' date(s) '+(block?'blocked':'updated'));this.body()},
 clearOver(){if(!confirm('Remove all custom prices and blocked dates?'))return;const d=bd();d.over={};d.blocked={};saveDB();toast('Calendar reset');this.body()},
 /* profile */
 profile(){const o=opById(ST.id),d=od(o.id),p=d.prof;return `<div class="xcard p-5 text-center mb-4"><div class="w-16 h-16 rounded-3xl mx-auto flex items-center justify-center font-display text-3xl text-gold" style="background:#082e23">${E(o.name[0])}</div><h3 class="font-display text-xl text-ink mt-3 leading-tight">${E(o.name)}</h3><p class="text-emerald text-xs font-semibold font-body">@${E(o.user)}</p><p class="text-gray-400 text-[11px] font-body">${E(o.loc)}</p></div>
  <div class="xcard p-4 mb-4 space-y-3"><p class="font-body font-semibold text-sm text-ink">Business profile</p><div><label class="xlbl">Contact person</label><input id="p-c" class="xin" value="${E(p.contact)}" placeholder="Full name"/></div><div><label class="xlbl">Phone</label><input id="p-p" type="tel" class="xin" value="${E(p.phone)}" placeholder="+91 …"/></div><div><label class="xlbl">Email</label><input id="p-e" type="email" class="xin" value="${E(p.email)}" placeholder="you@business.com"/></div><div><label class="xlbl">About the boat</label><textarea id="p-a" rows="3" class="xin" placeholder="Short description">${E(p.about)}</textarea></div><button onclick="OP.saveProfile()" class="xbtn xbtn-em w-full">Save profile</button></div>
  
  <button onclick="OP.logout()" class="w-full py-3.5 rounded-2xl border-2 border-red-200 text-red-500 font-semibold text-sm font-body"><i class="fa-solid fa-arrow-left mr-2"></i>Back to Admin</button>`},
 saveProfile(){const d=od(ST.id);d.prof={contact:$('p-c').value.trim(),phone:$('p-p').value.trim(),email:$('p-e').value.trim(),about:$('p-a').value.trim()};saveDB();toast('Profile saved')},
 savePw(){toast('Operator passwords are managed by Supabase Auth.',true)},
 logout(){ST.id=null;showView('admin');AD.go('operators')}
};
window.ST_F=f=>{ST.filter=f;ST.tab='enquiries';OP.body()};
Object.assign(OP,{
 fleet(){const o=opById(ST.id),d=od(o.id),L=fleetBoats(o.id);
  return `<div class="mb-3"><p class="font-display text-2xl text-ink leading-tight">Fleet</p><p class="text-[11px] text-gray-400 font-body">${L.length} boat${L.length>1?'s':''} · each boat has its own rates and calendar</p></div>`+
  L.map(b=>`<div class="xcard p-4 mb-3"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><p class="font-body font-bold text-sm text-ink truncate">${E(b.name)}</p><p class="text-[11px] text-gray-400 font-body">${Object.keys(b.d.over).length} custom dates · ${Object.keys(b.d.blocked).length} blocked</p></div>${b.i?`<button onclick="OP.rmBoat(${b.i})" class="xchip s-declined">Remove</button>`:''}</div><div class="grid grid-cols-2 gap-2 mt-3 text-center"><div class="bg-gray-50 rounded-xl py-2"><p class="adth">Weekday</p><p class="font-bold text-sm font-body">${inr(b.d.base)}</p></div><div class="bg-gold-pale rounded-xl py-2"><p class="adth">Weekend</p><p class="font-bold text-sm font-body">${inr(b.d.weekend)}</p></div></div><button onclick="OP.manageBoat(${b.i})" class="xbtn xbtn-em w-full mt-3">Manage pricing &amp; dates</button></div>`).join('')+
  `<div class="xcard p-4"><p class="font-body font-semibold text-sm text-ink mb-3">Add a boat</p><label class="xlbl">Boat name</label><input id="fb-n" class="xin mb-3" placeholder="Houseboat 0${L.length+1}"/><div class="grid grid-cols-2 gap-3"><div><label class="xlbl">Weekday ₹</label><input id="fb-b" type="number" class="xin" value="${d.base}"/></div><div><label class="xlbl">Weekend ₹</label><input id="fb-w" type="number" class="xin" value="${d.weekend}"/></div></div><button onclick="OP.addBoat()" class="xbtn xbtn-gold w-full mt-3">Add boat</button></div>`},
 manageBoat(i){ST.boat=i;ST.tab='pricing';this.body();window.scrollTo(0,0)},
 addBoat(){const d=od(ST.id),n=fleetBoats(ST.id).length,nm=($('fb-n').value||'').trim()||('Houseboat 0'+(n+1)),b=Math.round(Number($('fb-b').value)),w=Math.round(Number($('fb-w').value));if(!(b>0&&w>0))return toast('Enter valid rates',true);(d.extra=d.extra||[]).push({name:nm,base:b,weekend:w,over:{},blocked:{}});saveDB();toast('Boat added');this.body()},
 rmBoat(i){if(!confirm('Remove this boat and its pricing?'))return;od(ST.id).extra.splice(i-1,1);ST.boat=0;saveDB();toast('Boat removed');this.body()}
});
window.OP=OP;

/* Use the same calendar language in the operator/admin date-range controls. */
let _adminCalendarTarget='';
let _adminCalendarPreviousOverflow='';
function ensureAdminCalendar(){
  if(document.getElementById('nk-admin-calendar-backdrop'))return;
  document.body.insertAdjacentHTML('beforeend','<div id="nk-admin-calendar-backdrop" onclick="closeAdminDateCalendar()" aria-hidden="true"></div><div id="nk-admin-calendar-pop" role="dialog" aria-label="Select date"><div class="nk-cal-summary"><div class="nk-cal-summary-copy"><strong id="nk-admin-cal-summary-day">—</strong><span id="nk-admin-cal-summary-month">Select a date</span></div><div class="nk-cal-icon"><i class="fa-regular fa-calendar"></i></div></div><div class="nk-cal-head"><button type="button" class="nk-cal-nav" onclick="adminCalendarMonth(-1)"><i class="fa-solid fa-chevron-left"></i></button><p id="nk-admin-cal-month" class="nk-cal-month"></p><button type="button" class="nk-cal-nav" onclick="adminCalendarMonth(1)"><i class="fa-solid fa-chevron-right"></i></button></div><div class="nk-cal-week"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div><div id="nk-admin-cal-grid" class="nk-cal-grid"></div><p class="nk-cal-note">Choose a date for this pricing rule</p></div>');
}
function adminCalendarISO(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function adminTodayISO(){return adminCalendarISO(new Date())}
function adminDateLabel(iso){const [y,m,d]=String(iso).split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}
function paintAdminCalendar(){
  const d=window.nkAdminCalDate,grid=document.getElementById('nk-admin-cal-grid'),month=document.getElementById('nk-admin-cal-month');
  if(!d||!grid||!month)return;
  const input=document.getElementById(_adminCalendarTarget),min=input?.getAttribute('min')||adminTodayISO(),max=input?.getAttribute('max')||'';
  const y=d.getFullYear(),m=d.getMonth(),first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate(),selected=input?.value||'';
  month.textContent=d.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  let html='';
  for(let i=0;i<first;i++)html+='<span class="nk-cal-empty" aria-hidden="true"></span>';
  for(let day=1;day<=days;day++){
    const date=new Date(y,m,day),iso=adminCalendarISO(date),past=iso<min,after=max&&iso>max,disabled=past||after;
    const classes='nk-cal-day'+(iso===adminTodayISO()?' today':'')+(iso===selected?' selected':'')+(disabled?' disabled':'');
    html+='<button type="button" class="'+classes+'" '+(disabled?'disabled ':'')+'onclick="pickAdminDate(\''+iso+'\')">'+day+'</button>';
  }
  grid.innerHTML=html;
  const summaryDay=document.getElementById('nk-admin-cal-summary-day'),summaryMonth=document.getElementById('nk-admin-cal-summary-month');
  if(selected){const sd=new Date(selected+'T00:00:00');if(!Number.isNaN(sd.getTime())){summaryDay.textContent=String(sd.getDate());summaryMonth.textContent=sd.toLocaleDateString('en-US',{month:'long',year:'numeric'})}}else{summaryDay.textContent='—';summaryMonth.textContent='Select a date'}
}
function showAdminDateCalendar(id){
  const input=document.getElementById(id);if(!input)return;
  _adminCalendarTarget=id;ensureAdminCalendar();
  const base=input.value||input.getAttribute('min')||adminTodayISO(),parsed=new Date(base+'T00:00:00');
  window.nkAdminCalDate=Number.isNaN(parsed.getTime())?new Date():parsed;window.nkAdminCalDate.setDate(1);
  const pop=document.getElementById('nk-admin-calendar-pop');
  if(!pop.classList.contains('open'))_adminCalendarPreviousOverflow=document.body.style.overflow||'';
  document.body.style.overflow='hidden';
  pop.classList.add('open');document.getElementById('nk-admin-calendar-backdrop')?.classList.add('open');paintAdminCalendar();
}
function adminCalendarMonth(n){if(!window.nkAdminCalDate)return;window.nkAdminCalDate.setMonth(window.nkAdminCalDate.getMonth()+n);paintAdminCalendar()}
function pickAdminDate(iso){const input=document.getElementById(_adminCalendarTarget);if(!input)return;input.value=iso;input.dataset.display=adminDateLabel(iso);input.style.color='#1a1a18';closeAdminDateCalendar()}
function closeAdminDateCalendar(){const pop=document.getElementById('nk-admin-calendar-pop');const wasOpen=pop?.classList.contains('open');pop?.classList.remove('open');document.getElementById('nk-admin-calendar-backdrop')?.classList.remove('open');if(wasOpen){document.body.style.overflow=_adminCalendarPreviousOverflow;_adminCalendarPreviousOverflow=''}}
window.showAdminDateCalendar=showAdminDateCalendar;window.adminCalendarMonth=adminCalendarMonth;window.pickAdminDate=pickAdminDate;window.closeAdminDateCalendar=closeAdminDateCalendar;

/* Full listing manager inside the original fleet portal. */
const _originalFleetView=OP.fleet;
OP.fleet=function(){
  const listing=(window.__nkFleetListings||{})[String(ST.id)]||{};
  const amenities=Array.isArray(listing.amenities)?listing.amenities.map(item=>typeof item==='string'?item:item.label).filter(Boolean).join(', '):'';
  const gallery=Array.isArray(listing.gallery)?listing.gallery.join(', '):'';
  const field=(id,label,value,type='text',extra='')=>`<div><label class="xlbl">${label}</label><input id="${id}" type="${type}" class="xin" value="${E(value??'')}" ${extra}/></div>`;
  return `<div class="xcard p-4 mb-4"><div class="flex items-start justify-between gap-3 mb-4"><div><p class="font-display text-2xl text-ink leading-tight">Manage listing</p><p class="text-[11px] text-gray-400 font-body mt-1">Edit the live houseboat details guests see in the booking app.</p></div><span class="xchip ${listing.status==='active'?'s-active':'s-pending'}">${listing.status==='active'?'Live':'Draft'}</span></div>
    ${listing.image?`<img src="${E(listing.image)}" alt="" class="w-full h-36 object-cover rounded-2xl mb-4"/>`:''}
    <div class="grid grid-cols-1 gap-3">${field('fleet-title','Listing title',listing.title)}${field('fleet-subtitle','Short subtitle',listing.subtitle)}<div class="grid grid-cols-2 gap-3">${field('fleet-bedrooms','Bedrooms',listing.bedrooms,'number','min="1"')}${field('fleet-category','Category',listing.category)}</div>${field('fleet-location','Location',listing.location)}<div class="grid grid-cols-2 gap-3">${field('fleet-price','Base price ₹',listing.price,'number','min="1"')}${field('fleet-day-price','Day cruise ₹',listing.dayPrice,'number','min="0"')}</div>${field('fleet-overnight-price','Overnight price ₹',listing.overnightPrice,'number','min="0"')}<div><label class="xlbl">Main image URL</label><input id="fleet-image" type="url" class="xin" value="${E(listing.image||'')}" placeholder="https://…"/></div><div><label class="xlbl">Gallery image URLs</label><textarea id="fleet-gallery" rows="3" class="xin" placeholder="Paste one URL per comma">${E(gallery)}</textarea></div><div><label class="xlbl">Description</label><textarea id="fleet-description" rows="6" class="xin" placeholder="Describe the houseboat, route and experience">${E(listing.description||'')}</textarea></div><div><label class="xlbl">Amenities &amp; inclusions</label><textarea id="fleet-amenities" rows="3" class="xin" placeholder="AC, private deck, meals, Wi-Fi">${E(amenities)}</textarea></div></div>
    <button onclick="OP.saveFleetListing()" class="xbtn xbtn-em w-full mt-4"><i class="fa-solid fa-floppy-disk mr-1.5"></i>Save live listing</button></div>
    <details class="xcard p-4 mb-4"><summary class="font-body font-semibold text-sm text-ink cursor-pointer">Pricing calendar &amp; additional boats</summary><div class="mt-3">${_originalFleetView.call(this)}</div></details>`;
};
OP.saveFleetListing=async function(){
  const id=ST.id,listing=(window.__nkFleetListings||{})[String(id)]||{};
  const title=$('fleet-title')?.value.trim(),location=$('fleet-location')?.value.trim(),price=Math.round(Number($('fleet-price')?.value));
  if(!title||!location||!price)return toast('Title, location and base price are required',true);
  const amenities=($('fleet-amenities')?.value||'').split(',').map(label=>label.trim()).filter(Boolean).map(label=>({icon:'fa-check',label}));
  const gallery=($('fleet-gallery')?.value||'').split(',').map(url=>url.trim()).filter(Boolean);
  if(!window.nkSaveFleetListing)return toast('Fleet manager is still connecting to Supabase',true);
  const result=await window.nkSaveFleetListing(id,{title,subtitle:$('fleet-subtitle')?.value.trim()||'',bedrooms:Math.max(1,Number($('fleet-bedrooms')?.value)||1),category:listing.category||'houseboat',location,price,day_price:Number($('fleet-day-price')?.value)||null,overnight_price:Number($('fleet-overnight-price')?.value)||null,image:$('fleet-image')?.value.trim()||'',gallery,description:$('fleet-description')?.value.trim()||'',amenities});
  if(result?.error)return toast(result.error.message||'Could not save the listing',true);
  toast('Live listing updated');this.body();
};

/* ═══════════ ADMIN CONSOLE ═══════════ */
const AD={t:'overview',q:'',bq:'',bf:'all',
 go(t,keep){this.t=t;const v=$('view-admin');if(!$('ad-body')){v.style.paddingBottom='40px';v.innerHTML=`<div style="background:linear-gradient(135deg,#040f0a,#082e23 70%,#0d4f3c)" class="px-5 pt-12 pb-5"><div class="flex items-center justify-between"><div><img src="${_nkLogo?_nkLogo.data:'https://res.cloudinary.com/dxmuistk4/image/upload/v1791565882/nauka-logo-new_parqic.png'}" alt="Nauka" class="nk-logo nk-logo-white${_nkLogo?' nk-ready':''}" style="height:32px;" /><p class="text-white/50 text-[10px] font-body tracking-widest uppercase mt-2">Control Centre</p><h2 class="text-white font-display text-2xl font-light mt-0.5">Administration</h2></div><button onclick="adminLogOut()" class="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center" title="Sign out"><i class="fa-solid fa-right-from-bracket text-white/80 text-sm"></i></button></div></div>
   <div class="flex gap-2 overflow-x-auto px-4 py-3 sticky z-50" style="top:0;background:#f3f5f4;scrollbar-width:none">${[['overview','Overview'],['operators','Properties / Fleets'],['bookings','Bookings'],['revenue','Revenue'],['settings','Settings']].map(([k,l])=>`<button id="adt-${k}" onclick="AD.go('${k}')" class="adtab">${l}</button>`).join('')}</div><div id="ad-body" class="px-4 pb-6"></div>`}
  ['overview','applications','operators','bookings','revenue','settings'].forEach(k=>{const b=$('adt-'+k);if(b)b.classList.toggle('on',k===t)});
  $('ad-body').innerHTML=this[t]();if(!keep)window.scrollTo(0,0)},
 stats(){const bk=allBk(),rev=o=>bk.filter(b=>b.propertyName===o.name&&['confirmed','completed'].includes(b.st)).reduce((s,b)=>s+amt(b),0);return{bk,gross:bk.filter(b=>['confirmed','completed'].includes(b.st)).reduce((s,b)=>s+amt(b),0),rev}},
 overview(){const{bk,gross,rev}=this.stats(),cm=Math.round(gross*AD_S.commission/100),n=k=>bk.filter(b=>key(b)===k).length,susp=OPS.filter(o=>AD_S.suspended[o.id]).length;
  const fun=['pending','quoted','qdeclined','confirmed','completed','declined'],mx=Math.max(1,...fun.map(n)),col={qdeclined:'#f97316',pending:'#f59e0b',quoted:'#0ea5e9',confirmed:'#0d4f3c',completed:'#6b7280',declined:'#ef4444'};
  const top=OPS.map(o=>({o,r:rev(o)})).sort((a,b)=>b.r-a.r).slice(0,5),tm=Math.max(1,top[0]?.r || 1);
  return `<div class="grid grid-cols-2 gap-3 mb-4">${kpi('Operators',OPS.length-susp+' / '+OPS.length,'active / total','#0d4f3c')}${kpi('Enquiries',bk.length,n('pending')+' awaiting quote','#c9a84c')}${kpi('Gross bookings',inr(gross),'confirmed + completed')}${kpi('Commission',inr(cm),AD_S.commission+'% platform fee','#8b5cf6')}</div>
  <div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-3">Booking pipeline</p>${fun.map(k=>`<div class="flex items-center gap-3 mb-2"><p class="text-[11px] font-body text-gray-500 w-20">${LAB[k]}</p><div class="flex-1 h-2 rounded-full bg-gray-100"><div class="h-2 rounded-full" style="width:${n(k)/mx*100}%;background:${col[k]}"></div></div><p class="text-xs font-bold font-body w-6 text-right">${n(k)}</p></div>`).join('')}</div>
  <div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-3">Top operators by revenue</p>${top.map(t=>`<div class="mb-3"><div class="flex justify-between text-xs font-body mb-1"><span class="font-semibold text-ink truncate pr-2">${E(t.o.name)}</span><span class="text-gray-500">${inr(t.r)}</span></div><div class="h-1.5 rounded-full bg-gray-100"><div class="h-1.5 rounded-full bg-gold" style="width:${t.r/tm*100}%"></div></div></div>`).join('')}</div>
  <div class="xcard p-4"><p class="font-body font-semibold text-sm text-ink mb-2">Latest activity</p>${bk.length?bk.sort((a,b)=>(b.updatedAt||b.createdAt||'').localeCompare(a.updatedAt||a.createdAt||'')).slice(0,5).map(b=>this.brow(b)).join(''):'<p class="text-xs text-gray-400 font-body">No bookings have been requested yet.</p>'}</div>`},
 brow(b){const o=opByName(b.propertyName),actions=b.st==='pending'?`<div class="grid gap-2 mt-3" style="grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr)"><button onclick="event.stopPropagation();AD.bk('${b.id}')" class="xbtn xbtn-em">Set price &amp; confirm</button><button onclick="event.stopPropagation();OP.decline('${b.id}')" class="xbtn xbtn-red">Decline</button></div>`:'';return `<div onclick="AD.bk('${b.id}')" class="xrow cursor-pointer"><div class="flex items-center gap-3"><div class="flex-1 min-w-0"><p class="text-xs font-semibold font-body text-ink truncate">${E(b.guestName||'Guest')} · <span class="font-mono text-gray-400">#${E(b.reference)}</span></p><p class="text-[11px] text-gray-400 font-body truncate">${E(b.propertyName)} · @${E(o?o.user:'')} · ${formatDate(b.checkIn)}</p></div><div class="text-right"><p class="text-xs font-bold font-body">${amt(b)?inr(amt(b)):'—'}</p>${chip(b)}</div></div>${actions}</div>`},
 bk(id){OP.open(id)},
 operators(){return `<input class="xin mb-3" placeholder="Search name, username, location…" value="${E(this.q)}" oninput="AD.q=this.value;AD.list()"/><div id="ad-list">${this.listHTML()}</div>`},
 list(){$('ad-list').innerHTML=this.listHTML()},
 listHTML(){const q=this.q.toLowerCase(),{bk}=this.stats();const l=OPS.filter(o=>(o.name+o.user+o.loc).toLowerCase().includes(q));
  return l.length?l.map(o=>{const s=AD_S.suspended[o.id],n=bk.filter(b=>b.propertyName===o.name);return `<div class="xcard p-4 mb-3"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><p class="font-body font-bold text-sm text-ink truncate">${E(o.name)}</p><p class="text-xs text-emerald font-semibold font-body">@${E(o.user)}</p><p class="text-[11px] text-gray-400 font-body">${E(o.loc)} · ${n.length} bookings</p></div><span class="xchip s-${s?'suspended':'active'}">${s?'Suspended':'Active'}</span></div>
  <div class="flex gap-2 mt-3"><button onclick="AD.openFleet(${o.id})" class="xbtn xbtn-em flex-1">Open fleet</button><button onclick="AD.toggle(${o.id})" class="xbtn ${s?'xbtn-em':'xbtn-red'} flex-1">${s?'Activate':'Suspend'}</button></div></div>`}).join(''):empty('fa-magnifying-glass','No operators found','Try a different search.')},
 toggle(id){AD_S.suspended[id]=!AD_S.suspended[id];saveAD();toast(AD_S.suspended[id]?'Operator suspended':'Operator activated');this.go('operators',true)},
 op(id){const o=opById(id),d=od(id),n=opBk(id);sheet(`<div class="flex items-start justify-between mb-3"><div><h3 class="font-display text-2xl text-ink leading-tight">${E(o.name)}</h3><p class="text-emerald text-xs font-semibold font-body">@${E(o.user)}</p></div><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div>
  <div class="grid grid-cols-3 gap-2 mb-3">${[['Weekday',inr(d.base)],['Weekend',inr(d.weekend)],['Bookings',n.length]].map(([l,v])=>`<div class="xcard p-3 text-center"><p class="adth">${l}</p><p class="font-bold text-sm font-body">${v}</p></div>`).join('')}</div>
  <div class="xcard p-4 mb-3 text-xs font-body space-y-1"><p><span class="text-gray-400">Custom-priced dates:</span> <b>${Object.keys(d.over).length}</b> · <span class="text-gray-400">Blocked:</span> <b>${Object.keys(d.blocked).length}</b></p><p><span class="text-gray-400">Contact:</span> <b>${E(d.prof.contact||'—')}</b> · ${E(d.prof.phone||'—')}</p><p><span class="text-gray-400">Email:</span> <b>${E(d.prof.email||'—')}</b></p></div>
  <label class="xlbl">Set new password</label><input id="x-npw" class="xin" placeholder="Min 6 characters"/><div class="grid grid-cols-2 gap-2 mt-3"><button onclick="AD.setPw(${id})" class="xbtn xbtn-em">Save password</button><button onclick="AD.resetPw(${id})" class="xbtn xbtn-out">Reset to default</button></div>`)},
 setPw(){toast('Operator passwords are managed by Supabase Auth.',true)},
 resetPw(){toast('Operator passwords are managed by Supabase Auth.',true)},
 bookings(){return `<input class="xin mb-2" placeholder="Search reference, guest, operator…" value="${E(this.bq)}" oninput="AD.bq=this.value;AD.blist()"/><select class="xin mb-3" onchange="AD.bf=this.value;AD.blist()">${[['all','All statuses'],...Object.entries(LAB)].map(([k,l])=>`<option value="${k}" ${this.bf===k?'selected':''}>${l}</option>`).join('')}</select><div id="ad-blist">${this.blistHTML()}</div>`},
 blist(){$('ad-blist').innerHTML=this.blistHTML()},
 blistHTML(){const q=this.bq.toLowerCase(),l=allBk().filter(b=>(this.bf==='all'||key(b)===this.bf)&&((b.reference||'')+(b.guestName||'')+b.propertyName).toLowerCase().includes(q)).sort((a,b)=>(b.createdAt||'').localeCompare(a.createdAt||''));return l.length?l.map(b=>this.brow(b)).join(''):'<p class="text-xs text-gray-400 font-body py-6 text-center">No bookings match.</p>'},
 revenue(){const{bk,gross,rev}=this.stats(),c=AD_S.commission,cm=Math.round(gross*c/100);return `<div class="xcard p-5 mb-4" style="background:#082e23"><p class="adth" style="color:#e8c97a">Gross bookings value</p><p class="font-display text-4xl text-white mt-1">${inr(gross)}</p><div class="flex gap-6 mt-3"><div><p class="adth" style="color:#94a3b8">Commission (${c}%)</p><p class="font-bold text-gold-light font-body">${inr(cm)}</p></div></div></div>
  ${''}<button onclick="AD.csv()" class="xbtn xbtn-gold w-full"><i class="fa-solid fa-file-csv mr-1.5"></i>Export bookings CSV</button>`},
 csv(){const rows=[['Reference','Guest','Operator','Username','Check-in','Check-out','Nights','Status','Amount']].concat(allBk().map(b=>{const o=opByName(b.propertyName);return[b.reference,b.guestName||'',b.propertyName,o?o.user:'',b.checkIn,b.checkOut,b.nights||1,LAB[key(b)],amt(b)]}));
  const blob=new Blob([rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n')],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='nauka-bookings.csv';a.click();toast('CSV exported')},
  settings(){return `<div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-3">Cruise pricing</p><p class="text-[11px] text-gray-400 font-body mb-3">Set the global day and overnight rates for listings without their own custom prices. Listing-specific rates can be set while adding or editing a listing.</p><div class="grid grid-cols-2 gap-3"><div><label class="xlbl">Global day rate (% of base)</label><input id="s-day-rate" type="number" min="10" max="200" class="xin" value="${AD_S.cruisePricing.dayPercent}"/></div><div><label class="xlbl">Global overnight (% of base)</label><input id="s-night-rate" type="number" min="10" max="200" class="xin" value="${AD_S.cruisePricing.overnightPercent}"/></div></div><button onclick="AD.saveCruiseRates()" class="xbtn xbtn-em w-full mt-3">Save cruise prices</button></div>
  <div class="xcard p-4 mb-4"><p class="font-body font-semibold text-sm text-ink mb-3">Platform commission</p><label class="xlbl">Commission %</label><input id="s-c" type="number" min="0" max="50" class="xin" value="${AD_S.commission}"/><button onclick="AD.saveComm()" class="xbtn xbtn-em w-full mt-3">Save commission</button></div>
  <button onclick="adminLogOut()" class="xbtn xbtn-out w-full"><i class="fa-solid fa-right-from-bracket mr-1.5"></i>Sign out of admin</button>`},
 saveComm(){const v=Number($('s-c').value);if(!(v>=0&&v<=50))return toast('Enter 0–50',true);AD_S.commission=v;window.nkCommissionRate=v;saveAD();toast('Commission saved')},
 saveCruiseRates(){const day=Math.round(Number($('s-day-rate').value)),night=Math.round(Number($('s-night-rate').value));if(!(day>=10&&day<=200&&night>=10&&night<=200))return toast('Use rates between 10% and 200%',true);AD_S.cruisePricing={dayPercent:day,overnightPercent:night};saveAD();if(window.nkRefreshCruisePricing)window.nkRefreshCruisePricing();toast('Cruise prices saved');this.go('settings',true)},
 savePw(){toast('Admin passwords are managed by Supabase Auth.',true)},
 resetAll(){toast('Operator passwords are managed by Supabase Auth.',true)}
};
window.AD=AD;
AD.openFleet=function(id){
  ST.admin=true;
  showView('admin', false);
  if (window.AD && typeof window.AD.go==='function') {
    window.AD.go('fleet');
  }
  if (id != null && typeof window.nkaFleetSearch==='function') {
    const o = opById(id);
    if (o) window.nkaFleetSearch(o.name);
  }
};
window.switchAdminTab=t=>AD.go(['overview','fleet','bookings','revenue','settings'].includes(t)?t:'overview');
window.adminLogOut=function(){if(typeof window.logOut==='function')return window.logOut();localStorage.removeItem('alp_session');showView('login');setTimeout(()=>switchLoginTab('customer'),50)};

/* ═══════════ LOGIN + NAVIGATION HOOKS ═══════════ */
window.loginAsAgent=function(){toast('Admin sign-in is available through the protected customer sign-in form.',true)};
const _sv=window.showView;
window.showView=function(v,p){if(v==='agent')v='admin';if(v==='admin'&&!state.isAdmin)v='home';_sv(v,p);
  const an=$('agent-bottom-nav');if(an)an.classList.add('hidden');
  const nav=$('op-nav');if(nav)nav.style.display=v==='agent'?'flex':'none';
  if(v==='agent')OP.render();
  if(v==='admin'){AD.t='overview';AD.go('overview')}};
window.exitAgentDashboard=()=>OP.logout();
document.addEventListener('DOMContentLoaded',()=>{syncBk();});

/* ═══════════ CUSTOMER LOGIN GUARD + HOST PROFILE CARD ═══════════ */
/* Admin users authenticate through the same customer form. The live auth
   handler decides the destination after Supabase verifies the credentials. */
const _lc=window.loginAsCustomer;
window.loginAsCustomer=function(){return _lc.apply(this,arguments)};
function hostCard(){const pr=state.selectedProperty,o=pr&&opByName(pr.title);if(!o)return;
  const d=od(o.id),i=OPS.indexOf(o),av=PROFILE_AVATARS[i%PROFILE_AVATARS.length],bn=PROFILE_BANNERS[(i*5+2)%PROFILE_BANNERS.length];
  const done=allBk().filter(b=>b.propertyName===o.name&&b.st==='completed').length,trips=o.reviews+done;
  const about=d.prof.about||pr.description,st=(l,v)=>`<div class="rounded-2xl py-3 text-center" style="background:#fff;border:1px solid #eef0ef"><p class="font-body font-bold text-lg text-ink">${v}</p><p class="text-[10px] text-gray-400 font-body uppercase tracking-wider">${l}</p></div>`;
  const row=(l,v)=>`<div class="flex justify-between gap-3 py-2 text-xs font-body border-b border-gray-100 last:border-0"><span class="text-gray-400">${l}</span><span class="font-semibold text-ink text-right">${v}</span></div>`;
  sheet(`<div class="relative" style="margin:-.25rem 0 0"><div style="height:96px;border-radius:1.25rem;background:${bn.css};position:relative;overflow:hidden"><div style="position:absolute;top:-18px;right:-18px;width:80px;height:80px;border-radius:50%;background:${bn.dot1};opacity:.55"></div><div style="position:absolute;bottom:-14px;left:40%;width:60px;height:60px;border-radius:50%;background:${bn.dot2};opacity:.5"></div></div>
  <button onclick="closeSheet()" class="absolute w-8 h-8 rounded-full flex items-center justify-center" style="top:10px;right:10px;background:rgba(255,255,255,.7)"><i class="fa-solid fa-xmark text-gray-600 text-xs"></i></button>
  <div class="flex items-end gap-3" style="margin:-40px 0 0 14px;position:relative"><div style="width:84px;height:84px;border-radius:50%;border:4px solid #fff;overflow:hidden;background:${av.bg};box-shadow:0 8px 24px rgba(0,0,0,.14);flex-shrink:0">${av.svg}</div>
  <div class="pb-2 flex gap-1.5 flex-wrap"><span class="xchip" style="background:#fdf8ec;color:#a07a1a">★ ${o.rating}</span><span class="xchip s-confirmed">✓ Verified operator</span></div></div></div>
  <div class="mt-3 px-1"><h3 class="font-body font-bold text-xl text-ink leading-tight">${E(o.name)}</h3><p class="text-gray-500 text-sm font-body leading-relaxed mt-1">${E(about)}</p></div>
  <div class="grid grid-cols-3 gap-2 mt-4">${st('Trips completed',trips)}${st('Rating',o.rating+' ★')}${st('Reviews',o.reviews)}</div>
  <div class="xcard p-4 mt-4"><p class="adth mb-1">Operator details</p>${row('Operator ID','<span class="text-emerald">@'+E(o.user)+'</span>')}${row('Location',E(o.loc))}${d.prof.contact?row('Contact person',E(d.prof.contact)):''}${d.prof.phone?row('Phone',E(d.prof.phone)):''}${d.prof.email?row('Email',E(d.prof.email)):''}${row('Boat type',E(pr.subtitle||'Houseboat'))}</div>`)}
window.showHostProfile=hostCard;
document.addEventListener('DOMContentLoaded',()=>{const h=$('detail-host'),r=h&&h.closest('.border-y');if(!r)return;r.style.cursor='pointer';r.addEventListener('click',hostCard);r.insertAdjacentHTML('beforeend','<i class="fa-solid fa-chevron-right text-gray-300 text-xs"></i>')});

/* ═══════════ QUOTE SYNC (operator → customer, both directions) ═══════════ */
function myKey(){const u=state.loggedInUser;return u?String(u.email||u.username||'').toLowerCase():''}
function bookingUpdateTime(b){const value=Date.parse(b?.updatedAt||b?.createdAt||'');return Number.isFinite(value)?value:0}
function unseenBookingUpdateCount(){const seen=Number(state.bookingSeenAt)||0;return (state.userBookings||[]).filter(b=>bookingUpdateTime(b)>seen).length}
function markBookingUpdatesSeen(){state.bookingSeenAt=Date.now();persistState();quoteDot()}
function quoteDot(){const n=unseenBookingUpdateCount(),nav=$('nav-bookings');if(!nav)return;let d=nav.querySelector('.qdot');
  if(n&&!d){nav.style.position='relative';nav.insertAdjacentHTML('beforeend','<span class="qdot" style="position:absolute;top:2px;right:4px;min-width:16px;height:16px;border-radius:9px;background:#ef4444;color:#fff;font:700 9px sans-serif;display:flex;align-items:center;justify-content:center;border:2px solid #fff"></span>');d=nav.querySelector('.qdot')}
  if(d){if(n)d.textContent=n;else d.remove()}}
function pull(silent){if(!state.loggedInUser)return;const k=myKey();let ch=false,nq=false;
  load(K_BK,[]).forEach(r=>{if(r.guestKey!==k)return;const u=state.userBookings.find(x=>x.id===r.id);
    if(!u){state.userBookings.push(Object.assign({},r));ch=true;if(r.quoteStatus==='quoted'&&r.status==='pending')nq=true;return}
    if(tsOf(r)>tsOf(u)){if(r.quoteStatus==='quoted'&&u.quoteStatus!=='quoted')nq=true;Object.assign(u,r);ch=true}});
  if(ch){state.userBookings.sort((a,b)=>(b.createdAt||'').localeCompare(a.createdAt||''));persistState();if(window.renderMyBookings)renderMyBookings();if(nq&&!silent)toast('💬 You received a price quote — open Bookings to accept or decline')}
  quoteDot()}
const _sv2=window.showView;window.showView=function(v,p){if(v==='mybookings'||v==='home')pull(true);const result=_sv2(v,p);if(v==='mybookings')setTimeout(markBookingUpdatesSeen,80);return result};
const _lc2=window.loginAsCustomer;window.loginAsCustomer=function(){_lc2.apply(this,arguments);pull()};
const _apq=window.acceptPriceQuote;window.acceptPriceQuote=function(){_apq.apply(this,arguments);syncBk();quoteDot()};
window.declinePriceQuote=function(id){if(!confirm('Decline this price quote?'))return;const r=_raw(id);if(!r)return;r.quoteStatus='declined';r.updatedAt=new Date().toISOString();persistState();syncBk();renderMyBookings();quoteDot();toast('Quote declined. The operator has been notified.')};
const _nm=window._norm;window._norm=function(b){const n=_nm(b);if(b.status==='declined'){n.status='declined';n.opDeclined=true}return n};
const _bc=window._bookingCard;
window._bookingCard=function(b){let h=_bc(b);const id=E(b.id),qd=b.status==='pending'&&b.quoteStatus==='declined';
  if(b.status==='pending'&&b.quoteStatus==='quoted'&&b.price&&!b.opDeclined){
    h=h.replace('Accept price &amp; request confirmation</button>','Accept price &amp; request confirmation</button><button onclick="declinePriceQuote(\''+id+'\')" class="w-full mt-2 bg-white border border-red-200 text-red-500 text-xs font-bold font-body py-2.5 rounded-xl"><i class="fa-solid fa-xmark mr-1.5"></i>Decline this quote</button>').replace('Pending request','Quote received')}
  if(qd||b.opDeclined){const i=h.search(/<div class="bg-(gray-50 border border-gray-100|gold-pale border border-gold\/30) rounded-2xl p-4">/);
    if(i>-1){const box=qd?`<div class="bg-red-50 border border-red-100 rounded-2xl p-4"><p class="text-xs text-red-700 font-body"><i class="fa-solid fa-circle-xmark mr-1.5"></i>You declined the quote${b.price?' of <b>'+E(b.price)+'</b>':''}. Ask Nauka for a revised price.</p><button onclick="contactNaukaWhatsApp('${id}')" class="mt-3 w-full bg-white border border-gray-200 text-ink text-xs font-bold font-body py-2.5 rounded-xl"><i class="fa-brands fa-whatsapp text-emerald mr-1.5"></i>Contact Nauka</button></div>`:`<div class="bg-red-50 border border-red-100 rounded-2xl p-4"><p class="text-xs text-red-700 font-body"><i class="fa-solid fa-circle-info mr-1.5"></i>The operator could not accommodate these dates. Please try other dates or another houseboat.</p><button onclick="showView('boats')" class="mt-3 w-full btn-emerald text-white text-xs font-bold font-body py-2.5 rounded-xl">Browse the fleet</button></div>`;
      h=h.slice(0,i)+box+'\n</div></div>';h=h.replace('Pending request',qd?'Quote declined':'Not available').replace('bg-gold text-white text-xs','bg-red-500 text-white text-xs')}}
  return h};
window.addEventListener('storage',e=>{if(e.key===K_BK){pull();if(ST.id&&$('view-agent')?.classList.contains('active'))OP.body();if($('view-admin')?.classList.contains('active')&&$('ad-body'))AD.go(AD.t,true)}});
document.addEventListener('visibilitychange',()=>{if(!document.hidden)pull()});
setInterval(()=>{if(document.visibilityState==='visible'&&ST.id&&ST.tab==='bookings')pull()},30000);
document.addEventListener('DOMContentLoaded',()=>pull(true));

/* ═══════════ OPERATOR ONBOARDING ═══════════ */
const K_APP='alp_applications';
const apps=()=>load(K_APP,[]);
const saveApps=a=>{try{localStorage.setItem(K_APP,JSON.stringify(a));return true}catch(e){return false}};
const AMEN=[['AC Bedrooms','fa-snowflake'],['All Meals Included','fa-utensils'],['WiFi','fa-wifi'],['Sun Deck','fa-sun'],['Welcome Drinks','fa-champagne-glasses'],['Attached Bathrooms','fa-shower'],['Upper Deck Lounge','fa-ship'],['Karimeen Fry','fa-fish'],['Canoe Ride','fa-water'],['Music System','fa-music'],['LED TV','fa-tv'],['Butler Service','fa-bell-concierge']];
const NUMW=['One','Two','Three','Four','Five','Six'];
function materialize(a){const d=a.d,id=a.opId;
  if(!PROPERTIES.some(p=>p.id===id))PROPERTIES.push({id,category:'houseboat',bedrooms:Number(d.bedrooms),title:d.title,subtitle:NUMW[Number(d.bedrooms)-1]+'-Bedroom Kettuvallam',location:d.loc,price:Number(d.base),rating:5,reviews:0,host:d.business,description:d.desc,amenities:d.amen.map(l=>({icon:(AMEN.find(x=>x[0]===l)||[0,'fa-check'])[1],label:l})),image:d.img,gallery:[]});
  if(!OPS.some(o=>o.id===id))OPS.push({id,name:d.title,user:d.username,loc:d.loc,price:Number(d.base),rating:5,reviews:0});
  if(!DB[id]){DB[id]={pass:d.pass,base:Number(d.base),weekend:Number(d.weekend),over:{},blocked:{},prof:{contact:d.contact,phone:d.phone,email:d.email,about:d.desc},fresh:true};saveDB()}}
apps().filter(a=>a.status==='approved'&&a.opId).forEach(materialize);
const uErr=u=>{if(!/^[a-z][a-z0-9_]{3,19}$/.test(u))return '4–20 chars: letters, numbers, underscore; start with a letter';if(u.startsWith('admin'))return 'This username is reserved';if(OPS.some(o=>o.user===u)||apps().some(a=>a.d.username===u&&a.status!=='rejected'))return 'Username already taken';return ''};
function readImg(f,max,cb){const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.78))};im.src=r.result};r.readAsDataURL(f)}
const STEPS=['Account','Verify phone','Boat details','Documents','Review & submit'];
const fld=(k,l,t,ph,x)=>`<div class="mb-3"><label class="xlbl">${l}</label><input id="o-${k}" type="${t}" class="xin" placeholder="${ph}" value="${E(ONB.d[k]||'')}" oninput="ONB.set('${k}',this.value)" ${x||''}/></div>`;
const ONB={step:0,d:{},otp:'',otpFor:'',ok:false,t:null,
 el(){let e=$('onb');if(!e){e=document.createElement('div');e.id='onb';e.style.cssText='position:fixed;inset:0;z-index:990;background:#faf9f7;overflow-y:auto;display:none';document.body.appendChild(e)}return e},
 open(d){this.d=d||{amen:['AC Bedrooms','All Meals Included'],docs:{}};this.step=0;this.ok=false;this.otp='';this.show()},
 close(){clearInterval(this.t);this.el().style.display='none';document.body.style.overflow=''},
 set(k,v){this.d[k]=v},
 back(){if(this.step>0){this.step--;this.show()}else this.close()},
 show(keep){const e=this.el(),s=this.step,y=e.scrollTop;e.style.display='block';document.body.style.overflow='hidden';
  if(s===5){e.innerHTML=this.done();e.scrollTop=0;return}
  e.innerHTML=`<div class="sticky top-0 z-10 px-5 pt-5 pb-3" style="background:rgba(250,249,247,.97);backdrop-filter:blur(16px)"><div style="max-width:480px;margin:0 auto"><div class="flex items-center justify-between mb-3"><button onclick="ONB.back()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-${s?'arrow-left':'xmark'} text-gray-600 text-sm"></i></button><p class="font-display text-lg text-ink">Operator <em>registration</em></p><span class="text-[11px] font-body text-gray-400 w-9 text-right">${s+1}/5</span></div><div class="flex gap-1.5">${STEPS.map((_,i)=>`<div class="flex-1 h-1.5 rounded-full" style="background:${i<=s?'#0d4f3c':'#e5e7eb'}"></div>`).join('')}</div><p class="text-xs font-body text-emerald font-semibold mt-2">${STEPS[s]}</p></div></div>
  <div class="px-5 pt-3 pb-32" style="max-width:480px;margin:0 auto">${this['s'+s]()}</div>
  <div class="fixed bottom-0 left-0 right-0 px-5 py-4" style="background:rgba(250,249,247,.97);border-top:1px solid #eef0ef"><div style="max-width:480px;margin:0 auto"><button onclick="ONB.next()" class="btn-emerald w-full text-white font-semibold text-sm rounded-2xl py-3.5 font-body">${['Continue','Verify and continue','Continue','Review application','Submit application'][s]}</button></div></div>`;
  e.scrollTop=keep?y:0;if(s===1)this.timer()},
 s0(){const d=this.d;return `<h2 class="font-display text-3xl font-light text-ink mb-1">Create your <em>account</em></h2><p class="text-gray-400 text-sm font-body mb-5">List your houseboat on Nauka and receive bookings directly.</p>
  ${fld('business','Business / company name','text','e.g. Backwater Dreams')}${fld('contact','Contact person','text','Full name')}${fld('phone','Mobile number','tel','10-digit number','maxlength="10" inputmode="numeric"')}${fld('email','Business email','email','you@business.com')}
  <div class="mb-3"><label class="xlbl">Choose a username</label><input id="o-username" class="xin" autocapitalize="none" autocomplete="off" placeholder="e.g. backwaterdreams" value="${E(d.username||'')}" oninput="ONB.uchk(this)"/><p id="o-uh" class="text-[11px] font-body mt-1"></p></div>
  <div class="mb-3"><label class="xlbl">Password</label><div class="relative"><input id="o-pass" type="password" class="xin" style="padding-right:3rem" placeholder="Min 8 chars, letters &amp; numbers" value="${E(d.pass||'')}" oninput="ONB.set('pass',this.value);ONB.meter()"/><button type="button" onclick="const i=document.getElementById('o-pass');i.type=i.type==='password'?'text':'password'" class="absolute text-gray-400 text-xs font-semibold" style="right:12px;top:13px">Show</button></div><div class="flex gap-1 mt-2" id="o-mt">${[0,1,2,3].map(()=>'<div class="flex-1 h-1 rounded-full bg-gray-200"></div>').join('')}</div><p id="o-ml" class="text-[11px] font-body text-gray-400 mt-1"></p></div>
  ${fld('pass2','Confirm password','password','Re-enter password')}<p class="text-[11px] text-gray-400 font-body leading-relaxed">By continuing you agree to a one-time mobile verification in the next step.</p>`},
 uchk(i){i.value=i.value.toLowerCase().replace(/\s/g,'');this.d.username=i.value;const h=$('o-uh'),m=i.value?uErr(i.value):'';h.textContent=i.value?(m||'✓ Username is available'):'';h.style.color=m?'#dc2626':'#0d4f3c'},
 meter(){const p=this.d.pass||'',sc=(p.length>=8)+(/[A-Z]/.test(p)&&/[a-z]/.test(p))+/\d/.test(p)+/[^A-Za-z0-9]/.test(p),c=['#e5e7eb','#ef4444','#f59e0b','#84cc16','#0d4f3c'][p?Math.max(1,sc):0];[...$('o-mt').children].forEach((b,i)=>b.style.background=i<sc?c:'#e5e7eb');$('o-ml').textContent=p?['Weak','Weak','Fair','Good','Strong'][sc]:''},
 v0(){const d=this.d,t=k=>(d[k]||'').trim();if(t('business').length<3)return 'Enter your business name';if(t('contact').length<3)return 'Enter the contact person name';if(!/^[6-9]\d{9}$/.test(t('phone')))return 'Enter a valid 10-digit mobile number';if(!/^\S+@\S+\.\S+$/.test(t('email')))return 'Enter a valid email address';
  const u=uErr(d.username||'');if(u)return u;const p=d.pass||'';if(p.length<8||!/[A-Za-z]/.test(p)||!/\d/.test(p))return 'Password needs 8+ characters with letters and numbers';if(p!==d.pass2)return 'Passwords do not match';return ''},
 s1(){const ph=this.d.phone||'';return `<h2 class="font-display text-3xl font-light text-ink mb-1">Verify your <em>number</em></h2><p class="text-gray-400 text-sm font-body mb-4">Enter the 4-digit code sent to +91 ${E(ph.slice(0,2))}••••••${E(ph.slice(-2))}</p>
  <div class="rounded-2xl p-3 mb-5 text-xs font-body" style="background:#fdf8ec;border:1px solid #efdca4;color:#7a5a10"><b>Verification:</b> use the code sent to your registered phone. If you do not receive it, contact Nauka support.</div>
  <div class="flex gap-2 justify-center mb-4">${[0,1,2,3].map(i=>`<input class="otpb xin" maxlength="1" inputmode="numeric" style="width:46px;height:54px;text-align:center;font-size:1.3rem;font-weight:700;padding:0" oninput="ONB.ob(this,${i})" onkeydown="ONB.ok2(event,${i})"/>`).join('')}</div>
  <p class="text-center text-xs font-body text-gray-400"><span id="otp-t"></span> <button id="otp-r" onclick="ONB.resend()" class="text-emerald font-semibold hidden">Resend code</button></p>`},
 ob(el,i){el.value=el.value.replace(/\D/g,'');const b=document.querySelectorAll('.otpb');if(el.value&&b[i+1])b[i+1].focus()},
 ok2(e,i){if(e.key==='Backspace'&&!e.target.value){const b=document.querySelectorAll('.otpb');if(b[i-1])b[i-1].focus()}},
 timer(){clearInterval(this.t);let n=30;const t=$('otp-t'),r=$('otp-r');this.t=setInterval(()=>{n--;if(!$('otp-t')){clearInterval(this.t);return}if(n<=0){clearInterval(this.t);t.textContent='';r.classList.remove('hidden')}else t.textContent='Resend code in '+n+'s'},1000);t.textContent='Resend code in 30s'},
 resend(){toast('Verification code delivery is managed by Supabase Auth. Check your phone or contact Nauka support.',true)},
 v1(){if(this.ok)return '';const c=[...document.querySelectorAll('.otpb')].map(x=>x.value).join('');if(c.length<4)return 'Enter the 4-digit code';if(c!==this.otp)return 'Incorrect code. Try again.';this.ok=true;clearInterval(this.t);return ''},
 s2(){const d=this.d;return `<h2 class="font-display text-3xl font-light text-ink mb-1">Your <em>houseboat</em></h2><p class="text-gray-400 text-sm font-body mb-5">This is what guests will see in the Fleet.</p>
  ${fld('title','Houseboat name','text','e.g. Lake Breeze Houseboat')}
  <label class="xlbl">Bedrooms</label><div class="flex gap-2 mb-3">${[1,2,3,4,5,6].map(n=>`<button onclick="ONB.set('bedrooms',${n});ONB.show(true)" class="flex-1 py-2.5 rounded-xl text-sm font-bold font-body" style="${Number(d.bedrooms)===n?'background:#0d4f3c;color:#fff':'background:#fff;border:1.5px solid #e5e7eb;color:#4b5563'}">${n}</button>`).join('')}</div>
  <div class="grid grid-cols-2 gap-3">${fld('base','Weekday price ₹','number','e.g. 14000')}${fld('weekend','Weekend price ₹','number','e.g. 18000')}</div>
  <div class="mb-3"><label class="xlbl">Boarding location</label><input id="o-loc" class="xin" list="o-locs" placeholder="e.g. Finishing Point, Punnamada" value="${E(d.loc||'')}" oninput="ONB.set('loc',this.value)"/><datalist id="o-locs"><option>Punnamada Lake, Alappuzha</option><option>Finishing Point, Punnamada</option><option>Vembanad Lake, Alappuzha</option><option>Kuttanad Backwaters</option><option>Alleppey Canal Network</option></datalist></div>
  <div class="mb-3"><label class="xlbl">Description (min 30 characters)</label><textarea class="xin" rows="3" placeholder="Describe the cruise experience…" oninput="ONB.set('desc',this.value)">${E(d.desc||'')}</textarea></div>
  <label class="xlbl">Amenities</label><div class="flex flex-wrap gap-2 mb-4">${AMEN.map(([l])=>{const on=(d.amen||[]).includes(l);return `<button onclick="ONB.am('${l}')" class="xchip" style="padding:7px 12px;${on?'background:#0d4f3c;color:#fff':'background:#fff;color:#4b5563;border:1px solid #e5e7eb'}">${l}</button>`}).join('')}</div>
  <label class="xlbl">Cover photo</label><label class="block rounded-2xl overflow-hidden cursor-pointer" style="border:2px dashed #cbd5d1;background:#fff">${d.img?`<img src="${d.img}" style="width:100%;height:170px;object-fit:cover"/>`:`<div class="text-center py-9"><i class="fa-solid fa-camera text-emerald text-2xl"></i><p class="text-sm font-body font-semibold text-ink mt-2">Upload a clear photo of your boat</p></div>`}<input type="file" accept="image/*" class="hidden" onchange="ONB.photo(this)"/></label>${d.img?'<p class="text-[11px] text-emerald font-body mt-1">✓ Photo added · tap to change</p>':''}`},
 am(l){const a=this.d.amen=this.d.amen||[],i=a.indexOf(l);i<0?a.push(l):a.splice(i,1);this.show(true)},
 photo(i){const f=i.files[0];if(!f)return;if(!f.type.startsWith('image/'))return toast('Choose an image file',true);readImg(f,900,u=>{this.d.img=u;this.show(true)})},
 v2(){const d=this.d,t=k=>(d[k]||'').trim();if(t('title').length<3)return 'Enter the houseboat name';if(!d.bedrooms)return 'Select the number of bedrooms';if(!(Number(d.base)>0)||!(Number(d.weekend)>0))return 'Enter weekday and weekend prices';if(t('loc').length<3)return 'Enter the boarding location';if(t('desc').length<30)return 'Description needs at least 30 characters';if(!(d.amen||[]).length)return 'Select at least one amenity';if(!d.img)return 'Upload a cover photo';return ''},
 up(k,l,sub){const h=(this.d.docs||{})[k];return `<label class="block xcard p-3 mb-3 cursor-pointer"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:${h?'#e8f2ee':'#f3f4f6'}"><i class="fa-solid ${h?'fa-check text-emerald':'fa-upload text-gray-400'} text-sm"></i></div><div class="flex-1 min-w-0"><p class="font-body font-semibold text-sm text-ink">${l}</p><p class="text-[11px] text-gray-400 font-body truncate">${h?E(h.name):sub}</p></div><span class="text-emerald text-xs font-semibold">${h?'Change':'Upload'}</span></div><input type="file" accept="image/*,.pdf" class="hidden" onchange="ONB.doc('${k}',this)"/></label>`},
 s3(){return `<h2 class="font-display text-3xl font-light text-ink mb-1">Verify your <em>business</em></h2><p class="text-gray-400 text-sm font-body mb-5">Our team reviews these documents before your listing goes live. Images or PDF, up to 5 MB each.</p>${this.up('pan','PAN card','Owner or business PAN')}${this.up('aad','Aadhaar card','Owner identity proof')}${this.up('cert','Boat registration / licence','Tourism department or port registration')}${fld('gst','GST number (optional)','text','e.g. 32ABCDE1234F1Z5','maxlength="15"')}`},
 doc(k,i){const f=i.files[0];if(!f)return;if(f.size>5*1048576)return toast('File is larger than 5 MB',true);this.d.docs=this.d.docs||{};this.d.docs[k]={name:f.name};this.show(true)},
 v3(){const o=this.d.docs||{};return(o.pan&&o.aad&&o.cert)?'':'Upload PAN, Aadhaar and boat registration'},
 s4(){const d=this.d,r=(l,v)=>`<div class="flex justify-between gap-3 py-1.5 text-xs font-body border-b border-gray-100 last:border-0"><span class="text-gray-400">${l}</span><span class="font-semibold text-ink text-right">${v}</span></div>`;
  return `<h2 class="font-display text-3xl font-light text-ink mb-1">Review &amp; <em>submit</em></h2><p class="text-gray-400 text-sm font-body mb-4">Check your details. You can go back to edit anything.</p>
  <div class="xcard overflow-hidden mb-3">${d.img?`<img src="${d.img}" style="width:100%;height:130px;object-fit:cover"/>`:''}<div class="p-4"><p class="font-body font-bold text-ink">${E(d.title)}</p><p class="text-xs text-gray-400 font-body">${d.bedrooms} bedroom · ${E(d.loc)}</p><p class="text-xs font-body mt-1">Weekday <b>${inr(d.base)}</b> · Weekend <b>${inr(d.weekend)}</b></p></div></div>
  <div class="xcard p-4 mb-3">${r('Business',E(d.business))}${r('Contact',E(d.contact))}${r('Mobile','+91 '+E(d.phone)+' ✓')}${r('Email',E(d.email))}${r('Username','@'+E(d.username))}${r('Documents','PAN · Aadhaar · Registration')}</div>
  <label class="flex gap-2 items-start text-xs font-body text-gray-600 leading-relaxed"><input id="o-terms" type="checkbox" style="width:18px;height:18px;margin-top:1px;accent-color:#0d4f3c"/><span>I confirm the information is accurate and agree to the operator terms and platform commission.</span></label>`},
 v4(){return $('o-terms')&&$('o-terms').checked?'':'Please accept the terms to submit'},
 next(){const s=this.step,m=this['v'+s]();if(m)return toast(m,true);
  if(s===0&&(!this.ok||this.otpFor!==this.d.phone)){return toast('Phone verification is managed by Supabase Auth. Please complete verification before continuing.',true)}
  if(s===4)return this.submit();this.step++;this.show()},
 submit(){const l=apps(),ref='OP-'+Math.random().toString(36).slice(2,8).toUpperCase(),d=JSON.parse(JSON.stringify(this.d));
  l.push({ref,status:'pending',createdAt:new Date().toISOString(),d,docOk:{},reason:'',opId:null});
  if(!saveApps(l))return toast('Storage is full. Try a smaller photo.',true);this.ref=ref;this.step=5;this.show()},
 done(){const st=[['Application submitted',1],['Document verification',0],['Approval by our team',0],['Listing goes live',0]];
  return `<div class="px-6 py-12 text-center" style="max-width:480px;margin:0 auto"><div class="success-ring bg-emerald-mist mx-auto mb-4"><div class="success-check w-12 h-12 rounded-full bg-emerald flex items-center justify-center"><i class="fa-solid fa-check text-white text-xl"></i></div></div><h2 class="font-display text-3xl font-light text-ink">Application <em>received</em></h2><p class="text-gray-500 text-sm font-body mt-1 mb-4">We usually review within 48 hours.</p>
  <div class="xcard p-4 mb-4"><p class="adth">Reference number</p><p class="font-mono font-bold text-xl text-ink tracking-widest">${this.ref}</p><p class="text-[11px] text-gray-400 font-body mt-1">Keep this to track your status. Username: <b>@${E(this.d.username)}</b></p></div>
  <div class="xcard p-4 text-left mb-5">${st.map(([l,o],i)=>`<div class="flex items-center gap-3 py-2"><div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold" style="background:${o?'#0d4f3c':'#e5e7eb'};color:${o?'#fff':'#9ca3af'}">${o?'✓':i+1}</div><p class="text-sm font-body ${o?'font-semibold text-ink':'text-gray-400'}">${l}</p></div>`).join('')}</div>
  <button onclick="ONB.close();ONB.track('${this.ref}')" class="btn-emerald w-full text-white font-semibold text-sm rounded-2xl py-3.5 font-body mb-2">Track my application</button><button onclick="ONB.close();showView('login')" class="w-full py-3 text-sm font-body text-gray-500">Back to login</button></div>`},
 track(ref){sheet(`<div class="flex items-center justify-between mb-3"><h3 class="font-display text-2xl text-ink">Track <em>application</em></h3><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div><label class="xlbl">Reference number</label><input id="t-r" class="xin mb-3" placeholder="OP-XXXXXX" value="${E(ref||'')}"/><label class="xlbl">Registered mobile</label><input id="t-p" class="xin mb-3" type="tel" placeholder="10-digit number" maxlength="10"/><button onclick="ONB.trackGo()" class="xbtn xbtn-em w-full">Check status</button><div id="t-out" class="mt-4"></div>`)},
 trackGo(){const r=$('t-r').value.trim().toUpperCase(),p=$('t-p').value.trim(),a=apps().find(x=>x.ref===r&&x.d.phone===p);const o=$('t-out');
  if(!a){o.innerHTML='<p class="text-xs text-red-600 font-body">No application found with these details.</p>';return}
  const m={pending:['Under review','s-pending','Our team is verifying your documents.'],approved:['Approved','s-confirmed','You can now log in with your username and password.'],rejected:['Rejected','s-declined','Reason: '+E(a.reason)]}[a.status];
  o.innerHTML=`<div class="xcard p-4"><div class="flex items-center justify-between"><p class="font-body font-bold text-sm text-ink">${E(a.d.business)}</p><span class="xchip ${m[1]}">${m[0]}</span></div><p class="text-xs text-gray-500 font-body mt-2">${m[2]}</p>${a.status==='rejected'?`<button onclick="ONB.reapply('${a.ref}')" class="xbtn xbtn-gold w-full mt-3">Edit &amp; reapply</button>`:''}</div>`},
 reapply(ref){const a=apps().find(x=>x.ref===ref);if(!a)return;closeSheet();const d=JSON.parse(JSON.stringify(a.d));d.pass2=d.pass;this.open(d)},
 forgot(){sheet(`<div class="flex items-center justify-between mb-3"><h3 class="font-display text-2xl text-ink">Reset <em>password</em></h3><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div><label class="xlbl">Username</label><input id="fp-u" class="xin mb-3" autocapitalize="none"/><label class="xlbl">Registered mobile</label><input id="fp-p" type="tel" class="xin mb-3" maxlength="10"/><button onclick="ONB.fpSend()" class="xbtn xbtn-em w-full">Send verification code</button>`)},
  async fpSend(){const email=$('fp-u').value.trim().toLowerCase();if(!email||!email.includes('@'))return toast('Enter the email used for your Supabase account.',true);if(!window.naukaSupabase)return toast('Password reset is temporarily unavailable. Please try again.',true);const result=await window.naukaSupabase.auth.resetPasswordForEmail(email,{redirectTo:location.href.split('#')[0]+'#login'});if(result.error)return toast(result.error.message||'Could not start password reset.',true);closeSheet();toast('Password reset instructions sent. Check your email.')},
 fpDo(){toast('Use the password reset link sent by Supabase Auth.',true)}
};
window.ONB=ONB;

/* admin: applications tab */
AD.af='pending';
const APL={pending:['Pending','s-pending'],approved:['Approved','s-confirmed'],rejected:['Rejected','s-declined']};
AD.applications=function(){const l=apps(),f=this.af;return `<div class="flex gap-1.5 mb-3">${Object.entries(APL).map(([k,[lb]])=>`<button onclick="AD.af='${k}';AD.go('applications',true)" class="xchip flex-1" style="padding:8px;${k===f?'background:#082e23;color:#e8c97a':'background:#fff;color:#64748b;border:1px solid #e5e7eb'}">${lb} · ${l.filter(a=>a.status===k).length}</button>`).join('')}</div>`+
  (l.filter(a=>a.status===f).length?l.filter(a=>a.status===f).reverse().map(a=>`<div onclick="AD.app('${a.ref}')" class="xcard p-4 mb-3 cursor-pointer"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><p class="font-body font-bold text-sm text-ink truncate">${E(a.d.business)}</p><p class="text-xs text-emerald font-semibold font-body">@${E(a.d.username)} · <span class="font-mono text-gray-400">${a.ref}</span></p><p class="text-[11px] text-gray-400 font-body">${E(a.d.title)} · ${a.d.bedrooms} BR · ${formatDate(a.createdAt.slice(0,10))}</p></div><span class="xchip ${APL[a.status][1]}">${APL[a.status][0]}</span></div></div>`).join(''):empty('fa-user-plus','No '+f+' applications','New operator registrations appear here.'))};
AD.app=function(ref){const a=apps().find(x=>x.ref===ref);if(!a)return;const d=a.d,r=(l,v)=>`<div class="flex justify-between gap-3 py-1.5 text-xs font-body border-b border-gray-100 last:border-0"><span class="text-gray-400">${l}</span><span class="font-semibold text-ink text-right">${v}</span></div>`;
  const docs=[['pan','PAN card'],['aad','Aadhaar card'],['cert','Boat registration']].map(([k,l])=>`<label class="flex items-center gap-3 py-2 border-b border-gray-100 last:border-0"><input type="checkbox" ${a.docOk&&a.docOk[k]?'checked':''} ${a.status!=='pending'?'disabled':''} onchange="AD.docOk('${a.ref}','${k}',this.checked)" style="width:18px;height:18px;accent-color:#0d4f3c"/><span class="flex-1 min-w-0"><span class="block text-xs font-semibold font-body text-ink">${l}</span><span class="block text-[11px] text-gray-400 font-body truncate">${E((d.docs[k]||{}).name||'—')}</span></span></label>`).join('');
  sheet(`<div class="flex items-start justify-between mb-3"><div><h3 class="font-display text-2xl text-ink leading-tight">${E(d.business)}</h3><p class="text-[11px] text-gray-400 font-mono">${a.ref}</p></div><button onclick="closeSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button></div>
  ${d.img?`<img src="${d.img}" style="width:100%;height:140px;object-fit:cover;border-radius:1rem" class="mb-3"/>`:''}
  <div class="xcard p-4 mb-3"><p class="adth mb-1">Boat</p>${r('Name',E(d.title))}${r('Bedrooms',d.bedrooms)}${r('Weekday / weekend',inr(d.base)+' / '+inr(d.weekend))}${r('Boarding',E(d.loc))}${r('Amenities',E((d.amen||[]).join(', ')))}</div>
  <div class="xcard p-4 mb-3"><p class="adth mb-1">Contact</p>${r('Person',E(d.contact))}${r('Mobile','+91 '+E(d.phone)+' <span class="text-emerald">✓ verified</span>')}${r('Email',E(d.email))}${r('Username','@'+E(d.username))}${d.gst?r('GST',E(d.gst)):''}</div>
  <div class="xcard p-4 mb-3"><p class="adth mb-1">Document checklist</p>${docs}</div>
  ${a.status==='pending'?`<button onclick="AD.approve('${a.ref}')" class="xbtn xbtn-em w-full mb-3">Approve &amp; publish listing</button><label class="xlbl">Rejection reason</label><textarea id="x-rr" rows="2" class="xin mb-2" placeholder="Explain what needs fixing"></textarea><button onclick="AD.reject('${a.ref}')" class="xbtn xbtn-red w-full">Reject application</button>`:`<p class="text-xs font-body text-gray-500">Status: <b>${APL[a.status][0]}</b>${a.reason?' — '+E(a.reason):''}</p>`}`)};
AD.docOk=function(ref,k,v){const l=apps(),a=l.find(x=>x.ref===ref);if(!a)return;a.docOk=a.docOk||{};a.docOk[k]=v;saveApps(l)};
AD.approve=function(ref){const l=apps(),a=l.find(x=>x.ref===ref);if(!a)return;if(!['pan','aad','cert'].every(k=>a.docOk&&a.docOk[k]))return toast('Tick all three documents as verified first',true);
  a.status='approved';a.reviewedAt=new Date().toISOString();a.opId=301+l.filter(x=>x.opId).length;saveApps(l);materialize(a);closeSheet();toast('Operator approved — listing is live');if(window.renderProperties)renderProperties();AD.go('applications',true)};
AD.reject=function(ref){const t=($('x-rr').value||'').trim();if(t.length<10)return toast('Enter a reason (min 10 characters)',true);const l=apps(),a=l.find(x=>x.ref===ref);if(!a)return;a.status='rejected';a.reason=t;a.reviewedAt=new Date().toISOString();saveApps(l);closeSheet();toast('Application rejected');AD.go('applications',true)};
const _ado=AD.overview;AD.overview=function(){const n=apps().filter(a=>a.status==='pending').length;return(n?`<div onclick="AD.go('applications')" class="xcard p-4 mb-4 flex items-center gap-3 cursor-pointer" style="background:#fffbeb;border-color:#fde68a"><i class="fa-solid fa-user-clock text-yellow-600"></i><div class="flex-1"><p class="font-body font-semibold text-sm text-ink">${n} operator application${n>1?'s':''} awaiting review</p><p class="text-[11px] text-gray-500 font-body">Tap to verify documents and approve</p></div><i class="fa-solid fa-chevron-right text-gray-400 text-xs"></i></div>`:'')+_ado.call(this)};
const _ago=AD.go;AD.go=function(t,k){_ago.call(this,t,k);const b=$('adt-applications');if(b){const n=apps().filter(a=>a.status==='pending').length;b.textContent='Applications'+(n?' · '+n:'')}};
/* first-login welcome for newly approved operators */
const _orn=OP.render;OP.render=function(){_orn.call(this);const d=od(ST.id);if(d.fresh){d.fresh=false;saveDB();const o=opById(ST.id);setTimeout(()=>sheet(`<div class="text-center"><div class="w-16 h-16 mx-auto rounded-3xl flex items-center justify-center font-display text-3xl text-gold mb-3" style="background:#082e23">${E(o.name[0])}</div><h3 class="font-display text-2xl text-ink">Welcome aboard, <em>${E(d.prof.contact.split(' ')[0]||'captain')}</em>!</h3><p class="text-gray-500 text-sm font-body mt-1 mb-4">Your listing is now live in the Fleet.</p></div><div class="xcard p-4 text-left mb-4">${[['Review your rates','Pricing tab — set weekend and date prices'],['Complete your profile','Profile tab — add about text and contact'],['Respond within 24 hours','Bookings tab — send quotes to guests']].map(([a,b],i)=>`<div class="flex gap-3 py-2"><div class="w-6 h-6 rounded-full bg-emerald text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0">${i+1}</div><div><p class="text-sm font-semibold font-body text-ink">${a}</p><p class="text-[11px] text-gray-400 font-body">${b}</p></div></div>`).join('')}</div><button onclick="closeSheet();OP.tab('pricing')" class="xbtn xbtn-em w-full">Set my rates</button>`),400)}};
/* admin login screen hooks */
document.addEventListener('DOMContentLoaded',()=>{const pw=$('agent-login-pass');if(!pw)return;
  pw.parentElement.insertAdjacentHTML('beforeend','<div class="flex justify-start mt-2"><button type="button" onclick="const i=document.getElementById(\'agent-login-pass\');i.type=i.type===\'password\'?\'text\':\'password\'" class="text-gray-500 text-xs font-semibold font-body">Show password</button></div>')});
})();
</script>

<style id="nk-v3">
.xrow{background:#fff;border:1px solid #eef0ef;border-radius:1.1rem;padding:.8rem 1rem;margin-bottom:.65rem;box-shadow:0 4px 18px rgba(13,79,60,.07);transition:transform .15s}.xrow:active{transform:scale(.985)}
#bookingModal{padding-top:env(safe-area-inset-top,0px)}
#bookingModal .modal-sheet{max-height:92vh;max-height:92dvh;overflow-y:auto;overscroll-behavior:contain;background:#fff!important;border-radius:28px 28px 0 0;box-shadow:0 -24px 60px rgba(8,46,35,.35)}
#bookingModal .modal-sheet>.flex.justify-center{position:sticky;top:0;z-index:6;background:#fff}
#bookingModal .px-6{padding:0 1.25rem calc(1.4rem + env(safe-area-inset-bottom,0px))}
#bookingModal .px-6>.flex.items-center.justify-between.mb-5{position:sticky;top:20px;z-index:5;background:#fff;padding:.5rem 0 .85rem;margin-bottom:.6rem;border-bottom:1px solid #eef2f0}
#bookingModal h3{font-size:1.7rem;line-height:1.1}
#booking-form{display:grid;gap:1.1rem}#booking-form>*{margin:0!important}
#bookingModal label{font-size:10.5px;letter-spacing:.1em;color:#0d4f3c;margin-bottom:.5rem;display:block}
#bookingModal #booking-date{height:54px;border-radius:16px;border:1.5px solid #e3ebe7;background:#fafcfb;font-weight:600}
#bookingModal .shadow-soft{border-radius:20px;border:1.5px solid #e3ebe7;background:#fafcfb;box-shadow:none}
#bookingModal .shadow-soft .border-b{border-color:#e3ebe7}
#bookingModal button[onclick^="change"]{width:38px;height:38px;border-radius:50%;border:none;background:#e8f2ee;color:#0d4f3c;font-size:1.15rem;transition:all .2s}
#bookingModal button[onclick^="change"]:active{background:#0d4f3c;color:#fff;transform:scale(.92)}
#bookingModal .flex.items-center.gap-3:has(#booking-nights){background:#fafcfb;border:1.5px solid #e3ebe7;border-radius:20px;padding:.5rem .8rem;justify-content:space-between}
#bookingModal #booking-nights{width:70px!important;height:44px;border:none;background:transparent;font-size:1.3rem;font-weight:700;padding:0;box-shadow:none}
#booking-route{display:none}
.rt{display:flex;align-items:center;gap:.8rem;width:100%;padding:.8rem .95rem;border:1.5px solid #e3ebe7;border-radius:16px;background:#fafcfb;text-align:left;transition:all .2s}
.rt b{display:block;font:700 .88rem 'Plus Jakarta Sans',sans-serif;color:#1a1a18}.rt small{display:block;font:500 .72rem 'Plus Jakarta Sans',sans-serif;color:#6b7280;margin-top:1px}
.rt-i{width:38px;height:38px;border-radius:12px;background:#e8f2ee;color:#0d4f3c;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rt-r{width:20px;height:20px;border-radius:50%;border:2px solid #cbd5d1;flex-shrink:0;transition:all .2s}
.rt.on{border-color:#0d4f3c;background:#e8f2ee;box-shadow:0 0 0 3px rgba(13,79,60,.1)}.rt.on .rt-i{background:#0d4f3c;color:#e8c97a}.rt.on .rt-r{border:6px solid #0d4f3c}
#bookingModal .bg-emerald-mist.rounded-2xl{background:linear-gradient(135deg,#082e23,#0d4f3c);border-radius:20px;padding:1.1rem 1.2rem}
#bookingModal .bg-emerald-mist .text-gray-600{color:rgba(255,255,255,.65)!important}
#bookingModal .bg-emerald-mist .text-ink{color:#fff!important}
#bookingModal .bg-emerald-mist .text-emerald{color:#e8c97a!important}
#bookingModal .bg-emerald-mist hr{border-color:rgba(255,255,255,.15)}
#bookingModal .btn-emerald.w-full{height:56px;border-radius:18px;background:linear-gradient(135deg,#0d4f3c,#1a6b52);box-shadow:0 10px 28px rgba(13,79,60,.35)}
</style>
<script>
(function(){
document.addEventListener('DOMContentLoaded',()=>{const sel=document.getElementById('booking-route');if(!sel)return;
 const meta={'Alleppey Backwater Circuit':['fa-water','Overnight · Punnamada & Kuttanad'],'Alleppey to Kumarakom':['fa-dove','Overnight · Vembanad Lake crossing'],'Sunset & Day Cruise':['fa-sun','Day cruise · lunch & sunset']};
 const box=document.createElement('div');box.id='route-pills';box.style.cssText='display:grid;gap:.55rem';
 const sync=()=>box.querySelectorAll('.rt').forEach(b=>b.classList.toggle('on',b.dataset.v===sel.value));
 [...sel.options].filter(o=>o.value).forEach(o=>{const m=meta[o.value]||['fa-route',''],b=document.createElement('button');b.type='button';b.className='rt';b.dataset.v=o.value;
  b.innerHTML='<span class="rt-i"><i class="fa-solid '+m[0]+'"></i></span><span style="flex:1;min-width:0"><b></b><small>'+m[1]+'</small></span><span class="rt-r"></span>';b.querySelector('b').textContent=o.value;b.onclick=()=>{sel.value=o.value;sync()};box.appendChild(b)});
 sel.insertAdjacentElement('afterend',box);
 const w=window._setupRouteField;window._setupRouteField=function(){const r=w.apply(this,arguments);sync();return r};});
 /* return-from-WhatsApp confirmation */
const K='nk_wa_pending';
 function showReturnNotice(){
   let notice=document.getElementById('nk-wa-return-notice');
   if(!notice){
     document.body.insertAdjacentHTML('beforeend','<div id="nk-wa-return-notice" class="nk-wa-return-notice" role="dialog" aria-modal="true" aria-labelledby="nk-wa-return-title"><div class="nk-wa-return-card"><button type="button" class="nk-wa-return-close" aria-label="Close" onclick="nkCloseWhatsAppNotice()"><i class="fa-solid fa-xmark"></i></button><div class="nk-wa-return-icon"><i class="fa-brands fa-whatsapp"></i></div><p class="nk-wa-return-kicker">REQUEST RECEIVED</p><h3 id="nk-wa-return-title">We have received <em>your request</em></h3><p class="nk-wa-return-copy">We will be in touch with you soon!</p><button type="button" class="nk-wa-return-done" onclick="nkCloseWhatsAppNotice()">Done <i class="fa-solid fa-arrow-right"></i></button></div></div>');
     notice=document.getElementById('nk-wa-return-notice');
     notice.addEventListener('click',event=>{if(event.target===notice)window.nkCloseWhatsAppNotice?.()});
   }
   notice.classList.add('open');
   document.body.style.overflow='hidden';
}
 window.nkCloseWhatsAppNotice=function(){document.getElementById('nk-wa-return-notice')?.classList.remove('open');document.body.style.overflow=''};
let returnSplashTimer=0;
 function chk(){try{const t=+sessionStorage.getItem(K);if(!t||document.hidden)return;const wait=1500-(Date.now()-t);if(wait>0){clearTimeout(returnSplashTimer);returnSplashTimer=setTimeout(chk,wait+20);return}sessionStorage.removeItem(K);setTimeout(showReturnNotice,350)}catch(e){}}
document.addEventListener('visibilitychange',chk);window.addEventListener('focus',chk);window.addEventListener('pageshow',chk);
})();
</script>
<style id="nauka-responsive-layer">
:root { --xw: 1200px; }
@media (min-width: 1600px) { :root { --xw: 1360px; } }

@keyframes xDialogIn {
  from { opacity: 0; transform: translateY(18px) scale(.97); }
  to   { opacity: 1; transform: none; }
}

@media (min-width: 768px) {

  /* ── 1. Release the phone-width column ───────────────────────── */
  html body { max-width: none !important; margin: 0 !important; }

  /* ── 2. HERO: full-bleed, cinematic, text aligned to the grid ── */
  #view-home > section:first-child { height: min(82vh, 820px) !important; min-height: 520px; }
  #view-home > section:first-child > img { object-position: center 45%; }
  #view-home > section:first-child > .absolute.bottom-0 {
    padding-left:  max(2rem, calc((100% - var(--xw)) / 2 + 1.25rem)) !important;
    padding-right: max(2rem, calc((100% - var(--xw)) / 2 + 1.25rem)) !important;
    padding-bottom: 4.5rem !important;
  }
  #view-home > section:first-child h1 {
    font-size: clamp(3rem, 5.5vw, 5rem) !important;
    margin-bottom: .5rem;
  }
  #view-home > section:first-child p { font-size: 1.1rem; }
  .nk-hero-logo { height: clamp(76px, 7vw, 112px); }
  #view-login .nk-logo { height: 60px !important; }

  /* ── 3. Home content: centred container ──────────────────────── */
  #view-home > section:not(:first-child) {
    max-width: var(--xw);
    margin-left: auto !important;
    margin-right: auto !important;
  }
  #view-home > section.mx-5 { width: calc(100% - 2.5rem); }
  #view-home > section.h-40 { height: 13rem; }

  /* ── 4. Page containers ──────────────────────────────────────── */
  #view-boats, #view-saved, #view-mybookings, #view-tours {
    max-width: var(--xw);
    margin-left: auto;
    margin-right: auto;
  }
  #view-profile { max-width: 760px; margin-left: auto; margin-right: auto; }

  /* ── 5. Fleet: category chips in one row, cards in a grid ────── */
  #view-boats .grid.grid-cols-3 {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    max-width: 760px;
  }
  #property-list {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem !important;
  }
  #property-list > .text-center { grid-column: 1 / -1; }

  /* ── 6. Saved / My Bookings / Tours grids ────────────────────── */
  #saved-list, #mybookings-list, #tour-list {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem !important;
    align-items: start;
  }
  #saved-list > .property-card, #mybookings-list > div { margin-bottom: 0 !important; }
  #saved-list > .flex-col, #mybookings-list > .flex-col, #tour-list > .flex-col { grid-column: 1 / -1; }
  #mybookings-tabs { max-width: 520px; }
  #view-tours > div:first-child { margin: 1.25rem 1.25rem 0; border-radius: 1.75rem; height: 14rem; }

  /* ── 7. Property detail: image left (sticky), info right ─────── */
  #view-detail.active {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: start;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 2rem 120px;
  }
  #view-detail > .relative {
    grid-column: 1; grid-row: 1 / span 2;
    position: sticky; top: 1.5rem;
    border-radius: 1.75rem; overflow: hidden;
    box-shadow: var(--shadow-float);
  }
  #detail-hero-img, #detail-hero-src { height: min(76vh, 700px) !important; }
  #view-detail > .px-5 { grid-column: 2; grid-row: 1; padding-left: 0; padding-right: 0; padding-top: .5rem; }
  #view-detail > .sticky-bottom {
    grid-column: 2; grid-row: 2;
    position: sticky; bottom: 96px;
    border: 1px solid #eef0ef; border-radius: 1.25rem;
  }
  #view-detail #gallery-img-1, #view-detail #gallery-img-2, #view-detail #gallery-img-3 { height: 8rem; }

  /* ── 8. Login: centred card on branded backdrop ──────────────── */
  #view-login.active {
    display: flex; align-items: center; justify-content: center;
    min-height: 100vh; padding: 2rem !important;
    background: linear-gradient(145deg, #082e23 0%, #0d4f3c 55%, #1a7a5e 100%);
  }
  #view-login > div {
    width: 100%; max-width: 480px;
    min-height: 0 !important;
    border-radius: 2rem; overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,.35);
  }

  /* ── 9. Navigation pill: always show labels ──────────────────── */
  .pill-nav { bottom: calc(24px + env(safe-area-inset-bottom, 0px)); padding: 6px; gap: 6px; }
  .nav-item { padding: 11px 18px; font-size: .875rem; }
  .nav-item.active-nav { padding: 11px 20px; }
  .nav-item .nav-label { display: inline-block; }

  /* ── 10. WhatsApp concierge: bottom-right of the window ──────── */
  .whatsapp-fab { right: 1.75rem; bottom: calc(28px + env(safe-area-inset-bottom, 0px)); }

  /* ── 11. Bottom sheets become centred dialogs ────────────────── */
  #bookingModal, #paymentModal, #listingModal, #previewModal, .admin-modal-overlay {
    align-items: center; padding: 1.5rem;
  }
  .modal-sheet, .payment-sheet, .listing-sheet, .preview-sheet, .admin-modal-sheet {
    max-width: 520px !important;
    border-radius: 1.75rem !important;
    animation: xDialogIn .38s cubic-bezier(.2,.8,.2,1) both !important;
  }
  .modal-sheet { max-height: 90vh; overflow-y: auto; }
  #xsheet { align-items: center; padding: 1.5rem; }
  #xsheet .sh {
    max-width: 520px; border-radius: 1.75rem; padding-bottom: 1.5rem;
    animation: xDialogIn .38s cubic-bezier(.2,.8,.2,1) both;
  }

  /* Auth sheets → centred dialogs */
  #auth-sheet, #auth-gate-sheet {
    bottom: auto; top: 50%;
    max-width: 460px; max-height: 92vh; overflow-y: auto;
    border-radius: 2rem;
    transform: translate(-50%, -46%) scale(.98);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: transform .4s cubic-bezier(.2,.8,.2,1), opacity .3s ease, visibility 0s linear .4s;
  }
  #auth-sheet.open, #auth-gate-sheet.open {
    transform: translate(-50%, -50%);
    opacity: 1; visibility: visible; pointer-events: auto;
    transition-delay: 0s;
  }

  /* Notification drawer docks to the window's right edge */
  #notif-panel.open { right: 0 !important; }

  /* ── 12. Operator portal ─────────────────────────────────────── */
  #view-agent > .bg-emerald > .relative { max-width: 960px; margin: 0 auto; }
  #op-body { max-width: 960px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }

  /* ── 13. Admin console ───────────────────────────────────────── */
  #view-admin > div:first-child > .flex { max-width: 1100px; margin: 0 auto; }
  #view-admin > .overflow-x-auto, #view-admin #ad-body { max-width: 1100px; margin: 0 auto; width: 100%; }
}

/* ── Wide desktop: 3-column card grids ─────────────────────────── */
@media (min-width: 1180px) {
  #property-list, #saved-list, #tour-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

/* ── Accessibility: honour reduced-motion ──────────────────────── */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .modal-sheet, .payment-sheet, .listing-sheet, .preview-sheet, .admin-modal-sheet, #xsheet .sh { animation: none !important; }
}

</style>

<!-- NAUKA CUSTOMER EXPERIENCE PATCH -->
<style id="nauka-customer-v4">
  .nk-home-toolbar{position:absolute;inset:0 0 auto;z-index:12;display:flex;align-items:center;justify-content:space-between;padding:18px 18px 0;color:#fff}
  .nk-toolbar-logo{font:700 .92rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.12em;text-shadow:0 2px 14px rgba(0,0,0,.35)}
  .nk-toolbar-logo span{color:#28c86d}
  .nk-toolbar-actions{display:flex;align-items:center;gap:9px}
  .nk-icon-button{position:relative;width:42px;height:42px;border-radius:15px;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(8,46,35,.38);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(14px);box-shadow:0 6px 24px rgba(0,0,0,.15);transition:transform .2s,background .2s}
  .nk-icon-button:hover{transform:translateY(-2px);background:rgba(8,46,35,.62)}
  .nk-notif-count{position:absolute;right:-3px;top:-5px;min-width:18px;height:18px;padding:0 5px;border-radius:99px;display:flex;align-items:center;justify-content:center;background:#e34848;color:#fff;border:2px solid rgba(8,46,35,.35);font:800 9px/1 'Plus Jakarta Sans',sans-serif}
  .nk-experience-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .nk-experience-card{position:relative;min-height:152px;overflow:hidden;padding:18px;border-radius:24px;text-align:left;border:1px solid rgba(13,79,60,.1);box-shadow:0 10px 30px rgba(13,79,60,.08);transition:transform .25s,box-shadow .25s;background:#fff}
  .nk-experience-card:hover{transform:translateY(-4px);box-shadow:0 18px 36px rgba(13,79,60,.14)}
  .nk-experience-card:after{content:'';position:absolute;right:-24px;bottom:-30px;width:100px;height:100px;border-radius:50%;background:rgba(13,79,60,.07)}
  .nk-experience-card h3{position:relative;z-index:1;font:700 1.02rem/1.05 'Playfair Display',serif;color:#0a192f;max-width:120px}
  .nk-experience-card p{position:relative;z-index:1;color:#718096;font:500 .68rem/1.45 'Plus Jakarta Sans',sans-serif;margin-top:10px;max-width:145px}
  .nk-experience-card .nk-experience-icon{position:relative;z-index:1;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#e8f2ee;color:#0d4f3c;margin-bottom:13px}
  .nk-experience-card:nth-child(2) .nk-experience-icon{background:#fdf8ec;color:#b18a2f}.nk-experience-card:nth-child(3) .nk-experience-icon{background:#edf7ff;color:#1875a8}
  .nk-experience-card button{position:absolute;right:14px;bottom:14px;z-index:2;border:0;background:transparent;color:#0d4f3c;font:800 .66rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  .nk-section-kicker{display:flex;align-items:center;gap:8px;justify-content:center;color:#159759;font:800 .66rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase}
  .nk-section-kicker:before,.nk-section-kicker:after{content:'';width:34px;height:2px;background:#35bc79}
  .nk-review-section{margin:22px 0 8px;padding:22px 0 4px;background:#f1f8f4;border-radius:28px}
  .nk-review-track{display:flex;gap:12px;overflow-x:auto;padding:0 16px 12px;scroll-snap-type:x mandatory;scrollbar-width:none}
  .nk-review-track::-webkit-scrollbar{display:none}.nk-review-card{flex:0 0 min(84vw,320px);scroll-snap-align:start;background:#fff;border-radius:22px;padding:17px;box-shadow:0 7px 22px rgba(13,79,60,.08);border:1px solid rgba(13,79,60,.08);cursor:pointer}
  .nk-review-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}.nk-review-avatar{width:38px;height:38px;border-radius:50%;object-fit:cover;background:#e8f2ee}.nk-review-name{font:700 .78rem/1.1 'Plus Jakarta Sans',sans-serif;color:#1a1a18}.nk-review-meta{font:500 .64rem/1.2 'Plus Jakarta Sans',sans-serif;color:#9aa3a0;margin-top:3px}.nk-review-stars{color:#e4b938;font-size:.72rem;letter-spacing:1px}.nk-review-quote{font:500 .78rem/1.55 'Plus Jakarta Sans',sans-serif;color:#5c6863;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .nk-footer{margin-top:18px;padding:30px 20px 30px;border-radius:32px 32px 0 0;background:#082e23;color:#fff;text-align:center}.nk-footer-logo{font:800 1rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.12em}.nk-footer-logo span{color:#2cd06f}.nk-footer-copy{margin:12px auto 18px;max-width:260px;color:rgba(255,255,255,.58);font:500 .72rem/1.55 'Plus Jakarta Sans',sans-serif}.nk-footer-links{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}.nk-footer-links a{display:inline-flex;align-items:center;gap:6px;padding:9px 12px;border-radius:99px;background:rgba(255,255,255,.09);color:#fff;font:700 .68rem/1 'Plus Jakarta Sans',sans-serif}.nk-footer-bottom{margin-top:24px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.4);font:500 .65rem/1.4 'Plus Jakarta Sans',sans-serif}
  #nk-concierge-backdrop,#nk-gallery-backdrop,#nk-review-backdrop{display:none;position:fixed;inset:0;z-index:1800;background:rgba(8,46,35,.58);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:18px}#nk-concierge-backdrop.open,#nk-gallery-backdrop.open,#nk-review-backdrop.open{display:flex;animation:modalBg .25s ease both}
  .nk-contact-card,.nk-review-dialog{width:min(100%,390px);background:#fff;border-radius:28px;padding:24px 18px 18px;box-shadow:0 28px 80px rgba(0,0,0,.32);animation:xDialogIn .35s cubic-bezier(.2,.8,.2,1) both}.nk-contact-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px}.nk-contact-title{font:500 1.8rem/1.05 'Playfair Display',serif;color:#1a1a18}.nk-contact-title em{font-style:italic;color:#0d4f3c}.nk-contact-close{width:34px;height:34px;border:0;border-radius:50%;background:#f2f4f2;color:#59615d}.nk-open-state{display:flex;align-items:center;gap:10px;font:800 .83rem/1.2 'Plus Jakarta Sans',sans-serif;color:#1a1a18}.nk-open-dot{width:11px;height:11px;border-radius:50%;background:#24bd65;box-shadow:0 0 0 5px rgba(36,189,101,.13)}.nk-hours{margin-left:21px;margin-top:4px;color:#777f7a;font:500 .76rem/1.3 'Plus Jakarta Sans',sans-serif}.nk-contact-number{display:flex;align-items:center;gap:10px;margin:24px 0 18px;color:#1a1a18;font:800 clamp(1.65rem,7vw,2.15rem)/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.01em}.nk-contact-number i{font-size:1.45rem;color:#717975}.nk-contact-actions{display:grid;gap:10px}.nk-contact-action{display:flex;align-items:center;justify-content:center;gap:10px;min-height:58px;border:0;border-radius:18px;font:800 .95rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer;transition:transform .2s,filter .2s}.nk-contact-action:hover{transform:translateY(-2px);filter:brightness(1.03)}.nk-contact-action.wa{background:#16853f;color:#fff}.nk-contact-action.call{background:#f4f7f5;color:#1a1a18;border:1px solid #dce6e0}.nk-contact-action.mail{background:#fff;color:#616b66;border:0;font-weight:600}.nk-contact-action.mail i{color:#0d4f3c}.nk-contact-note{text-align:center;color:#a0a6a2;font:500 .68rem/1.45 'Plus Jakarta Sans',sans-serif;margin-top:5px}
  #nk-redirect-modal{display:none;position:fixed;inset:0;z-index:2400;background:rgba(8,46,35,.58);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:18px}#nk-redirect-modal.open{display:flex}.nk-redirect-card{width:min(100%,370px);padding:28px 22px 20px;text-align:center;background:#fff;border-radius:28px;box-shadow:0 30px 80px rgba(0,0,0,.35);animation:xDialogIn .35s cubic-bezier(.2,.8,.2,1) both}.nk-redirect-icon{width:64px;height:64px;margin:0 auto 15px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e8f2ee;color:#0d4f3c;font-size:1.6rem}.nk-redirect-card h3{font:500 1.5rem/1.15 'Playfair Display',serif;color:#1a1a18}.nk-redirect-card p{margin:9px 0 0;color:#64706a;font:500 .82rem/1.55 'Plus Jakarta Sans',sans-serif}.nk-redirect-timer{margin-top:15px;color:#0d4f3c;font:800 .72rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.06em;text-transform:uppercase}
  .nk-mode-card{margin:18px 0 22px;padding:17px;border-radius:24px;background:#f1f8f4;border:1px solid #d6e9dd}.nk-mode-tabs{display:grid;grid-template-columns:1fr 1fr;gap:7px;background:#dceee3;padding:4px;border-radius:15px;margin-bottom:14px}.nk-mode-tab{padding:11px 8px;border:0;border-radius:12px;background:transparent;color:#4f645a;font:800 .72rem/1 'Plus Jakarta Sans',sans-serif}.nk-mode-tab.active{background:#fff;color:#0d4f3c;box-shadow:0 4px 12px rgba(13,79,60,.11)}.nk-mode-title{font:700 1rem/1.2 'Playfair Display',serif;color:#1a1a18}.nk-mode-copy{margin-top:5px;color:#68756e;font:500 .72rem/1.5 'Plus Jakarta Sans',sans-serif}.nk-timeline{display:grid;gap:9px;margin-top:14px}.nk-timeline-row{display:grid;grid-template-columns:18px 1fr;gap:8px;align-items:start}.nk-timeline-dot{width:10px;height:10px;margin-top:3px;border-radius:50%;background:#17b968;box-shadow:0 0 0 4px rgba(23,185,104,.12)}.nk-timeline-row b{display:block;color:#1a1a18;font:800 .68rem/1.2 'Plus Jakarta Sans',sans-serif}.nk-timeline-row span{display:block;color:#7c8781;font:500 .66rem/1.35 'Plus Jakarta Sans',sans-serif;margin-top:2px}
  .nk-detail-supplement{display:grid;gap:14px;margin:-6px 0 22px}.nk-detail-mini{padding:16px;border-radius:22px;background:#fff;border:1px solid #edf1ee;box-shadow:0 6px 18px rgba(13,79,60,.05)}.nk-detail-mini h4{margin:0 0 8px;font:700 .98rem/1.2 'Playfair Display',serif;color:#1a1a18}.nk-detail-mini p{margin:0;color:#718078;font:500 .7rem/1.5 'Plus Jakarta Sans',sans-serif}.nk-detail-list{display:grid;gap:6px;margin:0;padding:0;list-style:none}.nk-detail-list li{display:flex;gap:7px;color:#69766f;font:500 .68rem/1.45 'Plus Jakarta Sans',sans-serif}.nk-detail-list li:before{content:'•';color:#11a85a;font-size:1.2rem;line-height:.7}
  .nk-gallery-modal{width:min(100%,520px);background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.38);animation:xDialogIn .35s cubic-bezier(.2,.8,.2,1) both}.nk-gallery-stage{position:relative;background:#082e23}.nk-gallery-stage img{display:block;width:100%;height:min(62vh,440px);object-fit:cover}.nk-gallery-close{position:absolute;right:14px;top:14px;width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(8,46,35,.65);color:#fff}.nk-gallery-arrow{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:#0d4f3c}.nk-gallery-arrow.prev{left:12px}.nk-gallery-arrow.next{right:12px}.nk-gallery-caption{padding:14px 17px;color:#65736b;font:600 .75rem/1.3 'Plus Jakarta Sans',sans-serif}.nk-gallery-thumbs{display:flex;gap:7px;padding:0 17px 17px;overflow:auto}.nk-gallery-thumbs img{width:58px;height:42px;object-fit:cover;border-radius:9px;opacity:.55}.nk-gallery-thumbs img.active{opacity:1;outline:2px solid #0d4f3c;outline-offset:2px}
  #nk-calendar-pop{display:none;position:fixed;z-index:2300;width:min(calc(100vw - 32px),355px);padding:16px;background:#fff;border:1px solid #e4ece7;border-radius:24px;box-shadow:0 22px 65px rgba(13,79,60,.2)}#nk-calendar-pop.open{display:block;animation:xDialogIn .25s ease both}.nk-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.nk-cal-month{font:800 .88rem/1 'Plus Jakarta Sans',sans-serif;color:#1a1a18}.nk-cal-nav{width:30px;height:30px;border:0;border-radius:50%;background:#f1f8f4;color:#0d4f3c}.nk-cal-week,.nk-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center}.nk-cal-week{margin-bottom:6px;color:#a1aaa5;font:800 .58rem/1 'Plus Jakarta Sans',sans-serif}.nk-cal-day{height:34px;border:0;border-radius:50%;background:transparent;color:#39463f;font:600 .68rem/1 'Plus Jakarta Sans',sans-serif}.nk-cal-day.today{color:#d64040;box-shadow:inset 0 0 0 1.5px #e04d4d}.nk-cal-day.occupied{background:#e95151;color:#fff}.nk-cal-day.disabled{opacity:.25}.nk-cal-day:not(.disabled):hover{background:#e8f2ee;color:#0d4f3c}.nk-cal-note{margin-top:12px;color:#909b95;font:500 .62rem/1.35 'Plus Jakarta Sans',sans-serif;text-align:center}.nk-cal-note strong{color:#dd4b4b}
  .nk-long-stay{padding:10px 12px;border-radius:14px;background:#fdf8ec;color:#8d7023;font:600 .68rem/1.45 'Plus Jakarta Sans',sans-serif}.nk-long-stay button{display:block;margin-top:7px;border:0;background:transparent;color:#0d4f3c;font:800 .68rem/1 'Plus Jakarta Sans',sans-serif;padding:0;cursor:pointer}
  .nk-avatar-img{width:100%;height:100%;object-fit:cover;border-radius:inherit}.nk-profile-banner{border-radius:0 0 28px 28px}
  @media(max-width:430px){.nk-experience-card{min-height:164px;padding:14px}.nk-experience-card h3{font-size:.92rem}.nk-experience-card p{font-size:.63rem}.nk-toolbar-logo{font-size:.8rem}}
  @media(min-width:768px){.nk-home-toolbar{padding:24px max(2rem,calc((100% - var(--xw))/2 + 1.25rem)) 0}.nk-footer{border-radius:30px;margin-left:auto;margin-right:auto;max-width:var(--xw)}}
  #view-home > section:has(#routes) .nk-old-route-replaced{display:none}
  #view-home > section:has(#routes) > #routes{margin-bottom:26px!important}
  #view-home{padding-bottom:0!important}
  #view-detail h4.nk-hidden-map,#view-detail h4.nk-hidden-map + div{display:none!important}
  #form-agent > .bg-gold-pale{display:none!important}
  #view-home > section.mx-5.mb-6,#view-home > section.mx-5.mb-8{display:none!important}
  #mybookings-list button[onclick^="acceptPriceQuote"],#mybookings-list button[onclick^="declinePriceQuote"]{display:none!important}
</style>

<style id="nauka-customer-v5">
  /* Keep the home chrome intentionally quiet: the home screen only needs the bell. */
  .nk-home-toolbar{pointer-events:none}
  .nk-home-toolbar > *{pointer-events:auto}
  .nk-toolbar-logo{display:none!important}
  .nk-toolbar-actions{margin-left:auto}

  /* The action label has its own lower row so it can never sit on top of copy. */
  .nk-experience-card{min-height:184px;padding:16px 16px 50px}
  .nk-experience-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .nk-experience-card h3{max-width:none}
  .nk-experience-card p{max-width:100%;padding-right:0;margin-top:9px}
  .nk-experience-card button{left:16px;right:auto;bottom:16px;display:inline-flex;align-items:center;gap:6px;min-height:25px;padding:0}
  .nk-experience-card:nth-child(3){grid-column:1/-1;min-height:148px}
  .nk-experience-card:nth-child(3) p{max-width:72%}
  @media(max-width:430px){.nk-experience-card{min-height:176px;padding:14px 14px 48px}.nk-experience-card button{left:14px;bottom:14px}}

  /* Notifications follow the supplied cream, grouped-list reference. */
  #notif-panel.nk-notif-page{right:-100%!important;width:min(100%,480px)!important;height:100dvh!important;overflow-y:auto!important;background:#fbfaf1!important;color:#111!important;border:0!important;border-radius:0!important;box-shadow:-22px 0 55px rgba(20,24,16,.18)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;transition:right .36s cubic-bezier(.32,.72,0,1)!important}
  #notif-panel.nk-notif-page.open{right:0!important}
  #notif-backdrop{background:rgba(21,24,17,.25)!important;backdrop-filter:blur(3px)!important;-webkit-backdrop-filter:blur(3px)!important}
  .nk-notification-page{min-height:100%;padding:32px 0 30px;background:#fbfaf1}
  .nk-notification-head{display:flex;align-items:center;gap:14px;padding:0 25px 26px}
  .nk-notification-back{width:30px;height:30px;border:0;background:transparent;color:#111;font:400 2.15rem/1 Arial,sans-serif;display:flex;align-items:center;justify-content:center;padding:0;cursor:pointer}
  .nk-notification-title{display:flex;align-items:center;gap:12px;margin:0;color:#080808;font:800 clamp(1.85rem,8vw,2.65rem)/1 'Plus Jakarta Sans',sans-serif;letter-spacing:-.06em}
  .nk-notification-badge{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:#ef3945;color:#fff;font:800 .95rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:0}
  .nk-notification-section{margin:0}
  .nk-notification-section h4{margin:0;padding:12px 25px 14px;color:#777972;font:700 1.15rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:-.03em;background:#fbfaf1}
  .nk-notification-list{background:#f2f0e5}
  .nk-notification-row{display:flex;align-items:center;gap:16px;min-height:104px;padding:17px 25px;border-bottom:1px solid rgba(30,32,24,.08);cursor:pointer}
  .nk-notification-row:nth-child(even){background:#f8f7ef}
  .nk-notification-row:active{background:#ebe9dc}
  .nk-notification-icon{width:58px;height:58px;border-radius:17px;display:flex;align-items:center;justify-content:center;flex:none;background:#050505;color:#fff;font-size:1.25rem}
  .nk-notification-icon.heart{color:#dc4771}.nk-notification-icon.grid{color:#58df5b}.nk-notification-icon.badge{color:#8bc4ef}.nk-notification-icon.pin{color:#5edc7c}
  .nk-notification-copy{min-width:0;flex:1;color:#111;font:500 .96rem/1.35 'Plus Jakarta Sans',sans-serif}
  .nk-notification-copy strong{font-weight:700}
  .nk-notification-dot{width:10px;height:10px;border-radius:50%;flex:none;background:#ef3945;opacity:0}
  .nk-notification-row.unread .nk-notification-dot{opacity:1}
  @media(max-width:420px){.nk-notification-head{padding-left:20px;padding-right:20px}.nk-notification-section h4{padding-left:20px;padding-right:20px}.nk-notification-row{padding-left:20px;padding-right:20px;gap:13px}.nk-notification-copy{font-size:.88rem}.nk-notification-icon{width:54px;height:54px}}

  /* Avoid stale fixed layers intercepting the next fleet selection. */
  #bookingModal:not(.open),#nk-calendar-pop:not(.open),#nk-gallery-backdrop:not(.open),#nk-concierge-backdrop:not(.open){pointer-events:none}
  #nk-calendar-pop.open{pointer-events:auto}
</style>

<style id="nauka-customer-v6">
  /* Main tab headings use the same confident weight throughout the app. */
  .view h2.font-display{font-weight:700!important}

  /* Compact, image-free notification cards with a glass surface behind them. */
  #notif-panel.nk-notif-page{background:rgba(245,248,244,.16)!important;backdrop-filter:blur(32px) saturate(145%)!important;-webkit-backdrop-filter:blur(32px) saturate(145%)!important}
  #notif-backdrop{background:rgba(21,24,17,.12)!important;backdrop-filter:blur(3px)!important;-webkit-backdrop-filter:blur(3px)!important}
  .nk-notification-page{background:rgba(246,248,243,.18)!important;backdrop-filter:blur(24px) saturate(135%);-webkit-backdrop-filter:blur(24px) saturate(135%);padding:32px 18px 34px}
  .nk-notification-head{padding:0 7px 24px}
  .nk-notification-section h4{padding:12px 7px 11px;background:transparent}
  .nk-notification-list{display:grid;gap:11px;background:transparent}
  .nk-notification-row,.nk-notification-row:nth-child(even){display:flex;align-items:center;min-height:0;padding:17px 18px;border:1px solid rgba(255,255,255,.74);border-radius:22px;background:rgba(255,255,255,.57);box-shadow:0 10px 26px rgba(44,63,49,.09),inset 0 1px 0 rgba(255,255,255,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
  .nk-notification-row.unread{background:rgba(255,255,255,.72)}
  .nk-notification-icon{display:none!important}
  .nk-notification-copy{display:flex;flex-direction:column;gap:5px;font-size:.9rem;line-height:1.35}
  .nk-notification-message{display:block;color:#3f4d46}
  .nk-notification-copy:before,.nk-notification-copy:after{content:none!important}
  .nk-notification-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;line-height:1}
  .nk-notification-meta strong{color:#111;font-size:.8rem;font-weight:800}
  .nk-notification-meta small{color:#8a918b;font-size:.68rem;font-weight:500}
  .nk-notification-dot{margin-left:7px}
  #nk-notification-reader{display:none;position:fixed;inset:0;z-index:2850;align-items:center;justify-content:center;padding:18px;background:rgba(8,46,35,.16);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
  #nk-notification-reader.open{display:flex;animation:modalBg .24s ease both}
  .nk-notification-reader-card{width:min(100%,390px);padding:24px 20px 18px;border:1px solid rgba(255,255,255,.78);border-radius:25px;background:rgba(255,255,255,.72);box-shadow:0 25px 70px rgba(8,46,35,.2);backdrop-filter:blur(28px);-webkit-backdrop-filter:blur(28px);animation:xDialogIn .3s ease both}
  .nk-notification-reader-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#758078;font:600 .7rem/1 'Plus Jakarta Sans',sans-serif}
  .nk-notification-reader-card h3{margin-top:14px;color:#111;font:800 1.35rem/1.15 'Playfair Display',serif}
  .nk-notification-reader-card p{margin-top:10px;color:#3f4d46;font:500 .86rem/1.55 'Plus Jakarta Sans',sans-serif}
  .nk-notification-reader-done{width:100%;min-height:46px;margin-top:18px;border:0;border-radius:15px;background:#0d4f3c;color:#fff;font:800 .75rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  @media(max-width:420px){.nk-notification-page{padding-left:12px;padding-right:12px}.nk-notification-head{padding-left:7px;padding-right:7px}.nk-notification-copy{font-size:.84rem}}

  #nk-mail-backdrop{display:none;position:fixed;inset:0;z-index:2750;align-items:center;justify-content:center;padding:18px;background:rgba(8,46,35,.34);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  #nk-mail-backdrop.open{display:flex;animation:modalBg .25s ease both}
  .nk-mail-card{width:min(100%,390px);padding:25px 20px 18px;border:1px solid rgba(255,255,255,.78);border-radius:26px;background:rgba(255,255,255,.88);box-shadow:0 26px 70px rgba(8,46,35,.25);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);animation:xDialogIn .3s ease both}
  .nk-mail-card h3{font:700 1.45rem/1.1 'Playfair Display',serif;color:#1a1a18}
  .nk-mail-card p{margin-top:7px;color:#6d7771;font:500 .78rem/1.45 'Plus Jakarta Sans',sans-serif}
  .nk-mail-address{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:18px 0 15px;padding:13px 14px;border-radius:15px;background:#f1f6f2;color:#0d4f3c;font:700 .82rem/1.2 'Plus Jakarta Sans',sans-serif;word-break:break-all}
  .nk-mail-copy{border:0;border-radius:11px;padding:8px 10px;background:#fff;color:#0d4f3c;font:800 .68rem/1 'Plus Jakarta Sans',sans-serif;white-space:nowrap;cursor:pointer}
  .nk-mail-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .nk-mail-actions button{min-height:46px;border:0;border-radius:15px;font:800 .75rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  .nk-mail-open{background:#0d4f3c;color:#fff}.nk-mail-cancel{background:#eef3ef;color:#50635a}

  /* Booking has only the two cruise modes; route choices stay out of the modal. */
  #booking-route-wrap,#route-pills{display:none!important}
  #nk-booking-cruise-mode{display:grid;gap:9px}
  #nk-booking-cruise-mode .nk-mode-tabs{margin:0}
  .nk-review-section-more{margin-top:0;padding-top:0;border-top:0}
  .nk-review-section > .nk-review-track:first-of-type{padding-bottom:12px}
</style>

<style id="nauka-customer-v7">
  .nk-category-scroller{display:flex;gap:9px;overflow-x:auto;scrollbar-width:none}
  .nk-category-scroller::-webkit-scrollbar{display:none}
  .nk-category-chip{display:flex;align-items:center;gap:8px;min-width:max-content;padding:8px 12px;border:1px solid #e3ebe7;border-radius:17px;background:rgba(255,255,255,.9);color:#53615a;font:700 .68rem/1 'Plus Jakarta Sans',sans-serif;box-shadow:0 5px 14px rgba(13,79,60,.06);white-space:nowrap;transition:all .2s}
  .nk-category-chip:hover,.nk-category-chip.selected{border-color:#0d4f3c;background:#e8f2ee;color:#0d4f3c;box-shadow:0 6px 16px rgba(13,79,60,.12)}
  .nk-category-mark{display:inline-flex;align-items:center;gap:3px;color:#0d4f3c}
  .nk-category-mark b{font-size:.9rem;line-height:1}
  .nk-category-mark i{font-size:.88rem}
  .nk-room-pricing{display:flex;align-items:flex-start;gap:8px;margin:0 0 8px;padding:10px 11px;border:1px solid rgba(201,168,76,.45);border-radius:14px;background:linear-gradient(135deg,#fff8df,#f1f8f4 72%);color:#0d4f3c;font:700 .68rem/1.25 'Plus Jakarta Sans',sans-serif;box-shadow:0 5px 15px rgba(13,79,60,.08)}
  .nk-room-pricing i{margin-top:1px;font-size:.9rem;color:#a07a1a}
  .nk-room-pricing b{display:block;color:#8b6713;font:800 .68rem/1.1 'Plus Jakarta Sans',sans-serif;letter-spacing:.06em}
  .nk-room-pricing small{display:block;margin-top:4px;color:#5f6d65;font:600 .6rem/1.3 'Plus Jakarta Sans',sans-serif}
  .nk-room-card-label{display:inline-flex;align-items:center;gap:5px;margin-bottom:7px;color:#0d4f3c;font:800 .63rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.03em;text-transform:uppercase}
  .nk-room-card-label i{font-size:.7rem}
  #property-list .property-card.room-listing-card .nk-room-pricing{display:flex}
  #customer-bottom-nav{z-index:2600!important;pointer-events:auto!important}
  #bookingModal #booking-date{text-align:center;text-align-last:center;padding-left:1rem;padding-right:1rem}
  #bookingModal #booking-date::-webkit-datetime-edit{text-align:center}
  .nk-detail-heading{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"title stars" "location reviews";column-gap:16px;row-gap:5px;align-items:center}
  #detail-title{grid-area:title;min-width:0;max-width:100%;font-size:clamp(1.45rem,5vw,2.25rem)!important;line-height:1.08!important;font-weight:700!important;overflow-wrap:normal;word-break:normal}
  #detail-stars{grid-area:stars;justify-content:flex-end;align-self:end;white-space:nowrap}
  #detail-location{grid-area:location;min-width:0;margin-top:0!important;line-height:1.25}
  #detail-reviews{grid-area:reviews;margin-left:0!important;text-align:right;white-space:nowrap;line-height:1.25}
  @media(max-width:430px){.nk-detail-heading{column-gap:10px;row-gap:4px}#detail-reviews{font-size:.65rem!important}}
  #nk-profile-feature-backdrop{display:none;position:fixed;inset:0;z-index:2800;align-items:flex-end;justify-content:center;padding:14px;background:rgba(8,46,35,.28);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
  #nk-profile-feature-backdrop.open{display:flex;animation:modalBg .24s ease both}
  .nk-profile-feature-card{width:min(100%,440px);max-height:min(82dvh,620px);overflow-y:auto;padding:22px 18px 18px;border:1px solid rgba(255,255,255,.78);border-radius:26px 26px 18px 18px;background:rgba(255,255,255,.9);box-shadow:0 24px 70px rgba(8,46,35,.24);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);animation:sheetUp .32s cubic-bezier(.2,.8,.2,1) both}
  .nk-profile-feature-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}
  .nk-profile-feature-head h3{color:#1a1a18;font:700 1.45rem/1.1 'Playfair Display',serif}
  .nk-profile-feature-head p{margin-top:5px;color:#7b8780;font:500 .72rem/1.4 'Plus Jakarta Sans',sans-serif}
  .nk-profile-field{display:grid;gap:7px;margin-top:14px}
  .nk-profile-field label{color:#758078;font:800 .65rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.08em;text-transform:uppercase}
  .nk-profile-field select{width:100%;min-height:48px;padding:0 13px;border:1px solid #dce8e0;border-radius:14px;background:#f7faf8;color:#163b2d;font:700 .8rem 'Plus Jakarta Sans',sans-serif;outline:none}
  .nk-profile-feature-save{width:100%;min-height:48px;margin-top:20px;border:0;border-radius:15px;background:#0d4f3c;color:#fff;font:800 .76rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  .nk-currency-prompt{display:none;margin-top:14px;padding:14px;border:1px solid rgba(201,168,76,.4);border-radius:17px;background:linear-gradient(135deg,#fff8df,#f1f8f4);box-shadow:0 7px 20px rgba(139,103,19,.08)}
  .nk-currency-prompt.open{display:block;animation:xDialogIn .22s ease both}
  .nk-currency-prompt strong{display:block;color:#735613;font:800 .78rem/1.2 'Plus Jakarta Sans',sans-serif}
  .nk-currency-prompt p{margin-top:5px;color:#69766f;font:500 .68rem/1.4 'Plus Jakarta Sans',sans-serif}
  .nk-currency-prompt-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:11px}
  .nk-currency-prompt-actions button{min-height:38px;border:0;border-radius:12px;font:800 .68rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  .nk-currency-rate-yes{background:#0d4f3c;color:#fff}.nk-currency-rate-no{background:#fff;color:#53635a;border:1px solid #dce8e0!important}
  .nk-manual-rate-label{display:block;margin-top:12px;color:#65756d;font:800 .66rem/1.25 'Plus Jakarta Sans',sans-serif}
  .nk-manual-rate-input{width:100%;min-height:42px;margin-top:7px;padding:0 12px;border:1px solid #d5e3da;border-radius:12px;background:#fff;color:#163b2d;font:700 .8rem 'Plus Jakarta Sans',sans-serif;outline:none}
  .nk-manual-rate-input:focus{border-color:#0d4f3c;box-shadow:0 0 0 3px rgba(13,79,60,.1)}
  .nk-chip-balance{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;border:1px solid rgba(201,168,76,.38);border-radius:19px;background:linear-gradient(135deg,#fff8df,#f1f8f4);box-shadow:0 8px 24px rgba(139,103,19,.08)}
  .nk-chip-balance strong{display:block;color:#8b6713;font:800 1.8rem/1 'Plus Jakarta Sans',sans-serif}
  .nk-chip-balance span{display:block;margin-top:5px;color:#69766f;font:600 .68rem/1.3 'Plus Jakarta Sans',sans-serif}
  .nk-chip-icon{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:#c9a84c;color:#fff;font-size:1.1rem}
  .nk-chip-list{display:grid;gap:8px;margin-top:15px}
  .nk-chip-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 13px;border-radius:14px;background:#f5f8f6;border:1px solid #e7efea}
  .nk-chip-row p{color:#30463b;font:700 .72rem/1.25 'Plus Jakarta Sans',sans-serif}
  .nk-chip-row small{display:block;margin-top:3px;color:#89948d;font:500 .64rem/1.2 'Plus Jakarta Sans',sans-serif}
  .nk-chip-amount{color:#0d4f3c;font:800 .76rem/1 'Plus Jakarta Sans',sans-serif;white-space:nowrap}
  .nk-chip-empty{padding:17px 14px;margin-top:15px;border-radius:15px;background:#f5f8f6;color:#758078;font:600 .73rem/1.45 'Plus Jakarta Sans',sans-serif;text-align:center}
  .nk-chip-redeem{width:100%;min-height:46px;margin-top:15px;border:1px solid #dce8e0;border-radius:14px;background:#eef3ef;color:#829087;font:800 .72rem/1 'Plus Jakarta Sans',sans-serif;cursor:not-allowed}
</style>

<script>
(function(){
  'use strict';
  const AVATAR_URLS = [
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273199/18f045b0936ab238ae827e9a0ee0b885_d6y3lr.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273199/e894980513fab0daba640d166222e49a_qqfwla.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273198/5934e727ac6d071bf744fbc59cc34e84_zz6w9s.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273198/396010118a7b68e3d3494ce026d6f416_jqmwpd.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273198/90ac0412146a1ea3b6ac6b66f850c8f6_pqkmod.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273197/1d9d933ba979f19f5ba43f596ed3dab3_btpiwl.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273197/1204d7de501c7e1b121f174c643378f7_nz44gw.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273197/87be62c3f4fa827d5a617a4192d0a4c4_fcxudw.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273197/87d239c65732f941a8f2d9cce9f245f9_qxcztm.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273196/534d5ed36af5c8ff9678976de6b3a4a2_igfqam.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273197/3a87adad06dcfba28c7a2476968f4da4_v4rcfp.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273196/b1f4fd0153976ecc4c9a5bd10e8415c6_gdjs5n.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273196/0e4589338f20bd818b11d779d10b7a4d_ayhdtb.jpg',
    'https://res.cloudinary.com/dxmuistk4/image/upload/v1791273196/68528b9e2dd457ae887a0060d91c521d_llp4wz.jpg'
  ];
  const REVIEWS = [
    ['Ananya Menon','Mumbai','The crew made our anniversary feel effortless. The food, the quiet canals and the sunset deck were all perfect.',0],
    ['Rohan Kapoor','New Delhi','A beautiful, genuinely warm experience. We booked through Nauka and every detail was handled quickly.',1],
    ['Meera Krishnan','Bengaluru','Our children loved the canoe stop and the crew. The boat was spotless and the Kerala lunch was memorable.',2],
    ['Arjun Sharma','Pune','The overnight cruise is the best way to see Alleppey. Calm, comfortable and exactly as described.',3],
    ['Ishita Nair','Chennai','Fast replies, transparent pricing and a lovely route. We will absolutely return for a longer stay.',4],
    ['Nikhil Varma','Hyderabad','The day cruise was beautifully paced, with a delicious lunch and plenty of time to enjoy the villages.',5],
    ['Sara Thomas','Kochi','The boat was peaceful, clean and comfortable. Nauka made the whole booking feel simple.',6],
    ['Devika Rao','Bengaluru','A lovely weekend on the water. The crew was thoughtful and the sunset route was unforgettable.',7],
    ['Kabir Mehta','Mumbai','Clear communication, warm hospitality and a genuinely special way to experience Kerala.',8],
    ['Asha Joseph','Delhi','Everything from check-in to breakfast was smooth. We are already planning our next trip.',9]
  ];
  const propImages = () => (typeof PROPERTIES!=='undefined'?PROPERTIES:[]).filter(p=>p.category==='houseboat').map(p=>p.image).filter(Boolean);
  function todayISO(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function normalizeBlockedDates(data){
    const dates=new Set(), rows=Array.isArray(data)?data:(data?[data]:[]), add=value=>{const iso=String(value||'').slice(0,10);if(/^\d{4}-\d{2}-\d{2}$/.test(iso))dates.add(iso)};
    rows.forEach(row=>{
      if(typeof row==='string'){add(row);return}
      if(!row||typeof row!=='object')return;
      const direct=row.blocked_date??row.date??row.date_value;
      if(direct){add(direct);return}
      const start=String(row.booking_date??row.check_in??row.checkin??'').slice(0,10);
      if(!/^\d{4}-\d{2}-\d{2}$/.test(start))return;
      const checkout=String(row.check_out??row.checkout??row.end_date??'').slice(0,10);
      const nights=Math.max(1,Number(row.nights)||1);
      const last=/^\d{4}-\d{2}-\d{2}$/.test(checkout)&&checkout!==start?addDaysISO(checkout,-1):addDaysISO(start,nights-1);
      for(let cursor=start;cursor<=last;cursor=addDaysISO(cursor,1))add(cursor);
    });
    return dates;
  }
  async function getBlockedDates(propertyId,from,to,cruiseType='night'){
    const rpc=window.naukaSupabase;
    if(!rpc?.rpc||!Number(propertyId))return {dates:new Set(),error:new Error('Live availability is unavailable.')};
    try{
      const result=await rpc.rpc('get_listing_blocked_dates',{p_property_id:Number(propertyId),p_from:from,p_to:to,p_cruise_type:cruiseType==='day'?'day':'night'});
      return {dates:normalizeBlockedDates(result.data),error:result.error||null};
    }catch(error){return {dates:new Set(),error};}
  }
  window.nkNormalizeBlockedDates=normalizeBlockedDates;
  window.nkGetBlockedDates=getBlockedDates;
  function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));}
  function currentCruiseMode(mode){
    if(mode==='day'||mode==='overnight')return mode;
    if(window.nkBookingMode==='day'||window.nkBookingMode==='overnight')return window.nkBookingMode;
    if(window.nkCruiseMode==='day'||window.nkCruiseMode==='overnight')return window.nkCruiseMode;
    if(state.nkCruiseMode==='day'||state.nkCruiseMode==='overnight')return state.nkCruiseMode;
    return state.selectedRoute==='Alleppey Backwater Circuit'?'overnight':'day';
  }
  function cruisePricing(){
    const cfg=(typeof AD_S!=='undefined'&&AD_S.cruisePricing)||{};
    return {dayPercent:Number(cfg.dayPercent)||70,overnightPercent:Number(cfg.overnightPercent)||100};
  }
  function nkPriceFor(prop,mode){
    if(!prop)return 0;
    const base=Number(prop.price)||0;
    if(prop.category!=='houseboat'||prop.roomListing)return base;
    const rates=cruisePricing();
    return Math.round(base*((currentCruiseMode(mode)==='day'?rates.dayPercent:rates.overnightPercent)/100));
  }
  function addCruisePricing(){
    window.nkPriceFor=nkPriceFor;
    window.nkRefreshCruisePricing=function(){
      if(typeof renderProperties==='function')renderProperties();
      if(state.selectedProperty&&state.currentView==='detail'){
        const el=document.getElementById('detail-price');
        if(el){el.textContent=typeof window.nkFormatPrice==='function'?window.nkFormatPrice(nkPriceFor(state.selectedProperty,currentCruiseMode())):nkPriceFor(state.selectedProperty,currentCruiseMode()).toLocaleString('en-IN');document.getElementById('detail-price-currency')?.replaceChildren();}
      }
      if(document.getElementById('bookingModal')?.classList.contains('open')&&typeof updatePriceSummary==='function')updatePriceSummary();
    };
  }

/* Galleries are supplied by the live listing records. */
  function addHomeToolbar(){
    const hero=document.querySelector('#view-home > section:first-child'); if(!hero||hero.querySelector('.nk-home-toolbar'))return;
    hero.insertAdjacentHTML('afterbegin',`<div class="nk-home-toolbar"><div aria-hidden="true"></div><div class="nk-toolbar-actions"><button class="nk-icon-button" aria-label="Notifications" onclick="openNotifPanel()"><i class="fa-regular fa-bell"></i><span id="nk-notif-count" class="nk-notif-count">2</span></button></div></div>`);
  }
  function addNotificationReader(){
    if(document.getElementById('nk-notification-reader'))return;
    document.body.insertAdjacentHTML('beforeend',`<div id="nk-notification-reader" role="dialog" aria-modal="true" aria-labelledby="nk-notification-reader-title" onclick="if(event.target===this)closeNotificationReader()"><div class="nk-notification-reader-card"><div class="flex items-start justify-between gap-3"><div class="nk-notification-reader-meta"><strong id="nk-notification-reader-from">Nauka</strong><span id="nk-notification-reader-time"></span></div><button type="button" class="nk-contact-close" aria-label="Close notification" onclick="closeNotificationReader()"><i class="fa-solid fa-xmark"></i></button></div><h3 id="nk-notification-reader-title">Notification</h3><p id="nk-notification-reader-body"></p><button type="button" class="nk-notification-reader-done" onclick="closeNotificationReader()">Close notification</button></div></div>`);
    window.openNotificationReader=openNotificationReader;
    window.closeNotificationReader=closeNotificationReader;
    document.addEventListener('keydown',event=>{if(event.key==='Escape')closeNotificationReader()});
  }
  function openNotificationReader(sender,message,time){
    addNotificationReader();
    const reader=document.getElementById('nk-notification-reader');
    document.getElementById('nk-notification-reader-from').textContent=sender||'Nauka';
    document.getElementById('nk-notification-reader-time').textContent=time||'';
    document.getElementById('nk-notification-reader-title').textContent=message||'Notification';
    document.getElementById('nk-notification-reader-body').textContent='You can revisit this update any time from the notifications panel.';
    reader.classList.add('open');
    document.body.style.overflow='hidden';
  }
  function closeNotificationReader(){
    document.getElementById('nk-notification-reader')?.classList.remove('open');
    if(!state.notifOpen)document.body.style.overflow='';
  }
  function restoreNotificationNav(){
    const nav=document.getElementById('customer-bottom-nav');
    if(!nav)return;
    if(Object.prototype.hasOwnProperty.call(nav.dataset,'nkNotifDisplay')){
      nav.style.display=nav.dataset.nkNotifDisplay;
      delete nav.dataset.nkNotifDisplay;
    }
  }
  function redesignNotifications(){
    const panel=document.getElementById('notif-panel');
    if(!panel||panel.dataset.nkRedesigned)return;
    panel.dataset.nkRedesigned='1';
    panel.classList.add('nk-notif-page');
    window.renderNaukaBookingNotifications=function(){
      const now=new Date(),startOfDay=d=>new Date(d.getFullYear(),d.getMonth(),d.getDate()),today=startOfDay(now);
       const stampOf=booking=>Math.max(...[booking.updatedAt,booking.createdAt].map(value=>{const stamp=Date.parse(value||'');return Number.isFinite(stamp)?stamp:0;}));
       const records=(state.userBookings||[]).map((booking,index)=>({booking,index,stamp:stampOf(booking)})).sort((a,b)=>b.stamp-a.stamp||b.index-a.index).map(entry=>entry.booking);
      const groups={Today:[],Yesterday:[], 'This week':[],Earlier:[]};
      records.forEach((booking,index)=>{
        const stamp=Date.parse(booking.updatedAt||booking.createdAt||'');
        const date=Number.isFinite(stamp)?new Date(stamp):now;
        const diff=Math.max(0,Math.floor((today-startOfDay(date))/86400000));
        const group=diff===0?'Today':diff===1?'Yesterday':diff<7?'This week':'Earlier';
        const property=esc(booking.propertyName||'your houseboat');
        const reference=booking.reference||booking.bookingId||'';
        const status=booking.quoteStatus==='quoted'?'Price quote ready':booking.status==='confirmed'?'Booking confirmed':booking.status==='declined'?'Booking update':'Booking request received';
        const message=booking.quoteStatus==='quoted'?`A price quote is ready for your ${property} booking.`:booking.status==='confirmed'?`Your booking for ${property} is confirmed.`:booking.status==='declined'?`Your booking request for ${property} needs an update from our team.`:`Your request for ${property} was received and is being reviewed.`;
        const timeLabel=diff===0?'just now':diff===1?'yesterday':diff<7?'this week':date.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
        groups[group].push(`<div class="nk-notification-row${index<Number(window.nkUnread||0)?' unread':''}"><div class="nk-notification-copy"><span class="nk-notification-meta"><strong>${status}</strong><small>${timeLabel}</small></span><span class="nk-notification-message">${message}${reference?` <span class="nk-notification-reference">${esc(reference)}</span>`:''}</span></div><span class="nk-notification-dot"></span></div>`);
      });
      const sections=Object.entries(groups).filter(([,rows])=>rows.length).map(([title,rows])=>`<section class="nk-notification-section"><h4>${title}</h4><div class="nk-notification-list">${rows.join('')}</div></section>`).join('');
      panel.innerHTML=`<div class="nk-notification-page"><header class="nk-notification-head"><button class="nk-notification-back" aria-label="Close notifications" onclick="closeNotifPanel()">‹</button><h2 class="nk-notification-title">Notifications <span class="nk-notification-badge" id="nk-notification-page-count">${Number(window.nkUnread||0)}</span></h2></header>${sections||'<div class="nk-notification-empty">No booking updates yet.</div>'}</div>`;
      const count=String(window.nkUnread||0),homeCount=document.getElementById('nk-notif-count'),pageCount=document.getElementById('nk-notification-page-count');
      if(homeCount){homeCount.textContent=count;homeCount.style.display=count==='0'?'none':'flex'}
      if(pageCount)pageCount.textContent=count;
      panel.querySelectorAll('.nk-notification-row').forEach(row=>row.addEventListener('click',()=>{
        row.classList.remove('unread');
        const meta=row.querySelector('.nk-notification-meta'),message=row.querySelector('.nk-notification-message');
        openNotificationReader(meta?.querySelector('strong')?.textContent||'Nauka',message?.textContent||'',meta?.querySelector('small')?.textContent||'');
      }));
    };
    window.renderNaukaBookingNotifications();
  }
  function addHomeSearch(){
    const hero=document.querySelector('#view-home > section:first-child');
    if(!document.getElementById('nk-home-search')&&hero){
      hero.insertAdjacentHTML('afterend',`<section id="nk-home-search" class="nk-home-search" aria-label="Find a houseboat"><div class="nk-home-search-card"><div class="nk-search-heading"><span class="nk-search-kicker">PLAN YOUR BACKWATER STAY</span><p>Find your houseboat</p></div><div class="nk-search-fields"><div class="nk-search-field nk-search-dates"><span class="nk-search-label">TRAVEL DATE</span><div class="nk-search-date-pair"><button type="button" class="nk-search-date" onclick="nkSearchPickDate('in')"><small>Check-in</small><strong id="nk-search-checkin">Choose date</strong></button><span class="nk-search-date-arrow"><i class="fa-solid fa-arrow-right"></i></span><button type="button" class="nk-search-date" onclick="nkSearchPickDate('out')"><small>Check-out</small><strong id="nk-search-checkout">Choose date</strong></button></div></div><label class="nk-search-field"><span class="nk-search-label">BOAT TYPE</span><select id="nk-search-boat-type"><option value="all">Any houseboat</option><option value="1">1 Bedroom</option><option value="2">2 Bedrooms</option><option value="3">3 Bedrooms</option><option value="4">4 Bedrooms</option><option value="5">5 Bedrooms</option><option value="5plus">6+ Bedrooms</option></select></label><label class="nk-search-field"><span class="nk-search-label">EXPERIENCE</span><select id="nk-search-experience" onchange="nkSearchSetExperience(this.value)"><option value="overnight">Overnight stay</option><option value="day">Day cruise</option></select></label><div class="nk-search-field nk-search-guest-field"><span class="nk-search-label">GUESTS</span><button type="button" class="nk-search-guest-toggle" id="nk-search-guest-toggle" aria-expanded="false" onclick="nkToggleGuestPanel()"><span id="nk-search-guest-summary">2 Adults</span><i class="fa-solid fa-chevron-down"></i></button><div id="nk-search-guest-panel" class="nk-search-guest-panel" hidden><div class="nk-guest-row"><div><strong>Adults</strong><small>Age 13+</small></div><div class="nk-guest-stepper"><button type="button" aria-label="Remove an adult" onclick="nkChangeSearchGuest('adults',-1)">−</button><span id="nk-search-adults">2</span><button type="button" aria-label="Add an adult" onclick="nkChangeSearchGuest('adults',1)">+</button></div></div><div class="nk-guest-row"><div><strong>Children</strong><small>Age 2–12</small></div><div class="nk-guest-stepper"><button type="button" aria-label="Remove a child" onclick="nkChangeSearchGuest('children',-1)">−</button><span id="nk-search-children">0</span><button type="button" aria-label="Add a child" onclick="nkChangeSearchGuest('children',1)">+</button></div></div><p>Boat capacity is matched to your group size.</p></div></div><button type="button" class="nk-search-submit" onclick="applyNaukaHomeSearch()"><i class="fa-solid fa-magnifying-glass"></i><span>Search<small>Find my boat</small></span></button></div></div></section>`);
    }
    window.nkSearchPickDate=function(which){const mode=document.getElementById('nk-search-experience')?.value||'overnight';window.nkCruiseMode=mode;window.nkBookingMode=mode;if(which==='out'&&(mode==='day'||!document.getElementById('booking-date')?.value))which='in';if(which==='in'&&!document.getElementById('booking-date')?.value)window.nkResetBookingDateRange?.();const old=state.selectedProperty;if(state.currentView==='home')state.selectedProperty=null;window.openBookingDatePicker?.(which);if(state.currentView==='home')state.selectedProperty=old};
    window.nkSearchSetExperience=function(mode){window.nkCruiseMode=mode==='day'?'day':'overnight';window.nkBookingMode=window.nkCruiseMode;const start=document.getElementById('booking-date')?.value||'',end=document.getElementById('booking-checkout');if(mode==='day'&&end&&start)end.value=start;else if(mode!=='day'&&end&&end.value===start)end.value='';syncHomeSearchDates()};
    window.nkToggleGuestPanel=function(){const p=document.getElementById('nk-search-guest-panel'),b=document.getElementById('nk-search-guest-toggle');if(p&&b){p.hidden=!p.hidden;b.setAttribute('aria-expanded',String(!p.hidden))}};
    window.nkChangeSearchGuest=function(kind,delta){const el=document.getElementById(kind==='adults'?'nk-search-adults':'nk-search-children');if(!el)return;el.textContent=String(Math.min(kind==='adults'?12:10,Math.max(kind==='adults'?1:0,Number(el.textContent||0)+delta)));const a=Number(document.getElementById('nk-search-adults')?.textContent||2),ch=Number(document.getElementById('nk-search-children')?.textContent||0);document.getElementById('nk-search-guest-summary').textContent=a+' Adult'+(a===1?'':'s')+(ch?' · '+ch+' Child'+(ch===1?'':'ren'):'')};
