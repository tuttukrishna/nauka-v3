    window.nkFaqToggle=function(btn){const item=btn.closest('.nk-faq-item'),open=!item.classList.contains('open');item.parentElement.querySelectorAll('.nk-faq-item.open').forEach(x=>{x.classList.remove('open');x.querySelector('.nk-faq-q').setAttribute('aria-expanded','false')});if(open){item.classList.add('open');btn.setAttribute('aria-expanded','true')}};
  }
  function addReviews(){
    const home=document.getElementById('view-home'); if(!home||home.querySelector('.nk-review-section'))return;
    const faq=document.getElementById('faq'); if(!faq)return;
    const card=r=>`<article class="nk-review-card" role="button" tabindex="0" onclick="openReview(${REVIEWS.indexOf(r)})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openReview(${REVIEWS.indexOf(r)})}"><div class="nk-review-head"><img loading="lazy" class="nk-review-avatar" src="${AVATAR_URLS[r[3]%AVATAR_URLS.length]}" alt="${esc(r[0])}"/><div class="flex-1"><p class="nk-review-name">${r[0]}</p><p class="nk-review-meta">${r[1]} · Google review</p></div><div class="nk-review-stars">★★★★★</div></div><p class="nk-review-quote">“${r[2]}”</p></article>`;
