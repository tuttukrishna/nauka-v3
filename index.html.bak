    border-radius: 26px !important;
    background: linear-gradient(135deg, #fff 0%, #fff 72%, #fff8f7 100%) !important;
    box-shadow: 0 14px 34px rgba(13,79,60,.13), 0 2px 0 rgba(255,255,255,.95) inset !important;
