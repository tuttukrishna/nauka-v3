  function addRedirectModal(){
    if(document.getElementById('nk-redirect-modal'))return;
    document.body.insertAdjacentHTML('beforeend',`<div id="nk-redirect-modal"><div class="nk-redirect-card"><div class="nk-redirect-icon"><i class="fa-solid fa-calendar-check"></i></div><h3>Request received</h3><p>We have received your request, Our team will contact you soon with best offers!. Thanks for your patience.</p></div></div>`);
  }
  function enhanceDetail(){
    const detail=document.getElementById('view-detail'); if(!detail||detail.dataset.nkDone)return; detail.dataset.nkDone='1';
    const loc=[...detail.querySelectorAll('h4')].find(h=>h.textContent.trim()==='Location'); if(loc){loc.classList.add('nk-hidden-map');loc.nextElementSibling?.classList.add('nk-hidden-map')}
    const desc=document.getElementById('detail-desc'); const bookingBar=detail.querySelector('.nk-detail-booking-bar'); const modeAnchor=bookingBar||desc; if(modeAnchor)modeAnchor.insertAdjacentHTML('afterend',`<div id="nk-cruise-mode" class="nk-mode-card"><div class="nk-mode-tabs"><button class="nk-mode-tab active" data-mode="day" onclick="setCruiseMode('day')"><i class="fa-solid fa-sun mr-1"></i>Day Cruise</button><button class="nk-mode-tab" data-mode="overnight" onclick="setCruiseMode('overnight')"><i class="fa-solid fa-moon mr-1"></i>Overnight Cruise</button></div><div id="nk-mode-copy"></div></div><div class="nk-detail-supplement"><section class="nk-detail-mini"><h4>Authentic Kerala meal plan</h4><p>Freshly prepared onboard by your dedicated chef.</p><ul class="nk-detail-list mt-3"><li>Welcome drink · fresh lime or tender coconut</li><li>Kerala lunch · rice, fish or seasonal vegetarian thali</li><li>Evening tea & snacks · pakoda or banana fritters</li><li>Dinner and breakfast · made fresh on the boat</li></ul></section><section class="nk-detail-mini"><h4>Policies & guidelines</h4><ul class="nk-detail-list"><li>Private accommodation with a dedicated captain and crew</li><li>Check-in at 12 PM; return by 9 AM after breakfast</li><li>Children under 5 stay free; extra guests are confirmed with the team</li><li>Special routes and celebration setups are available on request</li></ul></section></div>`);
  }
  function setCruiseMode(mode){
    window.nkCruiseMode=mode; const box=document.getElementById('nk-mode-copy'); if(!box)return;
    document.querySelectorAll('.nk-mode-tab').forEach(b=>b.classList.toggle('active',b.dataset.mode===mode));
    const day=mode==='day';
    const detailPrice=document.getElementById('detail-price');
    if(state.selectedProperty&&detailPrice&&typeof window.nkPriceFor==='function'){detailPrice.textContent=typeof window.nkFormatPrice==='function'?window.nkFormatPrice(window.nkPriceFor(state.selectedProperty,mode)):window.nkPriceFor(state.selectedProperty,mode).toLocaleString('en-IN');document.getElementById('detail-price-currency')?.replaceChildren();}
    const detailUnit=document.getElementById('detail-price-unit');
    if(detailUnit)detailUnit.textContent=day?' / cruise':' / night';
    const dayRoute=[
      ['11:00 AM','Depart from Alleppey','Board at the jetty, welcome drink served'],
      ['AFTERNOON','Punnamada Lake & Vembanad Lake',"Kerala's largest lake — open water, wide skies"],
      ['MID-AFTERNOON','R Block & C Block','Man-made paddy fields from the lake, cultivation below sea level — a rare sight'],
      ['LATE AFTERNOON','Rani · Chithira · Marthandam','Villages, islands and narrow canals winding through coconut groves'],
      ['EVENING · RETURN','Kainakari → Alleppey','Back at the jetty by 5:00 PM']
    ];
    const overnightRoute=[
      ['12:00 PM','Check-in · welcome drink & lunch',''],
      ['2:00 PM','Punnamada Lake · Vembanad views',''],
      ['6:30 PM','Boat moors · sunset & dinner',''],
      ['9:00 AM','Breakfast · return to Alleppey','']
    ];
    const route=day?dayRoute:overnightRoute;
    box.innerHTML=`${day?'<p class="nk-reference-kicker">IN 11:00 AM · OUT 05:00 PM (6 HRS)</p>':''}<p class="nk-mode-title">${day?'Cruise Route & Schedule':'A slow evening, then breakfast afloat'}</p>${day?'':'<p class="nk-mode-copy">Settle into your room after lunch, watch the route turn quiet, and wake up to the lake after breakfast.</p>'}<div class="nk-timeline">${route.map(x=>`<div class="nk-timeline-row"><span class="nk-timeline-dot"></span><div><b>${x[0]}</b>${day?`<strong class="nk-route-stop">${x[1]}</strong><span>${x[2]}</span>`:`<span>${x[1]}</span>`}</div></div>`).join('')}</div>`;
    const sel=document.getElementById('booking-route'); if(sel){sel.value=day?'Sunset & Day Cruise':'Alleppey Backwater Circuit'}
  }
  function openExperience(kind){
    if(kind==='day'){state.selectedRoute='Sunset & Day Cruise';state.nkCruiseMode='day'}
    if(kind==='overnight'){state.selectedRoute='Alleppey Backwater Circuit';state.nkCruiseMode='overnight'}
    if(kind==='rooms'){state._currentCategory='1'}
    updateRouteNotices(); showView('boats'); renderProperties();
  }
  function openConcierge(){document.getElementById('nk-concierge-backdrop')?.classList.add('open')}
  function closeConcierge(){document.getElementById('nk-concierge-backdrop')?.classList.remove('open')}
  function openReview(i){const r=REVIEWS[i];const b=document.getElementById('nk-review-backdrop');if(!b)return;document.getElementById('nk-review-dialog-avatar').src=AVATAR_URLS[r[3]%AVATAR_URLS.length];document.getElementById('nk-review-dialog-name').textContent=r[0];document.getElementById('nk-review-dialog-meta').textContent=r[1]+' · Google review';document.getElementById('nk-review-dialog-text').textContent='“'+r[2]+'”';b.classList.add('open')}
  function closeReview(){document.getElementById('nk-review-backdrop')?.classList.remove('open')}
  window.openConcierge=openConcierge;window.closeConcierge=closeConcierge;window.openMailContact=openMailContact;window.closeMailContact=closeMailContact;window.copyNaukaEmail=copyNaukaEmail;window.openNaukaGmail=openNaukaGmail;window.openReview=openReview;window.closeReview=closeReview;window.openExperience=openExperience;window.setCruiseMode=setCruiseMode;

  function addGalleryModal(){
    if(document.getElementById('nk-gallery-backdrop'))return;
    document.body.insertAdjacentHTML('beforeend',`<div id="nk-gallery-backdrop" onclick="if(event.target===this)closeGallery()"><div class="nk-gallery-modal"><div class="nk-gallery-stage"><img id="nk-gallery-image" src="" alt="Houseboat gallery"/><button class="nk-gallery-close" onclick="closeGallery()"><i class="fa-solid fa-xmark"></i></button><button class="nk-gallery-arrow prev" onclick="galleryStep(-1)"><i class="fa-solid fa-chevron-left"></i></button><button class="nk-gallery-arrow next" onclick="galleryStep(1)"><i class="fa-solid fa-chevron-right"></i></button></div><p id="nk-gallery-caption" class="nk-gallery-caption"></p><div id="nk-gallery-thumbs" class="nk-gallery-thumbs"></div></div></div>`);
  }
  let galleryState={images:[],index:0,title:''};
  function paintGallery(){const im=document.getElementById('nk-gallery-image');if(!im||!galleryState.images.length)return;const current=galleryState.images[galleryState.index];im.src=current;if(typeof window.nkApplyListingImagePosition==='function')window.nkApplyListingImagePosition(im,current);document.getElementById('nk-gallery-caption').textContent=galleryState.title+' · '+(galleryState.index+1)+' / '+galleryState.images.length;document.getElementById('nk-gallery-thumbs').innerHTML=galleryState.images.map((s,i)=>`<img loading="lazy" src="${s}" style="${typeof window.nkImagePositionStyle==='function'?window.nkImagePositionStyle(s):''}" class="${i===galleryState.index?'active':''}" onclick="galleryGo(${i})"/>`).join('')}
  function openGallery(id,index=0){const p=PROPERTIES.find(x=>x.id===id);if(!p)return;galleryState={images:(p.gallery||[p.image]).filter(Boolean),index,title:p.title};paintGallery();document.getElementById('nk-gallery-backdrop')?.classList.add('open')}
  function closeGallery(){document.getElementById('nk-gallery-backdrop')?.classList.remove('open')}
  function galleryStep(n){galleryState.index=(galleryState.index+n+galleryState.images.length)%galleryState.images.length;paintGallery()}
  function galleryGo(i){galleryState.index=i;paintGallery()}
  window.openGallery=openGallery;window.closeGallery=closeGallery;window.galleryStep=galleryStep;window.galleryGo=galleryGo;

  function addCalendar(){
    const input=document.getElementById('booking-date');if(!input||input.dataset.nkDone)return;input.dataset.nkDone='1';input.type='text';input.readOnly=true;input.placeholder='Select dates';input.addEventListener('click',showCalendar);document.body.insertAdjacentHTML('beforeend',`<div id="nk-calendar-pop"><div class="nk-cal-head"><button class="nk-cal-nav" onclick="calendarMonth(-1)"><i class="fa-solid fa-chevron-left"></i></button><p id="nk-cal-month" class="nk-cal-month"></p><button class="nk-cal-nav" onclick="calendarMonth(1)"><i class="fa-solid fa-chevron-right"></i></button></div><div class="nk-cal-week"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div><div id="nk-cal-grid" class="nk-cal-grid"></div><p class="nk-cal-note"><strong>Red dates</strong> are already occupied · today is marked in red</p></div>`);window.nkCalDate=new Date();window.nkCalDate.setDate(1);window.nkCalBlocked=new Set();window.nkCalOccupied=new Set();window.nkCalAvailabilityLoading=false;}
  function showCalendar(){const p=document.getElementById('nk-calendar-pop');if(!p)return;const r=document.getElementById('booking-date').getBoundingClientRect();p.style.left=Math.max(16,Math.min(window.innerWidth-371,r.left))+'px';p.style.top=Math.min(window.innerHeight-370,r.bottom+8)+'px';p.classList.add('open');paintCalendar();void refreshCalendarBlockedDates();}
  function calendarMonth(n){window.nkCalDate.setMonth(window.nkCalDate.getMonth()+n);paintCalendar();void refreshCalendarBlockedDates();}
  function paintCalendar(){const d=window.nkCalDate;const y=d.getFullYear(),m=d.getMonth();document.getElementById('nk-cal-month').textContent=d.toLocaleDateString('en-US',{month:'long',year:'numeric'});const first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate(),today=todayISO(),loading=!!window.nkCalAvailabilityLoading;let html='';for(let i=0;i<first;i++)html+='<span></span>';for(let day=1;day<=days;day++){const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(day).padStart(2,'0'),past=iso<today,occupied=window.nkCalBlocked?.has(iso)&&!past;html+=`<button class="nk-cal-day ${iso===today?'today':''} ${occupied?'occupied':''} ${past||loading?'disabled':''}" ${past||occupied||loading?'disabled':''} onclick="pickCalendarDate('${iso}')">${day}</button>`}document.getElementById('nk-cal-grid').innerHTML=html}
  function pickCalendarDate(iso){const i=document.getElementById('booking-date');if(!i)return;i.value=iso;i.dataset.display=fmtLong(iso);i.style.color='#1a1a18';document.getElementById('nk-calendar-pop')?.classList.remove('open');}
  function fmtLong(iso){const [y,m,d]=iso.split('-').map(Number);return new Date(y,m-1,d).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'})}
  async function refreshCalendarBlockedDates(){
    const prop=state?.selectedProperty;
    const d=window.nkCalDate;
    const rpc=window.naukaSupabase;
    if(!d||!rpc?.rpc){window.nkCalAvailabilityLoading=false;window.nkCalBlocked=new Set();paintCalendar();return}
    const y=d.getFullYear(),m=d.getMonth(),from=y+'-'+String(m+1).padStart(2,'0')+'-01',to=y+'-'+String(m+1).padStart(2,'0')+'-'+String(new Date(y,m+1,0).getDate()).padStart(2,'0');
    const requestKey=String(prop?.id||'home')+'|'+from+'|'+to;
    window.nkCalendarRequestKey=requestKey;
    window.nkCalAvailabilityLoading=true;window.nkCalBlocked=new Set();paintCalendar();
    let blocked=new Set(),error=null;
    if(prop?.id){
      const result=await getBlockedDates(prop.id,from,to,window.nkBookingMode||window.nkCruiseMode||'night');blocked=result.dates;error=result.error;
    }else if(state?.currentView==='home'){
      const type=document.getElementById('nk-search-boat-type')?.value||'all';
      const adults=Number(document.getElementById('nk-search-adults')?.textContent||2),children=Number(document.getElementById('nk-search-children')?.textContent||0),guests=adults+children;
      const candidates=(typeof PROPERTIES!=='undefined'?PROPERTIES:[]).filter(p=>p.category==='houseboat'&&!p.roomListing&&p.status!=='inactive'&&p.status!=='suspended'&&p.id&&p.image&&(type==='all'||(type==='5plus'?(Number(p.bedrooms)||0)>5:Number(p.bedrooms)===Number(type)))&&Math.max(2,Number(p.includedGuests)||(Number(p.bedrooms)||1)*2)>=guests);
      const results=await Promise.all(candidates.map(p=>getBlockedDates(p.id,from,to,document.getElementById('nk-search-experience')?.value||'night')));
      const failed=results.some(result=>result.error);
      if(candidates.length&&results.length===candidates.length){
        for(let day=1;day<=new Date(y,m+1,0).getDate();day++){
          const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(day).padStart(2,'0');
          if(results.every(result=>result.dates.has(iso)))blocked.add(iso);
        }
      }
      if(failed)error=new Error('One or more live availability lookups failed.');
    }
    if(window.nkCalendarRequestKey!==requestKey)return;
    window.nkCalAvailabilityLoading=false;
    if(error)console.warn('Nauka availability lookup failed:',error.message||error);
    window.nkCalBlocked=blocked;
    paintCalendar();
  }
  window.showCalendar=showCalendar;window.calendarMonth=calendarMonth;window.pickCalendarDate=pickCalendarDate;
  function ensureCalendarSummary(){
    const p=document.getElementById('nk-calendar-pop');
    if(!p||p.querySelector('.nk-cal-summary'))return;
    p.insertAdjacentHTML('afterbegin','<div class="nk-cal-summary"><div class="nk-cal-summary-copy"><strong id="nk-cal-summary-day">—</strong><span id="nk-cal-summary-month">Select a check-in date</span></div><div class="nk-cal-icon"><i class="fa-regular fa-calendar"></i></div></div><div class="nk-cal-progress" aria-hidden="true"><span></span><span></span><span></span></div>');
  }
  function ensureCalendarBackdrop(){
    if(document.getElementById('nk-calendar-backdrop'))return;
    document.body.insertAdjacentHTML('beforeend','<div id="nk-calendar-backdrop" onclick="closeCalendar()" aria-hidden="true"></div>');
  }
  function closeCalendar(){
    document.getElementById('nk-calendar-pop')?.classList.remove('open');
    document.getElementById('nk-calendar-backdrop')?.classList.remove('open');
  }
  function updateCalendarSummary(){
    const input=document.getElementById('booking-date'),dayEl=document.getElementById('nk-cal-summary-day'),monthEl=document.getElementById('nk-cal-summary-month');
    if(!dayEl||!monthEl)return;
    const value=input?.value||'';
    if(!value){dayEl.textContent='—';monthEl.textContent='Select a check-in date';return}
    const selected=new Date(value+'T00:00:00');
    dayEl.textContent=String(selected.getDate());
    monthEl.textContent=selected.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  }
  function paintNaukaCalendar(){
    const d=window.nkCalDate,grid=document.getElementById('nk-cal-grid'),monthEl=document.getElementById('nk-cal-month'),input=document.getElementById('booking-date');
    if(!d||!grid||!monthEl)return;
    const y=d.getFullYear(),m=d.getMonth(),first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate(),today=todayISO(),selected=input?.value||'';
    monthEl.textContent=d.toLocaleDateString('en-US',{month:'long',year:'numeric'});
    let html='';
    for(let i=0;i<first;i++)html+='<span class="nk-cal-empty" aria-hidden="true"></span>';
    for(let day=1;day<=days;day++){
      const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(day).padStart(2,'0'),past=iso<today,occupied=window.nkCalBlocked?.has(iso)&&!past,classes='nk-cal-day'+(iso===today?' today':'')+(iso===selected?' selected':'')+(occupied?' occupied':'')+(past?' disabled':'');
      html+='<button type="button" class="'+classes+'"'+(past?' disabled':'')+(occupied?' aria-label="Booked date '+day+'"':'')+' onclick="pickCalendarDate(&quot;'+iso+'&quot;,'+(occupied?'true':'false')+')">'+day+'</button>';
    }
    grid.innerHTML=html;
    updateCalendarSummary();
  }
  paintCalendar=paintNaukaCalendar;
  const originalShowCalendar=showCalendar;
  showCalendar=function(){
    ensureCalendarSummary();
    ensureCalendarBackdrop();
    originalShowCalendar();
    const p=document.getElementById('nk-calendar-pop');
    if(!p||!p.classList.contains('open'))return;
    document.getElementById('nk-calendar-backdrop')?.classList.add('open');
    p.style.left='50%';
    p.style.top='50%';
    p.style.transform='translate(-50%,-50%)';
    p.style.animation='none';
  };
  const originalPickCalendarDate=pickCalendarDate;
  pickCalendarDate=function(iso,occupied){
    if(occupied){
      closeCalendar();
      showBookingError('sorry. selected date is booked!!');
      const input=document.getElementById('booking-date');
      input?.classList.add('nk-date-booked-error');
      setTimeout(()=>input?.classList.remove('nk-date-booked-error'),1800);
      return;
    }
    originalPickCalendarDate(iso);
    closeCalendar();
    updateCalendarSummary();
  };
  window.showCalendar=showCalendar;window.pickCalendarDate=pickCalendarDate;window.closeCalendar=closeCalendar;
  document.addEventListener('click',e=>{const p=document.getElementById('nk-calendar-pop');if(p?.classList.contains('open')&&!p.contains(e.target)&&e.target.id!=='booking-date'&&!e.target.closest('#nk-booking-date-picker')&&!e.target.closest('.nk-search-date')&&!e.target.closest('#nk-calendar-backdrop'))closeCalendar();});

  /* Booking date range layer: check-in/check-out replaces manual night selection. */
  function nkBookingMode(){return window.nkBookingMode||window.nkCruiseMode||'day'}
  function nkIsDayBooking(){return nkBookingMode()==='day'}
  function nkDateDiff(start,end){
    if(!start||!end)return 0;
    const a=new Date(start+'T00:00:00'),b=new Date(end+'T00:00:00');
    return Math.round((b-a)/86400000);
  }
  function nkBookingDateError(message){
    showBookingError(message);
    const picker=document.getElementById('nk-booking-date-picker');
    if(picker){picker.classList.add('nk-date-range-error');setTimeout(()=>picker.classList.remove('nk-date-range-error'),1800)}
  }
  function nkSameDayCheckoutNotice(){
    const message='You have choosen for a same day pickup/drop-off ride.';
    if(typeof window.toast==='function')window.toast(message,true);
    nkBookingDateError(message);
  }
  function nkSyncBookingDateRange(){
    const start=document.getElementById('booking-date')?.value||'',end=document.getElementById('booking-checkout')?.value||'';
    const startDisplay=document.getElementById('nk-checkin-display'),endDisplay=document.getElementById('nk-checkout-display');
    if(startDisplay)startDisplay.textContent=start?fmtLong(start):'Choose date';
    if(endDisplay)endDisplay.textContent=nkIsDayBooking()&&start?'Same day':(end?fmtLong(end):'Choose date');
    const inTab=document.getElementById('nk-checkin-tab'),outTab=document.getElementById('nk-checkout-tab');
    const dayBooking=nkIsDayBooking();
    if(outTab){
      outTab.classList.toggle('nk-day-cruise-locked',dayBooking);
      outTab.setAttribute('aria-disabled',dayBooking?'true':'false');
      outTab.setAttribute('tabindex',dayBooking?'-1':'0');
      outTab.onclick=event=>{if(dayBooking){event.preventDefault();nkSameDayCheckoutNotice();return}openBookingDatePicker('out')};
      const small=outTab.querySelector('small');
      if(small)small.textContent=dayBooking?'Same-day return':'Departure date';
    }
    const selecting=window.nkCalSelecting||(start?'out':'in');
    inTab?.classList.toggle('active',selecting==='in');
    outTab?.classList.toggle('active',!dayBooking&&selecting==='out');
    const help=document.getElementById('nk-booking-date-help');
    if(help){
      const copy=help.querySelector('span');
      if(copy)copy.textContent=!start?'Choose check-in first, then choose your check-out date.':nkIsDayBooking()?'Day Cruise returns on the same date.':!end?'Now choose your check-out date.':'Dates selected. You can change either date before continuing.';
    }
    const nights=document.getElementById('booking-nights');
    if(nights)nights.value=nkIsDayBooking()?1:Math.max(1,nkDateDiff(start,end)||1);
    updateCalendarSummary();
    if(typeof updatePriceSummary==='function')updatePriceSummary();
  }
  function nkResetBookingDateRange(){
    const start=document.getElementById('booking-date'),end=document.getElementById('booking-checkout'),terms=document.getElementById('nk-booking-terms');
    if(start)start.value='';
    if(end)end.value='';
    if(terms)terms.checked=false;
    document.getElementById('nk-booking-terms-card')?.classList.remove('nk-terms-error');
    document.querySelector('#booking-form .nk-long-stay')?.remove();
    window.nkCalSelecting='in';
    nkSyncBookingDateRange();
  }
  window.nkResetBookingDateRange=nkResetBookingDateRange;
  function openBookingDatePicker(which){
    if(which==='out'&&nkIsDayBooking()){
      nkSameDayCheckoutNotice();
      return;
    }
    const start=document.getElementById('booking-date')?.value||'';
    if(which==='out'&&!start){
      nkBookingDateError('Please choose your check-in date first.');
      which='in';
    }
    if(!document.getElementById('nk-calendar-pop'))addCalendar();
    window.nkCalSelecting=which==='out'?'out':'in';
    showCalendar();
  }
  window.openBookingDatePicker=openBookingDatePicker;
  addCalendar=function(){
    const input=document.getElementById('booking-date'),checkout=document.getElementById('booking-checkout');
    if(!input||!checkout)return;
    input.type='hidden';checkout.type='hidden';input.readOnly=true;checkout.readOnly=true;
    if(!document.getElementById('nk-calendar-pop'))document.body.insertAdjacentHTML('beforeend','<div id="nk-calendar-pop"><div class="nk-cal-head"><button type="button" class="nk-cal-nav" onclick="calendarMonth(-1)"><i class="fa-solid fa-chevron-left"></i></button><p id="nk-cal-month" class="nk-cal-month"></p><button type="button" class="nk-cal-nav" onclick="calendarMonth(1)"><i class="fa-solid fa-chevron-right"></i></button></div><div class="nk-cal-week"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div><div id="nk-cal-grid" class="nk-cal-grid"></div><p class="nk-cal-note"><strong>Yellow dates</strong> are blocked or occupied · choose check-in and check-out dates</p></div>');
    ensureCalendarSummary();ensureCalendarBackdrop();
    window.nkCalDate=new Date();window.nkCalDate.setDate(1);window.nkCalBlocked=new Set();window.nkCalAvailabilityLoading=false;window.nkCalSelecting='in';
    nkResetBookingDateRange();
  };
  showCalendar=function(){
    const p=document.getElementById('nk-calendar-pop');if(!p)return;
    ensureCalendarSummary();ensureCalendarBackdrop();
    p.classList.add('open');document.getElementById('nk-calendar-backdrop')?.classList.add('open');
    p.style.left='50%';p.style.top='50%';p.style.transform='translate(-50%,-50%)';p.style.animation='none';
    nkSyncBookingDateRange();paintCalendar();void refreshCalendarBlockedDates();
  };
  window.showCalendar=showCalendar;
  paintCalendar=function(){
    const d=window.nkCalDate,grid=document.getElementById('nk-cal-grid'),monthEl=document.getElementById('nk-cal-month'),start=document.getElementById('booking-date')?.value||'',end=document.getElementById('booking-checkout')?.value||'';
    if(!d||!grid||!monthEl)return;
    const y=d.getFullYear(),m=d.getMonth(),first=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate(),today=todayISO(),loading=!!window.nkCalAvailabilityLoading;
    monthEl.textContent=d.toLocaleDateString('en-US',{month:'long',year:'numeric'});
    let html='';
    for(let i=0;i<first;i++)html+='<span class="nk-cal-empty" aria-hidden="true"></span>';
    for(let day=1;day<=days;day++){
      const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(day).padStart(2,'0'),past=iso<today,occupied=window.nkCalBlocked?.has(iso)&&!past,inRange=!!(start&&end&&iso>start&&iso<end),rangeStart=iso===start,rangeEnd=iso===end;
      const classes='nk-cal-day'+(iso===today?' today':'')+(rangeStart?' range-start':'')+(rangeEnd?' range-end':'')+(inRange?' in-range':'')+(occupied?' occupied':'')+(past?' disabled':'');
      html+='<button type="button" class="'+classes+(loading?' disabled':'')+'"'+(past||loading?' disabled':'')+(occupied?' aria-label="Booked date '+day+'"':'')+' onclick="pickCalendarDate(&quot;'+iso+'&quot;,'+(occupied?'true':'false')+')">'+day+'</button>';
    }
    grid.innerHTML=html;updateCalendarSummary();
  };
  window.paintCalendar=paintCalendar;
  updateCalendarSummary=function(){
    const start=document.getElementById('booking-date')?.value||'',end=document.getElementById('booking-checkout')?.value||'',dayEl=document.getElementById('nk-cal-summary-day'),monthEl=document.getElementById('nk-cal-summary-month');
    if(!dayEl||!monthEl)return;
    const startDate=start?new Date(start+'T00:00:00'):null,endDate=end?new Date(end+'T00:00:00'):null;
    dayEl.textContent=start?(end&&!nkIsDayBooking()?String(startDate.getDate())+' → '+String(endDate.getDate()):String(startDate.getDate())):'—';
    monthEl.textContent=!start?'Select a check-in date':nkIsDayBooking()?startDate.toLocaleDateString('en-US',{month:'long',year:'numeric'})+' · same-day cruise':!end?'Select a check-out date':startDate.toLocaleDateString('en-US',{month:'short'})+' → '+endDate.toLocaleDateString('en-US',{month:'short',year:'numeric'});
  };
  pickCalendarDate=async function(iso,occupied){
    if(window.nkCalAvailabilityLoading){nkBookingDateError('Checking live availability. Please wait a moment.');return}
    if(occupied){closeCalendar();nkBookingDateError('Sorry, that date is already booked. Please choose another date.');return}
    if(iso<todayISO()){nkBookingDateError('Please choose a date from today onward.');return}
    const startInput=document.getElementById('booking-date'),endInput=document.getElementById('booking-checkout'),start=startInput?.value||'';
    if(!start||window.nkCalSelecting==='in'){
      if(startInput)startInput.value=iso;
      if(nkIsDayBooking()){
        if(endInput)endInput.value=iso;
        window.nkCalSelecting='in';nkSyncBookingDateRange();closeCalendar();return;
      }
      if(endInput)endInput.value='';
      window.nkCalSelecting='out';nkSyncBookingDateRange();paintCalendar();return;
    }
    if(nkIsDayBooking()){
      if(iso!==start)return nkBookingDateError('A Day Cruise must have the same check-in and check-out date.');
      if(endInput)endInput.value=iso;
      nkSyncBookingDateRange();closeCalendar();return;
    }
    if(iso<=start)return nkBookingDateError('Please choose a check-out date after your check-in date.');
    const lastStayDate=addDaysISO(iso,-1);
    const localConflict=[];
    for(let cursor=start;cursor<=lastStayDate;cursor=addDaysISO(cursor,1))if(window.nkCalBlocked?.has(cursor))localConflict.push(cursor);
    if(localConflict.length)return nkBookingDateError('Sorry, you cannot book this range because one or more dates are already booked. Please choose another range.');
    const property=state?.currentView==='home'?null:state?.selectedProperty;
    if(property?.id){
      const result=await getBlockedDates(property.id,start,lastStayDate);
      if(!result.error&&result.dates.size)return nkBookingDateError('Sorry, you cannot book this range because one or more dates are already booked. Please choose another range.');
      if(result.error)return nkBookingDateError('We could not verify live availability. Please try again.');
    }
    if(endInput)endInput.value=iso;
    window.nkCalSelecting='out';nkSyncBookingDateRange();closeCalendar();
  };
  window.pickCalendarDate=pickCalendarDate;

  function addRoomLabels(){
    if(typeof PROPERTIES==='undefined')return; const old=window.renderPropertyCards; if(old.__nkWrapped)return; const wrap=function(props,target){old(props,target);if(target&&target!=='property-list')return;props.forEach(p=>{if(!p.roomListing)return;const card=document.querySelector(`#property-list [data-id="${p.id}"]`);if(!card)return;const labels=[...card.querySelectorAll('p')];const price=labels.find(x=>x.textContent.includes('Per night from'));if(price)price.textContent='Per room from';});};wrap.__nkWrapped=true;window.renderPropertyCards=wrap;
  }
  function addDetailGallery(){
    const old=window.openPropertyDetail;if(!old||old.__nkWrapped)return;const wrap=function(id){old(id);enhanceDetail();window.nkCruiseMode='day';setCruiseMode('day');const p=PROPERTIES.find(x=>x.id===id);const detail=document.getElementById('view-detail');const heading=detail?[...detail.querySelectorAll('h4')].find(h=>h.textContent.trim()==='Gallery'):null;const grid=document.getElementById('gallery-img-1')?.parentElement||heading?.nextElementSibling||detail?.querySelector('[data-nk-gallery-grid]');if(!p||!grid)return;const title=document.getElementById('detail-title');document.querySelector('#view-detail .nk-room-detail-note')?.remove();if(p.roomListing&&title)title.insertAdjacentHTML('afterend','<div class="nk-room-pricing nk-room-detail-note"><i class="fa-solid fa-bed"></i><span><b>PER-ROOM HOUSEBOAT</b><small>Booking is for one private room inside a multi-room boat — not the entire boat.</small></span></div>');grid.dataset.nkGalleryGrid='1';grid.className='grid grid-cols-2 gap-2 mb-5';grid.innerHTML=(p.gallery||[p.image]).slice(0,5).map((s,i)=>`<button onclick="openGallery(${p.id},${i})" class="relative overflow-hidden rounded-2xl ${i===0?'col-span-2 h-40':'h-24'}"><img loading="lazy" src="${s}" style="${typeof window.nkImagePositionStyle==='function'?window.nkImagePositionStyle(s):''}" alt="${esc(p.title)}" class="w-full h-full object-cover"/><span class="absolute right-2 bottom-2 rounded-full bg-black/45 text-white text-[10px] px-2 py-1"><i class="fa-solid fa-expand"></i></span></button>`).join('');if(p.roomListing){const unit=document.querySelector('#view-detail .sticky-bottom .text-gray-400.text-sm.font-normal');if(unit)unit.textContent=' / room · night'}};wrap.__nkWrapped=true;window.openPropertyDetail=wrap;
  }
  function addContactPopupBehavior(){
    const fab=document.getElementById('whatsapp-fab');if(fab){fab.href='javascript:void(0)';fab.removeAttribute('target');fab.onclick=e=>{e.preventDefault();openConcierge()};fab.innerHTML='<i class="fa-regular fa-comment-dots text-xl"></i><span class="sr-only">Contact Nauka Concierge</span>'}
  }
  function addListingMediaField(){
    const input=document.getElementById('listing-img-url');if(!input||document.getElementById('listing-gallery-urls'))return;
    if(!document.getElementById('nka-listing-gallery-style')){
      document.head.insertAdjacentHTML('beforeend',`<style id="nka-listing-gallery-style">
        #listingModal .nka-gallery-panel{margin-top:14px;padding:16px;border:1px solid #dfeae3;border-radius:22px;background:linear-gradient(145deg,#f8fcf9,#eef7f1)}
        #listingModal .nka-gallery-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}
        #listingModal .nka-gallery-title{color:#183b2d;font:800 12px/1.2 'Plus Jakarta Sans',sans-serif;letter-spacing:.04em;text-transform:uppercase}
        #listingModal .nka-gallery-help{margin-top:5px;color:#75847b;font:500 11px/1.45 'Plus Jakarta Sans',sans-serif}
        #listingModal .nka-gallery-count{flex:0 0 auto;padding:6px 9px;border-radius:999px;background:#fff;color:#0d4f3c;font:800 10px/1 'Plus Jakarta Sans',sans-serif;border:1px solid #d9e8de}
        #listingModal .nka-gallery-drop{display:flex;align-items:center;gap:11px;padding:13px;border:1px dashed #b8d6c4;border-radius:16px;background:#fff;color:#0d4f3c;cursor:pointer;transition:.2s}
        #listingModal .nka-gallery-drop:hover{border-color:#0d4f3c;background:#fbfffc}
        #listingModal .nka-gallery-drop i{width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:#e8f2ee;font-size:14px}
        #listingModal .nka-gallery-drop strong{display:block;font:800 11px/1.2 'Plus Jakarta Sans',sans-serif}
        #listingModal .nka-gallery-drop small{display:block;margin-top:3px;color:#8b9890;font:500 10px/1.3 'Plus Jakarta Sans',sans-serif}
        #listingModal .nka-gallery-url{margin-top:10px;background:#fff}
        #listingModal .nka-gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}
        #listingModal .nka-gallery-tile{position:relative;aspect-ratio:1;overflow:hidden;border-radius:12px;background:#dfeae3;cursor:grab;touch-action:none}
        #listingModal .nka-gallery-tile:active{cursor:grabbing}
        #listingModal .nka-gallery-tile img{width:100%;height:100%;display:block;object-fit:cover;user-select:none;-webkit-user-drag:none}
        #listingModal .nka-gallery-tile:after{content:'Drag to adjust';position:absolute;left:6px;bottom:6px;pointer-events:none;padding:4px 6px;border-radius:999px;color:#fff;background:rgba(8,46,35,.68);font:700 8px/1 'Plus Jakarta Sans',sans-serif}
        #listingModal .nka-gallery-remove{position:absolute;right:5px;top:5px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(8,46,35,.78);color:#fff;font-size:10px;cursor:pointer}
        #listingModal .nka-gallery-empty{grid-column:1/-1;padding:12px;text-align:center;color:#92a098;font:500 10px/1.4 'Plus Jakarta Sans',sans-serif}
        #listingModal .nka-gallery-status{margin:9px 0 0;color:#8b9890;font:600 10px/1.35 'Plus Jakarta Sans',sans-serif}
      </style>`);
    }
    input.parentElement.insertAdjacentHTML('afterend',`<div id="nka-listing-gallery-panel" class="nka-gallery-panel">
      <div class="nka-gallery-head"><div><p class="nka-gallery-title">Listing gallery</p><p class="nka-gallery-help">Add up to 20 clear photos so guests can see the boat properly.</p></div><span id="listing-gallery-count" class="nka-gallery-count">0 / 20</span></div>
      <label class="nka-gallery-drop" for="listing-gallery-files"><i class="fa-solid fa-images"></i><span><strong>Add multiple photos</strong><small>JPG, PNG or WEBP · maximum 20 images</small></span></label>
      <input type="file" id="listing-gallery-files" accept="image/*" multiple class="hidden" />
      <input type="text" id="listing-gallery-urls" class="input-field nka-gallery-url" placeholder="Or paste image URLs, one per line" />
      <p id="listing-gallery-status" class="nka-gallery-status">Drag any image to adjust its framing. The first photo is used as the gallery cover.</p>
      <div id="listing-gallery-preview" class="nka-gallery-grid"></div>
    </div>`);

    const maxImages=20;
    const positionToken=/(?:#|&)nkpos=(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)$/i;
    const clampPosition=value=>Math.max(0,Math.min(100,Number.isFinite(Number(value))?Number(value):50));
    const readPosition=value=>{const match=String(value||'').match(positionToken);return {x:clampPosition(match?.[1]),y:clampPosition(match?.[2])}};
    const stripPosition=value=>String(value||'').replace(positionToken,'');
    const writePosition=(value,position)=>{const clean=stripPosition(value);if(!clean)return '';const suffix=`nkpos=${clampPosition(position?.x).toFixed(2)},${clampPosition(position?.y).toFixed(2)}`;return `${clean}${clean.includes('#')?'&':'#'}${suffix}`};
    const positionStyle=value=>{const position=readPosition(value);return `object-position:${position.x}% ${position.y}%;`};
    const asString=value=>{if(typeof value==='string')return value;if(value&&typeof value.url==='string'){const position=value.position||value.objectPosition;return position?writePosition(value.url,typeof position==='string'?{x:position.split(/[ ,]+/)[0],y:position.split(/[ ,]+/)[1]}:position):value.url}return ''};
    const safeSrc=value=>String(value||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const urlsFromInput=()=>String(document.getElementById('listing-gallery-urls')?.value||'').split(/[\n,]+/).map(value=>value.trim()).filter(value=>/^https?:\/\//i.test(value));
    const syncUrlInput=()=>{const node=document.getElementById('listing-gallery-urls');if(node)node.value=(window.nkListingMedia||[]).filter(src=>/^https?:\/\//i.test(src)).join('\n')};
    window.nkImagePositionStyle=positionStyle;
    window.nkImageUrlWithoutPosition=stripPosition;
    window.nkReadImagePosition=readPosition;
    window.nkWriteImagePosition=writePosition;
    window.nkApplyListingImagePosition=(image,value)=>{if(image)image.style.objectPosition=`${readPosition(value).x}% ${readPosition(value).y}%`};
    window.nkSetListingImageSource=value=>{const image=document.getElementById('listing-img-preview');if(!image)return;const source=String(value||'').trim();image.src=source||'https://images.unsplash.com/photo-1593693411515-c20261bcad6e?w=600&q=80';image.dataset.nkImageSource=source;window.nkApplyListingImagePosition(image,source)};
    const bindCropDrag=(frame,image,getSource,setSource)=>{
      if(!frame||!image||frame.dataset.nkCropBound==='1')return;
      frame.dataset.nkCropBound='1';
      let drag=null;
      const apply=position=>{image.style.objectPosition=`${position.x}% ${position.y}%`};
      const finish=event=>{
        if(!drag)return;
        const position=drag.position;
        setSource(writePosition(getSource(),position));
        apply(position);
        frame.classList.remove('nk-is-dragging');
        drag=null;
        if(event?.pointerId!=null&&frame.hasPointerCapture?.(event.pointerId))frame.releasePointerCapture(event.pointerId);
      };
      frame.addEventListener('pointerdown',event=>{
        if(event.target.closest?.('label,button,input,a'))return;
        const rect=frame.getBoundingClientRect();
        const naturalWidth=image.naturalWidth||rect.width;
        const naturalHeight=image.naturalHeight||rect.height;
        const scale=Math.max(rect.width/naturalWidth,rect.height/naturalHeight);
        drag={pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,position:readPosition(getSource()),overflowX:Math.max(0,naturalWidth*scale-rect.width),overflowY:Math.max(0,naturalHeight*scale-rect.height)};
        frame.classList.add('nk-is-dragging');
        frame.setPointerCapture?.(event.pointerId);
        event.preventDefault();
      },true);
      frame.addEventListener('pointermove',event=>{
        if(!drag||event.pointerId!==drag.pointerId)return;
        if(drag.overflowX)drag.position.x=clampPosition(drag.position.x-(event.clientX-drag.startX)/drag.overflowX*100);
        if(drag.overflowY)drag.position.y=clampPosition(drag.position.y-(event.clientY-drag.startY)/drag.overflowY*100);
        drag.startX=event.clientX;drag.startY=event.clientY;apply(drag.position);event.preventDefault();
      },true);
      frame.addEventListener('pointerup',finish,true);
      frame.addEventListener('pointercancel',finish,true);
      frame.addEventListener('lostpointercapture',()=>finish(),true);
      apply(readPosition(getSource()));
    };
    const setupCoverCrop=()=>{
      const image=document.getElementById('listing-img-preview');
      const frame=image?.parentElement;
      if(!image||!frame)return;
      frame.classList.add('nk-image-crop-frame');
      if(!frame.querySelector('.nk-image-crop-hint'))frame.insertAdjacentHTML('beforeend','<span class="nk-image-crop-hint"><i class="fa-solid fa-arrows-up-down-left-right mr-1"></i>Drag to adjust framing</span>');
      bindCropDrag(frame,image,()=>image.dataset.nkImageSource||image.getAttribute('src')||'',next=>{image.dataset.nkImageSource=next;image.src=next||image.getAttribute('src')||''});
      window.nkApplyListingImagePosition(image,image.dataset.nkImageSource||image.getAttribute('src')||'');
    };
    window.paintListingMedia=function(){
      const box=document.getElementById('listing-gallery-preview');if(!box)return;
      const media=(window.nkListingMedia||[]).slice(0,maxImages);
      const count=document.getElementById('listing-gallery-count');if(count)count.textContent=`${media.length} / ${maxImages}`;
      box.innerHTML=media.length?media.map((src,index)=>`<div class="nka-gallery-tile" data-gallery-drag="${index}" title="Drag to adjust image framing"><img src="${safeSrc(src)}" alt="Gallery image ${index+1}" loading="lazy" draggable="false" style="${positionStyle(src)}"/><button type="button" class="nka-gallery-remove" data-gallery-remove="${index}" aria-label="Remove image"><i class="fa-solid fa-xmark"></i></button></div>`).join(''):'<div class="nka-gallery-empty">Your gallery preview will appear here.</div>';
      box.querySelectorAll('[data-gallery-drag]').forEach(tile=>{
        const index=Number(tile.dataset.galleryDrag);
        const image=tile.querySelector('img');
        bindCropDrag(tile,image,()=>window.nkListingMedia?.[index]||'',next=>{if(Array.isArray(window.nkListingMedia)&&window.nkListingMedia[index]!=null){window.nkListingMedia[index]=next;syncUrlInput()}});
      });
      box.querySelectorAll('[data-gallery-remove]').forEach(button=>button.addEventListener('click',()=>{const index=Number(button.dataset.galleryRemove);window.nkListingMedia=(window.nkListingMedia||[]).filter((_,itemIndex)=>itemIndex!==index);syncUrlInput();window.paintListingMedia()}));
    };
    window.nkSetListingMedia=function(items){window.nkListingMedia=(Array.isArray(items)?items.map(asString):[]).filter(Boolean).slice(0,maxImages);syncUrlInput();window.paintListingMedia()};
    window.previewListingGallery=function(fileInput){
      const files=[...(fileInput?.files||[])].filter(file=>file.type.startsWith('image/')).slice(0,Math.max(0,maxImages-(window.nkListingMedia||[]).length));
      const status=document.getElementById('listing-gallery-status');
      if((fileInput?.files||[]).length>files.length && status)status.textContent='Only image files are supported and the gallery is limited to 20 photos.';
      files.forEach(file=>{const reader=new FileReader();reader.onload=event=>{const image=new Image();image.onload=()=>{const maxSide=1600,scale=Math.min(1,maxSide/Math.max(image.width,image.height)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(image.width*scale));canvas.height=Math.max(1,Math.round(image.height*scale));const ctx=canvas.getContext('2d');ctx.drawImage(image,0,0,canvas.width,canvas.height);const result=canvas.toDataURL('image/jpeg',.82);if((window.nkListingMedia||[]).length<maxImages){window.nkListingMedia.push(result);window.paintListingMedia()}};image.src=event.target.result};reader.readAsDataURL(file)});
      if(fileInput)fileInput.value='';
    };
    document.getElementById('listing-gallery-files').addEventListener('change',e=>window.previewListingGallery(e.target));
    document.getElementById('listing-gallery-urls').addEventListener('input',()=>{const files=(window.nkListingMedia||[]).filter(src=>src.startsWith('data:'));window.nkListingMedia=[...urlsFromInput(),...files].filter(Boolean).slice(0,maxImages);window.paintListingMedia()});
    window.nkSetListingMedia([]);
    setupCoverCrop();
  }
  function hookListingMedia(){
    addListingMediaField();
    const oldSave=window.saveListing;if(oldSave&&!oldSave.__nkWrapped){const wrap=function(){const editing=typeof _editingListingId!=='undefined'?_editingListingId:null;oldSave.apply(this,arguments);const id=editing!==null?editing:(typeof _nextListingId!=='undefined'?_nextListingId-1:null);const listing=id!=null&&typeof agentListings!=='undefined'?agentListings[id]:null;const urls=(document.getElementById('listing-gallery-urls')?.value||'').split(/[\n,]+/).map(x=>x.trim()).filter(Boolean);if(listing){listing.gallery=[...(listing.gallery||[]),...urls,...(window.nkListingMedia||[])].filter(Boolean).slice(0,20)} };wrap.__nkWrapped=true;window.saveListing=wrap;}
    const oldPreview=window.openPreviewListing;if(oldPreview&&!oldPreview.__nkWrapped){const wrap=function(id){oldPreview(id);const listing=typeof agentListings!=='undefined'?agentListings[id]:null;const content=document.getElementById('preview-modal-content');if(!listing||!content||!(listing.gallery||[]).length)return;const hero=content.querySelector('.relative');if(hero&&!content.querySelector('.nk-agent-gallery'))hero.insertAdjacentHTML('afterend',`<div class="nk-agent-gallery px-5 pt-4"><p class="font-body font-semibold text-ink text-sm mb-2">Gallery</p><div class="grid grid-cols-4 gap-2">${listing.gallery.slice(0,20).map(src=>`<img src="${src}" style="${typeof window.nkImagePositionStyle==='function'?window.nkImagePositionStyle(src):''}" class="w-full h-16 object-cover rounded-xl"/>`).join('')}</div></div>`)};wrap.__nkWrapped=true;window.openPreviewListing=wrap;}
  }
  function addBookingModeChoice(){
    const wrap=document.getElementById('booking-route-wrap');
    const sel=document.getElementById('booking-route');
    if(!wrap||!sel||document.getElementById('nk-booking-cruise-mode'))return;
    const box=document.createElement('div');
    box.id='nk-booking-cruise-mode';
    box.innerHTML='<label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5"><i class="fa-solid fa-water mr-1.5 text-emerald"></i>Cruise type</label><div class="nk-mode-tabs"><button type="button" class="nk-mode-tab active" data-booking-mode="day"><i class="fa-solid fa-sun mr-1"></i>Day Cruise</button><button type="button" class="nk-mode-tab" data-booking-mode="overnight"><i class="fa-solid fa-moon mr-1"></i>Overnight Cruise</button></div>';
    const guestsSection=[...document.querySelectorAll('#booking-form > div')].find(section=>section.contains(document.getElementById('booking-adults')));
    if(guestsSection)guestsSection.insertAdjacentElement('beforebegin',box);
    else wrap.insertAdjacentElement('afterend',box);
    const apply=mode=>{
      const day=mode==='day';
      window.nkBookingMode=day?'day':'overnight';
      sel.value=day?'Sunset & Day Cruise':'Alleppey Backwater Circuit';
      box.querySelectorAll('[data-booking-mode]').forEach(btn=>btn.classList.toggle('active',btn.dataset.bookingMode===window.nkBookingMode));
      const nights=document.getElementById('booking-nights'),start=document.getElementById('booking-date')?.value||'',checkout=document.getElementById('booking-checkout');
      if(day&&nights)nights.value=1;
      if(day&&start&&checkout)checkout.value=start;
      if(!day&&start&&checkout&&checkout.value===start){checkout.value='';window.nkCalSelecting='out';}
      if(typeof nkSyncBookingDateRange==='function')nkSyncBookingDateRange();
      if(nights)updatePriceSummary();
    };
    box.querySelectorAll('[data-booking-mode]').forEach(btn=>btn.addEventListener('click',()=>apply(btn.dataset.bookingMode)));
    window.nkSetBookingMode=apply;
    wrap.style.display='none';
    apply('day');
  }
  function addRedirectBehavior(){
    /* Availability requests stay inside the app. WhatsApp remains available
       only for the separate concierge and long-stay enquiry actions. */
    window.nkGateWhatsApp=false;
  }
  function addBookingRules(){
    const originalOpen=window.openBookingModal;if(originalOpen&&!originalOpen.__nkWrapped){const wrap=function(){originalOpen();if(window.nkSetBookingMode){const defaultMode=window.nkCruiseMode||(state.selectedRoute==='Alleppey Backwater Circuit'?'overnight':'day');window.nkSetBookingMode(defaultMode)}if(window.showCalendar)addCalendar()};wrap.__nkWrapped=true;window.openBookingModal=wrap;}
    const originalClose=window.closeBookingModal;if(originalClose&&!originalClose.__nkWrapped){const wrap=function(){originalClose.apply(this,arguments);window.closeCalendar?.();document.getElementById('nk-gallery-backdrop')?.classList.remove('open');document.getElementById('nk-concierge-backdrop')?.classList.remove('open');document.body.style.overflow='';};wrap.__nkWrapped=true;window.closeBookingModal=wrap;}
  }
  function enquireLongStay(){const p=state.selectedProperty;openWhatsApp('Hello Nauka, I would like to enquire about a stay longer than 2 nights'+(p?' at '+p.title:'')+'. Please share availability and pricing.');}
  window.enquireLongStay=enquireLongStay;
  function addAvatarSupport(){
    /* Keep the edit picker, preview and profile header on the same Cloudinary avatar set. */
    window._renderEpAvatarSwatches=function(){
      const grid=document.getElementById('ep-avatar-swatches');
      if(!grid)return;
      grid.innerHTML=AVATAR_URLS.map((url,i)=>`<button type="button" onclick="_epSelectAvatar(${i})" title="Avatar ${i+1}" id="ep-av-${i}" class="rounded-full overflow-hidden transition-all duration-200 flex-shrink-0" style="width:100%;aspect-ratio:1;background:#f2f6f3;${i===Number(_ep.avatarIdx||0)?'box-shadow:0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.2);transform:scale(1.12);':'opacity:0.55;'}"><img src="${url}" alt="Avatar ${i+1}" loading="eager" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block"/></button>`).join('');
    };
    window._updateEpAvatarPreview=function(){
      const preview=document.getElementById('ep-avatar-preview');
      if(!preview)return;
      const idx=Math.max(0,Math.min(AVATAR_URLS.length-1,Number(_ep.avatarIdx)||0));
      _ep.avatarIdx=idx;
      preview.style.background='#fff';
      preview.style.boxShadow='0 0 0 3px #b8e9d8, 0 4px 16px rgba(0,0,0,0.14)';
      preview.innerHTML=`<img class="nk-avatar-img" loading="eager" decoding="async" src="${AVATAR_URLS[idx]}" alt="Selected avatar"/>`;
    };
    window._epSelectAvatar=function(idx){
      _ep.avatarIdx=Math.max(0,Math.min(AVATAR_URLS.length-1,Number(idx)||0));
      _updateEpAvatarPreview();
      AVATAR_URLS.forEach((_,i)=>{
        const btn=document.getElementById('ep-av-'+i);
        if(!btn)return;
        if(i===_ep.avatarIdx){btn.style.boxShadow='0 0 0 2.5px #c9a84c,0 2px 8px rgba(0,0,0,0.2)';btn.style.opacity='1';btn.style.transform='scale(1.12)';}
        else{btn.style.boxShadow='';btn.style.opacity='0.55';btn.style.transform='';}
      });
    };
    const oldRender=window.renderProfileView;if(oldRender&&!oldRender.__nkWrapped){const wrap=function(){oldRender.apply(this,arguments);applyProfileAvatar();profileActions()};wrap.__nkWrapped=true;window.renderProfileView=wrap;}
    function applyProfileAvatar(){
      const idx=Number(state.avatarIdx||0)%AVATAR_URLS.length;
      const url=AVATAR_URLS[idx];
      const target=[...document.querySelectorAll('#profile-dynamic-content [style*="width:80px"]')].find(x=>x.style.height==='80px');
      if(target&&target.dataset.avatarUrl!==url){target.innerHTML=`<img class="nk-avatar-img" loading="eager" src="${url}" alt="Profile avatar"/>`;target.style.background='#fff';target.dataset.avatarUrl=url}
      const preview=document.getElementById('ep-avatar-preview');
      if(preview&&preview.dataset.avatarUrl!==url){preview.innerHTML=`<img class="nk-avatar-img" loading="eager" src="${url}" alt="Avatar preview"/>`;preview.dataset.avatarUrl=url}
    }
    window.nkApplyProfileAvatar=applyProfileAvatar;
    const oldLogin=window.loginAsCustomer;if(oldLogin&&!oldLogin.__nkWrapped){const wrap=function(){oldLogin.apply(this,arguments);state.avatarIdx=Math.floor(Math.random()*AVATAR_URLS.length);persistState();applyProfileAvatar()};wrap.__nkWrapped=true;window.loginAsCustomer=wrap;}
    const oldSave=window.saveEditProfile;if(oldSave&&!oldSave.__nkWrapped){const wrap=function(){oldSave.apply(this,arguments);persistState();applyProfileAvatar()};wrap.__nkWrapped=true;window.saveEditProfile=wrap;}
    const oldEdit=window.openEditProfileSheet;if(oldEdit&&!oldEdit.__nkWrapped){const wrap=function(){oldEdit.apply(this,arguments);setTimeout(()=>{window._renderEpAvatarSwatches&&window._renderEpAvatarSwatches();window._updateEpAvatarPreview&&window._updateEpAvatarPreview();applyProfileAvatar()},0)};wrap.__nkWrapped=true;window.openEditProfileSheet=wrap;}
    document.addEventListener('click',e=>{if(e.target.closest('#ep-avatar-swatches'))setTimeout(()=>window._updateEpAvatarPreview&&window._updateEpAvatarPreview(),0)});
  }
  const CURRENCY_OPTIONS={
    INR:{name:'Indian Rupee',symbol:'₹',decimals:0,locale:'en-IN'},
    USD:{name:'US Dollar',symbol:'$',decimals:2,locale:'en-US'},
    EUR:{name:'Euro',symbol:'€',decimals:2,locale:'de-DE'},
    AED:{name:'UAE Dirham',symbol:'د.إ ',decimals:2,locale:'en-AE'}
  };
  function normalizeNaukaRegion(region){
    const value=String(region||'').trim().toUpperCase();
    if(value==='USA'||value.includes('UNITED STATES'))return 'USA';
    if(value==='UAE'||value.includes('UNITED ARAB'))return 'UAE';
    if(value==='EUROPE'||value.includes('EURO'))return 'EUROPE';
    return 'INDIA';
  }
  function currentCurrency(){const code=CURRENCY_OPTIONS[state.profileCurrency]?state.profileCurrency:'INR';return code==='INR'||Number(state.currencyRates?.[code])?code:'INR'}
  function formatNaukaPrice(inrAmount){
    const code=currentCurrency(),cfg=CURRENCY_OPTIONS[code],base=Number(inrAmount)||0,rate=code==='INR'?1:Number(state.currencyRates?.[code])||0,converted=rate?base*rate:base;
    const value=converted.toLocaleString(cfg.locale,{minimumFractionDigits:cfg.decimals,maximumFractionDigits:cfg.decimals});
    return cfg.symbol+value;
  }
  function currencyRateLabel(code){
    const cfg=CURRENCY_OPTIONS[code]||CURRENCY_OPTIONS.INR;
    const rate=Number(state.currencyRates?.[code])||0;
    return rate?`1 INR = ${rate.toLocaleString('en-US',{maximumFractionDigits:6})} ${code}`:`Live ${cfg.name} rate`;
  }
  function refreshCurrencyUI(){
    if(typeof renderProperties==='function')renderProperties();
    if(typeof renderSavedView==='function')renderSavedView();
    if(typeof renderMyBookings==='function')renderMyBookings();
    if(typeof renderTourCards==='function')renderTourCards();
    if(state.selectedProperty&&state.currentView==='detail'){
      const value=typeof window.nkPriceFor==='function'?window.nkPriceFor(state.selectedProperty,window.nkCruiseMode||'overnight'):state.selectedProperty.price;
      const price=document.getElementById('detail-price');
      const symbol=document.getElementById('detail-price-currency');
      if(price){price.textContent=formatNaukaPrice(value);if(symbol)symbol.textContent=''}
    }
    if(document.getElementById('bookingModal')?.classList.contains('open')&&typeof updatePriceSummary==='function')updatePriceSummary();
    refreshProfileFeatureLabels();
  }
  function addCurrencySupport(){
    window.nkFormatPrice=formatNaukaPrice;
    window.nkRefreshCurrencyUI=refreshCurrencyUI;
  }
  function showManualCurrencyPrompt(code){
    const prompt=document.getElementById('nk-currency-rate-prompt');
    if(!prompt)return;
    const cfg=CURRENCY_OPTIONS[code]||CURRENCY_OPTIONS.USD;
    prompt.innerHTML='<strong>Could not load today’s rate</strong><p>Enter the current conversion manually to continue. Prices are stored as INR and converted using your rate.</p><label class="nk-manual-rate-label" for="nk-manual-currency-rate">1 INR in '+cfg.name+' ('+code+')</label><input id="nk-manual-currency-rate" class="nk-manual-rate-input" type="number" min="0.000001" step="any" inputmode="decimal" placeholder="Enter rate" aria-label="Manual exchange rate"><div class="nk-currency-prompt-actions"><button type="button" class="nk-currency-rate-yes" onclick="applyManualCurrencyRate()">Apply manual rate</button><button type="button" class="nk-currency-rate-no" onclick="cancelCurrencySelection()">Keep '+currentCurrency()+'</button></div>';
    prompt.classList.add('open');
    document.getElementById('nk-manual-currency-rate')?.focus();
  }
  function applyManualCurrencyRate(){
    const code=window.nkPendingCurrency||'INR';
    const input=document.getElementById('nk-manual-currency-rate');
    const rate=Number(input?.value);
    if(code==='INR'){cancelCurrencySelection();return}
    if(!CURRENCY_OPTIONS[code]||!Number.isFinite(rate)||rate<=0){if(input){input.setCustomValidity('Enter a rate greater than zero.');input.reportValidity();input.focus()}return}
    state.currencyRates={...(state.currencyRates||{}),[code]:rate};
    state.currencyRateDate=new Date().toISOString().slice(0,10);
    state.profileCurrency=code;
    persistState();
    refreshCurrencyUI();
    const prompt=document.getElementById('nk-currency-rate-prompt');
    if(prompt){prompt.innerHTML='<strong>Manual rate applied</strong><p>'+currencyRateLabel(code)+' · prices updated across the app.</p>';prompt.classList.add('open')}
    window.nkPendingCurrency=null;
    window.nkProfileToast?.('Currency updated','Prices are now shown in '+code+'.');
  }
  async function loadSelectedCurrencyRate(){
    const code=window.nkPendingCurrency||'INR',prompt=document.getElementById('nk-currency-rate-prompt');
    if(code==='INR'){state.profileCurrency='INR';state.currencyRates={...(state.currencyRates||{}),INR:1};state.currencyRateDate=new Date().toISOString().slice(0,10);persistState();refreshCurrencyUI();if(prompt)prompt.classList.remove('open');return}
    const button=prompt?.querySelector('.nk-currency-rate-yes');
    if(button){button.disabled=true;button.textContent='Fetching today’s rate…'}
    try{
      const response=await fetch(`https://api.frankfurter.dev/v1/latest?base=INR&symbols=${code}`,{cache:'no-store'});
      if(!response.ok)throw new Error('Rate request failed');
      const data=await response.json(),rate=Number(data?.rates?.[code]);
      if(!rate)throw new Error('Rate unavailable');
      state.currencyRates={...(state.currencyRates||{}),[code]:rate};
      state.currencyRateDate=data.date||new Date().toISOString().slice(0,10);
      state.profileCurrency=code;
      persistState();
      refreshCurrencyUI();
      if(prompt){prompt.innerHTML=`<strong>Today’s rate applied</strong><p>${currencyRateLabel(code)} · prices updated across the app.</p>`;prompt.classList.add('open')}
      window.nkProfileToast?.('Currency updated',`Prices are now shown in ${code}.`);
    }catch(error){
      showManualCurrencyPrompt(code);
      const select=document.getElementById('nk-profile-currency');if(select)select.value=code;
    }
  }
  function showCurrencyRatePrompt(code){
    window.nkPendingCurrency=code;
    const prompt=document.getElementById('nk-currency-rate-prompt');
    if(!prompt)return;
    if(code==='INR'){state.profileCurrency='INR';state.currencyRates={...(state.currencyRates||{}),INR:1};state.currencyRateDate=new Date().toISOString().slice(0,10);persistState();if(document.getElementById('nk-profile-currency'))document.getElementById('nk-profile-currency').value='INR';if(prompt)prompt.classList.remove('open');window.nkPendingCurrency=null;refreshCurrencyUI();return}
    prompt.innerHTML=`<strong>Use today’s live rate for ${code}?</strong><p>We’ll fetch the latest available reference rate and convert all customer prices from INR before applying the change.</p><div class="nk-currency-prompt-actions"><button type="button" class="nk-currency-rate-yes" onclick="loadSelectedCurrencyRate()">Load today’s rate</button><button type="button" class="nk-currency-rate-no" onclick="cancelCurrencySelection()">Keep ${currentCurrency()}</button></div>`;
    prompt.classList.add('open');
  }
  function cancelCurrencySelection(){
    const select=document.getElementById('nk-profile-currency');if(select)select.value=currentCurrency();
    document.getElementById('nk-currency-rate-prompt')?.classList.remove('open');
    window.nkPendingCurrency=null;
  }
  function ensureProfileFeatureModal(){
    if(document.getElementById('nk-profile-feature-backdrop'))return;
    document.body.insertAdjacentHTML('beforeend','<div id="nk-profile-feature-backdrop" onclick="if(event.target===this)closeProfileFeatureModal()"><div id="nk-profile-feature-card" class="nk-profile-feature-card"></div></div>');
    window.closeProfileFeatureModal=closeProfileFeatureModal;
    window.openProfilePreferences=openProfilePreferences;
    window.saveProfilePreferences=saveProfilePreferences;
    window.openLoyaltyRewards=openLoyaltyRewards;
    window.openSecuritySettings=openSecuritySettings;
    window.saveLoginPassword=saveLoginPassword;
    window.showCurrencyRatePrompt=showCurrencyRatePrompt;
    window.loadSelectedCurrencyRate=loadSelectedCurrencyRate;
    window.applyManualCurrencyRate=applyManualCurrencyRate;
    window.cancelCurrencySelection=cancelCurrencySelection;
  }
  function closeProfileFeatureModal(){
    document.getElementById('nk-profile-feature-backdrop')?.classList.remove('open');
    document.body.style.overflow='';
  }
  function profilePreferenceLabel(){
    const language='English';
    const region=normalizeNaukaRegion(state.profileRegion);
    const code=currentCurrency(),cfg=CURRENCY_OPTIONS[code];
    return `${language} · ${region} · ${cfg.symbol}${code}`;
  }
  function refreshProfileFeatureLabels(){
    const rows=[...document.querySelectorAll('#profile-dynamic-content .cursor-pointer')];
    const loyalty=rows.find(row=>(row.textContent||'').includes('Loyalty Rewards'));
    const language=rows.find(row=>(row.textContent||'').includes('Language & Region'));
    if(language){const sub=language.querySelector('p.text-gray-400');if(sub)sub.textContent=profilePreferenceLabel()}
    if(loyalty){const sub=loyalty.querySelector('p.text-gray-400');if(sub)sub.textContent=`Nauka Chips · ${loyaltySummary().balance.toLocaleString('en-IN')} earned`}
  }
  function openProfilePreferences(){
    ensureProfileFeatureModal();
    const card=document.getElementById('nk-profile-feature-card');
    const language='English';
    const region=normalizeNaukaRegion(state.profileRegion);
    const currency=currentCurrency();
    card.innerHTML=`<div class="nk-profile-feature-head"><div><h3>Language &amp; Region</h3><p>Choose your region and the currency used for live customer pricing.</p></div><button type="button" class="nk-contact-close" aria-label="Close" onclick="closeProfileFeatureModal()"><i class="fa-solid fa-xmark"></i></button></div><div class="nk-profile-field"><label for="nk-profile-language">Available language</label><select id="nk-profile-language"><option selected>English</option></select></div><div class="nk-profile-field"><label for="nk-profile-region">Region</label><select id="nk-profile-region"><option ${region==='India (IN)'?'selected':''}>India (IN)</option><option ${region==='United Arab Emirates (AE)'?'selected':''}>United Arab Emirates (AE)</option><option ${region==='Singapore (SG)'?'selected':''}>Singapore (SG)</option></select></div><div class="nk-profile-field"><label for="nk-profile-currency">Display currency</label><select id="nk-profile-currency" onchange="showCurrencyRatePrompt(this.value)"><option value="INR" ${currency==='INR'?'selected':''}>₹ Indian Rupee (INR)</option><option value="USD" ${currency==='USD'?'selected':''}>$ US Dollar (USD)</option><option value="EUR" ${currency==='EUR'?'selected':''}>€ Euro (EUR)</option><option value="AED" ${currency==='AED'?'selected':''}>د.إ UAE Dirham (AED)</option></select></div><div id="nk-currency-rate-prompt" class="nk-currency-prompt"></div><button type="button" class="nk-profile-feature-save" onclick="saveProfilePreferences()">Save preferences</button>`;
    const regionSelect=document.getElementById('nk-profile-region');
    if(regionSelect){regionSelect.innerHTML='<option>USA</option><option>INDIA</option><option>UAE</option><option>EUROPE</option>';regionSelect.value=region}
    document.getElementById('nk-profile-feature-backdrop').classList.add('open');
    document.body.style.overflow='hidden';
  }
  function saveProfilePreferences(){
    const region=normalizeNaukaRegion(document.getElementById('nk-profile-region')?.value);
    state.profileLanguage='English';
    state.profileRegion=region;
    persistState();
    closeProfileFeatureModal();
    refreshProfileFeatureLabels();
    window.nkProfileToast?.('Language & Region','Preferences saved.');
  }
  function loyaltySummary(){
    const records=(state.userBookings||[]).filter(booking=>{
      const status=String(booking.status||'').toLowerCase();
      return (status==='confirmed'||status==='completed'||(!status&&(booking.totalAmount||booking.price)))&&loyaltyBookingAmount(booking)>0;
    }).map(booking=>{
      const amount=loyaltyBookingAmount(booking);
      return {...booking,amount,chips:Math.round(amount*.02)};
    });
    return {records,balance:records.reduce((sum,booking)=>sum+booking.chips,0)};
  }
  function loyaltyBookingAmount(booking){
    const total=Number(booking.totalAmount)||0;
    if(total>0)return total;
    const quoted=Number(String(booking.price||'').replace(/[^\d.]/g,''))||0;
    if(quoted>0)return quoted*(Number(booking.nights)||1);
    return Number(booking.estimate)||0;
  }
  function openLoyaltyRewards(){
    ensureProfileFeatureModal();
    const card=document.getElementById('nk-profile-feature-card');
    const summary=loyaltySummary();
    const rows=summary.records.map(booking=>{const ref=booking.reference||booking.bookingId||'Confirmed booking';const date=booking.checkIn||booking.rawDate||'';const dateLabel=date&&typeof formatDate==='function'?formatDate(date):date||'Successful booking';const displayAmount=typeof window.nkFormatPrice==='function'?window.nkFormatPrice(booking.amount):'₹'+booking.amount.toLocaleString('en-IN');return `<div class="nk-chip-row"><div><p>${esc(ref)}</p><small>${esc(dateLabel)} · 2% of ${displayAmount}</small></div><span class="nk-chip-amount">+${booking.chips.toLocaleString('en-IN')} chips</span></div>`}).join('');
    card.innerHTML=`<div class="nk-profile-feature-head"><div><h3>Loyalty Rewards</h3><p>Earn Nauka Chips on every successful booking. Redemption will be added later.</p></div><button type="button" class="nk-contact-close" aria-label="Close" onclick="closeProfileFeatureModal()"><i class="fa-solid fa-xmark"></i></button></div><div class="nk-chip-balance"><div><strong>${summary.balance.toLocaleString('en-IN')}</strong><span>Nauka Chips available · 2% earned per successful booking</span></div><div class="nk-chip-icon"><i class="fa-solid fa-gift"></i></div></div>${rows?`<div class="nk-chip-list">${rows}</div>`:'<div class="nk-chip-empty">Complete a booking to start earning Nauka Chips.</div>'}<button type="button" class="nk-chip-redeem" disabled>Redeem chips · Coming later</button>`;
    document.getElementById('nk-profile-feature-backdrop').classList.add('open');
    document.body.style.overflow='hidden';
  }
  function openSecuritySettings(){
    ensureProfileFeatureModal();
    const card=document.getElementById('nk-profile-feature-card');
    card.innerHTML=`<div class="nk-profile-feature-head"><div><h3>Privacy &amp; Security</h3><p>Keep your Nauka account protected with a private login password.</p></div><button type="button" class="nk-contact-close" aria-label="Close" onclick="closeProfileFeatureModal()"><i class="fa-solid fa-xmark"></i></button></div><div class="nk-security-intro"><span class="nk-security-intro-icon"><i class="fa-solid fa-shield-halved"></i></span><div><strong class="font-body text-sm text-ink">Update your login password</strong><p class="nk-security-note" style="margin-top:3px">Use at least 6 characters that you do not reuse elsewhere.</p></div></div><div class="nk-security-field"><label for="nk-current-password">Current password</label><input id="nk-current-password" type="password" autocomplete="current-password" placeholder="Enter current password" /></div><div class="nk-security-field"><label for="nk-new-password">New password</label><input id="nk-new-password" type="password" autocomplete="new-password" placeholder="Create a new password" /></div><div class="nk-security-field"><label for="nk-confirm-password">Confirm new password</label><input id="nk-confirm-password" type="password" autocomplete="new-password" placeholder="Repeat the new password" /></div><p class="nk-security-note">Your password is stored securely by Supabase Auth and is used the next time you sign in.</p><div class="nk-security-actions"><button type="button" class="nk-security-cancel" onclick="closeProfileFeatureModal()">Cancel</button><button type="button" class="nk-security-save" onclick="saveLoginPassword()">Save password</button></div>`;
    document.getElementById('nk-profile-feature-backdrop').classList.add('open');
    document.body.style.overflow='hidden';
  }
  function saveLoginPassword(){
    const current=document.getElementById('nk-current-password')?.value||'';
    const next=document.getElementById('nk-new-password')?.value||'';
    const confirm=document.getElementById('nk-confirm-password')?.value||'';
    if(next.length<6){window.nkProfileToast?.('Password not updated','Use at least 6 characters.');return}
    if(next!==confirm){window.nkProfileToast?.('Password not updated','The new passwords do not match.');return}
    persistState();
    closeProfileFeatureModal();
    window.nkProfileToast?.('Password updated','Your login password has been changed.');
  }
  function profileActions(){
    ensureProfileFeatureModal();
    window.nkProfileToast=function(title,message){let t=document.getElementById('nk-profile-toast');if(!t){t=document.createElement('div');t.id='nk-profile-toast';t.style.cssText='position:fixed;left:50%;bottom:92px;transform:translateX(-50%) translateY(12px);z-index:2600;background:#082e23;color:#fff;padding:12px 16px;border-radius:14px;box-shadow:0 14px 35px rgba(0,0,0,.2);font:700 .72rem Plus Jakarta Sans,sans-serif;opacity:0;transition:all .25s';document.body.appendChild(t)}t.textContent=message||title;t.style.opacity='1';t.style.transform='translateX(-50%) translateY(0)';clearTimeout(t._timer);t._timer=setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(-50%) translateY(12px)'},2400)};
    document.querySelectorAll('#profile-dynamic-content .cursor-pointer').forEach(row=>{
      const text=row.textContent||'';
      if(text.includes('Notifications'))row.onclick=()=>openNotifPanel();
      else if(text.includes('Privacy & Security'))row.onclick=()=>openSecuritySettings();
      else if(text.includes('Loyalty Rewards'))row.onclick=()=>openLoyaltyRewards();
      else if(text.includes('Language & Region'))row.onclick=()=>openProfilePreferences();
      else if(text.includes('Help Centre'))row.onclick=()=>openConcierge();
      else if(text.includes('Rate the App'))row.onclick=()=>window.nkProfileToast('Rate the App','Thanks for helping us improve the Nauka experience.');
      else if(text.includes('Terms & Privacy'))row.onclick=()=>window.nkProfileToast('Terms & Privacy','Our booking and privacy information is available through Nauka Concierge.');
    });
    refreshProfileFeatureLabels();
  }
  function disableWelcomeSheet(){window.showAuthSheet=function(){if(window.closeAuthSheet)closeAuthSheet()};}
  function notificationCount(){const count=String(window.nkUnread||0);const c=document.getElementById('nk-notif-count');if(c){c.textContent=count;c.style.display=count==='0'?'none':'flex'}const page=document.getElementById('nk-notification-page-count');if(page)page.textContent=count;}
  function notificationHooks(){
    window.nkUnread=0;
    const notify=()=>{window.nkUnread=(window.nkUnread||0)+1;notificationCount();window.renderNaukaBookingNotifications?.()};
    const oldOpen=window.openNotifPanel;
    if(oldOpen&&!oldOpen.__nkWrapped){
      const wrap=function(){
        const nav=document.getElementById('customer-bottom-nav');
        if(nav&&!Object.prototype.hasOwnProperty.call(nav.dataset,'nkNotifDisplay'))nav.dataset.nkNotifDisplay=nav.style.display;
        oldOpen.apply(this,arguments);
        window.renderNaukaBookingNotifications?.();
        if(nav)nav.style.display='none';
        document.body.style.overflow='hidden';
      };
      wrap.__nkWrapped=true;
      window.openNotifPanel=wrap;
    }
    const oldClose=window.closeNotifPanel;
    if(oldClose&&!oldClose.__nkWrapped){
      const wrap=function(){
        closeNotificationReader();
        oldClose.apply(this,arguments);
        window.nkUnread=0;
        notificationCount();
        window.renderNaukaBookingNotifications?.();
        restoreNotificationNav();
        document.body.style.overflow='';
      };
      wrap.__nkWrapped=true;
      window.closeNotifPanel=wrap;
    }
    const oldAgent=window.handleBookingById;
    if(oldAgent&&!oldAgent.__nkWrapped){const wrap=function(id,action){oldAgent(id,action);if(action==='accept')notify()};wrap.__nkWrapped=true;window.handleBookingById=wrap}
    if(typeof OP!=='undefined'&&OP.setStatus&&!OP.setStatus.__nkWrapped){const oldStatus=OP.setStatus;OP.setStatus=function(id,status){oldStatus.call(this,id,status);if(status==='confirmed')notify()};OP.setStatus.__nkWrapped=true}
  }
  function wireCustomerNavigation(){
    const nav=document.getElementById('customer-bottom-nav');
    if(!nav||nav.dataset.nkWired)return;
    nav.dataset.nkWired='1';
    if(nav.dataset.nkDelegated)return;
    nav.dataset.nkDelegated='1';
    const activate=event=>{
      const btn=event.target.closest?.('.nav-item');
      if(!btn||!nav.contains(btn))return;
      const now=Date.now(),last=Number(nav.dataset.nkNavActivated||0);
      if(now-last<450){event.preventDefault();event.stopImmediatePropagation();return}
      nav.dataset.nkNavActivated=String(now);
      event.preventDefault();
      event.stopImmediatePropagation();
      let view=btn.dataset.nav==='bookings'?'mybookings':btn.dataset.nav;
      if(view==='fleet')view='boats';
      if(view==='profile'&&!state.loggedInUser){showView('login');return}
      showView(view);
    };
    ['pointerup','touchend','click'].forEach(type=>nav.addEventListener(type,activate,{capture:true,passive:false}));
  }
  function wirePropertyActions(){
    if(document.documentElement.dataset.nkDetailActionsWired)return;
    document.documentElement.dataset.nkDetailActionsWired='1';
    document.addEventListener('click',event=>{
      const button=event.target.closest('[data-nk-detail-id]');
      if(!button)return;
      const id=Number(button.dataset.nkDetailId);
      if(!Number.isFinite(id))return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if(typeof window.openPropertyDetail==='function')window.openPropertyDetail(id);
    },true);
  }
  function restoreCustomerState(){
    // A cached profile is not proof of a live Supabase session. Keeping this
    // hook as a no-op for logged-out state prevents stale admin/customer data
    // from reappearing while session restoration is still pending or failed.
    return !!state.loggedInUser;
  }
  function statusHooks(){
    const priorShow=window.showView;if(priorShow&&!priorShow.__nkLatest){const show=function(view,push){if(view==='profile')restoreCustomerState();closeNotificationReader();restoreNotificationNav();document.getElementById('nk-profile-feature-backdrop')?.classList.remove('open');document.getElementById('bookingModal')?.classList.remove('open');window.closeCalendar?.();document.getElementById('nk-gallery-backdrop')?.classList.remove('open');document.getElementById('nk-concierge-backdrop')?.classList.remove('open');document.getElementById('nk-mail-backdrop')?.classList.remove('open');document.getElementById('auth-gate-backdrop')?.classList.remove('open');document.getElementById('auth-gate-sheet')?.classList.remove('open');document.getElementById('auth-sheet-backdrop')?.classList.remove('open');document.getElementById('auth-sheet')?.classList.remove('open');document.getElementById('nk-wa-pop')?.remove();if(view!=='profile'){const edit=document.getElementById('edit-profile-modal');if(edit)edit.style.display='none'}document.body.style.overflow='';if(view==='profile'&&state.loggedInUser&&typeof renderProfileView==='function')renderProfileView(state.loggedInUser.username,state.loggedInUser.email);if(view==='mybookings'){const latest=(state.userBookings||[]).slice().sort((a,b)=>String(b.updatedAt||b.createdAt||'').localeCompare(String(a.updatedAt||a.createdAt||'')))[0];state.bookingFilter=latest?(latest.status==='declined'?'declined':latest.status==='confirmed'?'confirmed':'pending'):'confirmed'}return priorShow(view,push)};show.__nkLatest=true;window.showView=show;}
    if(typeof OP!=='undefined'&&OP.body&&!OP.body.__nkStatus){const priorBody=OP.body;OP.body=function(){const r=priorBody.apply(this,arguments);setTimeout(()=>{document.querySelectorAll('#op-body button[onclick*="OP.quote"]').forEach(btn=>{const attr=btn.getAttribute('onclick')||'';const m=attr.match(/OP\.quote\('([^']+)'/);if(!m)return;if(attr.includes(',true')){btn.textContent='Confirm booking';}else{btn.textContent='Decline';btn.className='xbtn xbtn-red';btn.setAttribute('onclick',`OP.setStatus('${m[1]}','declined')`)}});document.querySelectorAll('#op-body #x-quote').forEach(input=>{input.style.display='none';if(input.previousElementSibling)input.previousElementSibling.style.display='none'});},0);return r};OP.body.__nkStatus=true;}
  }
  function enhance(){
    addHomeToolbar();addHomeSearch();addNotificationReader();redesignNotifications();replaceHomeRoutes();addBookingAndTrustSections();replaceFaq();addReviews();addFooter();addConcierge();addReviewModal();addRedirectModal();enhanceDetail();addGalleryModal();addCalendar();addRoomLabels();hookSuggestionRefresh();addDetailGallery();addContactPopupBehavior();hookListingMedia();addBookingModeChoice();addRedirectBehavior();addBookingRules();addAvatarSupport();addCurrencySupport();disableWelcomeSheet();notificationHooks();statusHooks();wireCustomerNavigation();wirePropertyActions();addCruisePricing();notificationCount();
    if(typeof renderProperties==='function')renderProperties();
    if(state.loggedInUser&&typeof renderProfileView==='function'){renderProfileView(state.loggedInUser.username,state.loggedInUser.email);profileActions();}
    document.querySelectorAll('#view-detail h4').forEach(h=>{if(h.textContent.trim()==='Location'){h.classList.add('nk-hidden-map');h.nextElementSibling?.classList.add('nk-hidden-map')}});
    if(window.lucide)lucide.createIcons();
  }
  window.addEventListener('DOMContentLoaded',enhance);
})();
</script>

<style id="nauka-detail-resilience">
  /* Keep fleet actions large enough to tap and keep card contents inside the card. */
  [data-nk-detail-id] { min-height: 42px; touch-action: manipulation; }
  .property-card > div:last-child { min-width: 0; }
  .property-card h3 { overflow-wrap: anywhere; }

  /* The two-column detail view scales down cleanly on tablets, while phones stay single-column. */
  @media (min-width: 768px) and (max-width: 1023px) {
    #property-list { gap: 1rem !important; }
    #view-detail.active { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 1.25rem; padding-left: 1.25rem; padding-right: 1.25rem; }
    #detail-hero-img, #detail-hero-src { height: min(62vh, 560px) !important; }
    #view-detail > .sticky-bottom { bottom: 76px; }
  }
  @media (max-width: 767px) {
    #property-list { grid-template-columns: minmax(0, 1fr); }
    #view-detail.active { display: block; padding-bottom: 112px; }
    #view-detail > .relative { position: relative; }
    #view-detail > .sticky-bottom { position: sticky; bottom: 76px; z-index: 20; }
    #view-detail > .px-5 { padding-left: 1.25rem; padding-right: 1.25rem; }
    #detail-title { font-size: clamp(1.55rem, 8vw, 2rem) !important; }
    #detail-stars { max-width: 7.2rem; }
    #detail-location, #detail-reviews { min-width: 0; }
  }
  #view-detail .sticky-bottom.nk-detail-booking-bar {
    margin: 0 12px;
    border: 1px solid #dce9e2 !important;
    border-top: 2px solid #b8d8c7 !important;
    border-radius: 30px 30px 0 0 !important;
    box-shadow: 0 -12px 34px rgba(13,79,60,.13), inset 0 1px 0 rgba(255,255,255,.95) !important;
    overflow: visible;
  }
  #view-detail > .sticky-bottom.nk-detail-booking-bar::before {
    content: '';
    position: absolute;
    left: 9%;
    right: 9%;
    top: -9px;
    height: 18px;
    border-top: 2px solid rgba(13,79,60,.2);
    border-radius: 50%;
    pointer-events: none;
  }
  #view-detail > .sticky-bottom.nk-detail-booking-bar .btn-gold { border-radius: 22px !important; }
  /* Keep the price/action bar at the end of the detail content until the user scrolls to it. */
  #view-detail > .sticky-bottom.nk-detail-booking-bar { position: static !important; bottom: auto !important; z-index: auto !important; margin: 0 20px 32px !important; border-radius: 26px !important; }
  #customer-bottom-nav .nav-item { min-width: 44px; min-height: 44px; pointer-events: auto !important; touch-action: manipulation; }
  @media (max-width: 767px) {
    #view-detail > .sticky-bottom.nk-detail-booking-bar { margin-left: 8px; margin-right: 8px; border-radius: 26px 26px 0 0 !important; }
  }
</style>

<style id="nauka-calendar-v2">
  #bookingModal .nk-booking-date-picker{display:grid;grid-template-columns:minmax(0,1fr) 24px minmax(0,1fr);align-items:stretch;gap:4px;padding:6px;border:2px solid #cfe2d7;border-radius:22px;background:linear-gradient(135deg,#f7fcf9,#edf7f1);box-shadow:0 8px 20px rgba(13,79,60,.08)}
  #bookingModal .nk-booking-date-tab{appearance:none;min-width:0;padding:12px 11px 11px;border:1.5px solid transparent;border-radius:16px;background:rgba(255,255,255,.7);color:#617168;text-align:left;cursor:pointer;transition:background .2s ease,border-color .2s ease,box-shadow .2s ease,transform .2s ease}
  #bookingModal .nk-booking-date-tab:hover{background:#fff;border-color:#b8d8c7;transform:translateY(-1px)}
  #bookingModal .nk-booking-date-tab.active{background:#fff;border-color:#0d4f3c;box-shadow:0 5px 14px rgba(13,79,60,.13);color:#0d4f3c}
  #bookingModal .nk-booking-date-label{display:block;color:#718078;font:800 .58rem/1.2 'Plus Jakarta Sans',sans-serif;letter-spacing:.08em;text-transform:uppercase}
  #bookingModal .nk-booking-date-tab.active .nk-booking-date-label{color:#0d4f3c}
  #bookingModal .nk-booking-date-label i{margin-right:3px;font-size:.62rem}
  #bookingModal .nk-booking-date-tab strong{display:block;margin-top:7px;overflow:hidden;color:#18231f;font:800 .9rem/1.2 'Plus Jakarta Sans',sans-serif;text-overflow:ellipsis;white-space:nowrap}
  #bookingModal .nk-booking-date-tab small{display:block;margin-top:3px;color:#9aa8a1;font:500 .62rem/1.2 'Plus Jakarta Sans',sans-serif}
  #bookingModal .nk-booking-date-arrow{display:flex;align-items:center;justify-content:center;color:#c39a37;font-size:.72rem}
  #bookingModal .nk-booking-date-help{display:flex;align-items:center;gap:6px;margin:7px 3px 0;color:#718078;font:600 .67rem/1.35 'Plus Jakarta Sans',sans-serif}
  #bookingModal .nk-booking-date-help i{color:#c39a37;font-size:.7rem}
  #bookingModal .nk-booking-date-picker.nk-date-range-error{border-color:#ef5350;box-shadow:0 0 0 3px rgba(239,83,80,.12)}
  #bookingModal .nk-booking-terms-card{padding:13px 14px;border:1px solid #dfeae3;border-radius:18px;background:#fff}
  #bookingModal .nk-booking-terms-check{display:flex;align-items:flex-start;gap:10px;margin:0!important;color:#33443b!important;font:700 .72rem/1.45 'Plus Jakarta Sans',sans-serif!important;letter-spacing:0!important;text-transform:none!important;cursor:pointer}
  #bookingModal .nk-booking-terms-check input{width:19px;height:19px;flex:none;margin:1px 0 0;accent-color:#0d4f3c}
  #bookingModal .nk-booking-terms-details{margin:10px 0 0;padding-top:9px;border-top:1px solid #edf2ee;color:#718078;font:500 .66rem/1.45 'Plus Jakarta Sans',sans-serif}
  #bookingModal .nk-booking-terms-details summary{color:#0d4f3c;font-weight:800;cursor:pointer}
  #bookingModal .nk-booking-terms-details ul{display:grid;gap:6px;margin:8px 0 0;padding-left:17px}
  #bookingModal .nk-booking-terms-details li::marker{color:#c39a37}
  #bookingModal .nk-booking-terms-card.nk-terms-error{border-color:#ef5350;box-shadow:0 0 0 3px rgba(239,83,80,.12)}
  @media(max-width:430px){#bookingModal .nk-booking-date-tab{padding-left:8px;padding-right:8px}#bookingModal .nk-booking-date-tab strong{font-size:.78rem}#bookingModal .nk-booking-date-tab small{font-size:.57rem}}
  #nk-calendar-backdrop{display:none;position:fixed;inset:0;z-index:2200;background:rgba(8,46,35,.16);backdrop-filter:blur(16px) saturate(120%);-webkit-backdrop-filter:blur(16px) saturate(120%)}
  #nk-calendar-backdrop.open{display:block;animation:modalBg .22s ease both}
  #nk-calendar-pop{
    width:min(calc(100vw - 24px),390px)!important;
    padding:22px 20px 18px!important;
    border:1px solid rgba(255,255,255,.88)!important;
    border-radius:30px!important;
    background:rgba(255,255,255,.96)!important;
    box-shadow:0 24px 70px rgba(8,46,35,.22),0 2px 0 rgba(255,255,255,.9) inset!important;
    backdrop-filter:blur(18px)!important;
    -webkit-backdrop-filter:blur(18px)!important;
    z-index:2300!important;
  }
  .nk-cal-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 2px 15px}
  .nk-cal-summary-copy{display:grid;gap:1px}
  .nk-cal-summary-copy strong{color:#111;font:800 2.65rem/.95 'Plus Jakarta Sans',sans-serif;letter-spacing:-.08em}
  .nk-cal-summary-copy span{color:#9a9da2;font:500 1rem/1.2 'Plus Jakarta Sans',sans-serif}
  .nk-cal-icon{width:62px;height:62px;display:flex;align-items:center;justify-content:center;border:1px solid #e6e8ea;border-radius:14px;background:#fff;box-shadow:0 6px 16px rgba(0,0,0,.08);color:#ef5350;font-size:1.55rem}
  /* The date picker no longer shows decorative red progress bars below check-in. */
  .nk-cal-progress{display:none!important}
  .nk-cal-progress span{height:6px;border-radius:99px;background:#f0f1f1}
  .nk-cal-progress span:nth-child(1),.nk-cal-progress span:nth-child(2){background:#ef5350}
  .nk-cal-head{margin-bottom:15px!important;padding:0 0 12px;border-bottom:1px solid #f0f1f1}
  .nk-cal-month{font-size:1rem!important;font-weight:800!important;letter-spacing:-.02em}
  .nk-cal-nav{width:36px!important;height:36px!important;background:#f5f8f6!important;color:#0d4f3c!important}
  .nk-cal-week{gap:6px!important;margin-bottom:8px!important;color:#9b9fa3!important;font-size:.72rem!important}
  .nk-cal-grid{gap:6px 4px!important}
  .nk-cal-empty{height:42px}
  .nk-cal-day{height:42px!important;border-radius:12px!important;color:#17191b!important;font-size:.95rem!important;font-weight:700!important}
  .nk-cal-day.today{box-shadow:inset 0 0 0 2px #ef5350!important;color:#ef5350!important}
  .nk-cal-day.selected{background:#0d4f3c!important;color:#fff!important;box-shadow:0 5px 12px rgba(13,79,60,.2)!important}
  .nk-cal-day.in-range{background:#e8f2ee!important;color:#0d4f3c!important;border-radius:8px!important}
  .nk-cal-day.range-start,.nk-cal-day.range-end{background:#0d4f3c!important;color:#fff!important;box-shadow:0 5px 12px rgba(13,79,60,.2)!important}
  .nk-cal-day.occupied{background:#fde047!important;color:#000!important;font-weight:800!important;box-shadow:0 3px 8px rgba(202,138,4,.25)!important}
  .nk-cal-day.occupied:hover,.nk-cal-day.occupied:active{background:#eab308!important;color:#000!important;transform:scale(.96)}
  .nk-cal-day.disabled{opacity:.25!important;background:transparent!important;box-shadow:none!important}
  .nk-cal-day:not(.disabled):not(.occupied):hover{background:#e8f2ee!important;color:#0d4f3c!important}
  .nk-cal-note{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:16px!important;color:#7c8580!important;font-size:.68rem!important}
  .nk-cal-note:before{content:'';width:8px;height:8px;border-radius:50%;background:#eab308;flex:none}
  .nk-cal-note strong{color:#a16207!important}
  #bookingModal #booking-date.nk-date-booked-error{border-color:#eab308!important;box-shadow:0 0 0 3px rgba(234,179,8,.18)!important;animation:nkDateShake .28s ease both}
  @keyframes nkDateShake{25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
  @media(max-width:430px){
    #nk-calendar-pop{padding:19px 15px 15px!important}
    .nk-cal-summary-copy strong{font-size:2.35rem}
    .nk-cal-icon{width:56px;height:56px}
    .nk-cal-day{height:39px!important;font-size:.88rem!important}
    .nk-cal-empty{height:39px}
  }
  #nk-admin-calendar-backdrop{display:none;position:fixed;inset:0;z-index:3000;background:rgba(8,46,35,.16);backdrop-filter:blur(16px) saturate(120%);-webkit-backdrop-filter:blur(16px) saturate(120%)}
  #nk-admin-calendar-backdrop.open{display:block;animation:modalBg .22s ease both}
  #nk-admin-calendar-pop{display:none;position:fixed;top:50%;left:50%;box-sizing:border-box;width:min(calc(100vw - 24px),390px);max-height:calc(100dvh - 24px);overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;padding:22px 20px 18px;border:1px solid rgba(255,255,255,.88);border-radius:30px;background:rgba(255,255,255,.97);box-shadow:0 24px 70px rgba(8,46,35,.22),0 2px 0 rgba(255,255,255,.9) inset;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);z-index:3001}
  #nk-admin-calendar-pop.open{display:block;animation:nkCalendarPopIn .25s ease both}
  @keyframes nkCalendarPopIn{from{opacity:0;transform:translate(-50%,-46%)}to{opacity:1;transform:translate(-50%,-50%)}}
  #nk-admin-calendar-pop .nk-cal-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 2px 15px}
  #nk-admin-calendar-pop .nk-cal-summary-copy{display:grid;gap:1px}
  #nk-admin-calendar-pop .nk-cal-summary-copy strong{color:#111;font:800 2.65rem/.95 'Plus Jakarta Sans',sans-serif;letter-spacing:-.08em}
  #nk-admin-calendar-pop .nk-cal-summary-copy span{color:#9a9da2;font:500 1rem/1.2 'Plus Jakarta Sans',sans-serif}
  #nk-admin-calendar-pop .nk-cal-icon{width:62px;height:62px;display:flex;align-items:center;justify-content:center;border:1px solid #e6e8ea;border-radius:14px;background:#fff;box-shadow:0 6px 16px rgba(0,0,0,.08);color:#ef5350;font-size:1.55rem}
  #nk-admin-calendar-pop .nk-cal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px;padding:0 0 12px;border-bottom:1px solid #f0f1f1}
  #nk-admin-calendar-pop .nk-cal-month{margin:0;text-align:center;color:#111;font:800 1rem/1.2 'Plus Jakarta Sans',sans-serif}
  #nk-admin-calendar-pop .nk-cal-nav{width:36px;height:36px;border:0;border-radius:50%;background:#f5f8f6;color:#0d4f3c}
  #nk-admin-calendar-pop .nk-cal-week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:8px;color:#9b9fa3;font:700 .72rem/1.2 'Plus Jakarta Sans',sans-serif;text-align:center}
  #nk-admin-calendar-pop .nk-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px 4px}
  #nk-admin-calendar-pop .nk-cal-empty{height:42px}
  #nk-admin-calendar-pop .nk-cal-day{height:42px;border:0;border-radius:12px;background:transparent;color:#17191b;font:700 .95rem/1 'Plus Jakarta Sans',sans-serif}
  #nk-admin-calendar-pop .nk-cal-day.today{box-shadow:inset 0 0 0 2px #ef5350;color:#ef5350}
  #nk-admin-calendar-pop .nk-cal-day.selected{background:#0d4f3c;color:#fff;box-shadow:0 5px 12px rgba(13,79,60,.2)}
  #nk-admin-calendar-pop .nk-cal-day.disabled{opacity:.25;background:transparent;box-shadow:none;cursor:not-allowed}
  #nk-admin-calendar-pop .nk-cal-day:not(.disabled):not(.selected):hover{background:#e8f2ee;color:#0d4f3c}
  #nk-admin-calendar-pop .nk-cal-day:focus-visible,#nk-admin-calendar-pop .nk-cal-nav:focus-visible{outline:3px solid #e4b938;outline-offset:2px}
  #nk-admin-calendar-pop .nk-cal-note{display:block;margin:16px 0 0;color:#7c8580;font:500 .68rem/1.3 'Plus Jakarta Sans',sans-serif;text-align:center}
  @media(max-width:540px){
    #nk-admin-calendar-pop{top:12px;bottom:12px;width:min(calc(100vw - 16px),390px);height:auto;max-height:none;transform:translateX(-50%);padding:16px 14px 12px;border-radius:26px;animation:nkCalendarPopInMobile .25s ease both}
    @keyframes nkCalendarPopInMobile{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
    #nk-admin-calendar-pop .nk-cal-summary{padding-bottom:10px}
    #nk-admin-calendar-pop .nk-cal-summary-copy strong{font-size:2.2rem}
    #nk-admin-calendar-pop .nk-cal-icon{width:54px;height:54px;font-size:1.35rem}
    #nk-admin-calendar-pop .nk-cal-head{margin-bottom:10px;padding-bottom:9px}
    #nk-admin-calendar-pop .nk-cal-nav{width:34px;height:34px}
    #nk-admin-calendar-pop .nk-cal-week{gap:4px;margin-bottom:5px}
    #nk-admin-calendar-pop .nk-cal-grid{gap:3px 3px}
    #nk-admin-calendar-pop .nk-cal-empty,#nk-admin-calendar-pop .nk-cal-day{height:36px}
    #nk-admin-calendar-pop .nk-cal-day{border-radius:10px;font-size:.86rem}
    #nk-admin-calendar-pop .nk-cal-note{margin-top:10px}
  }
</style>

<style id="nauka-notifications-v3">
  #notif-panel.nk-notif-page {
    overflow-y: auto !important;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    touch-action: pan-y;
  }
  #notif-panel.nk-notif-page .nk-notification-section h4 { color: #111 !important; }
  #notif-panel.nk-notif-page .nk-notification-reference { color: #7b8780; font-size: .72rem; white-space: nowrap; }
  #notif-panel.nk-notif-page .nk-notification-empty { padding: 54px 24px; text-align: center; color: #111; font: 700 .9rem/1.45 'Plus Jakarta Sans', sans-serif; }
  #customer-bottom-nav[style*="display: none"] { pointer-events: none !important; }
</style>

<style id="nauka-solid-booking-nav-v1">
  /* Keep the booking action and customer navigation crisp and solid on mobile. */
  #view-detail > .sticky-bottom.nk-detail-booking-bar,
  #customer-bottom-nav {
    background: #fff !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-color: #e2e8e5 !important;
  }
  #bookingModal .modal-sheet {
    background: #fff !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
  }
  #customer-bottom-nav {
    border: 1px solid #e2e8e5 !important;
    box-shadow: 0 12px 30px rgba(13,79,60,.14), 0 2px 7px rgba(0,0,0,.05) !important;
    isolation: isolate;
  }
  #customer-bottom-nav .nav-item { position: relative; z-index: 1; }
  @media (max-width: 767px) {
    #customer-bottom-nav { background-color: #fff !important; }
  }
</style>

<style id="nauka-profile-security-v1">
  #booking-check-availability{font-weight:800!important;letter-spacing:.01em}
  #bookingModal .nk-day-cruise-locked{opacity:.58;transition:opacity .2s ease}
  #bookingModal .nk-booking-date-tab.nk-day-cruise-locked{cursor:not-allowed!important;background:#f5f8f6!important;border-color:#e1e8e3!important;color:#94a39b!important;opacity:.72;box-shadow:none!important}
  #bookingModal .nk-booking-date-tab.nk-day-cruise-locked strong,#bookingModal .nk-booking-date-tab.nk-day-cruise-locked small,#bookingModal .nk-booking-date-tab.nk-day-cruise-locked .nk-booking-date-label{color:#94a39b!important}
  #bookingModal .nk-day-cruise-locked button{cursor:not-allowed!important;background:#eef2ef!important;color:#94a39b!important;border-color:#e1e8e3!important}
  #bookingModal .nk-day-cruise-locked input{color:#6b7b72!important;background:#f5f8f6!important}

  #edit-profile-modal{background:linear-gradient(180deg,#f1f8f4 0%,#faf9f7 34%)!important}
  #edit-profile-modal>div:first-child{border-bottom:1px solid rgba(13,79,60,.1)!important;background:rgba(250,249,247,.88)!important}
  #edit-profile-modal .profile-edit-section{margin-bottom:24px}
  #edit-profile-modal .profile-edit-section>p{padding-left:4px;color:#0d4f3c;font-size:.68rem;letter-spacing:.14em}
  #edit-profile-modal .profile-edit-card{overflow:hidden;border:1px solid rgba(13,79,60,.1);border-radius:24px;background:rgba(255,255,255,.82);box-shadow:0 12px 30px rgba(13,79,60,.08),inset 0 1px 0 rgba(255,255,255,.9)}
  #edit-profile-modal .profile-edit-card>div{padding:16px 18px;background:transparent;transition:background .2s ease}
  #edit-profile-modal .profile-edit-card>div+div{border-top:1px solid #edf3ef}
  #edit-profile-modal .profile-edit-card>div:focus-within{background:#f3faf6}
  #edit-profile-modal .profile-edit-card label{color:#7a8981!important;font-size:.61rem!important;letter-spacing:.13em!important}
  #edit-profile-modal .profile-edit-card input,#edit-profile-modal .profile-edit-card textarea{color:#17372b!important;font-size:.95rem!important}
  #edit-profile-modal .profile-edit-card input:focus,#edit-profile-modal .profile-edit-card textarea:focus{outline:none!important}
  #edit-profile-modal .profile-edit-card .text-gray-300{color:#9aa9a1!important}

  .nk-security-intro{display:flex;align-items:center;gap:12px;padding:14px;border-radius:18px;background:linear-gradient(135deg,#e8f5ee,#fdf8ec);border:1px solid rgba(13,79,60,.1)}
  .nk-security-intro-icon{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:#0d4f3c;color:#fff;flex:none}
  .nk-security-field{display:grid;gap:7px;margin-top:14px}
  .nk-security-field label{color:#718078;font:800 .64rem/1 'Plus Jakarta Sans',sans-serif;letter-spacing:.1em;text-transform:uppercase}
  .nk-security-field input{width:100%;min-height:48px;padding:0 13px;border:1px solid #dce8e0;border-radius:14px;background:#f8fbf9;color:#163b2d;font:700 .82rem 'Plus Jakarta Sans',sans-serif;outline:none}
  .nk-security-field input:focus{border-color:#0d4f3c;box-shadow:0 0 0 3px rgba(13,79,60,.1);background:#fff}
  .nk-security-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:20px}
  .nk-security-actions button{min-height:46px;border:0;border-radius:15px;font:800 .74rem/1 'Plus Jakarta Sans',sans-serif;cursor:pointer}
  .nk-security-cancel{background:#eef3ef;color:#50635a}.nk-security-save{background:#0d4f3c;color:#fff}
  .nk-security-note{margin-top:12px;color:#849189;font:500 .68rem/1.45 'Plus Jakarta Sans',sans-serif}
</style>

<script>
/* ═══════════════════════════════════════════════════════════════════════
   FINAL COMPATIBILITY LAYER
   Keeps the existing Nauka UI and flows, while adding room-aware booking,
   guest pricing, reliable profile history, contact capture, and nav motion.
═══════════════════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  const money = value => typeof window.nkFormatPrice === 'function'
    ? window.nkFormatPrice(value)
    : '₹' + Number(value || 0).toLocaleString('en-IN');
  const escValue = value => typeof escapeHTML === 'function'
    ? escapeHTML(value)
    : String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
  const todayISO = () => {
    const d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  };
  const getProp = () => state && state.selectedProperty;
  const isRoomProperty = () => !!(getProp() && getProp().roomListing);
  const includedGuestsFor = prop => Math.max(1, Number(prop && prop.includedGuests) || (prop && prop.roomListing ? 2 : Math.max(2, (Number(prop && prop.bedrooms) || 1) * 2)));
  const totalRoomsFor = prop => Math.max(1, Number(prop && (prop.totalRooms || prop.maxRooms)) || (prop && prop.roomListing ? 6 : (Number(prop && prop.bedrooms) || 1)));
  const priceFor = prop => typeof window.nkPriceFor === 'function'
    ? Number(window.nkPriceFor(prop, window.nkBookingMode || window.nkCruiseMode || 'overnight'))
    : Number(prop && prop.price) || 0;

  /* Every boat now carries explicit capacity/pricing metadata. */
  if (typeof PROPERTIES !== 'undefined') {
    PROPERTIES.forEach(prop => {
      if (!prop.includedGuests) prop.includedGuests = includedGuestsFor(prop);
      if (!prop.extraGuestFee) prop.extraGuestFee = 1000;
      if (prop.roomListing && !prop.totalRooms) prop.totalRooms = 6;
    });
  }

  /* Day and overnight prices can be set per listing. When a listing does not
     have custom rates, the admin-wide percentages remain the fallback. */
  const baseCruisePriceFor = window.nkPriceFor;
  if (baseCruisePriceFor && !baseCruisePriceFor.__nkModeRateLayer) {
    const modePriceFor = function (prop, mode) {
      if (!prop) return 0;
      const key = mode === 'day' ? 'dayPrice' : 'overnightPrice';
      const custom = Number(prop[key]);
      if (Number.isFinite(custom) && custom > 0) return Math.round(custom);
      if (prop.category === 'houseboat') {
        const base = Number(prop.price) || 0;
        const cfg = (typeof AD_S !== 'undefined' && AD_S.cruisePricing) || {};
        const percent = Number(mode === 'day' ? cfg.dayPercent : cfg.overnightPercent) || (mode === 'day' ? 70 : 100);
        return Math.round(base * percent / 100);
      }
      return baseCruisePriceFor(prop, mode);
    };
    modePriceFor.__nkModeRateLayer = true;
    window.nkPriceFor = modePriceFor;
    const baseRefreshCruisePricing = window.nkRefreshCruisePricing;
    window.nkRefreshCruisePricing = function () {
      if (typeof baseRefreshCruisePricing === 'function') baseRefreshCruisePricing.apply(this, arguments);
      if (typeof renderProperties === 'function') renderProperties();
      if (state.selectedProperty && state.currentView === 'detail') {
        const detailPrice = document.getElementById('detail-price');
        const mode = window.nkCruiseMode || window.nkBookingMode || 'overnight';
        if (detailPrice) detailPrice.textContent = money(modePriceFor(state.selectedProperty, mode));
      }
      if (document.getElementById('bookingModal')?.classList.contains('open') && typeof window.updatePriceSummary === 'function') window.updatePriceSummary();
    };
  }

  /* Guest pricing and room capacity helpers. */
  function roomCount() {
    return Math.max(1, Math.min(totalRoomsFor(getProp()), Number(document.getElementById('booking-rooms')?.value) || 1));
  }
  function roomGuestCount() {
    const max = roomCount() * 2;
    return Math.max(1, Math.min(max, Number(document.getElementById('booking-room-guests')?.value) || Math.min(2, max)));
  }
  function syncRoomGuestFields() {
    const rooms = roomCount();
    const max = rooms * 2;
    const guestsInput = document.getElementById('booking-room-guests');
    const guests = Math.max(1, Math.min(max, Number(guestsInput?.value) || Math.min(2, max)));
    if (guestsInput) guestsInput.value = guests;
    const roomDisplay = document.getElementById('booking-rooms-display');
    if (roomDisplay) roomDisplay.textContent = rooms;
    const display = document.getElementById('booking-room-guests-display');
    if (display) display.textContent = guests;
    const maxDisplay = document.getElementById('booking-room-max-display');
    if (maxDisplay) maxDisplay.textContent = max;
    const capacity = document.getElementById('booking-room-capacity');
    if (capacity) capacity.textContent = 'Max ' + max + ' guest' + (max === 1 ? '' : 's');
    const guestMinus = document.getElementById('btn-room-guests-minus');
    const guestPlus = document.getElementById('btn-room-guests-plus');
    if (guestMinus) guestMinus.style.opacity = guests <= 1 ? '0.35' : '1';
    if (guestPlus) guestPlus.style.opacity = guests >= max ? '0.35' : '1';
    const roomMinus = document.getElementById('btn-rooms-minus');
    const roomPlus = document.getElementById('btn-rooms-plus');
    if (roomMinus) roomMinus.style.opacity = rooms <= 1 ? '0.35' : '1';
    if (roomPlus) roomPlus.style.opacity = rooms >= totalRoomsFor(getProp()) ? '0.35' : '1';
    const adults = document.getElementById('booking-adults');
    const children = document.getElementById('booking-children');
    if (adults) adults.value = guests;
    if (children) children.value = 0;
    updatePriceSummary();
  }
  window.changeRooms = function (delta) {
    const input = document.getElementById('booking-rooms');
    if (!input) return;
    input.value = Math.max(1, Math.min(totalRoomsFor(getProp()), (Number(input.value) || 1) + delta));
    syncRoomGuestFields();
  };
  window.changeRoomGuests = function (delta) {
    const input = document.getElementById('booking-room-guests');
    if (!input) return;
    input.value = Math.max(1, Math.min(roomCount() * 2, (Number(input.value) || 1) + delta));
    syncRoomGuestFields();
  };

  function installGuestSection() {
    const adults = document.getElementById('booking-adults');
    const section = adults?.closest('#booking-form > div');
    if (!section) return;
    if (!section.dataset.nkOriginalHtml) section.dataset.nkOriginalHtml = section.innerHTML;

    if (isRoomProperty()) {
      if (section.dataset.nkRoomMode === '1') {
        syncRoomGuestFields();
        return;
      }
      section.dataset.nkRoomMode = '1';
      section.innerHTML = `
        <label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-2">
          <i class="fa-solid fa-users mr-1.5 text-emerald"></i>Rooms &amp; Guests
        </label>
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-soft">
          <div class="flex items-center justify-between px-4 py-3 border-b border-gray-50">
            <div><p class="font-body font-semibold text-ink text-sm">Rooms</p><p class="text-gray-400 text-xs font-body">Private room in sharing boat</p></div>
            <div class="flex items-center gap-3">
              <button type="button" id="btn-rooms-minus" onclick="changeRooms(-1)" class="w-9 h-9 rounded-full border-2 border-gray-200 flex items-center justify-center text-gray-500 font-bold text-lg hover:border-emerald hover:text-emerald transition">−</button>
              <span id="booking-rooms-display" class="font-body font-bold text-ink text-base w-5 text-center">1</span>
              <input type="hidden" id="booking-rooms" value="1" />
              <button type="button" id="btn-rooms-plus" onclick="changeRooms(1)" class="w-9 h-9 rounded-full border-2 border-gray-200 flex items-center justify-center text-gray-500 font-bold text-lg hover:border-emerald hover:text-emerald transition">+</button>
            </div>
          </div>
          <div class="flex items-center justify-between px-4 py-3 border-b border-gray-50">
            <div><p class="font-body font-semibold text-ink text-sm">Guests <span class="text-gray-400 font-normal">(5+ yrs)</span></p><p class="text-gray-400 text-xs font-body"><span id="booking-room-max-display">2</span> max for selected rooms</p></div>
            <div class="flex items-center gap-3">
              <button type="button" id="btn-room-guests-minus" onclick="changeRoomGuests(-1)" class="w-9 h-9 rounded-full border-2 border-gray-200 flex items-center justify-center text-gray-500 font-bold text-lg hover:border-emerald hover:text-emerald transition">−</button>
              <span id="booking-room-guests-display" class="font-body font-bold text-ink text-base w-5 text-center">2</span>
              <input type="hidden" id="booking-room-guests" value="2" />
              <button type="button" id="btn-room-guests-plus" onclick="changeRoomGuests(1)" class="w-9 h-9 rounded-full border-2 border-gray-200 flex items-center justify-center text-gray-500 font-bold text-lg hover:border-emerald hover:text-emerald transition">+</button>
            </div>
          </div>
          <div class="flex items-center justify-between px-4 py-3 bg-emerald-mist/45">
            <span id="booking-room-capacity" class="font-body font-semibold text-emerald text-xs">Max 2 guests</span>
            <span class="font-body text-xs text-gray-500">Kids below 5 stay free</span>
          </div>
          <input type="hidden" id="booking-adults" value="2" />
          <input type="hidden" id="booking-children" value="0" />
        </div>`;
      syncRoomGuestFields();
      return;
    }

    if (section.dataset.nkRoomMode === '1') {
      section.innerHTML = section.dataset.nkOriginalHtml;
      delete section.dataset.nkRoomMode;
    }
    const label = section.querySelector('label');
    if (label) label.innerHTML = '<i class="fa-solid fa-users mr-1.5 text-emerald"></i>Guests <span class="text-gray-400 font-normal">(5+ yrs)</span>';
    const childAge = [...section.querySelectorAll('p')].find(p => p.textContent.includes('Age 2–12'));
    if (childAge) childAge.textContent = 'Age 5–12';
    const included = includedGuestsFor(getProp());
    let note = section.querySelector('#nk-full-guest-note');
    if (!note) {
      note = document.createElement('p');
      note.id = 'nk-full-guest-note';
      note.className = 'text-xs font-body text-gray-500 mt-2 px-1';
      section.appendChild(note);
    }
    note.innerHTML = `<span class="font-semibold text-emerald">${included} guests included</span> · ${money(1000)}/extra guest · Kids below 5 stay free`;
    const maxAdults = document.getElementById('booking-adults');
    if (maxAdults) maxAdults.max = '50';
  }

  window.updatePriceSummary = function () {
    const prop = getProp();
    if (!prop) return;
    const mode = window.nkBookingMode || window.nkCruiseMode || 'overnight';
    const dayCruise = mode === 'day';
    const checkIn = document.getElementById('booking-date')?.value || '';
    const checkOut = document.getElementById('booking-checkout')?.value || '';
    const nights = dayCruise ? 1 : Math.max(1, Math.round((new Date(checkOut + 'T00:00:00') - new Date(checkIn + 'T00:00:00')) / 86400000) || 1);
    const datesReady = !!checkIn && (dayCruise || !!checkOut);
    const base = priceFor(prop);
    let subtotal = datesReady ? base * nights : 0;
    let breakdown = !checkIn ? 'Select dates to see the estimate' : dayCruise ? `${money(base)} · Day Cruise` : !checkOut ? 'Choose a check-out date' : `${money(base)} × ${nights} night${nights > 1 ? 's' : ''}`;
    if (prop.roomListing) {
      const rooms = roomCount();
      const guests = roomGuestCount();
      subtotal = datesReady ? base * rooms * nights : 0;
      breakdown = !checkIn ? 'Select dates to see the estimate' : dayCruise ? `${rooms} room${rooms > 1 ? 's' : ''} × ${money(base)} · ${guests} guest${guests > 1 ? 's' : ''} · Day Cruise` : !checkOut ? 'Choose a check-out date' : `${rooms} room${rooms > 1 ? 's' : ''} × ${money(base)} · ${guests} guest${guests > 1 ? 's' : ''} · ${nights} night${nights > 1 ? 's' : ''}`;
    } else {
      const adults = Number(document.getElementById('booking-adults')?.value) || 1;
      const children = Number(document.getElementById('booking-children')?.value) || 0;
      const included = includedGuestsFor(prop);
      const extra = Math.max(0, adults + children - included);
      if (extra && datesReady) {
        breakdown = dayCruise ? `${money(base)} + ${money(1000)} × ${extra} extra guest${extra > 1 ? 's' : ''} · Day Cruise` : `${money(base)} + ${money(1000)} × ${extra} extra guest${extra > 1 ? 's' : ''} · ${nights} night${nights > 1 ? 's' : ''}`;
        subtotal = (base + extra * 1000) * nights;
      }
    }
    const breakdownEl = document.getElementById('modal-price-breakdown');
    const subtotalEl = document.getElementById('modal-subtotal');
    const totalEl = document.getElementById('modal-total');
    if (breakdownEl) breakdownEl.textContent = breakdown;
    if (subtotalEl) subtotalEl.textContent = money(subtotal);
    if (totalEl) totalEl.textContent = money(subtotal);
  };

  /* Re-render cards with capacity information without replacing their design. */
  const originalRenderCards = window.renderPropertyCards;
  if (originalRenderCards && !originalRenderCards.__nkCapacityLayer) {
    const renderCards = function (props, target) {
      originalRenderCards.call(this, props, target);
      const scope = (target && typeof target !== 'string') ? target : document.getElementById(target || 'property-list');
      (props || []).forEach(prop => {
        const card = scope ? scope.querySelector(`[data-id="${prop.id}"]`) : null;
        if (!card || card.querySelector('.nk-guest-pricing')) return;
        const anchor = card.querySelector('.nk-room-pricing') || card.querySelector('.nk-card-chips') || card.querySelector('.amenity-pill')?.parentElement;
        const node = document.createElement('p');
        node.className = 'nk-guest-pricing text-[11px] font-body text-gray-500 mb-3';
        node.innerHTML = prop.roomListing
          ? `<i class="fa-solid fa-bed text-emerald mr-1"></i>Up to 2 guests per room · Kids below 5 stay free`
          : `<i class="fa-solid fa-users text-emerald mr-1"></i>${includedGuestsFor(prop)} guests included · ${money(1000)}/extra guest`;
        if (anchor) anchor.insertAdjacentElement('afterend', node); else card.querySelector('.px-4')?.appendChild(node);
      });
    };
    renderCards.__nkCapacityLayer = true;
    window.renderPropertyCards = renderCards;
    if (typeof renderProperties === 'function') renderProperties();
  }

  /* Booking modal: reset and adapt only the guest area for room listings. */
  const originalOpenBooking = window.openBookingModal;
  if (originalOpenBooking && !originalOpenBooking.__nkRoomLayer) {
    const openBooking = function () {
      originalOpenBooking.apply(this, arguments);
      if (!document.getElementById('bookingModal')?.classList.contains('open')) return;
      installGuestSection();
      if (isRoomProperty()) {
        const rooms = document.getElementById('booking-rooms');
        const guests = document.getElementById('booking-room-guests');
        if (rooms) rooms.value = 1;
        if (guests) guests.value = 2;
        const display = document.getElementById('booking-rooms-display');
        if (display) display.textContent = '1';
        syncRoomGuestFields();
      } else {
        const adults = document.getElementById('booking-adults');
        const children = document.getElementById('booking-children');
        if (adults) adults.addEventListener('input', window.updatePriceSummary);
        if (children) children.addEventListener('input', window.updatePriceSummary);
        window.updatePriceSummary();
      }
      const modalSheet = document.querySelector('#bookingModal .modal-sheet');
      const dateSection = document.getElementById('booking-date')?.closest('#booking-form > div');
      const guestSection = document.getElementById('booking-adults')?.closest('#booking-form > div');
      if (isRoomProperty() && modalSheet && dateSection && guestSection && dateSection !== guestSection) {
        guestSection.parentElement.insertBefore(dateSection, guestSection);
      }
      if (modalSheet) {
        modalSheet.scrollTop = 0;
        requestAnimationFrame(() => { modalSheet.scrollTop = 0; });
      }
    };
    openBooking.__nkRoomLayer = true;
    window.openBookingModal = openBooking;
  }
  const originalChangeAdults = window.changeAdults;
  if (originalChangeAdults && !originalChangeAdults.__nkRoomLayer) {
    const changeAdults = function () { originalChangeAdults.apply(this, arguments); window.updatePriceSummary(); };
    changeAdults.__nkRoomLayer = true;
    window.changeAdults = changeAdults;
  }
  const originalChangeChildren = window.changeChildren;
  if (originalChangeChildren && !originalChangeChildren.__nkRoomLayer) {
    const changeChildren = function () { originalChangeChildren.apply(this, arguments); window.updatePriceSummary(); };
    changeChildren.__nkRoomLayer = true;
    window.changeChildren = changeChildren;
  }

  /* Availability request stays in the app and records a pending request, with correct room and extra-guest totals. */
  window.submitAvailabilityRequest = function () {
    if (typeof window.__naukaLiveBookingHandler === 'function') return window.__naukaLiveBookingHandler();
    const prop = getProp();
    const dateInput = document.getElementById('booking-date');
    const date = dateInput?.value || '';
    const nights = Math.max(1, Number(document.getElementById('booking-nights')?.value) || 1);
    const room = !!(prop && prop.roomListing);
    const rooms = room ? roomCount() : 0;
    const adults = room ? roomGuestCount() : Math.max(1, Number(document.getElementById('booking-adults')?.value) || 1);
    const children = room ? 0 : Math.max(0, Number(document.getElementById('booking-children')?.value) || 0);
    const routeEl = document.getElementById('booking-route');
    const route = prop?.category === 'tour'
      ? 'Tour Package'
      : (routeEl?.value || state.selectedRoute || 'Alleppey Backwater Circuit');
    if (!date) { showBookingError('Please select a check-in date to continue.'); dateInput?.classList.add('shake'); setTimeout(() => dateInput?.classList.remove('shake'), 500); return; }
    if (date < todayISO()) { showBookingError('Check-in date cannot be in the past.'); return; }
    if (!prop) { showBookingError('Please select a houseboat first.'); return; }
    const included = includedGuestsFor(prop);
    const extraGuests = room ? 0 : Math.max(0, adults + children - included);
    const unitPrice = priceFor(prop);
    const estimate = room ? unitPrice * rooms * nights : (unitPrice + extraGuests * 1000) * nights;
    const guests = adults + children;
    const guestStr = [adults + ' Guest' + (adults > 1 ? 's' : ''), children > 0 ? children + ' Child' + (children > 1 ? 'ren' : '') : ''].filter(Boolean).join(', ');
    const checkOut = typeof addDaysISO === 'function' ? addDaysISO(date, nights) : date;
    const ref = 'NK-' + Math.floor(1000 + Math.random() * 9000);
    const iso = new Date().toISOString();
    const booking = {
      id: 'nk_' + Date.now(), reference: ref, bookingId: ref, status: 'pending',
      propertyName: prop.title, propertyCategory: prop.category, location: prop.location, host: prop.host, image: prop.image,
      guests, adults, children, guestStr, rooms, includedGuests: included, extraGuests, extraGuestFee: 1000, nights,
      checkIn: date, rawDate: date, checkOut, route, boarding: typeof BOARDING_POINT !== 'undefined' ? BOARDING_POINT : 'Finishing Point, Punnamada, Alleppey',
      price: '', estimate, cruiseType: window.nkBookingMode || window.nkCruiseMode || 'day', quoteStatus: 'awaiting', createdAt: iso, updatedAt: iso,
    };
    state.userBookings.unshift(booking);
    const user = state.loggedInUser || {};
    booking.guestName = state.profileDisplayName || user.username || 'Guest';
    booking.guestEmail = user.email || '';
    booking.guestKey = String(user.email || user.username || '').toLowerCase();
    booking.guestPhone = state.profilePhone ? '+91' + String(state.profilePhone).replace(/\D/g, '').slice(-10) : '';
    persistState();
    if (typeof syncBk === 'function') syncBk();
    window.nkUnread = (window.nkUnread || 0) + 1;
    window.renderNaukaBookingNotifications?.();
    closeBookingModal();
    state.bookingFilter = 'pending';
    showView('mybookings');
  };

  /* Reference content for the two cruise modes. The toggle changes both the
     route timeline and the supporting information cards. */
  const referenceSharedBoxes = [
    { title: 'How Sharing Houseboats Works', items: [
      "Our Sharing Houseboat service offers an affordable way to experience the backwaters by booking a private room on a shared premium houseboat.",
      "To ensure the best experience for everyone, we allocate our boats daily based on total bookings (e.g., 14 booked rooms means you'll sail on a spacious 14-bedroom boat).",
      "We guarantee that every houseboat in our fleet is flawlessly maintained and matches the exact premium quality, amenities, and aesthetics shown in our pictures, even if the specific boat size varies.",
      "This flexible system allows us to keep our prices accessible without ever compromising on the experience you expect.",
      "To protect the privacy and comfort of all guests — couples and families in particular — male-only groups are not permitted on sharing houseboats. A maximum of 1 solo male traveller is welcome."
    ]},
    { title: 'Inclusions & Amenities', items: [
      'Private room accommodation in a shared houseboat with a dedicated captain and chef.',
      'Comprehensive fixed menu including welcome drink, lunch, evening tea with snacks, dinner, and breakfast.',
      'Complimentary drinking water and an extended backwater cruise experience.'
    ]},
    { title: 'Air Conditioning (Category Specific)', items: [
      'Deluxe Houseboats: Air conditioning is available exclusively in the bedrooms and operates from 9:00 PM to 6:00 AM.',
      'Premium Houseboats: Air conditioning is available in bedrooms on-demand from check-in to check-out.',
      'Luxury Houseboats: Features a fully glass-enclosed living area with centralized air conditioning throughout the cruise.'
    ]},
    { title: 'Occupancy & Additional Guests', items: [
      'Base rates are calculated on single or double occupancy per bedroom.',
      'Children up to 5 years of age stay free of charge.',
      'Additional guests can be accommodated for an extra charge.'
    ]},
    { title: 'Dining Policy', items: [
      'Meals are prepared fresh on board using a fixed, authentic menu.',
      'Both vegetarian and non-vegetarian options can be arranged. Please communicate any special dietary requests prior to your arrival.',
      'Special arrangements like honeymoon cakes and floral decorations can be provided at an additional cost.'
    ]},
    { title: 'Seasonal Pricing Terms', items: [
      'Tariff rates are subject to increase during major festivals including Onam, Diwali, Pongal, Vishu, and Bakrid.',
      'Peak season rates apply from December 20th to January 10th and will be notably higher.'
    ]}
  ];
  const referenceCruiseModes = {
    overnight: {
      kicker: 'IN 12:00 PM · OUT 09:00 AM (21 HRS)',
      route: [
        ['DAY 1 · 12:00 PM', 'Depart from Alleppey', 'Board at the jetty, welcome drink served'],
        ['AFTERNOON', 'Punnamada Lake & Vembanad Lake', "Kerala's largest lake — open water, wide skies"],
        ['MID-AFTERNOON', 'R Block & C Block', 'Man-made paddy fields from the lake, cultivation below sea level — a rare sight'],
        ['LATE AFTERNOON', 'Rani · Chithira · Marthandam', 'Villages, islands and narrow canals winding through coconut groves'],
        ['EVENING', 'Kainakari → Kuppapuram', 'Boat docks for the night near the village. Dinner onboard under the stars.'],
        ['DAY 2 · MORNING', 'Kuppapuram → Meenapally Kayal', 'Breakfast onboard, early morning canal life'],
        ['RETURN', 'Pallathuruthy → Alleppey', 'Back at the jetty by 9:00 AM']
      ],
      boxes: referenceSharedBoxes
    },
    day: {
      kicker: 'IN 11:00 AM · OUT 05:00 PM (6 HRS)',
      route: [
        ['11:00 AM', 'Depart from Alleppey', 'Board at the jetty, welcome drink served'],
        ['AFTERNOON', 'Punnamada Lake & Vembanad Lake', "Kerala's largest lake — open water, wide skies"],
        ['MID-AFTERNOON', 'R Block & C Block', 'Man-made paddy fields from the lake, cultivation below sea level — a rare sight'],
        ['LATE AFTERNOON', 'Rani · Chithira · Marthandam', 'Villages, islands and narrow canals winding through coconut groves'],
        ['EVENING · RETURN', 'Kainakari → Alleppey', 'Back at the jetty by 5:00 PM']
      ],
      boxes: [
        { title: 'Authentic Kerala Meal Plan', intro: 'All meals are freshly prepared on board by your dedicated chef.', items: [
          'Welcome drink · fresh lime or tender coconut',
          'Kerala lunch · rice, fish or seasonal vegetarian thali',
          'Evening tea & snacks · pakoda or banana fritters'
        ]},
        ...referenceSharedBoxes.map(box => ({ ...box, items: box.items.slice() }))
      ]
    }
  };
  function renderReferenceCruiseContent(mode) {
    const data = referenceCruiseModes[mode === 'day' ? 'day' : 'overnight'];
    const copy = document.getElementById('nk-mode-copy');
    if (copy) {
      copy.innerHTML = `<p class="nk-reference-kicker">${escValue(data.kicker)}</p><p class="nk-mode-title">Cruise Route &amp; Schedule</p><div class="nk-timeline">${data.route.map(item => `<div class="nk-timeline-row"><span class="nk-timeline-dot"></span><div><b>${escValue(item[0])}</b><strong class="nk-route-stop">${escValue(item[1])}</strong><span>${escValue(item[2])}</span></div></div>`).join('')}</div>`;
    }
    const supplement = document.querySelector('#view-detail .nk-detail-supplement');
    if (supplement) {
      supplement.innerHTML = data.boxes.map(box => `<section class="nk-detail-mini"><h4>${escValue(box.title)}</h4>${box.intro ? `<p>${escValue(box.intro)}</p>` : ''}<ul class="nk-detail-list">${box.items.map(item => `<li>${escValue(item)}</li>`).join('')}</ul></section>`).join('');
    }
  }
  const originalSetCruiseModeReference = window.setCruiseMode;
  if (originalSetCruiseModeReference && !originalSetCruiseModeReference.__nkReferenceContent) {
    const setCruiseModeReference = function (mode) {
      const result = originalSetCruiseModeReference.apply(this, arguments);
      renderReferenceCruiseContent(mode);
      return result;
    };
    setCruiseModeReference.__nkReferenceContent = true;
    window.setCruiseMode = setCruiseModeReference;
  }
  renderReferenceCruiseContent(window.nkCruiseMode === 'day' ? 'day' : 'overnight');

  /* Classic contact capture sheet after customer sign-in. */
  function ensureContactSheet() {
    if (document.getElementById('nk-customer-contact-backdrop')) return;
    document.body.insertAdjacentHTML('beforeend', `
      <div id="nk-customer-contact-backdrop" role="dialog" aria-modal="true" aria-labelledby="nk-customer-contact-title">
        <div id="nk-customer-contact-sheet" class="glass-panel">
          <div class="flex items-start justify-between gap-3 mb-5">
            <div><p class="text-emerald text-[10px] font-body font-bold uppercase tracking-[.16em]">One last detail</p><h3 id="nk-customer-contact-title" class="font-display text-2xl font-light text-ink mt-1">Complete your <em>profile</em></h3><p class="text-gray-500 text-xs font-body mt-1 leading-relaxed">We use this to share booking requests with the right houseboat team.</p></div>
            <button type="button" onclick="skipCustomerContact()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button>
          </div>
          <label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Full name</label>
          <input id="nk-customer-name" class="input-field mb-3" type="text" placeholder="Your name" autocomplete="name" />
          <label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Phone number</label>
          <input id="nk-customer-phone" class="input-field" type="tel" name="customer-mobile" placeholder="Enter your mobile number" autocomplete="off" inputmode="tel" autocapitalize="off" autocorrect="off" spellcheck="false" data-form-type="other" data-lpignore="true" value="" />
          <p id="nk-customer-contact-error" class="hidden text-red-600 text-xs font-body mt-2"></p>
          <button type="button" onclick="saveCustomerContact()" class="btn-emerald w-full rounded-2xl py-3.5 text-white font-bold text-sm font-body mt-5">Save details &amp; continue</button>
          <button type="button" onclick="skipCustomerContact()" class="w-full text-gray-500 text-xs font-semibold font-body py-3">I’ll add this later</button>
        </div>
      </div>`);
  }
  function showCustomerContact() {
    ensureContactSheet();
    const name = document.getElementById('nk-customer-name');
    const phone = document.getElementById('nk-customer-phone');
    state.profilePhone = '';
    persistState();
    if (name) name.value = state.profileDisplayName || (state.loggedInUser?.username || '');
    if (phone) phone.value = '';
    document.getElementById('nk-customer-contact-error')?.classList.add('hidden');
    document.getElementById('nk-customer-contact-backdrop')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  window.saveCustomerContact = function () {
    const name = (document.getElementById('nk-customer-name')?.value || '').trim();
    const phone = (document.getElementById('nk-customer-phone')?.value || '').replace(/\D/g, '').slice(-10);
    const error = document.getElementById('nk-customer-contact-error');
    if (name.length < 2) { if (error) { error.textContent = 'Please enter your name.'; error.classList.remove('hidden'); } return; }
    if (phone.length !== 10) { if (error) { error.textContent = 'Please enter a valid 10-digit phone number.'; error.classList.remove('hidden'); } return; }
    state.profileDisplayName = name;
    state.profilePhone = phone;
    persistState();
    document.getElementById('nk-customer-contact-backdrop')?.classList.remove('open');
    document.body.style.overflow = '';
    if (state.currentView === 'profile') renderProfileView(state.loggedInUser.username, state.loggedInUser.email);
  };
  window.skipCustomerContact = function () {
    document.getElementById('nk-customer-contact-backdrop')?.classList.remove('open');
    document.body.style.overflow = '';
  };
  /* Firebase phone verification is an optional second factor for the existing Supabase account. */
  let nkFirebaseAuth = null;
  let nkFirebaseConfirmation = null;
  let nkFirebaseRecaptcha = null;
  let nkCustomerContactMode = 'phone';
  const firebaseConfigKeys = ['apiKey', 'authDomain', 'projectId', 'appId'];

  function firebaseConfigReady() {
    const config = window.NAUKA_FIREBASE_CONFIG;
    return !!config && typeof config === 'object' && firebaseConfigKeys.every(key => String(config[key] || '').trim());
  }
  function ensureFirebaseAuth() {
    if (nkFirebaseAuth) return nkFirebaseAuth;
    if (!firebaseConfigReady() || !window.firebase?.auth || !window.firebase?.initializeApp) return null;
    try {
      let app;
      try { app = window.firebase.app('nauka-phone-auth'); }
      catch (_) { app = window.firebase.initializeApp(window.NAUKA_FIREBASE_CONFIG, 'nauka-phone-auth'); }
      nkFirebaseAuth = window.firebase.auth(app);
      return nkFirebaseAuth;
    } catch (error) {
      console.warn('Nauka Firebase phone auth could not initialise.', error);
      return null;
    }
  }
  function clearFirebaseChallenge() {
    try { nkFirebaseRecaptcha?.clear(); } catch (_) {}
    nkFirebaseRecaptcha = null;
    nkFirebaseConfirmation = null;
  }
  function setContactStep(mode) {
    nkCustomerContactMode = mode === 'otp' ? 'otp' : 'phone';
    document.getElementById('nk-customer-phone-step')?.classList.toggle('hidden', nkCustomerContactMode !== 'phone');
    document.getElementById('nk-customer-otp-step')?.classList.toggle('hidden', nkCustomerContactMode !== 'otp');
    document.getElementById('nk-customer-email-fallback')?.classList.add('hidden');
    if (nkCustomerContactMode === 'phone') {
      const otp = document.getElementById('nk-customer-otp');
      if (otp) otp.value = '';
      document.getElementById('nk-firebase-recaptcha')?.replaceChildren();
    }
  }
  function setContactError(message, fallback = false) {
    const error = document.getElementById('nk-customer-contact-error');
    if (error) {
      error.textContent = message || '';
      error.classList.toggle('hidden', !message);
    }
    document.getElementById('nk-customer-email-fallback')?.classList.toggle('hidden', !fallback);
  }
  function setContactStatus(message) {
    const status = document.getElementById('nk-customer-contact-status');
    if (status) status.textContent = message || '';
  }
  function firebaseSmsMessage(error) {
    const code = String(error?.code || '');
    if (code === 'auth/quota-exceeded' || code === 'auth/too-many-requests') {
      return 'Sorry, SMS verification is temporarily unavailable because the SMS limit has been reached. Please verify by email instead.';
    }
    if (code === 'auth/operation-not-allowed' || code === 'auth/unauthorized-domain' || code === 'firebase-not-configured') {
      return 'SMS verification is not enabled for this app yet. Please verify by email instead.';
    }
    if (code === 'auth/invalid-phone-number' || code === 'auth/missing-phone-number') {
      return 'Please enter a valid mobile number.';
    }
    if (code === 'auth/invalid-verification-code') return 'That code is not valid. Check the message and try again.';
    if (code === 'auth/code-expired') return 'That code has expired. Please request a new SMS code.';
    if (code === 'auth/captcha-check-failed') return 'The security check could not be completed. Please try again or verify by email.';
    return 'We could not send the SMS code right now. Please verify by email instead.';
  }
  function ensureContactSheet() {
    if (document.getElementById('nk-customer-contact-backdrop')) return;
    document.body.insertAdjacentHTML('beforeend',
      '<div id="nk-customer-contact-backdrop" role="dialog" aria-modal="true" aria-labelledby="nk-customer-contact-title">' +
        '<div id="nk-customer-contact-sheet" class="glass-panel">' +
          '<div class="flex items-start justify-between gap-3 mb-5">' +
            '<div><p class="text-emerald text-[10px] font-body font-bold uppercase tracking-[.16em]">One last detail</p><h3 id="nk-customer-contact-title" class="font-display text-2xl font-light text-ink mt-1">Complete your <em>profile</em></h3><p class="text-gray-500 text-xs font-body mt-1 leading-relaxed">We use this to share booking requests with the right houseboat team.</p></div>' +
            '<button type="button" onclick="skipCustomerContact()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center"><i class="fa-solid fa-xmark text-gray-500 text-sm"></i></button>' +
          '</div>' +
          '<label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Full name</label>' +
          '<input id="nk-customer-name" class="input-field mb-3" type="text" placeholder="Your name" autocomplete="name" />' +
          '<div id="nk-customer-phone-step">' +
            '<label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Phone number</label>' +
            '<input id="nk-customer-phone" class="input-field" type="tel" name="customer-mobile" placeholder="Enter your mobile number" autocomplete="off" inputmode="tel" autocapitalize="off" autocorrect="off" spellcheck="false" data-form-type="other" data-lpignore="true" value="" />' +
            '<p class="text-gray-400 text-[11px] font-body mt-2 leading-relaxed">We will send one verification code by SMS. Your email account remains your Nauka login.</p>' +
            '<button id="nk-customer-otp-send" type="button" onclick="sendCustomerPhoneOtp()" class="btn-emerald w-full rounded-2xl py-3.5 text-white font-bold text-sm font-body mt-5">Send SMS code</button>' +
          '</div>' +
          '<div id="nk-customer-otp-step" class="hidden">' +
            '<p id="nk-customer-contact-status" class="text-emerald text-xs font-semibold font-body mb-3"></p>' +
            '<label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Verification code</label>' +
            '<input id="nk-customer-otp" class="input-field tracking-[.35em] text-center" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />' +
            '<div id="nk-firebase-recaptcha" class="flex justify-center mt-3"></div>' +
            '<button id="nk-customer-otp-verify" type="button" onclick="verifyCustomerPhoneOtp()" class="btn-emerald w-full rounded-2xl py-3.5 text-white font-bold text-sm font-body mt-5">Verify &amp; continue</button>' +
            '<button type="button" onclick="useDifferentCustomerPhone()" class="w-full text-emerald text-xs font-semibold font-body py-3">Use a different number</button>' +
          '</div>' +
          '<p id="nk-customer-contact-error" class="hidden text-red-600 text-xs font-body mt-3 leading-relaxed"></p>' +
          '<button id="nk-customer-email-fallback" type="button" onclick="continueWithEmailVerification()" class="hidden w-full rounded-2xl border border-emerald/20 bg-emerald-mist text-emerald font-bold text-sm font-body py-3.5 mt-4">Continue with email instead</button>' +
          '<button type="button" onclick="skipCustomerContact()" class="w-full text-gray-500 text-xs font-semibold font-body py-3">I’ll add this later</button>' +
        '</div>' +
      '</div>');
  }
  function showCustomerContact() {
    ensureContactSheet();
    const name = document.getElementById('nk-customer-name');
    const phone = document.getElementById('nk-customer-phone');
    clearFirebaseChallenge();
    setContactStep('phone');
    setContactError('');
    setContactStatus('');
    state.profilePhone = '';
    persistState();
    if (name) name.value = state.profileDisplayName || (state.loggedInUser?.username || '');
    if (phone) phone.value = '';
    document.getElementById('nk-customer-contact-backdrop')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  window.sendCustomerPhoneOtp = async function () {
    const name = (document.getElementById('nk-customer-name')?.value || '').trim();
    const phone = (document.getElementById('nk-customer-phone')?.value || '').replace(/\D/g, '').slice(-10);
    if (name.length < 2) return setContactError('Please enter your name.');
    if (phone.length !== 10) return setContactError('Please enter a valid 10-digit phone number.');
    const auth = ensureFirebaseAuth();
    if (!auth) {
      setContactError(firebaseSmsMessage({ code: 'firebase-not-configured' }), true);
      return;
    }
    const button = document.getElementById('nk-customer-otp-send');
    if (button) { button.disabled = true; button.textContent = 'Sending code…'; }
    setContactError('');
    setContactStatus('');
    try {
      clearFirebaseChallenge();
      setContactStep('otp');
      const recaptchaHost = document.getElementById('nk-firebase-recaptcha');
      if (!recaptchaHost) throw new Error('captcha-container-missing');
      nkFirebaseRecaptcha = new window.firebase.auth.RecaptchaVerifier(recaptchaHost, {
        size: 'normal',
        callback: () => setContactStatus('Security check complete. Enter the code sent to your phone.'),
        'expired-callback': () => setContactError('The security check expired. Please request a new code.', true)
      });
      await nkFirebaseRecaptcha.render();
      nkFirebaseConfirmation = await auth.signInWithPhoneNumber('+91' + phone, nkFirebaseRecaptcha);
      setContactStatus('Code sent to +91 ' + phone.slice(0, 5) + ' ' + phone.slice(5) + '.');
    } catch (error) {
      console.warn('Nauka SMS verification failed.', error);
      clearFirebaseChallenge();
      setContactStep('phone');
      setContactError(firebaseSmsMessage(error), true);
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Send SMS code'; }
    }
  };
  window.verifyCustomerPhoneOtp = async function () {
    const name = (document.getElementById('nk-customer-name')?.value || '').trim();
    const phone = (document.getElementById('nk-customer-phone')?.value || '').replace(/\D/g, '').slice(-10);
    const code = (document.getElementById('nk-customer-otp')?.value || '').replace(/\D/g, '').slice(0, 6);
    if (name.length < 2) return setContactError('Please enter your name.');
    if (!nkFirebaseConfirmation) return setContactError('Please request a new SMS code.', true);
    if (code.length !== 6) return setContactError('Enter the 6-digit verification code.');
    const button = document.getElementById('nk-customer-otp-verify');
    if (button) { button.disabled = true; button.textContent = 'Verifying…'; }
    setContactError('');
    try {
      const result = await nkFirebaseConfirmation.confirm(code);
      const verifiedPhone = String(result?.user?.phoneNumber || ('+91' + phone));
      state.profileDisplayName = name;
      state.profilePhone = verifiedPhone.replace(/^\+91/, '').replace(/\D/g, '').slice(-10);
      await window.persistState?.();
      try { await nkFirebaseAuth?.signOut(); } catch (_) {}
      clearFirebaseChallenge();
      document.getElementById('nk-customer-contact-backdrop')?.classList.remove('open');
      document.body.style.overflow = '';
      if (state.currentView === 'profile') renderProfileView(state.loggedInUser.username, state.loggedInUser.email);
      if (typeof window.toast === 'function') window.toast('Phone verified successfully.');
    } catch (error) {
      console.warn('Nauka SMS code verification failed.', error);
      setContactError(firebaseSmsMessage(error), String(error?.code || '').includes('too-many') || String(error?.code || '').includes('quota'));
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Verify & continue'; }
    }
  };
  window.useDifferentCustomerPhone = function () {
    clearFirebaseChallenge();
    setContactStep('phone');
    setContactError('');
    setContactStatus('');
  };
  window.continueWithEmailVerification = function () {
    const name = (document.getElementById('nk-customer-name')?.value || '').trim();
    if (name.length >= 2) {
      state.profileDisplayName = name;
      state.profilePhone = '';
      void window.persistState?.();
    }
    clearFirebaseChallenge();
    document.getElementById('nk-customer-contact-backdrop')?.classList.remove('open');
    document.body.style.overflow = '';
    if (typeof window.toast === 'function') window.toast('SMS verification is unavailable. You can continue with your email account and try phone verification later.');
  };
  window.saveCustomerContact = window.sendCustomerPhoneOtp;
  window.skipCustomerContact = function () {
    clearFirebaseChallenge();
    document.getElementById('nk-customer-contact-backdrop')?.classList.remove('open');
    document.body.style.overflow = '';
  };
  const originalCustomerLogin = window.loginAsCustomer;
  if (originalCustomerLogin && !originalCustomerLogin.__nkContactLayer) {
    const login = function () {
      originalCustomerLogin.apply(this, arguments);
      if (state.loggedInUser && (!state.profileDisplayName || !state.profilePhone)) setTimeout(showCustomerContact, 120);
    };
    login.__nkContactLayer = true;
    window.loginAsCustomer = login;
  }

  /* Profile sub-pages get their own history entry, so Back closes the open
     panel and stays on Profile instead of returning to My Bookings. */
  let profileOverlayHistory = null;
  const profileOverlayModal = kind => 'profile-' + kind;
  function pushProfileOverlay(kind) {
    if (state.currentView !== 'profile') return;
    const modal = profileOverlayModal(kind);
    if (history.state?.modal === modal) { profileOverlayHistory = modal; return; }
    profileOverlayHistory = modal;
    history.pushState({ view: 'profile', modal }, '', '#profile/' + kind);
  }
  function clearProfileOverlaySurfaces() {
    document.getElementById('nk-profile-feature-backdrop')?.classList.remove('open');
    document.getElementById('notif-panel')?.classList.remove('open');
    document.getElementById('notif-backdrop')?.classList.remove('open');
    document.getElementById('nk-notification-reader')?.classList.remove('open');
    document.getElementById('nk-concierge-backdrop')?.classList.remove('open');
    document.getElementById('nk-mail-backdrop')?.classList.remove('open');
    if (state) state.notifOpen = false;
    document.body.style.overflow = '';
  }
  function installProfileOverlayCloseHooks() {
    const rawFeatureClose = window.closeProfileFeatureModal;
    if (rawFeatureClose && !rawFeatureClose.__nkProfileHistoryClose) {
      const closeFeature = function () {
        const modal = profileOverlayHistory;
        const rewind = !!modal && modal !== 'profile-notifications' && history.state?.modal === modal;
        if (rewind) profileOverlayHistory = null;
        rawFeatureClose.apply(this, arguments);
        if (rewind) history.back();
      };
      closeFeature.__nkProfileHistoryClose = true;
      window.closeProfileFeatureModal = closeFeature;
    }
    const rawConciergeClose = window.closeConcierge;
    if (rawConciergeClose && !rawConciergeClose.__nkProfileHistoryClose) {
      const closeConcierge = function () {
        const rewind = profileOverlayHistory === 'profile-help' && history.state?.modal === 'profile-help';
        if (rewind) profileOverlayHistory = null;
        rawConciergeClose.apply(this, arguments);
        if (rewind) history.back();
      };
      closeConcierge.__nkProfileHistoryClose = true;
      window.closeConcierge = closeConcierge;
    }
    const rawNotifClose = window.closeNotifPanel;
    if (rawNotifClose && !rawNotifClose.__nkProfileHistoryClose) {
      const closeNotifications = function () {
        const rewind = profileOverlayHistory === 'profile-notifications' && history.state?.modal === 'profile-notifications';
        if (rewind) profileOverlayHistory = null;
        rawNotifClose.apply(this, arguments);
        if (rewind) history.back();
      };
      closeNotifications.__nkProfileHistoryClose = true;
      window.closeNotifPanel = closeNotifications;
    }
  }
  installProfileOverlayCloseHooks();
  if (!document.documentElement.dataset.nkProfileHistoryWired) {
    document.documentElement.dataset.nkProfileHistoryWired = '1';
    document.addEventListener('click', function (event) {
      const row = event.target.closest?.('#profile-dynamic-content .cursor-pointer');
      if (!row || state.currentView !== 'profile') return;
      const text = row.textContent || '';
      const kind = text.includes('Notifications') ? 'notifications'
        : text.includes('Privacy & Security') ? 'privacy-security'
        : text.includes('Loyalty Rewards') ? 'loyalty'
        : text.includes('Language & Region') ? 'language-region'
        : text.includes('Help Centre') ? 'help'
        : '';
      if (text.includes('Personal Info')) {
        setTimeout(function () {
          const edit = document.getElementById('edit-profile-modal');
          if (edit?.style.display === 'block' && !profileEditHistory && state.currentView === 'profile') {
            profileEditHistory = true;
            history.pushState({ view: 'profile', modal: 'edit-profile' }, '', '#profile/edit');
          }
        }, 0);
        return;
      }
      if (kind) {
        pushProfileOverlay(kind);
        setTimeout(installProfileOverlayCloseHooks, 0);
      }
    }, true);
  }
  window.addEventListener('popstate', function (event) {
    if (!profileOverlayHistory || event.state?.modal === profileOverlayHistory) return;
    profileOverlayHistory = null;
    clearProfileOverlaySurfaces();
  });

  /* Fix Profile → Personal Info history. Browser Back now closes the sheet and stays on Profile. */
  let profileEditHistory = false;
  let closingProfileEditFromPop = false;
  const rawOpenProfile = window.openEditProfileSheet;
  const rawCloseProfile = window.closeEditProfileSheet;
  if (rawOpenProfile && rawCloseProfile && !rawOpenProfile.__nkHistoryLayer) {
    const openProfile = function () {
      rawOpenProfile.apply(this, arguments);
      if (document.getElementById('edit-profile-modal')?.style.display === 'block' && !profileEditHistory && state.currentView === 'profile') {
        profileEditHistory = true;
        history.pushState({ view: 'profile', modal: 'edit-profile' }, '', '#profile/edit');
      }
    };
    openProfile.__nkHistoryLayer = true;
    window.openEditProfileSheet = openProfile;
    window.closeEditProfileSheet = function () {
      if (profileEditHistory && !closingProfileEditFromPop) { history.back(); return; }
      profileEditHistory = false;
      rawCloseProfile.apply(this, arguments);
    };
    window.addEventListener('popstate', function (event) {
      if (!profileEditHistory || event.state?.modal === 'edit-profile') return;
      profileEditHistory = false;
      closingProfileEditFromPop = true;
      rawCloseProfile();
      closingProfileEditFromPop = false;
    });
  }
  const baseShowView = window.showView;
  if (baseShowView && !baseShowView.__nkFinalHistoryLayer) {
    const show = function (view, push) {
      if (profileOverlayHistory && (view !== 'profile' || history.state?.modal === profileOverlayHistory)) {
        const modal = profileOverlayHistory;
        profileOverlayHistory = null;
        if (history.state?.modal === modal) history.replaceState({ view: 'profile' }, '', '#profile');
      }
      if (profileEditHistory && view !== 'profile') {
        profileEditHistory = false;
        rawCloseProfile?.();
      }
      if (push !== false && state.currentView === view) push = false;
      return baseShowView.call(this, view, push);
    };
    show.__nkFinalHistoryLayer = true;
    window.showView = show;
  }
  window.nkBackToPreviousSection = function () {
    if (history.state?.view === 'detail') history.back();
    else window.showView(state.detailReturn || 'boats', false);
  };
  const detailBack = document.querySelector('#view-detail > .relative > button:first-of-type');
  if (detailBack) detailBack.setAttribute('onclick', 'nkBackToPreviousSection()');

  /* Hide bottom navigation while scrolling down; reveal it on upward movement. */
  const navStyle = document.createElement('style');
  navStyle.id = 'nk-scroll-nav-style';
  navStyle.textContent = '#customer-bottom-nav,#agent-bottom-nav,#op-nav{transition:transform .28s ease,opacity .22s ease} .nk-nav-hidden{transform:translate(-50%,calc(100% + 28px)) !important;opacity:0 !important;pointer-events:none !important} #nk-customer-contact-backdrop{display:none;position:fixed;inset:0;z-index:2600;align-items:flex-end;justify-content:center;padding:16px;background:rgba(8,46,35,.42);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)} #nk-customer-contact-backdrop.open{display:flex;animation:modalBg .25s ease both} #nk-customer-contact-sheet{width:min(100%,440px);padding:24px;border-radius:28px;background:rgba(250,249,247,.98);box-shadow:0 20px 60px rgba(8,46,35,.25);animation:sheetUp .35s cubic-bezier(.34,1.2,.64,1) both}';
  document.head.appendChild(navStyle);
  let previousScroll = window.scrollY;
  let scrollTimer = 0;
  window.addEventListener('scroll', function () {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function () {
      const delta = window.scrollY - previousScroll;
      const blocked = document.querySelector('#bookingModal.open,#listingModal.open,#xsheet.open,#edit-profile-modal[style*="display: block"],#nk-customer-contact-backdrop.open');
      document.querySelectorAll('#customer-bottom-nav,#agent-bottom-nav,#op-nav').forEach(nav => {
        if (blocked || window.scrollY < 48 || delta < -4) nav.classList.remove('nk-nav-hidden');
        else if (delta > 4) nav.classList.add('nk-nav-hidden');
      });
      previousScroll = window.scrollY;
    }, 20);
  }, { passive: true });

  /* Listing editor fields: included guests and optional per-room inventory. */
  const listingPriceInput = document.getElementById('listing-price');
  if (listingPriceInput && !document.getElementById('nk-listing-mode-rates')) {
    listingPriceInput.parentElement.insertAdjacentHTML('afterend', `
      <div id="nk-listing-mode-rates" class="rounded-2xl p-4 mt-1" style="background:#f8f5eb;border:1px solid rgba(201,168,76,.2)">
        <p class="font-body font-semibold text-ink text-sm mb-1">Cruise mode pricing</p>
        <p class="text-[11px] text-gray-500 font-body mb-3">Set separate customer-facing rates for day and overnight cruises. Leave blank to use the global admin rates.</p>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Day cruise (₹)</label><input id="listing-day-price" type="number" min="100" class="input-field" placeholder="Global rate" /></div>
          <div><label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Overnight (₹)</label><input id="listing-overnight-price" type="number" min="100" class="input-field" placeholder="Global rate" /></div>
        </div>
      </div>`);
  }
  const listingAmenities = document.getElementById('listing-amenities');
  if (listingAmenities && !document.getElementById('nk-listing-capacity-fields')) {
    listingAmenities.parentElement.insertAdjacentHTML('afterend', `
      <div id="nk-listing-capacity-fields" class="rounded-2xl p-4 mt-1" style="background:#e8f2ee;border:1px solid rgba(13,79,60,.12)">
        <p class="font-body font-semibold text-ink text-sm mb-1">Guest pricing &amp; room setup</p>
        <p class="text-[11px] text-gray-500 font-body mb-3">The nightly price includes this many guests. Additional guests cost ₹1,000 each.</p>
        <label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Guests included in nightly rate</label>
        <input id="listing-included-guests" type="number" min="1" max="50" value="2" class="input-field mb-3" />
        <label class="flex items-center gap-2 text-xs font-semibold font-body text-ink mb-3"><input id="listing-room-stay" type="checkbox" class="accent-emerald" /> List as per-room stay inside a multi-room boat</label>
        <div id="nk-listing-total-rooms-wrap" class="hidden"><label class="block text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1.5">Total rooms available</label><input id="listing-total-rooms" type="number" min="1" max="50" value="6" class="input-field" /></div>
      </div>`);
    document.getElementById('listing-room-stay')?.addEventListener('change', function () {
      document.getElementById('nk-listing-total-rooms-wrap')?.classList.toggle('hidden', !this.checked);
    });
  }
  function setListingCapacity(listing) {
    const included = document.getElementById('listing-included-guests');
    const room = document.getElementById('listing-room-stay');
    const totalRooms = document.getElementById('listing-total-rooms');
    const dayPrice = document.getElementById('listing-day-price');
    const overnightPrice = document.getElementById('listing-overnight-price');
    if (included) included.value = listing?.includedGuests || 2;
    if (room) {
      room.checked = !!listing?.roomListing;
      document.getElementById('nk-listing-total-rooms-wrap')?.classList.toggle('hidden', !room.checked);
    }
    if (totalRooms) totalRooms.value = listing?.totalRooms || 6;
    if (dayPrice) dayPrice.value = listing?.dayPrice || '';
    if (overnightPrice) overnightPrice.value = listing?.overnightPrice || '';
  }
  const rawAddListing = window.openAddListing;
  if (rawAddListing && !rawAddListing.__nkCapacityLayer) {
    const add = function () { rawAddListing.apply(this, arguments); setListingCapacity({ includedGuests: 2, totalRooms: 6, roomListing: false }); };
    add.__nkCapacityLayer = true;
    window.openAddListing = add;
  }
  const rawEditListing = window.openEditListing;
  if (rawEditListing && !rawEditListing.__nkCapacityLayer) {
    const edit = function (id) { rawEditListing.apply(this, arguments); setListingCapacity(window.agentListings?.[id] || (typeof agentListings !== 'undefined' ? agentListings[id] : null)); };
    edit.__nkCapacityLayer = true;
    window.openEditListing = edit;
  }
  const rawSaveListing = window.saveListing;
  if (rawSaveListing && !rawSaveListing.__nkCapacityLayer) {
    const saveListing = function () {
      const editing = typeof _editingListingId !== 'undefined' ? _editingListingId : null;
      const dayPriceValue = Number(document.getElementById('listing-day-price')?.value) || 0;
      const overnightPriceValue = Number(document.getElementById('listing-overnight-price')?.value) || 0;
      if (dayPriceValue && dayPriceValue < 100) { showListingError('Day cruise price must be at least ₹100, or leave it blank.'); return; }
      if (overnightPriceValue && overnightPriceValue < 100) { showListingError('Overnight price must be at least ₹100, or leave it blank.'); return; }
      const meta = {
        includedGuests: Math.max(1, Number(document.getElementById('listing-included-guests')?.value) || 2),
        roomListing: !!document.getElementById('listing-room-stay')?.checked,
        totalRooms: Math.max(1, Number(document.getElementById('listing-total-rooms')?.value) || 6),
        dayPrice: dayPriceValue || null,
        overnightPrice: overnightPriceValue || null,
      };
      rawSaveListing.apply(this, arguments);
      const id = editing !== null ? editing : (typeof _nextListingId !== 'undefined' ? _nextListingId - 1 : null);
      const listing = id !== null && typeof agentListings !== 'undefined' ? agentListings[id] : null;
      if (listing && !document.getElementById('listingModal')?.classList.contains('open')) Object.assign(listing, meta, { extraGuestFee: 1000 });
    };
    saveListing.__nkCapacityLayer = true;
    window.saveListing = saveListing;
  }

  /* Simple operator list: Confirm, Decline, and Call the customer. */
  if (typeof AGENT_BOOKINGS !== 'undefined') {
    const phones = ['+919447724293', '+919876543210', '+919812345678', '+919900112233', '+919811223344'];
    AGENT_BOOKINGS.forEach((booking, index) => { if (!booking.phone) booking.phone = phones[index % phones.length]; });
  }
  window.callNaukaCustomer = function (phone) { if (phone) window.location.href = 'tel:' + String(phone).replace(/[^\d+]/g, ''); };
  const rawAgentRender = window.renderAgentBookings;
  if (rawAgentRender && !rawAgentRender.__nkCustomerCallLayer) {
    const renderAgentBookings = function () {
      const container = document.getElementById('bookings-list');
      if (!container || typeof AGENT_BOOKINGS === 'undefined') return rawAgentRender.apply(this, arguments);
      container.innerHTML = AGENT_BOOKINGS.map(b => `
        <div class="booking-row px-5 py-4 border-b border-gray-50 last:border-b-0" data-booking-id="${escValue(b.id)}">
          <div class="flex items-start justify-between mb-2"><div><p class="font-body font-semibold text-ink text-sm">${escValue(b.guest)}</p><p class="text-gray-400 text-xs font-body">${escValue(b.property)}</p></div><span class="badge-${escValue(b.status)} text-[11px] font-semibold font-body px-2.5 py-1 rounded-full capitalize">${escValue(b.status)}</span></div>
          <div class="flex items-center justify-between gap-2"><div class="flex gap-2 flex-wrap"><span class="text-gray-500 text-xs font-body">${escValue(b.date)}</span><span class="text-gray-400 text-xs font-body">·</span><span class="text-gray-500 text-xs font-body">${b.guests} guests</span><span class="text-gray-400 text-xs font-body">·</span><span class="text-emerald font-semibold text-xs font-body">${escValue(b.total)}</span></div>
          ${b.status === 'pending' ? `<div class="flex gap-1.5 flex-wrap justify-end"><button onclick="handleBookingById('${escValue(b.id)}','confirm')" class="bg-emerald-mist text-emerald text-[11px] font-semibold font-body px-2.5 py-1.5 rounded-xl hover:bg-emerald hover:text-white transition">Confirm</button><button onclick="handleBookingById('${escValue(b.id)}','decline')" class="bg-red-50 text-red-500 text-[11px] font-semibold font-body px-2.5 py-1.5 rounded-xl hover:bg-red-500 hover:text-white transition">Decline</button><button onclick="callNaukaCustomer('${escValue(b.phone || '')}')" class="bg-gray-100 text-ink text-[11px] font-semibold font-body px-2.5 py-1.5 rounded-xl hover:bg-gray-200 transition"><i class="fa-solid fa-phone mr-1"></i>Call the customer</button></div>` : ''}</div>
        </div>`).join('');
    };
    renderAgentBookings.__nkCustomerCallLayer = true;
    window.renderAgentBookings = renderAgentBookings;
    renderAgentBookings();
  }
  const rawHandleBookingById = window.handleBookingById;
  if (rawHandleBookingById && !rawHandleBookingById.__nkConfirmLayer) {
    const handle = function (id, action) { return rawHandleBookingById.call(this, id, action === 'confirm' ? 'accept' : action); };
    handle.__nkConfirmLayer = true;
    window.handleBookingById = handle;
  }
  document.querySelectorAll('#agent-tab-overview button[onclick*="handleBooking(this,\'accept\')"]').forEach(btn => { btn.textContent = 'Confirm'; });
  document.querySelectorAll('#agent-tab-overview button[onclick*="handleBooking(this,\'decline\')"]').forEach(btn => { btn.textContent = 'Decline'; });

  /* Operator portal detail sheet: remove quote controls and expose Confirm / Decline / Call. */
  if (window.OP?.open && !window.OP.open.__nkFinalBookingActions) {
    const originalOpen = window.OP.open;
    const openOperatorBooking = function (id) {
      originalOpen.call(window.OP, id);
      setTimeout(function () {
        const sheet = document.querySelector('#xsheet.open .sh');
        if (!sheet) return;
        const booking = typeof allBk === 'function' ? allBk().find(item => item.id === id) : null;
        const quote = sheet.querySelector('#x-quote');
        if (quote) {
          quote.style.display = 'none';
          quote.previousElementSibling?.style && (quote.previousElementSibling.style.display = 'none');
        }
        const send = [...sheet.querySelectorAll('button')].find(button => (button.getAttribute('onclick') || '').includes(`OP.quote('${id}',false)`));
        const confirmNow = [...sheet.querySelectorAll('button')].find(button => (button.getAttribute('onclick') || '').includes(`OP.quote('${id}',true)`));
        if (send) { send.textContent = 'Confirm'; send.setAttribute('onclick', `OP.setStatus('${id}','confirmed')`); }
        if (confirmNow) confirmNow.remove();
        const decline = [...sheet.querySelectorAll('button')].find(button => (button.getAttribute('onclick') || '').includes(`OP.decline('${id}')`));
        if (decline) decline.textContent = 'Decline';
        if (booking && !sheet.querySelector('[data-nk-call-customer]')) {
          const phone = booking.guestPhone || '';
          const call = document.createElement(phone ? 'a' : 'button');
          call.dataset.nkCallCustomer = '1';
          call.className = 'xbtn xbtn-out w-full mt-2 text-center';
          if (phone) call.href = 'tel:' + phone.replace(/[^\d+]/g, '');
          else { call.type = 'button'; call.disabled = true; call.style.opacity = '.55'; }
          call.innerHTML = '<i class="fa-solid fa-phone mr-1"></i>' + (phone ? 'Call the customer' : 'Phone not provided');
          (decline || send || sheet.lastElementChild)?.insertAdjacentElement('afterend', call);
        }
      }, 0);
    };
    openOperatorBooking.__nkFinalBookingActions = true;
    window.OP.open = openOperatorBooking;
  }
});
</script>
<style id="nk-booking-card-redesign-v1">
  /* Compact, fully rounded booking action card; booking behavior is unchanged. */
