      <ellipse cx="47" cy="35" rx="2" ry="2.2" fill="#1a1a18"/>
      <!-- Earring -->
      <circle cx="52" cy="41" r="2" fill="#f9d97a" stroke="#e8b800" stroke-width="0.5"/>
      <!-- Smile -->
      <path d="M36 44 Q41 48 46 44" stroke="#1a1a18" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Blouse -->
      <path d="M20 80 Q25 62 40 61 Q55 62 60 80Z" fill="#fce9b0"/>
    </svg>`
  },
  {
    bg: '#f0ebff', ring: '#ddd0ff', label: 'Lilac',
    svg: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" width="80" height="80">
      <!-- Woman with bun -->
      <circle cx="40" cy="40" r="40" fill="#f0ebff"/>
      <!-- Bun -->
      <circle cx="40" cy="16" r="8" fill="#1a1a18"/>
      <!-- Bun stick -->
      <line x1="35" y1="16" x2="45" y2="22" stroke="#8b6914" stroke-width="1.5"/>
      <!-- Hair sides -->
      <ellipse cx="40" cy="26" rx="14" ry="10" fill="#1a1a18"/>
      <rect x="25" y="26" width="6" height="18" rx="3" fill="#1a1a18"/>
      <rect x="49" y="26" width="6" height="18" rx="3" fill="#1a1a18"/>
