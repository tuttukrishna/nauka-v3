      <ellipse cx="40" cy="39" rx="14" ry="16" fill="#e8b88a"/>
      <!-- Beard -->
      <path d="M26 44 Q28 58 40 60 Q52 58 54 44 Q48 50 40 51 Q32 50 26 44Z" fill="#1a1a18"/>
      <!-- Eyes -->
      <ellipse cx="34" cy="36" rx="2.2" ry="2.5" fill="#1a1a18"/>
