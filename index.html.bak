</nav>

<!-- ═══════════════════════════════════════
     AGENT BOTTOM NAV (separate)
═══════════════════════════════════════ -->
<nav id="agent-bottom-nav" class="agent-nav bg-emerald-dark/95 backdrop-blur-xl border-t border-white/10 px-2 py-2 pb-4 shadow-float hidden">
  <div class="flex justify-around items-center">
    <button onclick="switchAgentTab('overview')" class="flex flex-col items-center gap-1 px-4 py-1 text-white/50" id="anav-overview">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span class="text-xs font-body font-medium">Overview</span>
    </button>
    <button onclick="switchAgentTab('bookings')" class="flex flex-col items-center gap-1 px-4 py-1 text-white/50" id="anav-bookings">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span class="text-xs font-body font-medium">Bookings</span>
    </button>
    <button onclick="switchAgentTab('listings')" class="flex flex-col items-center gap-1 px-4 py-1 text-white/50" id="anav-listings">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="text-xs font-body font-medium">Listings</span>
    </button>
    <button onclick="switchAgentTab('earnings')" class="flex flex-col items-center gap-1 px-4 py-1 text-white/50" id="anav-earnings">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span class="text-xs font-body font-medium">Earnings</span>
    </button>
    <button onclick="exitAgentDashboard()" class="flex flex-col items-center gap-1 px-4 py-1 text-white/50">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span class="text-xs font-body font-medium">Exit</span>
    </button>
  </div>
</nav>


<!-- ═══════════════════════════════════════
     EDIT PROFILE FULL-SCREEN MODAL
═══════════════════════════════════════ -->
<div id="edit-profile-modal" style="display:none;position:fixed;inset:0;z-index:980;background:#faf9f7;overflow-y:auto;">

  <!-- Header bar -->
  <div class="flex items-center justify-between px-5 pt-5 pb-4 border-b border-gray-100 sticky top-0 z-10" style="background:rgba(250,249,247,0.97);backdrop-filter:blur(20px);">
    <button onclick="closeEditProfileSheet()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center hover:bg-gray-200 transition">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 class="font-display text-xl font-light text-ink">Edit <em>Profile</em></h3>
    <button onclick="saveEditProfile()" class="btn-emerald text-white text-sm font-semibold font-body px-4 py-2 rounded-xl">Save</button>
  </div>

  <div class="px-5 pt-5 pb-24" style="max-width:480px;margin:0 auto;">

    <!-- AVATAR PICKER -->
    <div class="mb-6">
      <p class="text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-3">Profile Picture</p>
      <div class="bg-white rounded-3xl border border-gray-100 shadow-soft p-4">
        <div class="flex items-center gap-4 mb-4">
          <div id="ep-avatar-preview" class="rounded-full border-4 border-white shadow-card overflow-hidden flex-shrink-0" style="width:72px;height:72px;"></div>
          <div class="flex-1">
            <p class="font-body font-semibold text-ink text-sm mb-0.5">Choose your avatar</p>
            <p class="text-gray-400 text-xs font-body">12 unique illustrated characters</p>
            <button onclick="epShuffleAvatar()" class="mt-2 flex items-center gap-1.5 text-emerald text-xs font-semibold font-body hover:underline">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              Shuffle Random
            </button>
          </div>
        </div>
        <!-- Avatar swatch grid -->
        <div class="grid grid-cols-6 gap-2" id="ep-avatar-swatches"></div>
      </div>
    </div>

    <!-- BANNER PICKER -->
    <div class="mb-6">
      <p class="text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-3">Profile Banner</p>
      <div class="bg-white rounded-3xl border border-gray-100 shadow-soft p-4">
        <div id="ep-banner-preview" class="w-full rounded-2xl overflow-hidden mb-4 relative" style="height:64px;"></div>
        <div class="grid grid-cols-6 gap-2" id="ep-banner-swatches"></div>
      </div>
    </div>

    <!-- PERSONAL INFO -->
    <div class="mb-6 profile-edit-section">
      <p class="text-xs font-semibold font-body text-gray-500 uppercase tracking-wider mb-1">Personal Information</p>
      <p class="text-xs text-gray-400 font-body mb-3">Keep your traveller details current for smoother booking and host communication.</p>
      <div class="profile-edit-card">

        <div class="px-4 py-3.5">
          <label class="block text-[10px] font-semibold font-body text-gray-400 uppercase tracking-wider mb-1.5">Display Name</label>
          <input id="ep-name" type="text" placeholder="Your name" class="w-full outline-none font-body text-ink placeholder-gray-300" style="border:none;padding:0;font-size:0.95rem;font-weight:600;background:transparent;" />
        </div>

        <div class="px-4 py-3.5">
          <label class="block text-[10px] font-semibold font-body text-gray-400 uppercase tracking-wider mb-1.5">Email Address</label>
          <p id="ep-email-display" class="font-body text-gray-500 text-sm"></p>
          <p class="text-[10px] text-gray-300 font-body mt-0.5">Email cannot be changed here</p>
        </div>

        <div class="px-4 py-3.5">
          <label class="block text-[10px] font-semibold font-body text-gray-400 uppercase tracking-wider mb-1.5">Phone Number</label>
          <div class="flex items-center gap-2">
            <span class="text-gray-400 text-sm font-body flex-shrink-0">+91</span>
            <input id="ep-phone" type="tel" placeholder="Enter your mobile number" autocomplete="off" inputmode="tel" autocapitalize="off" autocorrect="off" spellcheck="false" class="flex-1 outline-none font-body text-ink placeholder-gray-300" style="border:none;padding:0;font-size:0.9rem;background:transparent;" />
          </div>
        </div>

        <div class="px-4 py-3.5">
          <label class="block text-[10px] font-semibold font-body text-gray-400 uppercase tracking-wider mb-1.5">City / Location</label>
          <input id="ep-location" type="text" placeholder="e.g. Mumbai, India" class="w-full outline-none font-body text-ink placeholder-gray-300" style="border:none;padding:0;font-size:0.9rem;background:transparent;" />
        </div>

        <div class="px-4 py-3.5">
          <label class="block text-[10px] font-semibold font-body text-gray-400 uppercase tracking-wider mb-1.5">Short Bio</label>
          <textarea id="ep-bio" rows="2" placeholder="Tell hosts a little about yourself…"
            class="w-full font-body text-sm text-ink placeholder-gray-300 outline-none resize-none"
            style="border:none;padding:0;background:transparent;"></textarea>
        </div>

      </div>
    </div>

    <!-- SAVE BUTTON (bottom) -->
    <button onclick="saveEditProfile()" class="btn-gold w-full rounded-2xl py-4 text-white font-bold text-sm font-body shadow-gold flex items-center justify-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Save Changes
    </button>

  </div>
</div>

<!-- ═══════════════════════════════════════
     JAVASCRIPT — APPLICATION LOGIC
═══════════════════════════════════════ -->
<script>
'use strict';

/* ─────────────────────────────────────────
   DATA STORE
───────────────────────────────────────── */
const PROPERTIES = (function() {
  try {
    const raw = localStorage.getItem('nk_cached_listings');
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length > 0) return parsed;
    }
  } catch (_) {}
  return [];
})();
/* ─────────────────────────────────────────
   PROFILE VISUAL IDENTITY CONSTANTS
───────────────────────────────────────── */
// ── PROFILE BANNERS — pure CSS pastel gradients, each visually unique ──
const PROFILE_BANNERS = [
  { id:'rose',     css:'linear-gradient(135deg,#fde8e8 0%,#fbc8d4 40%,#f9a8c2 100%)',                             dot1:'#f9c5d1', dot2:'#fbd5df', label:'Rose Mist'       },
  { id:'sky',      css:'linear-gradient(135deg,#dff0fd 0%,#bde3fb 45%,#a5d8f7 100%)',                             dot1:'#c8e8fc', dot2:'#dff3ff', label:'Sky Drift'       },
  { id:'mint',     css:'linear-gradient(135deg,#e0f5ee 0%,#b8e9d8 40%,#9edece 100%)',                             dot1:'#bfedd9', dot2:'#d6f5ec', label:'Mint Breeze'     },
  { id:'gold',     css:'linear-gradient(135deg,#fdf6e3 0%,#fce9b0 40%,#f9d97a 100%)',                             dot1:'#fce8b2', dot2:'#fdf3d0', label:'Golden Hour'     },
  { id:'lilac',    css:'linear-gradient(135deg,#f0ebff 0%,#ddd0ff 45%,#cebdff 100%)',                             dot1:'#ddd5ff', dot2:'#eeeaff', label:'Lilac Haze'      },
  { id:'peach',    css:'linear-gradient(135deg,#fff0e8 0%,#ffd8c2 40%,#ffc8a8 100%)',                             dot1:'#ffd5bc', dot2:'#ffe8d8', label:'Peach Dusk'      },
  { id:'sage',     css:'linear-gradient(135deg,#eaf3e8 0%,#cce4c8 45%,#b8d9b2 100%)',                             dot1:'#cde3c9', dot2:'#e0f0dd', label:'Sage Garden'     },
  { id:'blush',    css:'linear-gradient(135deg,#fff0f5 0%,#ffd6e7 40%,#ffc1d9 100%)',                             dot1:'#ffd6e6', dot2:'#ffeaf3', label:'Blush Bloom'     },
  { id:'dusk',     css:'linear-gradient(135deg,#e8eeff 0%,#c8d5ff 40%,#b5c4ff 100%)',                             dot1:'#c8d5ff', dot2:'#dde5ff', label:'Dusk Indigo'     },
  { id:'cream',    css:'linear-gradient(135deg,#fdf8f0 0%,#f7e9d0 40%,#f2ddb8 100%)',                             dot1:'#f5e8cc', dot2:'#faf3e6', label:'Warm Cream'      },
  { id:'coral',    css:'linear-gradient(135deg,#fff3ee 0%,#ffd5c8 40%,#ffbfac 100%)',                             dot1:'#ffd4c5', dot2:'#ffe8e0', label:'Coral Tide'      },
  { id:'powder',   css:'linear-gradient(135deg,#eef8ff 0%,#d0ebff 40%,#b8dfff 100%)',                             dot1:'#d0eaff', dot2:'#e6f4ff', label:'Powder Blue'     },
];

// ── PROFILE AVATARS — 12 distinct inline SVG vector portrait characters ──
// Each: { bg (pastel circle fill), svg (inline vector portrait), label }
const PROFILE_AVATARS = [
  {
    bg: '#fde8e8', ring: '#f9c5d1', label: 'Rose',
    svg: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" width="80" height="80">
      <!-- Short hair woman facing right -->
      <circle cx="40" cy="40" r="40" fill="#fde8e8"/>
      <!-- Hair -->
      <ellipse cx="40" cy="26" rx="16" ry="17" fill="#1a1a18"/>
      <rect x="24" y="26" width="7" height="20" rx="3" fill="#1a1a18"/>
      <!-- Neck -->
      <rect x="35" y="51" width="10" height="10" rx="2" fill="#f5c5a3"/>
      <!-- Face -->
      <ellipse cx="40" cy="40" rx="14" ry="16" fill="#f5c5a3"/>
      <!-- Eyes -->
      <ellipse cx="34" cy="37" rx="2" ry="2.5" fill="#1a1a18"/>
      <ellipse cx="46" cy="37" rx="2" ry="2.5" fill="#1a1a18"/>
      <!-- Smile -->
      <path d="M35 44 Q40 48 45 44" stroke="#1a1a18" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Shoulder top -->
      <path d="M20 80 Q22 62 40 61 Q58 62 60 80Z" fill="#2a2a28"/>
    </svg>`
  },
  {
    bg: '#dff0fd', ring: '#bde3fb', label: 'Sky',
    svg: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" width="80" height="80">
      <!-- Bearded man -->
      <circle cx="40" cy="40" r="40" fill="#dff0fd"/>
