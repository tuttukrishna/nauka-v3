<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0d4f3c" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Nauka — Luxury Backwater Escapes</title>

<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400;1,600&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
<!-- Retired launch quote animation kept inert so it cannot run during auth or app boot. -->
<script id="nauka-retired-launch-splash" type="text/plain">(function(){
  // The legacy quote image is intentionally retired. Keep this dormant compatibility
  // hook lightweight in case an older cached caller still references nkPlaySplash.
  var IMG="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==", IMG_FALLBACK=IMG, TOTAL=0, MAXWAIT=0;
  var root=document.documentElement;
  var splash=document.createElement('div');
  splash.id='nk-splash'; splash.setAttribute('role','img'); splash.setAttribute('aria-label','Nauka');
  splash.innerHTML="<div class=\"nk-ext nk-ext-t\" id=\"nk-ext-t\"></div><div class=\"nk-ext nk-ext-b\" id=\"nk-ext-b\"></div><div class=\"nk-frame\" id=\"nk-frame\"><img class=\"nk-bg\" id=\"nk-splash-bg\" alt=\"\" decoding=\"async\" referrerpolicy=\"no-referrer\" src=\""+IMG+"\"></div><div class=\"nk-scrim\"></div><div class=\"nk-logo\" id=\"nk-splash-logo\"><img class=\"nk-l-text\" alt=\"\" src=\"data:image/webp;base64,\"><img class=\"nk-l-swoosh\" alt=\"\" src=\"data:image/webp;base64,\"><img class=\"nk-l-trunk\" alt=\"\" src=\"data:image/webp;base64,\"><img class=\"nk-l-crown\" alt=\"\" src=\"data:image/webp;base64,\"></div><button class=\"nk-skip\" id=\"nk-splash-skip\" type=\"button\" aria-label=\"Skip intro\">Skip</button><div class=\"nk-tag\"><span class=\"nk-orn\"></span><p>Premium House Boats<br>at your Fingertip</p></div>";
  root.appendChild(splash);
  splash.classList.add('nk-off');
  var bg=splash.querySelector('#nk-splash-bg'), logo=splash.querySelector('#nk-splash-logo'), tag=splash.querySelector('.nk-tag p');
  var text=logo.querySelector('.nk-l-text'), sw=logo.querySelector('.nk-l-swoosh');
  var run=0, raf=0, timers=[], hiddenAt=0, pageReady=document.readyState==='complete';
  window.addEventListener('load',function(){pageReady=true;});
  function setMask(el,p){
    var end=Math.min(108,Math.max(0,p*108)), edge=Math.max(0,end-8);
    el.style.setProperty('--nk-wipe-edge',edge+'%');
    el.style.setProperty('--nk-wipe-end',end+'%');
  }
  function ease(t){return t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2}
  var seg=[[200,640,0,.355],[640,860,.355,.46],[860,1080,.46,.62],[1080,1340,.62,.80],[1340,1750,.80,1]];
  function clearTimers(){ cancelAnimationFrame(raf); timers.forEach(clearTimeout); timers=[]; }
  function hideNow(id){
    if(id!==run) return;
    splash.classList.add('nk-out');
    timers.push(setTimeout(function(){
      if(id!==run) return;
      splash.classList.add('nk-off'); root.style.overflow='';
    },480));
  }
  var skip=splash.querySelector('#nk-splash-skip');
  if(skip) skip.addEventListener('click',function(){ clearTimers(); hideNow(run); });

  // leave after the 10s show, but never reveal a half-loaded app
  function finish(id,t0){
    if(id!==run) return;
    var elapsed=performance.now()-t0;
    if(pageReady || elapsed>=MAXWAIT) hideNow(id);
    else timers.push(setTimeout(function(){finish(id,t0)},120));
  }
  function play(message){
    clearTimers(); var id=++run;
    if(tag){
      if(message){ tag.textContent=message; tag.style.whiteSpace='normal'; }
      else { tag.innerHTML='Premium House Boats<br>at your Fingertip'; tag.style.whiteSpace=''; }
    }
    timers.push(setTimeout(function(){hideNow(id)},3000)); // keep the launch layer from blocking the app
    root.style.overflow='hidden';
    splash.classList.remove('nk-go','nk-out','nk-off');
    setMask(text,0); setMask(sw,0);
    bg.src=IMG;
    void splash.offsetWidth;
    var started=false;
    function start(){
      if(started||id!==run) return; started=true; prep();
      // clock starts on the first painted frame, so heavy script loading can't eat the animation
      raf=requestAnimationFrame(function(){ raf=requestAnimationFrame(function(t0){
        if(id!==run) return;
        t0=performance.now(); splash.classList.add('nk-go');
        (function frame(now){
          if(id!==run) return;
          var t=now-t0, p=0;
          for(var i=0;i<seg.length;i++){var s=seg[i];
            if(t>=s[0]&&t<=s[1]){p=s[2]+(s[3]-s[2])*ease((t-s[0])/(s[1]-s[0]));break}
            if(t>s[1])p=s[3];}
          setMask(text,p);
          setMask(sw,ease(Math.min(1,Math.max(0,(t-1750)/450))));
          if(t<2300) raf=requestAnimationFrame(frame); else {setMask(text,1);setMask(sw,1);}
        })(t0);
        timers.push(setTimeout(function(){finish(id,t0)},TOTAL-450));
      });});
    }
    function begin(){
      if(started||id!==run) return;
      if(typeof bg.decode==='function'&&!bg.complete) bg.decode().then(start).catch(start);
      else start();
    }
    if(bg.complete&&bg.naturalWidth) begin();
    else { bg.onload=begin; bg.onerror=function(){ if(bg.src.indexOf('f_auto')>-1){bg.onerror=begin; bg.src=IMG_FALLBACK;} else begin(); }; timers.push(setTimeout(begin,700)); }
  }

  // ---- seamless extension: fit frame to real image ratio, sample edge colours ----
  var frame=splash.querySelector('#nk-frame'), extT=splash.querySelector('#nk-ext-t'), extB=splash.querySelector('#nk-ext-b'), AR=0;
  function layout(){
    if(!AR) return;
    var vw=window.innerWidth, vh=window.innerHeight;
    var fw=Math.min(vw,vh*AR), fh=fw/AR, top=(vh-fh)/2, f=fh*.14;
    frame.style.width=fw+'px'; frame.style.height=fh+'px'; frame.style.top=top+'px';
    frame.style.setProperty('--hf', fw<vw-1 ? '6%' : '0%');
    extT.style.height=(top+f+4)+'px'; extB.style.height=(vh-(top+fh-f)+4)+'px';
  }
  function prep(){ if(bg.naturalWidth){ AR=bg.naturalWidth/bg.naturalHeight; layout(); } }
  window.addEventListener('resize',layout);
  function rgb(d){var r=0,g=0,b=0,n=d.length/4;for(var k=0;k<d.length;k+=4){r+=d[k];g+=d[k+1];b+=d[k+2]}return 'rgb('+Math.round(r/n)+','+Math.round(g/n)+','+Math.round(b/n)+')'}
  (function sample(){
    var im=new Image(); im.crossOrigin='anonymous'; im.referrerPolicy='no-referrer';
    im.onload=function(){ try{
      var w=128,h=Math.max(4,Math.round(w*im.naturalHeight/im.naturalWidth));
      var c=document.createElement('canvas'); c.width=w; c.height=h;
      var x=c.getContext('2d'); x.drawImage(im,0,0,w,h);
      var n=Math.max(2,Math.round(h*.02));
      function strip(y0){var o=document.createElement('canvas');o.width=w;o.height=1;var ox=o.getContext('2d');ox.imageSmoothingQuality='high';ox.drawImage(c,0,y0,w,n,0,0,w,1);return o}
      var t=strip(0), b=strip(h-n);
      extT.style.backgroundImage='url('+t.toDataURL()+')';
      extB.style.backgroundImage='url('+b.toDataURL()+')';
      var ct=rgb(t.getContext('2d').getImageData(0,0,w,1).data), cb=rgb(b.getContext('2d').getImageData(0,0,w,1).data);
      splash.style.background='linear-gradient(180deg,'+ct+' 0,'+ct+' 50%,'+cb+' 50%,'+cb+' 100%)';
    }catch(e){} };
    im.src=IMG;
  })();
  // Do not revive the retired launch/quote animation from any stale caller.
  window.nkPlaySplash=function(){};
  if(splash.parentNode) splash.remove();
})();</script>

<style id="nk-auth-loading-style">
#nk-auth-loading{position:fixed;inset:0;z-index:2147482000;display:grid;place-items:center;padding:24px;background:rgba(5,27,20,.46);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s ease,visibility .22s ease;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
#nk-auth-loading.open{opacity:1;visibility:visible;pointer-events:auto}
#nk-auth-loading .nk-auth-loading-card{display:grid;justify-items:center;width:min(100%,330px);padding:30px 26px 28px;border:1px solid rgba(218,236,220,.62);border-radius:25px;background:linear-gradient(145deg,rgba(250,248,239,.98),rgba(235,245,237,.96));box-shadow:0 24px 70px rgba(3,25,17,.3),inset 0 1px 0 rgba(255,255,255,.8);text-align:center}
#nk-auth-loading .nk-auth-loading-logo{width:auto;height:34px;object-fit:contain;filter:brightness(0) saturate(100%) invert(23%) sepia(16%) saturate(1320%) hue-rotate(111deg) brightness(88%) contrast(95%);opacity:.92}
#nk-auth-loading .nk-auth-loading-spinner{width:32px;height:32px;margin:22px 0 16px;border:3px solid rgba(32,132,82,.18);border-top-color:#208452;border-right-color:#d1ae58;border-radius:50%;animation:nkAuthSpin .78s linear infinite}
#nk-auth-loading .nk-auth-loading-title{margin:0;color:#123c2e;font:700 .92rem/1.25 'Plus Jakarta Sans',sans-serif;letter-spacing:.01em}
#nk-auth-loading .nk-auth-loading-note{margin:7px 0 0;color:#70837a;font:500 .68rem/1.45 'Plus Jakarta Sans',sans-serif}
@keyframes nkAuthSpin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){#nk-auth-loading{transition:none}#nk-auth-loading .nk-auth-loading-spinner{animation:none}}
</style>
<script id="nk-auth-loading-js">(function(){
  var previousOverflow='';
  function ensure(){
    var overlay=document.getElementById('nk-auth-loading');
    if(overlay||!document.body) return overlay;
    document.body.insertAdjacentHTML('beforeend','<div id="nk-auth-loading" role="status" aria-live="polite" aria-busy="true"><div class="nk-auth-loading-card"><img class="nk-auth-loading-logo" src="https://res.cloudinary.com/dxmuistk4/image/upload/v1791565882/nauka-logo-new_parqic.png" alt="Nauka"/><span class="nk-auth-loading-spinner" aria-hidden="true"></span><p class="nk-auth-loading-title" data-nk-auth-loading-text>Signing you in…</p><p class="nk-auth-loading-note">Please wait while we prepare your account.</p></div></div>');
    return document.getElementById('nk-auth-loading');
  }
  window.nkShowAuthLoading=function(message){
    var overlay=ensure();
    if(!overlay) return;
    if(!overlay.classList.contains('open')) previousOverflow=document.body.style.overflow||'';
    var text=overlay.querySelector('[data-nk-auth-loading-text]');
    if(text) text.textContent=message||'Signing you in…';
    overlay.classList.add('open');
    document.body.style.overflow='hidden';
  };
  window.nkHideAuthLoading=function(){
    var overlay=document.getElementById('nk-auth-loading');
    if(!overlay) return;
    overlay.classList.remove('open');
    document.body.style.overflow=previousOverflow;
    previousOverflow='';
  };
})();</script>

