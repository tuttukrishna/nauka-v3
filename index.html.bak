    document.addEventListener('click',e=>{const p=document.getElementById('nk-search-guest-panel'),b=document.getElementById('nk-search-guest-toggle');if(p&&!p.hidden&&!p.contains(e.target)&&!b?.contains(e.target)){p.hidden=true;b?.setAttribute('aria-expanded','false')}});
    const original=window.openBookingModal;if(original&&!original.__nkSearchHook){const wrapped=function(){const result=original.apply(this,arguments),f=window.nkHomeFilter;if(f&&state.selectedProperty){const set=(id,value)=>{const el=document.getElementById(id);if(el)el.value=value};set('booking-date',f.start);set('booking-checkout',f.checkout);set('booking-adults',f.adults);set('booking-children',f.children);const nights=f.mode==='day'?1:Math.max(1,Math.round((new Date(f.checkout+'T00:00:00')-new Date(f.start+'T00:00:00'))/86400000));set('booking-nights',nights);const dateHelp=document.querySelector('#nk-booking-date-help span');if(dateHelp)dateHelp.textContent='Dates selected from your search. You can change either date before continuing.';const fmtDate=x=>new Date(x+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});document.getElementById('nk-checkin-display').textContent=fmtDate(f.start);document.getElementById('nk-checkout-display').textContent=f.mode==='day'?'Same day':fmtDate(f.checkout);document.getElementById('booking-adults-display').textContent=f.adults;document.getElementById('booking-children-display').textContent=f.children;window.nkCruiseMode=f.mode;window.nkBookingMode=f.mode;window.updatePriceSummary?.()}return result};wrapped.__nkSearchHook=true;window.openBookingModal=wrapped}
